              <h5>CATEGORY</h5>
              <span class="toggle-icon cs-toggle-icon" data-open-char="{{ icon_open_char }}" data-closed-char="{{ icon_closed_char }}"{% if icon_open_img %} data-open-img="{{ icon_open_img | image_url: width: 40 }}"{% endif %}{% if icon_closed_img %} data-closed-img="{{ icon_closed_img | image_url: width: 40 }}"{% endif %}>
                {%- if icon_open_img -%}<img src="{{ icon_open_img | image_url: width: 40 }}" alt="" class="cs-icon-img" style="width:{{ icon_size }}px;height:{{ icon_size }}px;object-fit:contain;display:block;">{%- else -%}{{- icon_open_char -}}{%- endif -%}
              </span>
            </div>
            <div class="filter-group-body" id="body-category">
              {% assign used_categories = '' %}
              {% for product in collection.products %}
                {% assign category = product.metafields.custom.filter_category_title %}
                {% unless category == blank or used_categories contains category %}
