<script>
(function () {

  /* ---------- ELEMENTS ---------- */
  var layout     = document.getElementById('mainLayout');
  var overlay    = document.getElementById('filterOverlay');
  var toggleBtn  = document.getElementById('toggleFilter');
  var closeBtn   = document.getElementById('closeFilter');
  var sortSel    = document.getElementById('sortProducts');
  var grid       = document.getElementById('productGrid');
  var prevBtn    = document.getElementById('prevPage');
  var nextBtn    = document.getElementById('nextPage');
  var pageNumsEl = document.getElementById('pageNumbers');
  var paginWrap  = document.getElementById('paginationWrapper');

  var minSlider    = document.getElementById('priceMin');
  var maxSlider    = document.getElementById('priceMax');
  var minNumInput  = document.getElementById('priceMinInput');
  var maxNumInput  = document.getElementById('priceMaxInput');
  var priceFill    = document.getElementById('priceFill');

  var PER_PAGE     = 8;
  var currentPage  = 1;
  var filteredList = [];

  /* ---------- SNAPSHOT ALL PRODUCTS ---------- */
  var allProducts = Array.from(grid.querySelectorAll('.product-item'));

  /* ---------- FILTER CHECKBOXES ---------- */
  var vendorCBs   = Array.from(document.querySelectorAll('.filter-vendor'));
  var tagCBs      = Array.from(document.querySelectorAll('.filter-tag'));
  var gemCBs      = Array.from(document.querySelectorAll('.filter-gem'));
  var materialCBs = Array.from(document.querySelectorAll('.filter-material'));
  var shapeCBs    = Array.from(document.querySelectorAll('.filter-shape'));
  var categoryCBs = Array.from(document.querySelectorAll('.filter-category'));
  var sizeCBs     = Array.from(document.querySelectorAll('.filter-size'));
  var allCBs      = vendorCBs.concat(tagCBs, gemCBs, materialCBs, shapeCBs, categoryCBs, sizeCBs);

  /* ============================================================
     SIDEBAR OPEN / CLOSE
  ============================================================ */
  function openSidebar() {
    layout.classList.add('active-filter');
    overlay.classList.add('is-active');
    document.body.style.overflow = 'hidden';
  }
  function closeSidebar() {
    layout.classList.remove('active-filter');
    overlay.classList.remove('is-active');
    document.body.style.overflow = '';
  }

  toggleBtn.addEventListener('click', function () {
    layout.classList.contains('active-filter') ? closeSidebar() : openSidebar();
  });
  if (closeBtn) closeBtn.addEventListener('click', closeSidebar);
  overlay.addEventListener('click', closeSidebar);

  /* ============================================================
     COLLAPSIBLE FILTER GROUPS
  ============================================================ */
  document.querySelectorAll('.filter-group-header').forEach(function (header) {
    header.addEventListener('click', function () {
      var targetId = header.getAttribute('data-target');
      var body = document.getElementById(targetId);
      if (!body) return;
      var nowCollapsed = body.classList.toggle('is-collapsed');
      header.classList.toggle('is-collapsed', nowCollapsed);
      var iconEl = header.querySelector('.cs-toggle-icon');
      if (iconEl) {
        var imgEl = iconEl.querySelector('img');
        if (imgEl) {
          var openSrc   = iconEl.dataset.openImg;
          var closedSrc = iconEl.dataset.closedImg;
          if (nowCollapsed && closedSrc) {
            imgEl.src = closedSrc;
          } else if (!nowCollapsed && openSrc) {
            imgEl.src = openSrc;
          }
        } else {
          iconEl.textContent = nowCollapsed
            ? iconEl.dataset.closedChar
            : iconEl.dataset.openChar;
        }
      }
    });
  });

  /* ============================================================
     PRICE RANGE WIDGET
  ============================================================ */
  function updatePriceFill() {
    if (!minSlider || !maxSlider || !priceFill) return;
    var min = +minSlider.min || 0;
    var max = +minSlider.max || 1000;
    var lo  = +minSlider.value;
    var hi  = +maxSlider.value;
    var leftPct  = ((lo - min) / (max - min)) * 100;
    var rightPct = ((hi - min) / (max - min)) * 100;
    priceFill.style.left  = leftPct + '%';
    priceFill.style.width = (rightPct - leftPct) + '%';
  }

  if (minSlider && maxSlider) {
    minSlider.addEventListener('input', function () {
      if (+minSlider.value > +maxSlider.value) minSlider.value = maxSlider.value;
      if (minNumInput) minNumInput.value = minSlider.value;
      updatePriceFill();
      applyFilters();
    });
    maxSlider.addEventListener('input', function () {
      if (+maxSlider.value < +minSlider.value) maxSlider.value = minSlider.value;
      if (maxNumInput) maxNumInput.value = maxSlider.value;
      updatePriceFill();
      applyFilters();
    });
    if (minNumInput) {
      minNumInput.addEventListener('input', function () {
        var v = Math.min(Math.max(+minNumInput.value, +minSlider.min), +maxSlider.value);
        minSlider.value = v;
        updatePriceFill();
        applyFilters();
      });
    }
    if (maxNumInput) {
      maxNumInput.addEventListener('input', function () {
        var v = Math.max(Math.min(+maxNumInput.value, +maxSlider.max), +minSlider.value);
        maxSlider.value = v;
        updatePriceFill();
        applyFilters();
      });
    }
    updatePriceFill();
  }

  /* ============================================================
     CHECKBOX EVENTS + SORT
  ============================================================ */
  allCBs.forEach(function (cb) { cb.addEventListener('change', applyFilters); });
  sortSel.addEventListener('change', applyFilters);

  function getChecked(arr) {
    return arr.filter(function (cb) { return cb.checked; }).map(function (cb) { return cb.value; });
  }

  /* ============================================================
     HELPER — split a ||‑joined data attribute into an array
  ============================================================ */
  function splitVals(str) {
    if (!str) return [];
    return str.split('||').map(function (s) { return s.trim(); }).filter(Boolean);
  }

  /* ============================================================
     APPLY FILTERS + SORT
  ============================================================ */
  function applyFilters() {
    currentPage = 1;

    var vendors = getChecked(vendorCBs);
    var tags    = getChecked(tagCBs);
    var gems    = getChecked(gemCBs);
    var mats    = getChecked(materialCBs);
    var shapes  = getChecked(shapeCBs);
    var cats    = getChecked(categoryCBs);
    var sizes   = getChecked(sizeCBs);
    var minP    = minSlider ? +minSlider.value : 0;
    var maxP    = maxSlider ? +maxSlider.value : 999999;
    var sort    = sortSel.value;

    filteredList = allProducts.filter(function (p) {
      var price    = parseFloat(p.dataset.price) || 0;
      var pTags    = splitVals(p.dataset.tags);
      var pMats    = splitVals(p.dataset.material);   /* ← now multi-value */
      var pShapes  = splitVals(p.dataset.shape);      /* ← now multi-value */
      var pSizes   = splitVals(p.dataset.size);

      var vOk  = vendors.length === 0 || vendors.indexOf(p.dataset.vendor) !== -1;
      var tOk  = tags.length    === 0 || tags.some(function (t)   { return pTags.indexOf(t)   !== -1; });
      var gOk  = gems.length    === 0 || gems.indexOf(p.dataset.gem) !== -1;
      var mOk  = mats.length    === 0 || mats.some(function (m)   { return pMats.indexOf(m)   !== -1; });
      var shOk = shapes.length  === 0 || shapes.some(function (s) { return pShapes.indexOf(s) !== -1; });
      var cOk  = cats.length    === 0 || cats.indexOf(p.dataset.category) !== -1;
      var sOk  = sizes.length   === 0 || sizes.some(function (s)  { return pSizes.indexOf(s)  !== -1; });
      var pOk  = price >= minP && price <= maxP;

      return vOk && tOk && gOk && mOk && shOk && cOk && sOk && pOk;
    });

    filteredList.sort(function (a, b) {
      if (sort === 'title-asc')  return a.dataset.title.localeCompare(b.dataset.title);
      if (sort === 'title-desc') return b.dataset.title.localeCompare(a.dataset.title);
      if (sort === 'price-asc')  return parseFloat(a.dataset.price) - parseFloat(b.dataset.price);
      if (sort === 'price-desc') return parseFloat(b.dataset.price) - parseFloat(a.dataset.price);
      if (sort === 'date-desc')  return new Date(b.dataset.date) - new Date(a.dataset.date);
      return 0;
    });

    renderPage();
  }

  /* ============================================================
     RENDER PAGE
  ============================================================ */
  function renderPage() {
    var totalPages = Math.max(1, Math.ceil(filteredList.length / PER_PAGE));
    if (currentPage > totalPages) currentPage = totalPages;
    if (currentPage < 1) currentPage = 1;

    var start      = (currentPage - 1) * PER_PAGE;
    var pageItems  = filteredList.slice(start, start + PER_PAGE);
    var visibleSet = new Set(pageItems);

    pageItems.forEach(function (p) { grid.appendChild(p); });

    allProducts.forEach(function (p) {
      if (visibleSet.has(p)) {
        p.classList.remove('cs-hidden');
      } else {
        p.classList.add('cs-hidden');
      }
    });

    renderPagination(totalPages);
  }

  /* ============================================================
     PAGINATION
  ============================================================ */
  function renderPagination(totalPages) {
    pageNumsEl.innerHTML = '';
    prevBtn.disabled = (currentPage <= 1);
    nextBtn.disabled = (currentPage >= totalPages);

    if (totalPages <= 1) {
      paginWrap.style.display = 'none';
      return;
    }
    paginWrap.style.display = 'flex';

    buildPageRange(currentPage, totalPages).forEach(function (p) {
      if (p === '\u2026') {
        var dots = document.createElement('span');
        dots.className = 'page-dots';
        dots.textContent = '\u2026';
        pageNumsEl.appendChild(dots);
      } else {
        var btn = document.createElement('button');
        btn.className = 'page-number' + (p === currentPage ? ' active' : '');
        btn.textContent = p;
        (function (pageNum) {
          btn.addEventListener('click', function () {
            currentPage = pageNum;
            renderPage();
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        })(p);
        pageNumsEl.appendChild(btn);
      }
    });
  }

  function buildPageRange(current, total) {
    if (total <= 7) {
      var all = [];
      for (var i = 1; i <= total; i++) all.push(i);
      return all;
    }
    var pages = [];
    if (current <= 4) {
      for (var i = 1; i <= 5; i++) pages.push(i);
      pages.push('\u2026');
      pages.push(total);
    } else if (current >= total - 3) {
      pages.push(1);
      pages.push('\u2026');
      for (var i = total - 4; i <= total; i++) pages.push(i);
    } else {
      pages.push(1);
      pages.push('\u2026');
      pages.push(current - 1);
      pages.push(current);
      pages.push(current + 1);
      pages.push('\u2026');
      pages.push(total);
    }
    return pages;
  }

  prevBtn.addEventListener('click', function () {
    if (currentPage > 1) {
      currentPage--;
      renderPage();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  });
  nextBtn.addEventListener('click', function () {
    var totalPages = Math.ceil(filteredList.length / PER_PAGE);
    if (currentPage < totalPages) {
      currentPage++;
      renderPage();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  });

  /* ---------- INIT ---------- */
  applyFilters();

})();
</script> {% endcomment %}



