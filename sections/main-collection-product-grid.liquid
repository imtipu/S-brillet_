{% comment %} {% schema %}
{
  "name": "CS Collection Filter",
  "settings": [
    {
      "type": "header",
      "content": "Filter Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show Vendor Filter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Show Tags Filter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_gem",
      "label": "Show Gem Filter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_material",
      "label": "Show Material Filter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_shape",
      "label": "Show Shape Filter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_category",
      "label": "Show Category Filter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_size",
      "label": "Show Size Filter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show Price Filter",
      "default": true
    },
    {
      "type": "header",
      "content": "Filter Group Icon"
    },
    {
      "type": "select",
      "id": "toggle_icon",
      "label": "Icon Style (used when no custom image set)",
      "default": "arrow",
      "options": [
        { "value": "arrow",   "label": "Arrow ▾" },
        { "value": "chevron", "label": "Chevron ›" },
        { "value": "plus",    "label": "Plus +" },
        { "value": "dash",    "label": "Dash −" }
      ]
    },
    {
      "type": "image_picker",
      "id": "icon_open_img",
      "label": "Custom Icon — Group Open (expanded state)"
    },
    {
      "type": "image_picker",
      "id": "icon_closed_img",
      "label": "Custom Icon — Group Closed (collapsed state)"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Custom Icon Size (px)",
      "min": 10,
      "max": 40,
      "step": 1,
      "default": 18
    },
    {
      "type": "header",
      "content": "Pagination Icons"
    },
    {
      "type": "image_picker",
      "id": "prev_icon_img",
      "label": "Previous Page Icon"
    },
    {
      "type": "image_picker",
      "id": "next_icon_img",
      "label": "Next Page Icon"
    },
    {
      "type": "range",
      "id": "pagination_icon_size",
      "label": "Pagination Icon Size (px)",
      "min": 10,
      "max": 40,
      "step": 1,
      "default": 18
    },
    {
      "type": "header",
      "content": "Filter Close Icon"
    },
    {
      "type": "image_picker",
      "id": "close_icon_img",
      "label": "Custom Close Icon (replaces ✕)"
    },
    {
      "type": "range",
      "id": "close_icon_size",
      "label": "Close Icon Size (px)",
      "min": 10,
      "max": 40,
      "step": 1,
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "CS Collection Filter"
    }
  ]
}
{% endschema %}

{% comment %} collection, title and description come from the page context automatically {% endcomment %}
{% assign toggle_icon = section.settings.toggle_icon %}
{% case toggle_icon %}
  {% when 'chevron' %}{% assign icon_open_char = '›' %}{% assign icon_closed_char = '›' %}
  {% when 'plus' %}{% assign icon_open_char = '−' %}{% assign icon_closed_char = '+' %}
  {% when 'dash' %}{% assign icon_open_char = '−' %}{% assign icon_closed_char = '−' %}
  {% else %}{% assign icon_open_char = '▾' %}{% assign icon_closed_char = '▾' %}
{% endcase %}
{% assign icon_open_img = section.settings.icon_open_img %}
{% assign icon_closed_img = section.settings.icon_closed_img %}
{% assign icon_size = section.settings.icon_size %}
{% assign prev_icon_img = section.settings.prev_icon_img %}
{% assign next_icon_img = section.settings.next_icon_img %}
{% assign pagination_icon_size = section.settings.pagination_icon_size %}
{% assign close_icon_img = section.settings.close_icon_img %}
{% assign close_icon_size = section.settings.close_icon_size %}

{% comment %}
  ============================================================
  PRE-BUILD: Collect unique Material & Shape values with images.

  Duplicate-safe sentinel pattern:
    used_materials stores values as ~VALUE~ so that `contains`
    does exact boundary matching, not substring matching.
    e.g. "~Gold~" will NOT match inside "~Rose Gold~".

  Material is capped at 3 unique values.
  Shape has no cap.

  Image source = variant.image (the image assigned to that
  specific variant in Shopify admin). Falls back to
  product.featured_image if the variant has no image.
  ============================================================
{% endcomment %}

{% assign used_materials  = '' %}
{% assign material_labels = '' %}
{% assign material_imgs   = '' %}
{% assign material_count  = 0 %}

{% assign used_shapes  = '' %}
{% assign shape_labels = '' %}
{% assign shape_imgs   = '' %}

{% for product in collection.products %}

  {% comment %} ---- Locate the option index for "material" and "shape" ---- {% endcomment %}
  {% assign mat_opt_index = nil %}
  {% assign shp_opt_index = nil %}

  {% for opt in product.options %}
    {% assign opt_lower = opt | downcase %}
    {% if opt_lower == 'material' %}{% assign mat_opt_index = forloop.index %}{% endif %}
    {% if opt_lower == 'shape'    %}{% assign shp_opt_index = forloop.index %}{% endif %}
  {% endfor %}

  {% comment %} ---- MATERIAL: collect up to 3 unique values ---- {% endcomment %}
  {% if mat_opt_index and material_count < 3 %}
    {% assign mat_key = 'option' | append: mat_opt_index %}
    {% for variant in product.variants %}
      {% if material_count >= 3 %}{% break %}{% endif %}
      {% assign mat_val = variant[mat_key] %}
      {% assign mat_sentinel = '~' | append: mat_val | append: '~' %}
      {% unless mat_val == blank or used_materials contains mat_sentinel %}
        {% assign used_materials = used_materials | append: mat_sentinel %}
        {% assign material_count = material_count | plus: 1 %}

        {% if variant.image %}
          {% assign mat_img_url = variant.image | image_url: width: 80 %}
        {% else %}
          {% assign mat_img_url = product.featured_image | image_url: width: 80 %}
        {% endif %}

        {% assign material_labels = material_labels | append: mat_val | append: '||' %}
        {% assign material_imgs   = material_imgs   | append: mat_img_url | append: '||' %}
      {% endunless %}
    {% endfor %}
  {% endif %}

  {% comment %} ---- SHAPE: collect all unique values ---- {% endcomment %}
  {% if shp_opt_index %}
    {% assign shp_key = 'option' | append: shp_opt_index %}
    {% for variant in product.variants %}
      {% assign shp_val = variant[shp_key] %}
      {% assign shp_sentinel = '~' | append: shp_val | append: '~' %}
      {% unless shp_val == blank or used_shapes contains shp_sentinel %}
        {% assign used_shapes = used_shapes | append: shp_sentinel %}

        {% if variant.image %}
          {% assign shp_img_url = variant.image | image_url: width: 80 %}
        {% else %}
          {% assign shp_img_url = product.featured_image | image_url: width: 80 %}
        {% endif %}

        {% assign shape_labels = shape_labels | append: shp_val | append: '||' %}
        {% assign shape_imgs   = shape_imgs   | append: shp_img_url | append: '||' %}
      {% endunless %}
    {% endfor %}
  {% endif %}

{% endfor %}

{% comment %} Split parallel strings into arrays for sidebar rendering {% endcomment %}
{% assign material_label_arr = material_labels | split: '||' %}
{% assign material_img_arr   = material_imgs   | split: '||' %}
{% assign shape_label_arr    = shape_labels    | split: '||' %}
{% assign shape_img_arr      = shape_imgs      | split: '||' %}

{% comment %} ---- GEMSTONE: collect unique gems from metafields across all products ---- {% endcomment %}
{% assign used_gems_sentinel = '' %}
{% assign gem_labels = '' %}
{% assign gem_imgs   = '' %}

{% for product in collection.products %}
  {% assign gem_val = product.metafields.custom.filter_gem_title %}
  {% assign gem_sentinel = '~' | append: gem_val | append: '~' %}
  {% unless gem_val == blank or used_gems_sentinel contains gem_sentinel %}
    {% assign used_gems_sentinel = used_gems_sentinel | append: gem_sentinel %}
    {% assign gem_img_src = product.metafields.custom.filter_gem_image | image_url: width: 80 %}
    {% assign gem_labels = gem_labels | append: gem_val | append: '||' %}
    {% assign gem_imgs   = gem_imgs   | append: gem_img_src | append: '||' %}
  {% endunless %}
{% endfor %}

{% assign gem_label_arr = gem_labels | split: '||' %}
{% assign gem_img_arr   = gem_imgs   | split: '||' %}

<!-- OVERLAY: placed OUTSIDE .layout so clicking it never collapses the grid -->
<div class="filter-overlay" id="filterOverlay"></div>

<section class="custom-collection cs-icon-{{ section.settings.toggle_icon }}">
  <div class="page-width">

    <!-- SECTION HEADING & DESCRIPTION — dynamic from collection page context -->
    {% if collection.title != blank or collection.description != blank %}
    <div class="section-intro">
      {% if collection.title != blank %}
        <h1 class="section-heading">{{ collection.title }}</h1>
      {% endif %}
      {% if collection.description != blank %}
        <p class="section-description">{{ collection.description }}</p>
      {% endif %}
    </div>
    {% endif %}

    <!-- TOOLBAR -->
    <div class="cs-sticky-toolbar">
    <div class="toolbar" style="max-width: 1500px; margin: 0 auto">
      <button id="toggleFilter" aria-label="Toggle Filters">&#9776; FILTERS</button>
      <select id="sortProducts">
        <option value="">SORT</option>
        <option value="title-asc">A TO Z</option>
        <option value="title-desc">Z TO A</option>
        <option value="price-asc">PRICE LOW TO HIGH</option>
        <option value="price-desc">PRICE HIGH TO LOW</option>
        <option value="date-desc">NEWEST</option>
      </select>
    </div>
    </div>
    <div class="layout" id="mainLayout">

      <!-- FILTER SIDEBAR -->
      <div class="filters" id="filterSidebar">

        <div class="filter-header">
          <h4>Filter</h4>
          <button class="filter-close" id="closeFilter" aria-label="Close Filters">
            {%- if close_icon_img -%}
              <img src="{{ close_icon_img | image_url: width: 40 }}" alt="Close" style="width:{{ close_icon_size }}px;height:{{ close_icon_size }}px;object-fit:contain;display:block;">
            {%- else -%}
              &#10005;
            {%- endif -%}
          </button>
        </div>

        <!-- VENDOR -->
        {% if section.settings.show_vendor %}
        <div class="filter-group">
          <div class="filter-group-header" data-target="body-vendor">
            <h5>Vendor</h5>
            <span class="toggle-icon cs-toggle-icon"
              data-open-char="{{ icon_open_char }}"
              data-closed-char="{{ icon_closed_char }}"
              {% if icon_open_img %}data-open-img="{{ icon_open_img | image_url: width: 40 }}"{% endif %}
              {% if icon_closed_img %}data-closed-img="{{ icon_closed_img | image_url: width: 40 }}"{% endif %}>
              {%- if icon_open_img -%}
                <img src="{{ icon_open_img | image_url: width: 40 }}" alt="" class="cs-icon-img" style="width:{{ icon_size }}px;height:{{ icon_size }}px;object-fit:contain;display:block;">
              {%- else -%}
                {{- icon_open_char -}}
              {%- endif -%}
            </span>
          </div>
          <div class="filter-group-body" id="body-vendor">
            {% assign vendors = collection.products | map: 'vendor' | uniq %}
            {% for vendor in vendors %}
              <label class="filter-right">
                <span>{{ vendor }}</span>
                <input type="checkbox" class="filter-vendor" value="{{ vendor }}">
              </label>
            {% endfor %}
          </div>
        </div>
        {% endif %}

        <!-- TAGS -->
        {% if section.settings.show_tags %}
        <div class="filter-group">
          <div class="filter-group-header" data-target="body-tags">
            <h5>Tags</h5>
            <span class="toggle-icon cs-toggle-icon"
              data-open-char="{{ icon_open_char }}"
              data-closed-char="{{ icon_closed_char }}"
              {% if icon_open_img %}data-open-img="{{ icon_open_img | image_url: width: 40 }}"{% endif %}
              {% if icon_closed_img %}data-closed-img="{{ icon_closed_img | image_url: width: 40 }}"{% endif %}>
              {%- if icon_open_img -%}
                <img src="{{ icon_open_img | image_url: width: 40 }}" alt="" class="cs-icon-img" style="width:{{ icon_size }}px;height:{{ icon_size }}px;object-fit:contain;display:block;">
              {%- else -%}
                {{- icon_open_char -}}
              {%- endif -%}
            </span>
          </div>
          <div class="filter-group-body" id="body-tags">
            {% assign used_tags = '' %}
            {% for product in collection.products %}
              {% for tag in product.tags %}
                {% unless used_tags contains tag %}
                  {% assign used_tags = used_tags | append: tag | append: '||' %}
                  <label class="filter-right">
                    <span>{{ tag }}</span>
                    <input type="checkbox" class="filter-tag" value="{{ tag }}">
                  </label>
                {% endunless %}
              {% endfor %}
            {% endfor %}
          </div>
        </div>
        {% endif %}

        <!-- GEMSTONES (MEANINGS) — from product metafields, sentinel-dedup -->
        {% if section.settings.show_gem %}
        {% if gem_label_arr.size > 0 %}
        <div class="filter-group">
          <div class="filter-group-header" data-target="body-gem">
            <h5>GEMSTONES (MEANINGS)</h5>
            <span class="toggle-icon cs-toggle-icon"
              data-open-char="{{ icon_open_char }}"
              data-closed-char="{{ icon_closed_char }}"
              {% if icon_open_img %}data-open-img="{{ icon_open_img | image_url: width: 40 }}"{% endif %}
              {% if icon_closed_img %}data-closed-img="{{ icon_closed_img | image_url: width: 40 }}"{% endif %}>
              {%- if icon_open_img -%}
                <img src="{{ icon_open_img | image_url: width: 40 }}" alt="" class="cs-icon-img" style="width:{{ icon_size }}px;height:{{ icon_size }}px;object-fit:contain;display:block;">
              {%- else -%}
                {{- icon_open_char -}}
              {%- endif -%}
            </span>
          </div>
          <div class="filter-group-body" id="body-gem">
            {% for gem_label in gem_label_arr %}
              {% unless gem_label == blank %}
              <label class="filter-right">
                <span class="filter-item">
                  <img src="{{ gem_img_arr[forloop.index0] }}" alt="{{ gem_label }}">
                  <span>{{ gem_label }}</span>
                </span>
                <input type="checkbox" class="filter-gem" value="{{ gem_label }}">
              </label>
              {% endunless %}
            {% endfor %}
          </div>
        </div>
        {% endif %}
        {% endif %}

        <!-- ============================================================
             MATERIAL — built from VARIANT OPTION named "Material"
             Image shown = featured_image of first variant with that value
        ============================================================ -->
        {% if section.settings.show_material %}
        {% if material_label_arr.size > 0 %}
        <div class="filter-group">
          <div class="filter-group-header" data-target="body-material">
            <h5>MATERIAL</h5>
            <span class="toggle-icon cs-toggle-icon"
              data-open-char="{{ icon_open_char }}"
              data-closed-char="{{ icon_closed_char }}"
              {% if icon_open_img %}data-open-img="{{ icon_open_img | image_url: width: 40 }}"{% endif %}
              {% if icon_closed_img %}data-closed-img="{{ icon_closed_img | image_url: width: 40 }}"{% endif %}>
              {%- if icon_open_img -%}
                <img src="{{ icon_open_img | image_url: width: 40 }}" alt="" class="cs-icon-img" style="width:{{ icon_size }}px;height:{{ icon_size }}px;object-fit:contain;display:block;">
              {%- else -%}
                {{- icon_open_char -}}
              {%- endif -%}
            </span>
          </div>
          <div class="filter-group-body" id="body-material">
            {% for mat_label in material_label_arr %}
              {% unless mat_label == blank %}
              <label class="filter-right">
                <span class="filter-item">
                  <img src="{{ material_img_arr[forloop.index0] }}" alt="{{ mat_label }}">
                  <span>{{ mat_label }}</span>
                </span>
                <input type="checkbox" class="filter-material" value="{{ mat_label }}">
              </label>
              {% endunless %}
            {% endfor %}
          </div>
        </div>
        {% endif %}
        {% endif %}

        <!-- ============================================================
             SHAPE — built from VARIANT OPTION named "Shape"
             Image shown = featured_image of first variant with that value
        ============================================================ -->
        {% if section.settings.show_shape %}
        {% if shape_label_arr.size > 0 %}
        <div class="filter-group">
          <div class="filter-group-header" data-target="body-shape">
            <h5>SHAPE</h5>
            <span class="toggle-icon cs-toggle-icon"
              data-open-char="{{ icon_open_char }}"
              data-closed-char="{{ icon_closed_char }}"
              {% if icon_open_img %}data-open-img="{{ icon_open_img | image_url: width: 40 }}"{% endif %}
              {% if icon_closed_img %}data-closed-img="{{ icon_closed_img | image_url: width: 40 }}"{% endif %}>
              {%- if icon_open_img -%}
                <img src="{{ icon_open_img | image_url: width: 40 }}" alt="" class="cs-icon-img" style="width:{{ icon_size }}px;height:{{ icon_size }}px;object-fit:contain;display:block;">
              {%- else -%}
                {{- icon_open_char -}}
              {%- endif -%}
            </span>
          </div>
          <div class="filter-group-body" id="body-shape">
            {% for shp_label in shape_label_arr %}
              {% unless shp_label == blank %}
              <label class="filter-right">
                <span class="filter-item">
                  <img src="{{ shape_img_arr[forloop.index0] }}" alt="{{ shp_label }}">
                  <span>{{ shp_label }}</span>
                </span>
                <input type="checkbox" class="filter-shape" value="{{ shp_label }}">
              </label>
              {% endunless %}
            {% endfor %}
          </div>
        </div>
        {% endif %}
        {% endif %}

        <!-- CATEGORY — only shown when collection has at least one product with a category -->
        {% if section.settings.show_category %}
          {% assign has_category = false %}
          {% for product in collection.products %}
            {% unless product.metafields.custom.filter_category_title == blank %}
              {% assign has_category = true %}
              {% break %}
            {% endunless %}
          {% endfor %}
          {% if has_category %}
        <div class="filter-group">
          <div class="filter-group-header" data-target="body-category">
            <h5>CATEGORY</h5>
            <span class="toggle-icon cs-toggle-icon"
              data-open-char="{{ icon_open_char }}"
              data-closed-char="{{ icon_closed_char }}"
              {% if icon_open_img %}data-open-img="{{ icon_open_img | image_url: width: 40 }}"{% endif %}
              {% if icon_closed_img %}data-closed-img="{{ icon_closed_img | image_url: width: 40 }}"{% endif %}>
              {%- if icon_open_img -%}
                <img src="{{ icon_open_img | image_url: width: 40 }}" alt="" class="cs-icon-img" style="width:{{ icon_size }}px;height:{{ icon_size }}px;object-fit:contain;display:block;">
              {%- else -%}
                {{- icon_open_char -}}
              {%- endif -%}
            </span>
          </div>
          <div class="filter-group-body" id="body-category">
            {% assign used_categories = '' %}
            {% for product in collection.products %}
              {% assign category = product.metafields.custom.filter_category_title %}
              {% unless category == blank or used_categories contains category %}
                {% assign used_categories = used_categories | append: category | append: '||' %}
                <label class="filter-right">
                  <span class="filter-item">
                    <img src="{{ product.metafields.custom.filter_category_img | image_url: width: 40 }}" alt="{{ category }}">
                    <span>{{ category }}</span>
                  </span>
                  <input type="checkbox" class="filter-category" value="{{ category }}">
                </label>
              {% endunless %}
            {% endfor %}
          </div>
        </div>
          {% endif %}
        {% endif %}

        <!-- SIZE — from variant option named "Size" -->
        {% if section.settings.show_size %}
        <div class="filter-group">
          <div class="filter-group-header" data-target="body-size">
            <h5>SIZE</h5>
            <span class="toggle-icon cs-toggle-icon"
              data-open-char="{{ icon_open_char }}"
              data-closed-char="{{ icon_closed_char }}"
              {% if icon_open_img %}data-open-img="{{ icon_open_img | image_url: width: 40 }}"{% endif %}
              {% if icon_closed_img %}data-closed-img="{{ icon_closed_img | image_url: width: 40 }}"{% endif %}>
              {%- if icon_open_img -%}
                <img src="{{ icon_open_img | image_url: width: 40 }}" alt="" class="cs-icon-img" style="width:{{ icon_size }}px;height:{{ icon_size }}px;object-fit:contain;display:block;">
              {%- else -%}
                {{- icon_open_char -}}
              {%- endif -%}
            </span>
          </div>
          <div class="filter-group-body" id="body-size">
            {% assign used_sizes = '' %}
            {% for product in collection.products %}
              {% for opt_i in (1..3) %}
                {% assign opt_index = opt_i | minus: 1 %}
                {% assign opt_name = product.options[opt_index] | downcase %}
                {% if opt_name contains 'size' %}
                  {% for variant in product.variants %}
                    {% assign opt_key = 'option' | append: opt_i %}
                    {% assign size_opt = variant[opt_key] %}
                    {% unless size_opt == blank or used_sizes contains size_opt %}
                      {% assign used_sizes = used_sizes | append: size_opt | append: '||' %}
                      <label class="filter-right">
                        <span>{{ size_opt }}</span>
                        <input type="checkbox" class="filter-size" value="{{ size_opt }}">
                      </label>
                    {% endunless %}
                  {% endfor %}
                {% endif %}
              {% endfor %}
            {% endfor %}
          </div>
        </div>
        {% endif %}

        <!-- PRICE -->
        {% if section.settings.show_price %}
        <div class="filter-group">
          <div class="filter-group-header" data-target="body-price">
            <h5>PRICE</h5>
            <span class="toggle-icon cs-toggle-icon"
              data-open-char="{{ icon_open_char }}"
              data-closed-char="{{ icon_closed_char }}"
              {% if icon_open_img %}data-open-img="{{ icon_open_img | image_url: width: 40 }}"{% endif %}
              {% if icon_closed_img %}data-closed-img="{{ icon_closed_img | image_url: width: 40 }}"{% endif %}>
              {%- if icon_open_img -%}
                <img src="{{ icon_open_img | image_url: width: 40 }}" alt="" class="cs-icon-img" style="width:{{ icon_size }}px;height:{{ icon_size }}px;object-fit:contain;display:block;">
              {%- else -%}
                {{- icon_open_char -}}
              {%- endif -%}
            </span>
          </div>
          <div class="filter-group-body" id="body-price">
            <div class="price-range-widget">
              <div class="price-range-track-wrap">
                <div class="price-range-track" id="priceTrack">
                  <div class="price-range-fill" id="priceFill"></div>
                  <input type="range" id="priceMin" min="0" max="1000" value="0" class="price-thumb price-thumb-min" aria-label="Minimum price">
                  <input type="range" id="priceMax" min="0" max="1000" value="1000" class="price-thumb price-thumb-max" aria-label="Maximum price">
                </div>
              </div>
              <div class="price-inputs-row">
                <div class="price-input-box">
                  <span class="price-input-prefix">$</span>
                  <input type="number" id="priceMinInput" min="0" max="1000" value="0" class="price-num-input" aria-label="Min price input">
                </div>
                <div class="price-input-box">
                  <span class="price-input-prefix">$</span>
                  <input type="number" id="priceMaxInput" min="0" max="1000" value="1000" class="price-num-input" aria-label="Max price input">
                </div>
              </div>
            </div>
          </div>
        </div>
        {% endif %}

      </div>
      <!-- END FILTERS -->

      <!-- PRODUCTS -->
      <div class="products-area" style="max-width: 1500px; margin: 0 auto">

        <div class="grid" id="productGrid">
          {% paginate collection.products by 250 %}
            {% for product in collection.products %}

              {% comment %}
                ============================================================
                Build data-material and data-shape from VARIANT OPTIONS.

                For each product we walk its options to find "Material" and
                "Shape" (case-insensitive), then collect every unique value
                across all variants, joined with || so the JS splitVals()
                helper can compare them to the checked filter values.
                ============================================================
              {% endcomment %}

              {% assign p_mat_opt_idx = nil %}
              {% assign p_shp_opt_idx = nil %}
              {% for opt in product.options %}
                {% assign opt_lower = opt | downcase %}
                {% if opt_lower == 'material' %}{% assign p_mat_opt_idx = forloop.index %}{% endif %}
                {% if opt_lower == 'shape'    %}{% assign p_shp_opt_idx = forloop.index %}{% endif %}
              {% endfor %}

              {% assign p_mat_vals = '' %}
              {% if p_mat_opt_idx %}
                {% assign p_mat_key = 'option' | append: p_mat_opt_idx %}
                {% for variant in product.variants %}
                  {% assign v_mat = variant[p_mat_key] %}
                  {% unless v_mat == blank or p_mat_vals contains v_mat %}
                    {% assign p_mat_vals = p_mat_vals | append: v_mat | append: '||' %}
                  {% endunless %}
                {% endfor %}
              {% endif %}

              {% assign p_shp_vals = '' %}
              {% if p_shp_opt_idx %}
                {% assign p_shp_key = 'option' | append: p_shp_opt_idx %}
                {% for variant in product.variants %}
                  {% assign v_shp = variant[p_shp_key] %}
                  {% unless v_shp == blank or p_shp_vals contains v_shp %}
                    {% assign p_shp_vals = p_shp_vals | append: v_shp | append: '||' %}
                  {% endunless %}
                {% endfor %}
              {% endif %}

              {% comment %} Size values (unchanged) {% endcomment %}
              {% assign size_vals = '' %}
              {% for opt_i in (1..3) %}
                {% assign opt_index = opt_i | minus: 1 %}
                {% assign opt_name = product.options[opt_index] | downcase %}
                {% assign opt_key = 'option' | append: opt_i %}
                {% for variant in product.variants %}
                  {% assign opt_val = variant[opt_key] %}
                  {% if opt_name contains 'size' %}
                    {% unless size_vals contains opt_val %}
                      {% assign size_vals = size_vals | append: opt_val | append: '||' %}
                    {% endunless %}
                  {% endif %}
                {% endfor %}
              {% endfor %}

              <div class="product-item"
                data-vendor="{{ product.vendor }}"
                data-price="{{ product.price | divided_by: 100 }}"
                data-title="{{ product.title | downcase }}"
                data-date="{{ product.created_at }}"
                data-tags="{{ product.tags | join: '||' }}"
                data-gem="{{ product.metafields.custom.filter_gem_title }}"
                data-material="{{ p_mat_vals }}"
                data-shape="{{ p_shp_vals }}"
                data-size="{{ size_vals }}"
                data-category="{{ product.metafields.custom.filter_category_title }}">
                {%- render 'product-card-2',
                  product: product,
                  section_id: section.id,
                  product_card_style: 'style-1'
                -%}
              </div>
            {% endfor %}
          {% endpaginate %}
        </div>

        <!-- PAGINATION -->
        <div class="pagination-wrapper" id="paginationWrapper" style="display:none;">
          {%- if prev_icon_img -%}
          <button class="page-btn cs-page-btn-img" id="prevPage" aria-label="Previous">
            <img src="{{ prev_icon_img | image_url: width: 40 }}" alt="Previous" style="width:{{ pagination_icon_size }}px;height:{{ pagination_icon_size }}px;object-fit:contain;display:block;">
          </button>
          {%- else -%}
          <button class="page-btn" id="prevPage" aria-label="Previous">&#8249;</button>
          {%- endif -%}
          <div class="page-numbers" id="pageNumbers"></div>
          {%- if next_icon_img -%}
          <button class="page-btn cs-page-btn-img" id="nextPage" aria-label="Next">
            <img src="{{ next_icon_img | image_url: width: 40 }}" alt="Next" style="width:{{ pagination_icon_size }}px;height:{{ pagination_icon_size }}px;object-fit:contain;display:block;">
          </button>
          {%- else -%}
          <button class="page-btn" id="nextPage" aria-label="Next">&#8250;</button>
          {%- endif -%}
        </div>

      </div>
      <!-- END PRODUCTS -->

    </div>
  </div>
</section>

<style>

