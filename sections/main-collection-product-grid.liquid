{% assign close_icon_size      = section.settings.close_icon_size %}

{% comment %}
  ============================================================
  SIDEBAR GEM LIST
  Read all filter_by_gemstone metaobjects from the shop.
  Each entry's "title" field (key: title) becomes both the
  sidebar checkbox label AND the value we write into data-gem
  on every product card. Matching is therefore exact.
  ============================================================
{% endcomment %}
{% assign used_gems_sentinel = '' %}
{% assign gem_labels = '' %}
{% assign gem_imgs   = '' %}

{% for gem_entry in shop.metaobjects.filter_by_gemstone.values %}
  {% assign gem_title = gem_entry.title.value %}
  {% if gem_title == blank %}{% assign gem_title = gem_entry.title %}{% endif %}
  {% if gem_title == blank %}{% assign gem_title = gem_entry.system.handle | replace: '-', ' ' | capitalize %}{% endif %}

  {% assign gem_sentinel = '~' | append: gem_title | append: '~' %}
  {% unless gem_title == blank or used_gems_sentinel contains gem_sentinel %}
    {% assign used_gems_sentinel = used_gems_sentinel | append: gem_sentinel %}

    {% assign gem_img_list = gem_entry.image.value %}
    {% assign gem_img_file = gem_img_list | first %}
    {% if gem_img_file %}
      {% assign gem_img_src = gem_img_file | image_url: width: 80 %}
    {% else %}
      {% assign gem_img_src = '' %}
    {% endif %}

    {% assign gem_labels = gem_labels | append: gem_title | append: '||' %}
    {% assign gem_imgs   = gem_imgs   | append: gem_img_src | append: '||' %}
  {% endunless %}
{% endfor %}

{% assign gem_label_arr = gem_labels | split: '||' %}
{% assign gem_img_arr   = gem_imgs   | split: '||' %}

{% comment %}
  ============================================================
  MATERIAL & SHAPE — from variant options
  ============================================================
{% endcomment %}
{% assign used_materials  = '' %}
{% assign material_labels = '' %}
{% assign material_imgs   = '' %}
{% assign material_count  = 0 %}
{% assign used_shapes     = '' %}
{% assign shape_labels    = '' %}
{% assign shape_imgs      = '' %}

{% for product in collection.products %}
  {% assign mat_opt_index = nil %}
  {% assign shp_opt_index = nil %}
  {% for opt in product.options %}
    {% assign opt_lower = opt | downcase %}
    {% if opt_lower == 'material' %}{% assign mat_opt_index = forloop.index %}{% endif %}
    {% if opt_lower == 'shape'    %}{% assign shp_opt_index = forloop.index %}{% endif %}
  {% endfor %}

  {% if mat_opt_index and material_count < 3 %}
    {% assign mat_key = 'option' | append: mat_opt_index %}
    {% for variant in product.variants %}
      {% if material_count >= 3 %}{% break %}{% endif %}
      {% assign mat_val      = variant[mat_key] %}
      {% assign mat_sentinel = '~' | append: mat_val | append: '~' %}
      {% unless mat_val == blank or used_materials contains mat_sentinel %}
        {% assign used_materials  = used_materials | append: mat_sentinel %}
        {% assign material_count  = material_count | plus: 1 %}
        {% if variant.image %}
          {% assign mat_img_url = variant.image | image_url: width: 80 %}
        {% else %}
          {% assign mat_img_url = product.featured_image | image_url: width: 80 %}
        {% endif %}
        {% assign material_labels = material_labels | append: mat_val | append: '||' %}
        {% assign material_imgs   = material_imgs   | append: mat_img_url | append: '||' %}
      {% endunless %}
    {% endfor %}
  {% endif %}

  {% if shp_opt_index %}
    {% assign shp_key = 'option' | append: shp_opt_index %}
    {% for variant in product.variants %}
      {% assign shp_val      = variant[shp_key] %}
      {% assign shp_sentinel = '~' | append: shp_val | append: '~' %}
      {% unless shp_val == blank or used_shapes contains shp_sentinel %}
        {% assign used_shapes  = used_shapes | append: shp_sentinel %}
        {% if variant.image %}
          {% assign shp_img_url = variant.image | image_url: width: 80 %}
        {% else %}
          {% assign shp_img_url = product.featured_image | image_url: width: 80 %}
        {% endif %}
        {% assign shape_labels = shape_labels | append: shp_val | append: '||' %}
        {% assign shape_imgs   = shape_imgs   | append: shp_img_url | append: '||' %}
      {% endunless %}
    {% endfor %}
  {% endif %}
{% endfor %}

{% assign material_label_arr = material_labels | split: '||' %}
{% assign material_img_arr   = material_imgs   | split: '||' %}
{% assign shape_label_arr    = shape_labels    | split: '||' %}
{% assign shape_img_arr      = shape_imgs      | split: '||' %}

