<script>
  document.addEventListener('DOMContentLoaded', function() {
    const grid = document.getElementById('sbi-grid-{{ section.id }}');
    const loadMoreBtn = document.getElementById('sbi-load-more-{{ section.id }}');
    const finalBtn = document.getElementById('sbi-final-btn-{{ section.id }}');
    
    // 1. LOAD MORE FUNCTIONALITY
    if (grid && loadMoreBtn) {
      let hiddenItems = grid.querySelectorAll('.hidden-item');
      
      if (hiddenItems.length === 0) {
        loadMoreBtn.style.display = 'none';
        finalBtn.style.display = 'flex';
      }

      loadMoreBtn.addEventListener('click', function(e) {
        e.preventDefault();
        hiddenItems = grid.querySelectorAll('.hidden-item');
        
        for (let i = 0; i < 4 && i < hiddenItems.length; i++) {
          hiddenItems[i].classList.remove('hidden-item');
        }
        
        if (grid.querySelectorAll('.hidden-item').length === 0) {
          loadMoreBtn.style.display = 'none';
          finalBtn.style.display = 'flex';
        }
      });
    }

    // 2. MODAL FUNCTIONALITY
    const modal = document.getElementById('sbi-modal-{{ section.id }}');
    const closeBtn = document.getElementById('sbi-modal-close-{{ section.id }}');
    const mainImg = document.getElementById('sbi-modal-main-img-{{ section.id }}');
    const instaLink = document.getElementById('sbi-modal-insta-link-{{ section.id }}');
    const productsContainer = document.getElementById('sbi-modal-products-{{ section.id }}');
    const paginationContainer = document.getElementById('sbi-modal-pagination-{{ section.id }}');
    const items = grid.querySelectorAll('.sbi-item');
    
    let currentIndex = 0;

    // Helper to determine how many products to show per page based on screen size
    function getProductsPerPage() {
      return window.innerWidth <= 768 ? 4 : 6;
    }

    const blockData = [
      {%- for block in section.blocks -%}
        {
          image: "{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 800 }}{% endif %}",
          link: "{{ block.settings.link | default: '#' }}",
          collection: "{{ block.settings.collection.handle }}"
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ];

    function openModal(index) {
      currentIndex = index;
      const data = blockData[index];
      
      mainImg.src = data.image;
      instaLink.href = data.link;
      
      productsContainer.innerHTML = '<div class="sbi-modal-empty">Loading products...</div>';
      paginationContainer.innerHTML = '';
      modal.classList.add('active');

      if(data.collection) {
        fetch(`/collections/${data.collection}/products.json?limit=250`)
          .then(response => response.json())
          .then(data => {
            const allProducts = data.products;
            
            if(allProducts.length === 0) {
               productsContainer.innerHTML = '<div class="sbi-modal-empty">No products found in this collection.</div>';
               return;
            }

            // Function to render products for a specific page
            function renderProducts(page) {
              const productsPerPage = getProductsPerPage();
              productsContainer.innerHTML = '';
              const start = (page - 1) * productsPerPage;
              const end = start + productsPerPage;
              const paginatedProducts = allProducts.slice(start, end);

              paginatedProducts.forEach(product => {
                const price = (product.variants[0].price).replace('.00', '');
                const comparePrice = product.variants[0].compare_at_price ? `<span class="sbi-product-compare">$${product.variants[0].compare_at_price}</span>` : '';
                const imgSrc = product.images.length > 0 ? product.images[0].src : '';

                const html = `
                  <a href="/products/${product.handle}" class="sbi-product-card">
                    <div class="sbi-product-img-wrapper">
                      <img src="${imgSrc}" class="sbi-product-img" alt="${product.title}">
                    </div>
                    <div class="sbi-product-info">
                      <h4 class="sbi-product-title">${product.title}</h4>
                      <div class="sbi-product-price-row">
                        <span class="sbi-product-price">$${price}</span>
                        ${comparePrice}
                      </div>
                    </div>
                  </a>
                `;
                productsContainer.innerHTML += html;
              });

              renderPagination(page, productsPerPage);
            }

            // Function to create pagination buttons with ... logic
            function renderPagination(currentPage, productsPerPage) {
              const totalPages = Math.ceil(allProducts.length / productsPerPage);
              paginationContainer.innerHTML = '';

              if (totalPages <= 1) return;

              // Prev Button (<)
              const prevBtn = document.createElement('button');
              prevBtn.className = 'sbi-page-btn sbi-page-arrow';
              prevBtn.disabled = currentPage === 1;
              
              // ==========================================
              // PASTE YOUR CUSTOM LEFT ARROW SVG HERE
              // ==========================================
              {% comment %} prevBtn.innerHTML = '<svg viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"></path></svg>'; {% endcomment %}
              prevBtn.innerHTML = `
              <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="12" height="14" viewBox="0 0 12 14" fill="none">
<g transform="scale(-1, 1) translate(-12, 0)">
<rect width="12" height="14" transform="matrix(1 0 0 -1 0 14)" fill="url(#pattern0_8021_19384)"/>
</g>
<defs>
<pattern id="pattern0_8021_19384" patternContentUnits="objectBoundingBox" width="1" height="1">
<use xlink:href="#image0_8021_19384" transform="matrix(0.00452489 0 0 0.00387847 0 -0.00808016)"/>
</pattern>
<image id="image0_8021_19384" width="221" height="262" preserveAspectRatio="none" xlink:href="data:image/png;base64,"/>
</defs>
</svg>
              `;

              
              prevBtn.addEventListener('click', () => {
                if (currentPage > 1) renderProducts(currentPage - 1);
              });
              paginationContainer.appendChild(prevBtn);

              // Logic to show pages with ... (ellipsis)
              let pages = [];
              if (totalPages <= 5) {
                for (let i = 1; i <= totalPages; i++) pages.push(i);
              } else {
                if (currentPage <= 3) {
                  pages = [1, 2, 3, '...', totalPages];
                } else if (currentPage >= totalPages - 2) {
                  pages = [1, '...', totalPages - 2, totalPages - 1, totalPages];
                } else {
                  pages = [1, '...', currentPage - 1, currentPage, currentPage + 1, '...', totalPages];
                }
              }

              pages.forEach(p => {
                if (p === '...') {
                  const dots = document.createElement('span');
                  dots.className = 'sbi-page-dots';
                  dots.innerText = '...';
                  paginationContainer.appendChild(dots);
                } else {
                  const btn = document.createElement('button');
                  btn.className = `sbi-page-btn ${p === currentPage ? 'active' : ''}`;
                  btn.innerText = p;
                  btn.addEventListener('click', () => {
                    renderProducts(p);
                  });
                  paginationContainer.appendChild(btn);
                }
              });

              // Next Button (>)
              const nextBtn = document.createElement('button');
              nextBtn.className = 'sbi-page-btn sbi-page-arrow';
              nextBtn.disabled = currentPage === totalPages;
              
              // ==========================================
              // PASTE YOUR CUSTOM RIGHT ARROW SVG HERE
              // ==========================================
              {% comment %} nextBtn.innerHTML = '<svg viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"></path></svg>'; {% endcomment %}
              
              nextBtn.innerHTML = `
              <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="12" height="14" viewBox="0 0 12 14" fill="none">
<rect width="12" height="14" transform="matrix(1 0 0 -1 0 14)" fill="url(#pattern0_8021_19384)"/>
<defs>
<pattern id="pattern0_8021_19384" patternContentUnits="objectBoundingBox" width="1" height="1">
<use xlink:href="#image0_8021_19384" transform="matrix(0.00452489 0 0 0.00387847 0 -0.00808016)"/>
</pattern>
<image id="image0_8021_19384" width="221" height="262" preserveAspectRatio="none" xlink:href="data:image/png;base64,"/>
</defs>
</svg>
              `;

              
              nextBtn.addEventListener('click', () => {
                if (currentPage < totalPages) renderProducts(currentPage + 1);
              });
              paginationContainer.appendChild(nextBtn);
            }

            // Initialize the first page
            renderProducts(1);
          })
          .catch(error => {
            productsContainer.innerHTML = '<div class="sbi-modal-empty">Failed to load products.</div>';
          });
      } else {
        productsContainer.innerHTML = '<div class="sbi-modal-empty">Please assign a collection to this image in the theme editor.</div>';
      }
    }

    items.forEach((item, index) => {
      item.addEventListener('click', () => openModal(index));
    });

    closeBtn.addEventListener('click', () => {
      modal.classList.remove('active');
    });

    modal.addEventListener('click', (e) => {
      if(e.target === modal) modal.classList.remove('active');
    });

    document.getElementById('sbi-modal-prev-{{ section.id }}').addEventListener('click', () => {
      let newIndex = currentIndex - 1;
      if (newIndex < 0) newIndex = blockData.length - 1;
      openModal(newIndex);
    });

    document.getElementById('sbi-modal-next-{{ section.id }}').addEventListener('click', () => {
      let newIndex = currentIndex + 1;
      if (newIndex >= blockData.length) newIndex = 0;
      openModal(newIndex);
    });
  });
</script>

