    width: 530px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
  }

  .custom-sbi-section-{{ section.id }} .sbi-modal-image-wrapper {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    margin-bottom: 20px;
  }

  .custom-sbi-section-{{ section.id }} .sbi-modal-image-wrapper img {
