{%- style -%}
@import url('https://fonts.googleapis.com/css2?family=Licorice&display=swap');

  {%- if section.settings.title_font != blank -%}
    {{ section.settings.title_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if section.settings.hover_font != blank -%}
    {{ section.settings.hover_font | font_face: font_display: 'swap' }}
  {%- endif -%}

  /* =========================================================
     Shop by Instagram - Pixel Perfect Custom CSS
     ========================================================= */
  .custom-sbi-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --title-color: {{ section.settings.title_color }};
    --grid-gap: {{ section.settings.grid_gap }}px;
    --btn-bg-default: transparent;
    --btn-text-default: {{ section.settings.btn_text_color }};
    --btn-border-default: {{ section.settings.btn_border_color }};
    --btn-bg-hover: {{ section.settings.btn_hover_bg }};
    --btn-text-hover: {{ section.settings.btn_hover_text }};
    --overlay-color: {{ section.settings.overlay_bg_color }};
    --popup-bg: #ffffff;
    --popup-text: #333333;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    width: 100%;
    display: block;
    box-sizing: border-box;
    font-family: 'Inter', sans-serif;
  }

  .custom-sbi-section-{{ section.id }} .sbi-container {
    max-width: 1920px;
    margin: 0 auto;
    padding-left: {{ section.settings.padding_sides }}px;
    padding-right: {{ section.settings.padding_sides }}px;
    text-align: center;
  }

  /* Section Title */
  .custom-sbi-section-{{ section.id }} .sbi-title {
    font-family: var(--font-heading-family, {{ section.settings.title_font.family }}, serif);
    font-size: {{ section.settings.title_size }}px;
    line-height: 1.23;
    color: var(--title-color);
    margin: 0 0 40px 0;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0px;
  }

  /* Image Grid */
  .custom-sbi-section-{{ section.id }} .sbi-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: var(--grid-gap);
    margin-bottom: 40px;
  }

  .custom-sbi-section-{{ section.id }} .sbi-item {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    cursor: pointer;
    background-color: #f4f4f4;
  }

  .custom-sbi-section-{{ section.id }} .sbi-item.hidden-item {
    display: none;
  }

  .custom-sbi-section-{{ section.id }} .sbi-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  /* Hover Overlay State */
  .custom-sbi-section-{{ section.id }} .sbi-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--overlay-color);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 2;
    text-decoration: none;
    border: 1px solid rgba(255,255,255,0.3);
  }

  .custom-sbi-section-{{ section.id }} .sbi-item:hover .sbi-overlay {
    opacity: 1;
  }
  .custom-sbi-section-{{ section.id }} .sbi-item:hover img {
    transform: scale(1.05);
  }

  /* .custom-sbi-section-{{ section.id }} .sbi-overlay-icon {
    width: 80px;
    height: 80px;
    margin-bottom: 12px;
    stroke: #ffffff;
    fill: none;
    stroke-width: 1.2;
  } */

  /* Dynamic Custom Font for Hover Text */
  .custom-sbi-section-{{ section.id }} .sbi-overlay-text {
    font-family: {% if section.settings.hover_font != blank %}{{ section.settings.hover_font.family }}, {{ section.settings.hover_font.fallback_families }}{% else %}'Brush Script MT', 'Lucida Handwriting', cursive{% endif %};
      font-family: "Licorice", cursive;

    font-weight: {% if section.settings.hover_font != blank %}{{ section.settings.hover_font.weight }}{% else %}400{% endif %};
    font-style: {% if section.settings.hover_font != blank %}{{ section.settings.hover_font.style }}{% else %}normal{% endif %};
    font-size: 55px;
    color: #ffffff;
    margin: 0;
    text-transform: lowercase;
    text-shadow: 1px 1px 3px rgba(0,0,0,0.3);
  }

  /* Buttons */
  .custom-sbi-section-{{ section.id }} .sbi-btn-container {
    display: flex;
    justify-content: center;
    margin-top: 20px;
  }

  /* Load More Button - Figma Match (350x55, Font 20px Light, Theme Heading Font) */
  .custom-sbi-section-{{ section.id }} .sbi-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
     max-width: 350px; 
    height: 55px;
        font-family: var(--font-body-family, 'Inter', sans-serif);

    font-size: 20px;
    font-weight: 300;
    line-height: 20px;
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: 0px;
    cursor: pointer;
    transition: all 0.3s ease;
    border: 1px solid var(--btn-border-default);
    background-color: var(--btn-bg-default);
    color: var(--btn-text-default);
    box-sizing: border-box;
  }

  .custom-sbi-section-{{ section.id }} .sbi-btn:hover {
    background-color: var(--btn-bg-hover);
    color: var(--btn-text-hover);
    border-color: var(--btn-bg-hover);
  }

  /* Shop By Style Final Button */
  .custom-sbi-section-{{ section.id }} .sbi-btn-final {
    display: none;
    align-items: center;
    justify-content: center;
    width: 350px;
    max-width: 100%;
    height: 55px;
    background: linear-gradient(90deg, #bfa895 0%, #d8c8b8 50%, #bfa895 100%);
    color: #ffffff;
    border: none;
    font-family: var(--font-heading-family, {{ section.settings.title_font.family }}, serif);
    font-size: 20px;
    font-weight: 300;
    line-height: 20px;
    text-transform: uppercase;
    letter-spacing: 0px;
    cursor: pointer;
    text-decoration: none;
    box-sizing: border-box;
  }

  /* --- MODAL / POPUP CSS (Pixel Perfect to Figma) --- */
  .custom-sbi-section-{{ section.id }} .sbi-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(5px);
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .custom-sbi-section-{{ section.id }} .sbi-modal-overlay.active {
    display: flex;
    opacity: 1;
  }

  .custom-sbi-section-{{ section.id }} .sbi-modal-content {
    background: var(--popup-bg);
    width: 95%;
    max-width: 1350px; /* Widened to fit 530px image + 2 product columns */
    box-shadow: 0 10px 50px rgba(0,0,0,0.08);
    position: relative;
    display: flex;
    padding: 50px;
    gap: 50px;
  }

  .custom-sbi-section-{{ section.id }} .sbi-modal-close {
    position: absolute;
    top: 20px;
    right: 20px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 5px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .custom-sbi-section-{{ section.id }} .sbi-modal-close img {
    width: 20px;
    height: auto;
  }

  .custom-sbi-section-{{ section.id }} .sbi-modal-close svg {
    width: 20px;
    height: 20px;
    stroke: #999;
    stroke-width: 1;
  }

  /* Modal Left - Image (530x530) */
  .custom-sbi-section-{{ section.id }} .sbi-modal-left {
    width: 530px;
    flex-shrink: 0; /* Prevents image from shrinking */
    display: flex;
    flex-direction: column;
  }

  .custom-sbi-section-{{ section.id }} .sbi-modal-image-wrapper {
    width: 530px;
    height: 530px; /* Exact dimension from Figma */
    overflow: hidden;
    margin-bottom: 20px;
  }

  .custom-sbi-section-{{ section.id }} .sbi-modal-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .custom-sbi-section-{{ section.id }} .sbi-modal-view-insta {
    text-align: center;
    font-size: 13px;
    color: #555;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-decoration: none;
    display: inline-block;
    margin: 0 auto;
    width: 210px; /* Exact dimension from Figma */
  }

  /* Modal Right - Products */
  .custom-sbi-section-{{ section.id }} .sbi-modal-right {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .custom-sbi-section-{{ section.id }} .sbi-modal-header {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 20px;
    margin-bottom: 30px;
    border-bottom: 1px solid #f0f0f0;
    padding-bottom: 15px;
  }

  /* PRODUCTS Title - Exact Figma properties */
  .custom-sbi-section-{{ section.id }} .sbi-modal-title {
    font-family: var(--font-heading-family, {{ section.settings.title_font.family }}, serif);
    font-size: 53px; /* Exact size from Figma */
    line-height: 1.23; /* 123% line height from Figma */
    color: var(--popup-text);
    margin: 0;
    font-weight: 400;
  }

  /* Navigation Arrows Container (27x20 Hug from Figma) */
  .custom-sbi-section-{{ section.id }} .sbi-modal-nav {
    display: flex;
    gap: 15px;
    height: 20px;
  }

  .custom-sbi-section-{{ section.id }} .sbi-modal-nav button {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .custom-sbi-section-{{ section.id }} .sbi-modal-nav img {
    height: 20px;
    width: auto;
    object-fit: contain;
  }

  .custom-sbi-section-{{ section.id }} .sbi-modal-nav svg {
    width: 20px;
    height: 20px;
    stroke: #999;
    stroke-width: 1;
  }

  .custom-sbi-section-{{ section.id }} .sbi-modal-products {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 20px;
    overflow-y: auto;
    max-height: 480px;
    padding-right: 5px;
  }

  .custom-sbi-section-{{ section.id }} .sbi-modal-products::-webkit-scrollbar {
    width: 4px;
  }
  .custom-sbi-section-{{ section.id }} .sbi-modal-products::-webkit-scrollbar-thumb {
    background-color: #eee;
    border-radius: 4px;
  }

  /* Product Card - Height 100px, Pad 8px/16px from Figma */
  .custom-sbi-section-{{ section.id }} .sbi-product-card {
    display: flex;
    align-items: center;
    gap: 16px;
    text-decoration: none;
    background: transparent;
    border: none;
    padding: 8px 16px; /* Exact padding from Figma */
    height: 100px; /* Exact height from Figma */
    box-sizing: border-box;
    transition: background-color 0.2s;
  }
  
  .custom-sbi-section-{{ section.id }} .sbi-product-card:hover {
    background-color: #f9f9f9;
  }

  .custom-sbi-section-{{ section.id }} .sbi-product-img-wrapper {
    width: 84px; /* 100px height - 16px padding = 84px */
    height: 84px;
    background-color: #F9F9F9;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 5px;
    flex-shrink: 0;
  }

  .custom-sbi-section-{{ section.id }} .sbi-product-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .custom-sbi-section-{{ section.id }} .sbi-product-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* Product Name - Inter, 20px, 400, 100% LH from Figma */
  .custom-sbi-section-{{ section.id }} .sbi-product-title {
    font-family: 'Inter', sans-serif;
    font-size: 20px;
    line-height: 1;
    color: var(--popup-text);
    margin: 0 0 8px 0;
    font-weight: 400;
  }

  .custom-sbi-section-{{ section.id }} .sbi-product-price-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .custom-sbi-section-{{ section.id }} .sbi-product-price {
    font-size: 14px;
    color: #333;
    font-weight: 500;
  }

  .custom-sbi-section-{{ section.id }} .sbi-product-compare {
    font-size: 12px;
    color: #aaa;
    text-decoration: line-through;
  }

  .custom-sbi-section-{{ section.id }} .sbi-modal-empty {
    grid-column: span 2;
    text-align: center;
    padding: 40px 20px;
    color: #666;
    font-size: 14px;
  }



  

