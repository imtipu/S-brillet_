    padding: 5px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
  }

  .custom-sbi-section-{{ section.id }} .sbi-modal-close img {
    width: 20px;
    height: auto;
  }

  .custom-sbi-section-{{ section.id }} .sbi-modal-close svg {
    width: 20px;
    height: 20px;
    stroke: #999;
    stroke-width: 1;
  }

  /* Modal Left - Image (Default Large Desktop) */
