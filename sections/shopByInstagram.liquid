    font-weight: 500;
  }
  
  .custom-sbi-section-{{ section.id }} .sbi-page-btn:hover:not(.active):not(:disabled) {
    opacity: 0.7;
  }

  .custom-sbi-section-{{ section.id }} .sbi-page-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .custom-sbi-section-{{ section.id }} .sbi-page-dots {
    color: #333333;
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    padding: 4px;
  }

  .custom-sbi-section-{{ section.id }} .sbi-page-arrow svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke-width: 1.5;
  }


/* ─────────────────────────────────────────────────────────
   RESPONSIVE MEDIA QUERIES 
   ───────────────────────────────────────────────────────── */

/* ── Large Desktop ── */
@media (min-width: 1441px) and (max-width: 1728px) {
  .custom-sbi-section-{{ section.id }} .sbi-title { font-size: 54px; }
