    box-shadow: 0 10px 50px rgba(0,0,0,0.08);
    position: relative;
    display: flex;
    padding: 50px;
    gap: 50px;
    box-sizing: border-box;
    border-radius: 4px;
  }

  .custom-sbi-section-{{ section.id }} .sbi-modal-close {
