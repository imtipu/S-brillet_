      backdrop-filter: blur(4px);
  }

  .custom-sbi-section-{{ section.id }} .sbi-modal-content {
      flex-direction: column;
      width: calc(100% - 32px);
      max-width: calc(100% - 32px);
      margin: 0;
      height: 85vh; /* PERFECT FIX: Locks modal height so it NEVER jumps */
      max-height: 85vh;
      overflow: hidden;
      padding: 40px 16px 20px 16px;
