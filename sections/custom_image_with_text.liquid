      height: 650px; /* Scaled down height for laptop */
    }
  }

  /* Tablets (up to 990px) */
  @media screen and (max-width: 990px) {
    .custom-mission-wrapper-{{ section.id }} {
      flex-direction: column-reverse !important; /* Always put text below image */
    }
    .custom-mission-image-{{ section.id }},
    .custom-mission-text-container-{{ section.id }} {
      flex: 1 1 100%;
      max-width: 100%;
    }
    .custom-mission-image-{{ section.id }} img,
    .custom-mission-image-{{ section.id }} .placeholder-img {
      height: 500px;
    }
    .custom-mission-text-container-{{ section.id }} {
      padding: 40px; /* Text spacing when stacked */
    }
  }
  /* Tablets (769px - 1024px) - FIXED: image full width */
@media screen and (min-width: 769px) and (max-width: 1024px) {
  .custom-mission-text-content-{{ section.id }} {
    max-width: 920px; /* Updated from 549px to 720px to match Figma body text width */
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 40px; /* Gap between paragraphs and button */
  }
  .custom-mission-wrapper-{{ section.id }} {
    flex-direction: column-reverse !important;
  }
  .custom-mission-image-{{ section.id }},
  .custom-mission-text-container-{{ section.id }} {
    flex: 1 1 100%;
    max-width: 100%;
    width: 100%;
  }
  .custom-mission-image-{{ section.id }} img,
  .custom-mission-image-{{ section.id }} .placeholder-img {
    height: 700px;
    width: 100%;
  }
  /* .custom-mission-text-container-{{ section.id }} {
    padding: 60px;
  } */
}

  /* Mobile (up to 768px) */
  @media screen and (max-width: 768px) {
    .custom-mission-{{ section.id }} {
      --heading-size: 28px !important; /* 28px heading for Mobile */
      --body-size: calc({{ section.settings.body_size }}px * 0.85);
    }
    .custom-mission-text-content-{{ section.id }} h2 {
      font-size: 28px !important; /* Strictly enforce 28px on mobile */
    }
    .custom-mission-text-container-{{ section.id }} {
      padding: 40px 20px; /* 20px padding left/right for mobile text */
    }
    .custom-mission-image-{{ section.id }} img,
    .custom-mission-image-{{ section.id }} .placeholder-img {
      height: 400px; /* Shorter image for mobile */
    }
    .custom-mission-{{ section.id }} .btn-outline {
      width: 100%; /* Full width button on small screens */
      max-width: 350px;
    }
  }
