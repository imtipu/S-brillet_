{%- style -%}
  /* We use CSS variables here so you can change colors from the Shopify Customizer */
  .custom-mission-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    
    --btn-bg: {{ section.settings.btn_bg_color }};
    --btn-text: {{ section.settings.btn_text_color }};
    --btn-border: {{ section.settings.btn_border_color }};
    --title-color: {{ section.settings.btn_hover_text_color }};
    --border-grad-1: {{ section.settings.grad_color_1 }};
    --border-grad-2: {{ section.settings.grad_color_2 }};
    --border-grad-3: {{ section.settings.grad_color_3 }};

    /* CSS variables for responsive typography */
    --heading-size: {{ section.settings.heading_size }}px;
    --body-size: {{ section.settings.body_size }}px;
  }

  .custom-mission-wrapper-{{ section.id }} {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    /* Fixed Logic: If setting is 'left', use row-reverse to put image on the left! */
    flex-direction: {% if section.settings.image_position == 'left' %}row-reverse{% else %}row{% endif %};
    width: 100%;
    max-width: 1920px;
    margin: 0 auto;
    box-sizing: border-box; /* Added to keep padding inside the max-width */
  }

  /* Image Area: Takes exactly 960px out of 1920px on desktop (50%) */
  .custom-mission-image-{{ section.id }} {
    flex: 1 1 50%;
    max-width: 50%;
    display: flex;
  }

  .custom-mission-image-{{ section.id }} img {
    width: 100%;
    height: 930px; /* Pixel-perfect height from Figma */
    object-fit: cover;
  }

  .custom-mission-image-{{ section.id }} .placeholder-img {
    width: 100%;
    height: 930px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Text Area */
  .custom-mission-text-container-{{ section.id }} {
    flex: 1 1 50%;
    max-width: 50%;
    display: flex;
    justify-content: center; /* Centers the text block inside the 960px space */
    padding: 20px;
  }

  .custom-mission-text-content-{{ section.id }} {
    max-width: 720px; /* Updated from 549px to 720px to match Figma body text width */
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 40px; /* Gap between paragraphs and button */
  }

  /* Heading Typography */
  .custom-mission-text-content-{{ section.id }} h2 {
    margin: 0;
    font-weight: 400;
    font-size: var(--heading-size); /* Uses variable for easy resizing */
    font-family: var(--font-heading-family, 'Libre Caslon Text', serif);
    line-height: 1.23; /* 123% from Figma */
    text-transform: uppercase;
    color: {{ section.settings.text_color }};
  }

  /* Body Typography */
  .custom-mission-text-content-{{ section.id }} p {
    margin: 0;
    font-weight: 400;
    font-size: var(--body-size); /* Uses variable for easy resizing */
    line-height: {{ section.settings.body_line_height }}px; /* 30px from Figma */
    font-family: var(--font-body-family, 'Inter', sans-serif);
    color: {{ section.settings.text_color }};
  }

  /* BUTTON CSS */
  .custom-mission-{{ section.id }} .btn-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: {{ section.settings.button_width }}px; 
    font-family: var(--font-body-family, 'Inter', sans-serif);
    height: 55px;
    background-color: var(--btn-bg);
    color: var(--btn-text);
    border: 1px solid var(--btn-border);
    font-size: 20px; /* Updated to 20px from Figma */
    font-weight: 300; /* Updated to Light/300 from Figma */
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: 0px; /* Figma shows 0px letter spacing */
    cursor: pointer;
    transition: background-color 0.3s ease, color 0.3s ease;
    box-sizing: border-box;
  }

  .custom-mission-{{ section.id }} .btn-outline:hover {
    background-color: transparent;
    color: var(--title-color);
    border: 1px solid transparent;
    border-image: linear-gradient(135deg, var(--border-grad-1), var(--border-grad-2), var(--border-grad-3)) 1;
  }

  /* --- RESPONSIVE DESIGN --- */


  /* ─── MacBook Air 15 inch M2 (1441px - 1728px) ───────────────── */
@media screen and (min-width: 1441px) and (max-width: 1728px) {
  .custom-mission-{{ section.id }} {
    --heading-size: 54px !important;
  }
  .custom-mission-text-content-{{ section.id }} h2 {
    font-size: 54px !important;
  }
  .custom-mission-{{ section.id }} .btn-outline,
  .custom-mission-text-content-{{ section.id }} p {
    font-size: 18px;
  }
  .custom-mission-image-{{ section.id }} img,
  .custom-mission-image-{{ section.id }} .placeholder-img {
    height: 780px;
  }
  .custom-mission-text-container-{{ section.id }} {
    padding-left: 120px;
    padding-right: 120px;
  }
}




  /* Laptop & Macbook (up to 1440px) */
  @media screen and (max-width: 1440px) {
    .custom-mission-{{ section.id }} {
      --heading-size: 46px !important; /* 46px heading for Macbook (Forced) */
    }
    .custom-mission-text-content-{{ section.id }} h2 {
      font-size: 46px !important; /* Double check to ensure 46px applies */
    }

      .custom-mission-{{ section.id }} .btn-outline ,
