{% comment %} {%- style -%}
  /* We use CSS variables here so you can change colors from the Shopify Customizer */
  .custom-mission-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    
    --btn-bg: {{ section.settings.btn_bg_color }};
    --btn-text: {{ section.settings.btn_text_color }};
    --btn-border: {{ section.settings.btn_border_color }};
    --title-color: {{ section.settings.btn_hover_text_color }};
    --border-grad-1: {{ section.settings.grad_color_1 }};
    --border-grad-2: {{ section.settings.grad_color_2 }};
    --border-grad-3: {{ section.settings.grad_color_3 }};
  }

  .custom-mission-wrapper-{{ section.id }} {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    /* By default, it's row. If setting is 'right', we use row-reverse to flip the layout! */
    flex-direction: {% if section.settings.image_position == 'right' %}row-reverse{% else %}row{% endif %};
    width: 100%;
    max-width: 1920px;
    margin: 0 auto;
  }

  /* Image Area: Takes exactly 960px out of 1920px on desktop (50%) */
  .custom-mission-image-{{ section.id }} {
    flex: 1 1 50%;
    max-width: 50%;
    display: flex;
  }

  .custom-mission-image-{{ section.id }} img {
    width: 100%;
    height: 930px; /* Pixel-perfect height from Figma */
    object-fit: cover;
  }

  .custom-mission-image-{{ section.id }} .placeholder-img {
    width: 100%;
    height: 930px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Text Area */
  .custom-mission-text-container-{{ section.id }} {
    flex: 1 1 50%;
    max-width: 50%;
    display: flex;
    justify-content: center; /* Centers the 549px text block inside the 960px space */
    padding: 20px;
  }

  .custom-mission-text-content-{{ section.id }} {
    max-width: 549px; /* Pixel-perfect text width from Figma */
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 40px; /* Gap between paragraphs and button */
  }

  /* Heading Typography */
  .custom-mission-text-content-{{ section.id }} h2 {
    margin: 0;
    font-weight: 400;
    font-size: {{ section.settings.heading_size }}px; /* 64px from Figma */
    font-family: var(--font-heading-family, 'Libre Caslon Text', serif);

    line-height: 1.23; /* 123% from Figma */
    text-transform: uppercase;
    color: {{ section.settings.text_color }};
  }

  /* Body Typography */
  .custom-mission-text-content-{{ section.id }} p {
    margin: 0;
    font-weight: 400;
    font-size: {{ section.settings.body_size }}px; /* 20px from Figma */
    line-height: {{ section.settings.body_line_height }}px; /* 30px from Figma */
    font-family: var(--font-body-family, 'Inter', sans-serif);
    color: {{ section.settings.text_color }};
  }

  /* BUTTON CSS (Exact code you provided + Width adapted to Figma 350px) */
  .custom-mission-{{ section.id }} .btn-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: {{ section.settings.button_width }}px; /* Figma shows 350px, customizable */
    font-family: var(--font-body-family, 'Inter', sans-serif);

    height: 55px;
    background-color: var(--btn-bg);
    color: var(--btn-text);
    border: 1px solid var(--btn-border);
    font-size: 16px;
    font-weight: 400;
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: 1px;
    cursor: pointer;
    transition: background-color 0.3s ease, color 0.3s ease;
    box-sizing: border-box;
  }

  .custom-mission-{{ section.id }} .btn-outline:hover {
    background-color: transparent;
    color: var(--title-color);
    border: 1px solid transparent;
    border-image: linear-gradient(135deg, var(--border-grad-1), var(--border-grad-2), var(--border-grad-3)) 1;
  }

  /* Responsive Design for Mobile */
  @media screen and (max-width: 990px) {
    .custom-mission-wrapper-{{ section.id }} {
      flex-direction: column-reverse; /* Always put text below image on mobile */
    }
    .custom-mission-image-{{ section.id }},
    .custom-mission-text-container-{{ section.id }} {
      flex: 1 1 100%;
      max-width: 100%;
    }
    .custom-mission-image-{{ section.id }} img,
    .custom-mission-image-{{ section.id }} .placeholder-img {
      height: 500px; /* Shorter image on mobile */
    }
    .custom-mission-text-content-{{ section.id }} h2 {
      font-size: calc({{ section.settings.heading_size }}px * 0.7);
    }
    .custom-mission-text-content-{{ section.id }} p {
      font-size: calc({{ section.settings.body_size }}px * 0.85);
    }
    .custom-mission-{{ section.id }} .btn-outline {
      width: 100%; /* Full width button on small screens */
      max-width: 350px;
    }
  }
{%- endstyle -%}

<div class="custom-mission-{{ section.id }}">
  <div class="custom-mission-wrapper-{{ section.id }}">
    
    <!-- Text Section -->
    <div class="custom-mission-text-container-{{ section.id }}">
      <div class="custom-mission-text-content-{{ section.id }}">
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
        
        {%- if section.settings.body_text != blank -%}
          <div class="mission-rte">
            {{ section.settings.body_text }}
          </div>
        {%- endif -%}
        
        {%- if section.settings.button_label != blank -%}
          <div>
            <a href="{{ section.settings.button_link }}" class="btn-outline">
              {{ section.settings.button_label }}
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>

    <!-- Image Section -->
    <div class="custom-mission-image-{{ section.id }}">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1920 | image_tag: loading: 'lazy', alt: section.settings.heading }}
      {%- else -%}
        <div class="placeholder-img">
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- endif -%}
    </div>

  </div>
</div>

