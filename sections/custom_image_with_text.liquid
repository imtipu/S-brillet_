      font-size:16px;
    }
    .custom-mission-text-container-{{ section.id }} {
      padding-left: 120px; /* Padding shudhu text side e, jate image full thake */
      padding-right: 120px; 
    }
    .custom-mission-image-{{ section.id }} img,
