<script>
window.addEventListener('load', function () {
  var urlParams = new URLSearchParams(window.location.search);
  var themeParam = urlParams.get('theme');
  if (!themeParam) return;

  var targetText = themeParam.replace(/\+/g, ' ').trim();
  var targetLower = targetText.toLowerCase();

  var attempts = 0;
  var maxAttempts = 30; // ~6s, covers late-rendered blocks

  var interval = setInterval(function () {
    attempts++;
    var matched = false;

    var wrappers = document.querySelectorAll('.yk-custom-select-wrapper');

    wrappers.forEach(function (wrapper) {
      var items = wrapper.querySelectorAll('.yk-dropdown-item');

      items.forEach(function (item) {
        var val = (item.getAttribute('data-value') || '').trim();
        var text = (item.textContent || '').trim();

        if (val.toLowerCase() !== targetLower && text.toLowerCase() !== targetLower) return;

        matched = true;

        // Already selected? nothing to do.
        if (item.classList.contains('is-selected')) return;

        // Fire a real click so the block's own handler runs — that handler
        // is the single source of truth for how message1/2/3 and the
        // "From" field get shown, so we never duplicate that logic here.
        item.dispatchEvent(new MouseEvent('mousedown', { bubbles: true, cancelable: true }));
        item.dispatchEvent(new MouseEvent('mouseup', { bubbles: true, cancelable: true }));
        item.click();
      });
    });

    if (matched || attempts >= maxAttempts) {
      clearInterval(interval);
    }
  }, 200);
});
</script>



