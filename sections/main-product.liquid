{% comment %} {{ 'product.css' | asset_url | stylesheet_tag }}
{% if section.settings.show_zoom_button %}
  {{ 'photoswipe.css' | asset_url | stylesheet_tag }}
  {{ 'component-photoswipe.css' | asset_url | stylesheet_tag }}
{% endif %}

{%- if product.quantity_price_breaks_configured? -%}
  {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- liquid
  assign container = section.settings.container
  assign layout = section.settings.layout
  if container == 'w-full'
    assign container = 'container-full'
  endif
  if layout == 'layout-7'
    assign container = 'container-full'
  endif
  assign first_3d_model = product.media | where: 'media_type', 'model' | first

  assign animation_effect = settings.animations
  assign animated = false
  if animation_effect != 'none'
    assign animated = true
  endif

  assign enable_variant_group_img = false
  if section.settings.enable_variant_group_images and product.metafields['foxecom-bs-kit']['variant-images'].value.enable
    assign enable_variant_group_img = true
  endif

  assign disable_selected_variant_default = section.settings.disable_selected_variant_default

  if product.has_only_default_variant
    assign enable_variant_group_img = false
    assign disable_selected_variant_default = false
  endif
-%}


{%- if first_3d_model -%}
  <link
    id="ModelViewerStyle"
    rel="stylesheet"
    href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
    media="print"
    onload="this.media='all'"
  >
{%- endif -%}

{%- capture variant_option_none_text -%}
  {%- render 'new-locale', key: 'products.product.choose_an_option' -%}
{%- endcapture -%}

<style>
  /* 1. Bulletproof hiding class */
  .fox-hidden-media {
    display: none !important;
  }


  /* 2. Consistent Grid Layout for Desktop */
  .m-product-media--grid-layout,
  .m-product-media--grid-layout .m-product-media--list,
  .m-product-media--grid-layout .swiper-wrapper,
  .m-product-media--grid-layout > .swiper {
    display: grid !important;
    grid-template-columns: 1fr  !important;
    gap: 8px !important;
    width: 100% !important;
    height: auto !important;
    transform: none !important;
    box-sizing: border-box !important;
    flex-wrap: unset !important;
    flex-direction: unset !important;
    overflow: visible !important;
  }

  /* Isolate this region so variant-swap reflow doesn't leak into the
     rest of the page, and give it its own compositing layer so Safari
     doesn't repaint the whole area as a visible white flash. */
  .m-product-media--grid-layout {
    contain: layout style paint;
    -webkit-transform: translateZ(0) scale(1);
    transform: translateZ(0) scale(1);
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    transition: opacity 0.22s cubic-bezier(0.4, 0, 0.2, 1),
                transform 0.22s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .m-product-media--grid-layout.fox-media-swapping {
    opacity: 0;
    transform: translateZ(0) scale(0.985);
    will-change: opacity, transform;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .m-product-media--grid-layout {
      transition: none !important;
    }
  }

  /* 3. Force slides to stay in their grid cells (Prevents Overlap) */
  .m-product-media--grid-layout .swiper-slide,
  .m-product-media--grid-layout .m-product-media--item,
  .m-product-media--grid-layout .m-product-media--list > * {
    width: 100% !important;
    max-width: 100% !important;
    height: auto !important;
    margin: 0 !important;
    position: relative !important;
    display: block !important;
    transform: none !important;
    left: auto !important;
    top: auto !important;
    flex-shrink: unset !important;
    overflow: hidden !important;
  }

  /* Make sure images inside fill the space correctly */
  .m-product-media--grid-layout .swiper-slide img,
  .m-product-media--grid-layout .m-product-media--item img,
  .m-product-media--grid-layout .m-product-media--item video,
  .m-product-media--grid-layout .m-product-media--item model-viewer {
    width: 100% !important;
    height: auto !important;
    display: block !important;
    object-fit: cover !important;
  }

  /* 4. First visible item takes full width (spans both columns) */
  .m-product-media--grid-layout .m-product-media--item:first-child,
  .m-product-media--grid-layout .swiper-slide:first-child,
  .m-product-media--grid-layout .m-product-media--list > *:first-child,
  .m-product-media--grid-layout .swiper-slide.is-first-visible,
  .m-product-media--grid-layout .m-product-media--item.is-first-visible {
    grid-column: 1 / -1 !important;
  }

  /* Secondary images: square crop */
  .m-product-media--grid-layout .m-product-media--item:not(:first-child):not(.is-first-visible) img,
  .m-product-media--grid-layout .swiper-slide:not(:first-child):not(.is-first-visible) img {
    aspect-ratio: 1 / 1 !important;
    height: 100% !important;
    object-fit: cover !important;
  }

  /* Hidden items collapse fully */
  .m-product-media--grid-layout .m-product-media--item[style*="display: none"],
  .m-product-media--grid-layout .m-product-media--item[style*="display:none"],
  .m-product-media--grid-layout .swiper-slide[style*="display: none"],
  .m-product-media--grid-layout .swiper-slide[style*="display:none"] {
    display: none !important;
    grid-column: auto !important;
  }

  /* 5. Hide pagination/thumbnails */
  .m-product-media--grid-layout .swiper-pagination,
  .m-product-media--grid-layout .m-product-media--thumbnails {
    display: none !important;
  }

  /* 6. Custom Navigation Arrows (Hidden on Desktop) */
  .custom-mobile-arrows {
    display: none !important; 
  }

  /* 7. MOBILE: Native CSS Carousel with Smooth Scrolling */
  @media (max-width: 767px) {
    .custom-mobile-arrows {
      display: flex !important;
      position: absolute;
      top: 50%;
      left: 0;
      width: 100%;
      justify-content: space-between;
      transform: translateY(-50%);
      z-index: 10;
      pointer-events: none; 
      padding: 0 10px;
      box-sizing: border-box;
    }

    .custom-arrow {
      background: rgba(255, 255, 255, 0.9) !important;
      color: #000 !important;
      border: 1px solid #ddd !important;
      border-radius: 50% !important;
      width: 38px !important;
      height: 38px !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      cursor: pointer !important;
      pointer-events: auto !important; 
      box-shadow: 0 2px 5px rgba(0,0,0,0.15) !important;
      font-size: 16px !important;
      line-height: 1 !important;
      padding: 0 !important;
      margin: 0 !important;
      transition: background 0.3s ease;
    }

    .custom-arrow:active {
      background: #e0e0e0 !important;
    }

    .m-product-media--grid-layout > .swiper {
      touch-action: pan-y pinch-zoom !important; 
    }

    .m-product-media--grid-layout .swiper-wrapper {
      display: flex !important;
      flex-wrap: nowrap !important;
      overflow-x: auto !important;
      overflow-y: hidden !important;
      scroll-snap-type: x mandatory !important;
      scroll-behavior: smooth !important;
      -webkit-overflow-scrolling: touch !important; 
      gap: 0px !important; 
      width: 100% !important;
    }

    .m-product-media--grid-layout .swiper-wrapper::-webkit-scrollbar {
      display: none !important;
    }

    .m-product-media--grid-layout .m-product-media--item,
    .m-product-media--grid-layout .swiper-slide,
    .m-product-media--grid-layout .m-product-media--list > * {
      flex: 0 0 100% !important;
      width: 100% !important;
      max-width: 100% !important;
      scroll-snap-align: center !important; 
    }

    .m-product-media--grid-layout .m-product-media--item:first-child,
    .m-product-media--grid-layout .swiper-slide:first-child,
    .m-product-media--grid-layout .m-product-media--list > *:first-child,
    .m-product-media--grid-layout .swiper-slide.is-first-visible,
    .m-product-media--grid-layout .m-product-media--item.is-first-visible {
      grid-column: auto !important;
    }
    
    .m-product-media--grid-layout .m-product-media--item:not(:first-child):not(.is-first-visible) img,
    .m-product-media--grid-layout .swiper-slide:not(:first-child):not(.is-first-visible) img {
      aspect-ratio: unset !important;
      height: auto !important;
    }
  }

  /* --- Wishlist Active Icon Safe CSS (STRICTLY SCOPED) --- */
  /* This ".m-main-product" prefix protects your header! */
  .m-main-product .m-wishlist-button .m-tooltip-icon--active { 
    display: none !important; 
  }
  
  .m-main-product .m-wishlist-button.is-active .m-tooltip-icon--active,
  .m-main-product .m-wishlist-button.is-wishlisted .m-tooltip-icon--active,
  .m-main-product .m-wishlist-button.added-to-wishlist .m-tooltip-icon--active,
  .m-main-product .m-wishlist-button.m-wishlist--active .m-tooltip-icon--active,
  .m-main-product .m-wishlist-button.active .m-tooltip-icon--active { 
    display: inline-block !important; 
  }
  
  .m-main-product .m-wishlist-button.is-active .m-tooltip-icon,
  .m-main-product .m-wishlist-button.is-wishlisted .m-tooltip-icon,
  .m-main-product .m-wishlist-button.added-to-wishlist .m-tooltip-icon,
  .m-main-product .m-wishlist-button.m-wishlist--active .m-tooltip-icon,
  .m-main-product .m-wishlist-button.active .m-tooltip-icon { 
    display: none !important; 
  }

  /*
    Keep the unfiltered gallery invisible only for the brief period before
    ProductInfo applies the initially selected Material. The core JS always
    releases this state, including when no exact Alt match is found.
  */
  product-info[data-material-alt-filter="true"]:not([data-material-filter-ready="true"])
  .m-product-media--grid-layout {
    opacity: 0 !important;
    pointer-events: none !important;
  }

  product-info[data-material-alt-filter="true"][data-material-filter-ready="true"]
  .m-product-media--grid-layout {
    opacity: 1 !important;
    pointer-events: auto !important;
  }

</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const SECTION_ID = '{{ section.id }}';
    const productInfo = document.querySelector('product-info#MainProduct-' + SECTION_ID);
    if (!productInfo) return;

    // --- Custom Mobile Slider Logic (Index-based, No DOM Manipulation) ---
    const nextBtn = productInfo.querySelector('.custom-arrow.next');
    const prevBtn = productInfo.querySelector('.custom-arrow.prev');
    const sliderContainer = productInfo.querySelector('.m-product-media--grid-layout .swiper-wrapper') || productInfo.querySelector('.m-product-media--grid-layout');

    if (nextBtn && prevBtn && sliderContainer) {
      let currentIndex = 0;

      function getVisibleSlides() {
        return Array.from(sliderContainer.children).filter(
          el => !el.classList.contains('fox-hidden-media') && el.style.display !== 'none'
        );
      }

      function updateArrowStates() {
        const visibleSlides = getVisibleSlides();
        const isFirst = currentIndex <= 0;
        const isLast = currentIndex >= visibleSlides.length - 1;

        prevBtn.disabled = isFirst;
        prevBtn.style.opacity = isFirst ? '0.35' : '';
        prevBtn.style.cursor = isFirst ? 'default' : '';
        prevBtn.style.pointerEvents = isFirst ? 'none' : '';

        nextBtn.disabled = isLast;
        nextBtn.style.opacity = isLast ? '0.35' : '';
        nextBtn.style.cursor = isLast ? 'default' : '';
        nextBtn.style.pointerEvents = isLast ? 'none' : '';
      }

      function goToIndex(index) {
        const visibleSlides = getVisibleSlides();
        if (!visibleSlides.length) return;

        // Clamp — no wrap-around, stop at edges
        if (index < 0) index = 0;
        if (index >= visibleSlides.length) index = visibleSlides.length - 1;

        currentIndex = index;

        const targetSlide = visibleSlides[currentIndex];
        sliderContainer.scrollTo({ left: targetSlide.offsetLeft, behavior: 'smooth' });

        updateArrowStates();
      }

      nextBtn.addEventListener('click', function() {
        goToIndex(currentIndex + 1);
      });

      prevBtn.addEventListener('click', function() {
        goToIndex(currentIndex - 1);
      });

      // Keep currentIndex in sync when user swipes manually
      sliderContainer.addEventListener('scroll', function() {
        const visibleSlides = getVisibleSlides();
        const scrollLeft = sliderContainer.scrollLeft;
        let closest = 0;
        let minDiff = Infinity;
        visibleSlides.forEach(function(slide, i) {
          const diff = Math.abs(slide.offsetLeft - scrollLeft);
          if (diff < minDiff) { minDiff = diff; closest = i; }
        });
        currentIndex = closest;
        updateArrowStates();
      }, { passive: true });

      // Reset to first slide when variant changes
      productInfo.addEventListener('change', function() {
        setTimeout(function() { goToIndex(0); }, 200);
      });

      // Set initial arrow states on load
      updateArrowStates();
    }
    // -------------------------------------------------------------------

    /*
      Material media filtering now runs inside assets/product-info.js,
      directly from ProductInfo's resolved variant callback.
      Do not add another click/change/URL media filter here.
    */

    // --- Start: Custom Variant Metafield Logic ---
    const variantDynamicData = {
      {% for variant in product.variants %}
        "{{ variant.id }}": {
          gemstone: {{ variant.metafields.custom.plating_thickness.value | json }},
          plating: {{ variant.metafields.custom.materials_and_details.value | json }},
          description: {{ variant.metafields.custom.gemstone_description.value | json }}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    };

    {% comment %} ------------------------for gemstone and meterial in description  {% endcomment %}
    {% comment %} function updateMaterialsText() {
      const urlParams = new URLSearchParams(window.location.search);
      let variantId = urlParams.get('variant');

      if (!variantId) {
        const variantsNode = document.querySelector('[type="application/json"][data-name="product-variants"]');
        if (variantsNode) {
          try {
            const variants = JSON.parse(variantsNode.textContent);
            const defaultVar = variants.find(v => v.available) || variants[0];
            variantId = defaultVar.id;
          } catch (e) {}
        }
      } {% endcomment %}
      
       const defaultVariantId = {{ product.selected_or_first_available_variant.id | json }};

          function updateMaterialsText() {
            const urlParams = new URLSearchParams(window.location.search);
            let variantId = urlParams.get('variant');

            if (!variantId && productInfo.currentVariant && productInfo.currentVariant.id) {
              variantId = productInfo.currentVariant.id;
            }

            if (!variantId) {
              variantId = defaultVariantId;
            }

      if (!variantId) return;
{% comment %} ----------------------- {% endcomment %}
      const data = variantDynamicData[variantId];
      if (!data) return;

      const gemContainer = document.getElementById('dynamic-gemstone-text');
      const platingContainer = document.getElementById('dynamic-plating-text');
      const descContainer = document.getElementById('dynamic-gemstone-description');
      
      if (gemContainer && data.gemstone) {
        gemContainer.innerHTML = data.gemstone;
      }
      if (platingContainer && data.plating) {
        platingContainer.innerHTML = data.plating;
      }
      if (descContainer && data.description) {
        descContainer.innerHTML = data.description;
      }
    }

    setTimeout(updateMaterialsText, 150);

    document.addEventListener('change', function(event) {
       if(event.target.closest('variant-radios, variant-selects, product-info')) {
           setTimeout(updateMaterialsText, 50);
       }
    });

    /*
      LIVE MATERIAL CHANGE — no page reload required.

      Capture the intended Material before Minimog updates currentVariant.
      Filtering uses this clicked value directly.
    */
    productInfo.addEventListener(
      'pointerdown',
      function (event) {
        const materialInput = getMaterialInputFromTarget(event.target);
        const materialValue = getMaterialFromInput(materialInput);

        if (materialValue) {
          scheduleLiveMaterialFilter(materialValue);
        }
      },
      true
    );

    productInfo.addEventListener(
      'click',
      function (event) {
        const materialInput = getMaterialInputFromTarget(event.target);
        const materialValue = getMaterialFromInput(materialInput);

        if (materialValue) {
          scheduleLiveMaterialFilter(materialValue);
        }
      },
      true
    );

    productInfo.addEventListener(
      'change',
      function (event) {
        const materialInput = getMaterialInputFromTarget(event.target);
        const materialValue = getMaterialFromInput(materialInput);

        if (materialValue) {
          scheduleLiveMaterialFilter(materialValue);
        }
      },
      true
    );

    /*
      Keep dynamic metafield text synchronized with the selected variant.
    */
    productInfo.addEventListener('change', function () {
      window.setTimeout(updateMaterialsText, 50);
    });

    /*
      Patch history once so URL variant changes are detectable even when
      Minimog does not create a useful DOM mutation.
    */
    if (!window.__sbrilletVariantHistoryPatched) {
      window.__sbrilletVariantHistoryPatched = true;

      ['pushState', 'replaceState'].forEach(function (methodName) {
        const originalMethod = history[methodName];

        history[methodName] = function () {
          const result = originalMethod.apply(this, arguments);

          window.dispatchEvent(
            new CustomEvent('sbrillet:variant-url-change')
          );

          return result;
        };
      });
    }

    window.addEventListener(
      'sbrillet:variant-url-change',
      function () {
        window.setTimeout(syncMaterialFromUrl, 0);
        window.setTimeout(syncMaterialFromUrl, 80);
      }
    );

    window.addEventListener('popstate', function () {
      window.setTimeout(syncMaterialFromUrl, 0);
    });

    /*
      Compatibility fallback matching the event structure of the user's
      previously working code.
    */
    let currentUrl = location.href;

    function handleUrlChange() {
      if (location.href === currentUrl) return;

      currentUrl = location.href;
      window.setTimeout(updateMaterialsText, 50);
      window.setTimeout(syncMaterialFromUrl, 0);
    }

    new MutationObserver(handleUrlChange).observe(document.body, {
      subtree: true,
      childList: true
    });
  });
</script>

<script>
// --- Start: Smart Wishlist Sync Logic ---
document.addEventListener('DOMContentLoaded', function() {
  const pHandle = "{{ product.handle }}";
  const pId = "{{ product.id }}";
  const wlBtns = document.querySelectorAll('.m-main-product .m-wishlist-button, .m-main-product [data-action="add-to-wishlist"], .m-main-product .m-product-media--mobile__atwl-button');

  // Scanner: Scans theme's native Local Storage for the product
  function isProductInThemeWishlist() {
    for (let i = 0; i < localStorage.length; i++) {
      let key = localStorage.key(i);
      if (key && key.toLowerCase().includes('wishlist')) {
        try {
          let data = localStorage.getItem(key);
          if (data && (data.includes(pHandle) || data.includes(pId))) {
            return true;
          }
        } catch(e) {}
      }
    }
    return false;
  }

  // Force active visual classes if it is already in the wishlist
  if (isProductInThemeWishlist()) {
    wlBtns.forEach(btn => {
      btn.classList.add('is-active', 'added-to-wishlist', 'm-wishlist--active', 'active');
    });
  }

  // Visual click toggle for instant feedback
  document.addEventListener('click', function(e) {
    const btn = e.target.closest('.m-main-product .m-wishlist-button, .m-main-product [data-action="add-to-wishlist"], .m-main-product .m-product-media--mobile__atwl-button');
    if (btn) {
      setTimeout(() => {
        btn.classList.toggle('is-active');
        btn.classList.toggle('added-to-wishlist');
      }, 50);
    }
  });
});
// --- End: Smart Wishlist Sync Logic ---
</script>




<script>
// --- Start: Bulletproof Wishlist Sync & Counter Fix ---
document.addEventListener('DOMContentLoaded', function() {
  const pHandle = "{{ product.handle }}";
  const pId = "{{ product.id }}";
  
  // 1. Get theme icon settings directly from Liquid configuration
  const imgDefaultSrc = "{% if section.settings.wishlist_icon_initial %}{{ section.settings.wishlist_icon_initial | image_url: width: 24 }}{% endif %}";
  const imgActiveSrc = "{% if section.settings.wishlist_icon_active %}{{ section.settings.wishlist_icon_active | image_url: width: 24 }}{% endif %}";

  // 2. Scanner: Checks if product exists in theme's native storage
  function isItemWishlisted() {
    for (let i = 0; i < localStorage.length; i++) {
      let key = localStorage.key(i);
      if (key && key.toLowerCase().includes('wishlist')) {
        try {
          let data = localStorage.getItem(key);
          if (data && (data.includes(pHandle) || data.includes(pId))) {
            return true;
          }
        } catch(e) {}
      }
    }
    return false;
  }

  // 3. UI Updater: Safely alters icons without interrupting core click scripts
  function syncWishlistVisuals() {
    const isSaved = isItemWishlisted();
    const wlBtns = document.querySelectorAll('.m-main-product .m-wishlist-button, .m-main-product [data-action="add-to-wishlist"], .m-main-product .m-product-media--mobile__atwl-button');

    wlBtns.forEach(btn => {
      // Toggle core design classes
      if (isSaved) {
        btn.classList.add('is-active', 'added-to-wishlist', 'm-wishlist--active', 'active');
      } else {
        btn.classList.remove('is-active', 'added-to-wishlist', 'm-wishlist--active', 'active');
      }

      // Handle custom template elements safely
      if (imgDefaultSrc && imgActiveSrc) {
        let defaultIconEl = btn.querySelector('.m-tooltip-icon:not(.m-tooltip-icon--active)');
        let activeIconEl = btn.querySelector('.m-tooltip-icon--active');

        // Dynamically insert active nodes if missing on Desktop layout
        if (!activeIconEl && defaultIconEl) {
          defaultIconEl.insertAdjacentHTML('afterend', '<span class="m-tooltip-icon--active"><img class="m-svg-icon--medium" src="' + imgActiveSrc + '" alt="active"></span>');
          activeIconEl = btn.querySelector('.m-tooltip-icon--active');
        }

        // Apply clean styles based on current state
        if (defaultIconEl && activeIconEl) {
          defaultIconEl.style.setProperty('display', isSaved ? 'none' : 'block', 'important');
          activeIconEl.style.setProperty('display', isSaved ? 'block' : 'none', 'important');
          activeIconEl.style.setProperty('opacity', isSaved ? '1' : '0', 'important');
        }
      }
    });
  }

  // Run initial configuration scan on page load
  setTimeout(syncWishlistVisuals, 300);

  // 4. Capture theme state transformations immediately when clicked
  document.addEventListener('click', function(e) {
    const btn = e.target.closest('.m-main-product .m-wishlist-button, .m-main-product [data-action="add-to-wishlist"], .m-main-product .m-product-media--mobile__atwl-button');
    if (btn) {
      // Wait exactly 100ms to let the theme complete counter changes and update storage first
      setTimeout(() => {
        syncWishlistVisuals();
      }, 100);
    }
  });
});
// --- End: Bulletproof Wishlist Sync & Counter Fix ---
</script>

<product-info
  id="MainProduct-{{ section.id }}"
  data-section-type="product-page"
  data-section-id="{{ section.id }}"
  data-layout="{{ layout }}"
  data-product-handle="{{ product.handle }}"
  data-url="{{ product.url }}"
  data-update-url="true"
  data-enable-history-state="{{ section.settings.enable_history_state }}"
  data-product-id="{{ product.id }}"
  data-container="{{ container }}"
  data-enable-variant-group-images="{{ enable_variant_group_img }}"
  data-disable-selected-variant-default="{{ disable_selected_variant_default }}"
  data-variant-option-none-text="{{ variant_option_none_text }}"
  data-show-featured-media="{{ section.settings.show_featured_media }}"
  data-material-alt-filter="true"
  class="m-main-product m-gradient m-color-{{ settings.default_color_scheme }} m:block"
>
  <div class="{{ container }}">
    {% liquid
      assign media_class = 'm:w-full md:m:w-1/2'
      assign info_class = 'm:w-full md:m:w-1/2'
      assign wrapper_class = 'm:flex m:flex-wrap'
      case layout
        when 'layout-2'
          assign media_class = 'm:w-full md:m:w-7/12'
          assign info_class = 'm:w-full md:m:w-5/12'
          assign column_gap = '70px'
        when 'layout-3'
          assign media_class = 'm:w-full md:m:w-7/12'
          assign info_class = 'm:w-full md:m:w-5/12'
          assign column_gap = '70px'
        when 'layout-5'
          assign media_class = 'm:w-full md:m:w-7/12'
          assign info_class = 'm:w-full md:m:w-5/12 '
          assign column_gap = '70px'
        when 'layout-7'
          assign media_class = 'm:w-full'
          if product.media.size == 1
            assign media_class = 'container-narrow'
          endif
          assign info_class = 'container-narrow md:m:text-center'
          assign wrapper_class = 'm:flex m:flex-wrap md:m:block m-product-media--layout-7'
        else
          assign column_gap = '50px'
      endcase
    %}
    <div
      class="m-main-product--wrapper {{ wrapper_class }} "
      style="--column-gap: {{ column_gap }}; --column-gap-mobile: 20px;"
    >
      <product-recently-viewed data-product-id="{{ product.id }}" class="m:hidden"></product-recently-viewed>
      <div class="m-main-product--media m:column {{ media_class }} m:relative">
        
        <div class="custom-mobile-arrows md:m:hidden">
          <button class="custom-arrow prev" aria-label="Previous image">❮</button>
          <button class="custom-arrow next" aria-label="Next image">❯</button>
        </div>
        
        <div class="m-product-media--desktop m-product-media--wrapper m-product-media--{{ section.settings.layout }} m:justify-end m-product-media--grid-layout">
          {% render 'product-media',
            section: section,
            template_product: true,
            show_thumbnails_mobile: section.settings.show_nav_media_mobile,
            show_pagination_mobile: section.settings.show_pagination_mobile
          %}

          {% if section.settings.show_atwl %}
            {%- liquid
              assign wishlist_app = settings.wishlist_app
            -%}
            {% if wishlist_app == 'growave' %}
              {% capture the_snippet_fave_icon %}{% render 'ssw-widget-faveicon' with product.id %}{% endcapture %}
              <div class="m-product-media--mobile__atwl-button md:m:hidden">
                {% unless the_snippet_fave_icon contains 'Liquid error' %}
                  {{ the_snippet_fave_icon }}
                {% else %}
                  {% render 'mm-ssw-widget-faveicon' with product.id %}
                {% endunless %}
              </div>
            {% else %}
                {% render 'tooltip',
                type: 'wishlist',
                product: product,
                class_name: 'm-tooltip--top m-product-media--mobile__atwl-button !md:m:hidden',
                icon_initial: section.settings.wishlist_icon_initial,
                icon_active: section.settings.wishlist_icon_active,
                style: 2
              %}
            {% endif %}
          {% endif %}
          {%- if first_3d_model -%}
