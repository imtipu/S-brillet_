{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400&family=Libre+Caslon+Text:wght@400&family=Licorice&display=swap');

  /* BASE VARIABLES */
  .vip-banner-{{ section.id }} {
    --title-size: {{ section.settings.title_size }}px;
    --subtitle-size: {{ section.settings.subtitle_size }}px;
    --desc-size: {{ section.settings.desc_size }}px;
    --pad-tb: {{ section.settings.card_padding_top_bottom }}px;
    --pad-lr: {{ section.settings.card_padding_left_right }}px;
    
    position: relative;
    width: 100%;
    /* Fluid height based on screen size, matching the minimum height */
    min-height: clamp(500px, 60vw, {{ section.settings.section_min_height }}px); 
    display: flex;
    align-items: flex-end; /* Keeps the box positioned near the bottom over the planet */
    justify-content: center;
    background-size: cover;
    background-position: {{ section.settings.bg_position }}; 
    background-repeat: no-repeat;
    padding: 5% 20px 8%; /* Percentage padding keeps position consistent */
    
    {% if section.settings.bg_image != blank %}
      background-image: url('{{ section.settings.bg_image | img_url: 'master' }}');
    {% else %}
      background-color: #1a0b2e; 
    {% endif %}
  }

  .vip-banner-{{ section.id }}::before {
    content: "";
    position: absolute;
    inset: 0;
    /* background-color: rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }}); */
    pointer-events: none;
    z-index: 0;
  }

  .vip-glass-card-{{ section.id }} {
    width: 95%; /* Adapts to screen, but maxes out below */
    max-width: {{ section.settings.card_max_width }}px;
    position: relative;
    z-index: 1;
    
    background: rgba(255, 255, 255, 0.4); 
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    border: 1.5px solid #FFFFFF;
    
    /* Fluid border radius and padding so it looks exactly the same, just smaller */
    border-radius: clamp(20px, 3vw, 50px);
    padding: clamp(30px, 6vw, var(--pad-tb)) clamp(15px, 4vw, var(--pad-lr)); 
    
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    box-shadow: inset 0px 0px 40px 0px rgba(255, 255, 255, 0.8);
    
    margin-top: clamp(0px, 4vw, {{ section.settings.card_margin_top }}px); 
  }

  .vip-title-{{ section.id }} {
    font-family: var(--font-heading-family, 'Libre Caslon Text', serif);
    /* Fluid typography ensures the text scales perfectly with the box */
    font-size: clamp(24px, 4vw, var(--title-size)); 
    font-weight: 400;
    line-height: 1.1; 
    color: {{ section.settings.text_color }};
    text-transform: uppercase;
    margin: 0 0 clamp(5px, 1.5vw, 10px) 0;
    white-space: normal; /* Changed from nowrap so it stays perfectly centered and readable on mobile */
  }

  .vip-subtitle-{{ section.id }} {
    
    font-size: clamp(16px, 3vw, var(--subtitle-size)); 
    font-weight: 400;
    line-height: 1.2;
    color: {{ section.settings.text_color }};
    margin: 0 0 clamp(20px, 4vw, 20px) ;
    font-family: "Licorice", cursive;
    font-style: normal;
    text-transform: capitalize;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.3);
  }

  .vip-buttons-{{ section.id }} {
    display: flex;
    flex-direction: row;
    gap: clamp(15px, 3vw, 40px);
    justify-content: center;
    align-items: center;
    margin-bottom: clamp(20px, 4vw, 40px);
    width: 100%;
  }

  .vip-btn-{{ section.id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    /* Fluid button width so they stay side-by-side gracefully */
    width: clamp(140px, 20vw, 350px);
    height: clamp(45px, 5vw, 55px);
    border-radius: 12px;
    font-family: var(--font-body-family, 'Inter', sans-serif);
    font-size: clamp(10px, 1.2vw, 14px);
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
    letter-spacing: 0.5px;
    text-align: center;
    padding: 0 10px;
  }

  .btn-primary-{{ section.id }} {
    background-color: {{ section.settings.btn1_bg_color }};
    color: {{ section.settings.btn1_text_color }};
    border: 1px solid {{ section.settings.btn1_bg_color }};
  }

  .btn-primary-{{ section.id }}:hover {
    background: linear-gradient(135deg, #947863, #E9DDD4, #947863);
    color: #FFFFFF;
    border: 1px solid transparent;
  }

  .btn-secondary-{{ section.id }} {
    background-color: transparent;
    color: {{ section.settings.text_color }};
    border: 1px solid {{ section.settings.text_color }};
  }

  .btn-secondary-{{ section.id }}:hover {
    background: linear-gradient(135deg, #947863, #E9DDD4, #947863);
    color: #FFFFFF;
    border: 1px solid transparent;
  }

  .vip-description-{{ section.id }} {
    font-family: var(--font-body-family, 'Inter', sans-serif);
    font-size: clamp(12px, 1.5vw, var(--desc-size));
    line-height: 1.5;
    color: {{ section.settings.text_color }};
    max-width: 800px;
    margin: 0 auto;
  }

  /* =========================================
     RESPONSIVE MEDIA QUERIES (Fine-Tuning)
     ========================================= */

  /* Mobile specific overrides to ensure buttons fit if screen is extremely small */
  @media (max-width: 480px) {
    .vip-buttons-{{ section.id }} {
      /* Forces buttons to stack only on very tiny phones to avoid breaking */
      flex-direction: row; 
      gap: 15px;
    }
    .vip-btn-{{ section.id }} {
      width: 100%;
      max-width: 280px;
      height: 50px;
      font-size: 12px;
    }
    .vip-title-{{ section.id }} {
        font-size: 26px;
    }
    .vip-subtitle-{{ section.id }} {
        font-size: 18px;
    }
  }
{%- endstyle -%}

<div class="vip-banner-{{ section.id }}">
  <div class="vip-glass-card-{{ section.id }}">
    
    {% if section.settings.title != blank %}
      <h2 class="vip-title-{{ section.id }}">{{ section.settings.title }}</h2>
    {% endif %}

    {% if section.settings.subtitle != blank %}
      <h3 class="vip-subtitle-{{ section.id }}">{{ section.settings.subtitle }}</h3>
    {% endif %}

    <div class="vip-buttons-{{ section.id }}">
      {% if section.settings.btn1_text != blank %}
        <a href="{{ section.settings.btn1_link }}" class="vip-btn-{{ section.id }} btn-primary-{{ section.id }}">
          {{ section.settings.btn1_text }}
        </a>
      {% endif %}

      {% if section.settings.btn2_text != blank %}
        <a href="{{ section.settings.btn2_link }}" class="vip-btn-{{ section.id }} btn-secondary-{{ section.id }}">
          {{ section.settings.btn2_text }}
        </a>
      {% endif %}
    </div>

    {% if section.settings.description != blank %}
      <p class="vip-description-{{ section.id }}">{{ section.settings.description }}</p>
    {% endif %}

  </div>
</div>

