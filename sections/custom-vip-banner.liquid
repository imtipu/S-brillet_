{% comment %} {%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400&family=Libre+Caslon+Text:wght@400&family=Licorice&display=swap');

  /* BASE DESKTOP VARIABLES (For screens larger than 1728px) */
  .vip-banner-{{ section.id }} {
    --title-size: {{ section.settings.title_size }}px;
    --subtitle-size: {{ section.settings.subtitle_size }}px;
    --desc-size: {{ section.settings.desc_size }}px;
    --pad-tb: {{ section.settings.card_padding_top_bottom }}px;
    --pad-lr: {{ section.settings.card_padding_left_right }}px;
    --btn-width: 350px;
    --btn-gap: 40px;

    position: relative;
    width: 100%;
    /* Section Height */
    min-height: {{ section.settings.section_min_height }}px; 
    display: flex;
    align-items: end;
    justify-content: center;
    background-size: cover;
    /* Background Image Position */
    background-position: {{ section.settings.bg_position }}; 
    background-repeat: no-repeat;
    padding: 80px 20px;
    {% if section.settings.bg_image != blank %}
      background-image: url('{{ section.settings.bg_image | img_url: 'master' }}');
    {% else %}
      background-color: #1a0b2e; 
    {% endif %}
  }

  .vip-glass-card-{{ section.id }} {
    width: 100%;
    max-width: {{ section.settings.card_max_width }}px;
    
    /* Fixed Perfect Glass Effect (0.08 was your perfect previous value) */
    background: rgba(255, 255, 255, 0.4); 
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    
    border: 1.5px solid #FFFFFF;
    border-radius: 50px;
    /* Using Variables */
    padding: var(--pad-tb) var(--pad-lr); 
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    box-shadow: inset 0px 0px 40px 0px rgba(255, 255, 255, 0.8);
    
    /* CUSTOMIZE: Move card up or down */
    margin-top: {{ section.settings.card_margin_top }}px; 
  }

  .vip-title-{{ section.id }} {
   font-family: var(--font-heading-family, 'Libre Caslon Text', serif);
    font-size: var(--title-size); 
    font-weight: 400;
    line-height: 1; 
    color: {{ section.settings.text_color }};
    text-transform: uppercase;
    margin: 0 0 10px 0;
    white-space: nowrap; 
  }

  .vip-subtitle-{{ section.id }} {
    font-family: var(--font-heading-family, 'Libre Caslon Text', serif);
    font-size: var(--subtitle-size); 
    font-weight: 400;
    line-height: 1.2;
    color: {{ section.settings.text_color }};
    margin: 0 0 40px 0;
  }

  .vip-buttons-{{ section.id }} {
    display: flex;
    flex-direction: row;
    gap: var(--btn-gap);
    justify-content: center;
    align-items: center;
    margin-bottom: 40px;
  }

  .vip-btn-{{ section.id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--btn-width);
    height: 55px;
    border-radius: 12px;
    font-family: var(--font-body-family, 'Inter', sans-serif);
    font-size: 14px;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
    letter-spacing: 0.5px;
  }

  .btn-primary-{{ section.id }} {
    background-color: {{ section.settings.btn1_bg_color }};
    color: {{ section.settings.btn1_text_color }};
    border: 1px solid {{ section.settings.btn1_bg_color }};
  }

  .btn-primary-{{ section.id }}:hover {
    /* opacity: 0.8; */
        background: linear-gradient(135deg, #947863, #E9DDD4, #947863);
    color: #FFFFFF;
    border:none;
  }

  .btn-secondary-{{ section.id }} {
    background-color: transparent;
    color: {{ section.settings.text_color }};
    border: 1px solid {{ section.settings.text_color }};
  }

  .btn-secondary-{{ section.id }}:hover {
       background: linear-gradient(135deg, #947863, #E9DDD4, #947863);
    color: #FFFFFF;
    border:none;
  }

  .vip-description-{{ section.id }} {
    font-family: var(--font-body-family, 'Inter', sans-serif);
    font-size: var(--desc-size);
    line-height: 1.5;
    color: {{ section.settings.text_color }};
    max-width: 800px;
    margin: 0 auto;
  }

  /* =========================================
     RESPONSIVE MEDIA QUERIES
     ========================================= */

  /* 1. MacBook M2 / Large Laptops (1441px to 1728px) */
  @media (min-width: 1441px) and (max-width: 1728px) {
    .vip-banner-{{ section.id }} {
      --title-size: calc({{ section.settings.title_size }}px * 0.85); /* 85% of customizer size */
      --subtitle-size: calc({{ section.settings.subtitle_size }}px * 0.85);
      --desc-size: calc({{ section.settings.desc_size }}px * 0.90);
      --pad-tb: calc({{ section.settings.card_padding_top_bottom }}px * 0.90);
      --pad-lr: calc({{ section.settings.card_padding_left_right }}px * 0.90);
          padding-left: 120px;
    padding-right: 120px;
 
    }
  }

  /* 2. MacBook Air / Standard Laptops (1025px to 1440px) */
  @media (min-width: 1025px) and (max-width: 1440px) {
    .vip-banner-{{ section.id }} {
      --title-size: calc({{ section.settings.title_size }}px * 0.70); /* 70% of customizer size */
      --subtitle-size: calc({{ section.settings.subtitle_size }}px * 0.75);
      --desc-size: calc({{ section.settings.desc_size }}px * 0.85);
      --pad-tb: calc({{ section.settings.card_padding_top_bottom }}px * 0.75);
      --pad-lr: calc({{ section.settings.card_padding_left_right }}px * 0.75);
      --btn-width: 300px; /* Buttons slightly smaller */
    }
  }

  /* 3. iPad / Tablets (769px to 1024px) */
  @media (min-width: 769px) and (max-width: 1024px) {
    .vip-banner-{{ section.id }} {
      --title-size: calc({{ section.settings.title_size }}px * 0.55); /* 55% of customizer size */
      --subtitle-size: calc({{ section.settings.subtitle_size }}px * 0.65);
      --desc-size: calc({{ section.settings.desc_size }}px * 0.80);
      --pad-tb: 50px; /* Fixed padding for iPad */
      --pad-lr: 30px;
      --btn-width: 250px;
      --btn-gap: 20px;
    }
    .vip-title-{{ section.id }} {
      white-space: normal; /* Allows text to wrap on iPad if screen is too narrow */
    }
  }

  /* 4. Mobile (up to 768px) */
  @media (max-width: 768px) {
    .vip-banner-{{ section.id }} {
      min-height: 600px; 
      padding: 60px 15px; 
    }
    .vip-glass-card-{{ section.id }} {
      padding: 40px 20px;
      border-radius: 30px;
      margin-top: 20px; 
    }
    .vip-title-{{ section.id }} {
      font-size: 32px; /* Fixed size for mobile */
      white-space: normal; 
    }
    .vip-subtitle-{{ section.id }} {
      font-size: 36px;
    }
    .vip-buttons-{{ section.id }} {
      flex-direction: column;
      gap: 20px;
    }
    .vip-btn-{{ section.id }} {
      width: 100%;
      max-width: 350px;
    }
    .vip-description-{{ section.id }} {
      font-size: 14px;
    }
  }
{%- endstyle -%}

<div class="vip-banner-{{ section.id }}">
  <div class="vip-glass-card-{{ section.id }}">
    
    {% if section.settings.title != blank %}
      <h2 class="vip-title-{{ section.id }}">{{ section.settings.title }}</h2>
    {% endif %}

    {% if section.settings.subtitle != blank %}
      <h3 class="vip-subtitle-{{ section.id }}">{{ section.settings.subtitle }}</h3>
    {% endif %}

    <div class="vip-buttons-{{ section.id }}">
      {% if section.settings.btn1_text != blank %}
        <a href="{{ section.settings.btn1_link }}" class="vip-btn-{{ section.id }} btn-primary-{{ section.id }}">
          {{ section.settings.btn1_text }}
        </a>
      {% endif %}

      {% if section.settings.btn2_text != blank %}
        <a href="{{ section.settings.btn2_link }}" class="vip-btn-{{ section.id }} btn-secondary-{{ section.id }}">
          {{ section.settings.btn2_text }}
        </a>
      {% endif %}
    </div>

    {% if section.settings.description != blank %}
      <p class="vip-description-{{ section.id }}">{{ section.settings.description }}</p>
    {% endif %}

  </div>
</div>

