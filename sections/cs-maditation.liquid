{%- style -%}
  .mmspx-{{ section.id }} {
    --mmspx-bg:            {{ section.settings.section_bg }};
    --mmspx-card-bg:       {{ section.settings.card_bg }};
    --mmspx-title-color:   {{ section.settings.title_color }};
    --mmspx-text-color:    {{ section.settings.text_color }};
    --mmspx-label-color:   {{ section.settings.label_color }};
    --mmspx-divider-color: {{ section.settings.divider_color }};
    --mmspx-btn-text:      {{ section.settings.btn_text_color }};
    --mmspx-btn-border:    {{ section.settings.btn_border_color }};
    --mmspx-dot-inactive:  {{ section.settings.dot_inactive_color }};
    --mmspx-arrow-color:   {{ section.settings.arrow_color }};

    background-color: var(--mmspx-bg);
    padding: {{ section.settings.section_padding_v }}px {{ section.settings.section_padding_h }}px;
    width: 100%;
    display: block;
    box-sizing: border-box;
  }

  .mmspx-{{ section.id }} .mmspx-card {
    max-width: 1680px;
    margin: 0 auto;
    background-color: var(--mmspx-card-bg);
    box-shadow: inset 0 0 30px 8px rgba(0, 0, 0, 0.06);
    padding: {{ section.settings.card_padding_top }}px {{ section.settings.card_padding_h }}px;
    box-sizing: border-box;
    position: relative;
  }

  /* ── OUTER LAYOUT: CSS GRID FOR PERFECT ALIGNMENT ── */
  .mmspx-{{ section.id }} .mmspx-layout {
    display: grid;
    grid-template-columns: {{ section.settings.text_col_width }}px 1fr;
    grid-template-rows: auto auto; /* Row 1 for Text & Image, Row 2 for Controls */
    column-gap: {{ section.settings.card_gap }}px;
  }

  /* img-left variant: flip columns */
  .mmspx-{{ section.id }} .mmspx-layout.img-left {
    grid-template-columns: 1fr {{ section.settings.text_col_width }}px;
  }

  /* ── TEXT COLUMN ── */
  .mmspx-{{ section.id }} .mmspx-text-panel {
    grid-column: 1;
    grid-row: 1; /* Sits on Row 1 */
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 400px; /* Safe fallback */
  }
  .mmspx-{{ section.id }} .mmspx-layout.img-left .mmspx-text-panel {
    grid-column: 2;
  }

  /* ── IMAGE COLUMN ── */
  .mmspx-{{ section.id }} .mmspx-img-panel {
    grid-column: 2;
    grid-row: 1; /* Exactly parallel to text, takes identical height */
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  .mmspx-{{ section.id }} .mmspx-layout.img-left .mmspx-img-panel {
    grid-column: 1;
  }

  /* ── CONTROLS COLUMN ── */
  .mmspx-{{ section.id }} .mmspx-controls-panel {
    grid-column: 2;
    grid-row: 2; /* Sits exactly below the image */
    padding-top: 25px;
  }
  .mmspx-{{ section.id }} .mmspx-layout.img-left .mmspx-controls-panel {
    grid-column: 1;
  }

  /* ── INNER IMAGE STACK (Children are absolute) ── */
  .mmspx-{{ section.id }} .mmspx-slide-img {
    position: absolute !important;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.6s ease-in-out;
    visibility: hidden;
  }

  .mmspx-{{ section.id }} .mmspx-slide-img.is-active {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
  }

  .mmspx-{{ section.id }} .mmspx-slide-img.is-leaving {
    opacity: 0;
    pointer-events: none;
    visibility: visible;
  }

  .mmspx-{{ section.id }} .mmspx-image-wrapper {
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .mmspx-{{ section.id }} .mmspx-image-wrapper img,
  .mmspx-{{ section.id }} .mmspx-image-wrapper .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── INNER TEXT STACK (Grid stacking prevents layout jumps) ── */
  .mmspx-{{ section.id }} .mmspx-text-stack {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: 1fr;
    align-items: center;
  }

  .mmspx-{{ section.id }} .mmspx-slide-text {
    grid-area: 1 / 1 / 2 / 2; /* Forces all slides to overlap perfectly */
    display: flex;
    flex-direction: column;
    gap: 20px;
    box-sizing: border-box;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.6s ease-in-out;
    visibility: hidden;
  }

  .mmspx-{{ section.id }} .mmspx-slide-text.is-active {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
  }

  .mmspx-{{ section.id }} .mmspx-slide-text.is-leaving {
    opacity: 0;
    pointer-events: none;
    visibility: visible;
  }

  /* ── TYPOGRAPHY ── */
  .mmspx-{{ section.id }} .mmspx-title {
    font-family: var(--font-heading-family, 'Libre Caslon Text', serif);
    font-size: {{ section.settings.title_size }}px;
    font-weight: 400;
    line-height: 1.1;
    color: var(--mmspx-title-color);
    margin: 0;
    text-transform: uppercase;
  }

  .mmspx-{{ section.id }} .mmspx-desc {
    font-family: var(--font-body-family, 'Inter', sans-serif);
    font-size: {{ section.settings.desc_size }}px;
    font-weight: 400;
    line-height: 1.65;
    color: var(--mmspx-text-color);
    margin: 0;
  }

  .mmspx-{{ section.id }} .mmspx-divider {
    border: none;
    border-top: 1.5px solid var(--mmspx-divider-color);
    margin: 0;
    width: 100%;
  }

  .mmspx-{{ section.id }} .mmspx-text-blocks {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .mmspx-{{ section.id }} .mmspx-text-block-row {
    font-family: var(--font-body-family, 'Inter', sans-serif);
    font-size: {{ section.settings.block_text_size }}px;
    font-weight: 400;
    line-height: 1.6;
    color: var(--mmspx-text-color);
    margin: 0;
  }

  .mmspx-{{ section.id }} .mmspx-text-block-label {
    font-weight: 700;
    color: var(--mmspx-label-color);
  }

  /* ── BUTTON ── */
  .mmspx-{{ section.id }} .mmspx-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 350px;
    max-width: 100%;
    height: 55px;
    background-color: transparent;
    color: var(--mmspx-btn-text);
    border: 1px solid var(--mmspx-btn-border);
    font-family: var(--font-body-family, 'Inter', sans-serif);
    font-size: 16px;
    font-weight: 400;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
    box-sizing: border-box;
  }

  .mmspx-{{ section.id }} .mmspx-btn:hover {
   background: linear-gradient(135deg, #947863, #E9DDD4, #947863) !important;
    color: #FFF;
  }

  /* ── CONTROLS STYLING ── */
  .mmspx-{{ section.id }} .mmspx-controls {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
  }

  .mmspx-{{ section.id }} .mmspx-arrow-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--mmspx-arrow-color);
    opacity: 0.55;
    transition: opacity 0.2s;
    line-height: 0;
    flex-shrink: 0;
  }
  .mmspx-{{ section.id }} .mmspx-arrow-btn:hover { opacity: 1; }
  .mmspx-{{ section.id }} .mmspx-arrow-btn .mmspx-arrow-svg {
    width: 22px;
    height: 16px;
    display: block;
  }

  .mmspx-{{ section.id }} .mmspx-dot-strip {
    display: flex;
    align-items: center;
    gap: 10px;
    justify-content: center;
  }
  .mmspx-{{ section.id }} .mmspx-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--mmspx-dot-inactive);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: all 0.3s ease;
    flex-shrink: 0;
  }

  .mmspx-{{ section.id }} .mmspx-dot.is-active {
    background: linear-gradient(180deg, #947863 0%, #E9DDD4 50%, #947863 100%) !important;
    transform: scale(1.3);
  }


  

  /* ══════════════════════════════════════════════
     RESPONSIVE BREAKPOINTS
  ══════════════════════════════════════════════ */


  /* ─── MacBook Air 15 inch M2 (1441px - 1728px) ───────────────── */
@media (min-width: 1441px) and (max-width: 1728px) {
  .mmspx-{{ section.id }} .mmspx-title {
    font-size: 54px;
  }
  .mmspx-{{ section.id }} .mmspx-desc,
  .mmspx-{{ section.id }} .mmspx-text-block-row {
    font-size: 18px;
  }
  .mmspx-{{ section.id }} .mmspx-layout {
    grid-template-columns: 560px 1fr;
  }
  .mmspx-{{ section.id }} .mmspx-layout.img-left {
    grid-template-columns: 1fr 560px;
  }
  .mmspx-{{ section.id }} .mmspx-btn {
    width: 320px;
  }
}


  @media (max-width: 1440px) {
    .mmspx-{{ section.id }} .mmspx-title {
      font-size: 46px; 
    }
    .mmspx-{{ section.id }} .mmspx-desc,
    .mmspx-{{ section.id }} .mmspx-text-block-row {
      font-size: 16px; 
    }
    .mmspx-{{ section.id }} .mmspx-layout {
      grid-template-columns: 500px 1fr;
    }
    .mmspx-{{ section.id }} .mmspx-layout.img-left {
      grid-template-columns: 1fr 500px;
    }
    .mmspx-{{ section.id }} .mmspx-btn {
      width: 280px;
    }
  }

  @media (max-width: 1100px) {
    .mmspx-{{ section.id }} {
      padding: 60px 40px;
    }
    .mmspx-{{ section.id }} .mmspx-card {
      padding: 50px 40px;
    }
    .mmspx-{{ section.id }} .mmspx-layout,
    .mmspx-{{ section.id }} .mmspx-layout.img-left {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto auto;
    }
    .mmspx-{{ section.id }} .mmspx-img-panel,
    .mmspx-{{ section.id }} .mmspx-layout.img-left .mmspx-img-panel {
      grid-column: 1 !important;
      grid-row: 1 !important; /* Image on top */
      aspect-ratio: 16 / 10;
    }
    .mmspx-{{ section.id }} .mmspx-controls-panel,
    .mmspx-{{ section.id }} .mmspx-layout.img-left .mmspx-controls-panel {
      grid-column: 1 !important;
      grid-row: 2 !important; /* Controls under image */
      padding-top: 20px;
      padding-bottom: 40px;
    }
    .mmspx-{{ section.id }} .mmspx-text-panel,
    .mmspx-{{ section.id }} .mmspx-layout.img-left .mmspx-text-panel {
      grid-column: 1 !important;
      grid-row: 3 !important; /* Text at bottom */
      min-height: auto;
    }
    .mmspx-{{ section.id }} .mmspx-title {
      font-size: 36px;
    }
  }

  @media (max-width: 768px) {
    .mmspx-{{ section.id }} {
      padding: 32px 16px;
    }
    .mmspx-{{ section.id }} .mmspx-card {
      padding: 28px 18px;
    }
    .mmspx-{{ section.id }} .mmspx-title {
      font-size: 28px; 
      line-height: 1.2;
    }
    .mmspx-{{ section.id }} .mmspx-desc,
    .mmspx-{{ section.id }} .mmspx-text-block-row {
      font-size: 16px;
      line-height: 1.6;
    }
    .mmspx-{{ section.id }} .mmspx-img-panel {
      aspect-ratio: 4 / 3;
    }
    .mmspx-{{ section.id }} .mmspx-btn {
      width: 100%;
      height: 50px;
    }
  }

{%- endstyle -%}

