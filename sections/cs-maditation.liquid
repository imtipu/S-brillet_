{% comment %} {%- style -%}
  .mmspx-{{ section.id }} {
    --mmspx-bg:            {{ section.settings.section_bg }};
    --mmspx-card-bg:       {{ section.settings.card_bg }};
    --mmspx-title-color:   {{ section.settings.title_color }};
    --mmspx-text-color:    {{ section.settings.text_color }};
    --mmspx-label-color:   {{ section.settings.label_color }};
    --mmspx-divider-color: {{ section.settings.divider_color }};
    --mmspx-btn-text:      {{ section.settings.btn_text_color }};
    --mmspx-btn-border:    {{ section.settings.btn_border_color }};
    --mmspx-dot-inactive:  {{ section.settings.dot_inactive_color }};
    --mmspx-dot-active:    {{ section.settings.dot_active_color }};
    --mmspx-arrow-color:   {{ section.settings.arrow_color }};

    background-color: var(--mmspx-bg);
    padding: {{ section.settings.section_padding_v }}px {{ section.settings.section_padding_h }}px;
    width: 100%;
    display: block;
    box-sizing: border-box;
  }

  .mmspx-{{ section.id }} .mmspx-card {
    max-width: 1680px;
    margin: 0 auto;
    background-color: var(--mmspx-card-bg);
    box-shadow: inset 0 0 30px 8px rgba(0, 0, 0, 0.06);
    padding: {{ section.settings.card_padding_top }}px {{ section.settings.card_padding_h }}px;
    box-sizing: border-box;
    position: relative;
  }

  /* ── OUTER GRID: text col | image+controls col ── */
  .mmspx-{{ section.id }} .mmspx-layout {
    display: grid;
    grid-template-columns: 5fr 4fr;
    grid-template-rows: auto auto;
    gap: 0 80px;
  }

  /* text column spans both rows on the left */
  .mmspx-{{ section.id }} .mmspx-text-panel {
    grid-column: 1;
    grid-row: 1 / 3;
    display: flex;
    flex-direction: column;
    gap: 20px;
    box-sizing: border-box;
  }

  /* image area: top-right cell */
  .mmspx-{{ section.id }} .mmspx-img-panel {
    grid-column: 2;
    grid-row: 1;
    padding-right: {{ section.settings.right_padding_r }}px;
    box-sizing: border-box;
  }

  /* controls area: bottom-right cell */
  .mmspx-{{ section.id }} .mmspx-controls-panel {
    grid-column: 2;
    grid-row: 2;
    padding-right: {{ section.settings.right_padding_r }}px;
    padding-bottom: {{ section.settings.right_padding_b }}px;
    box-sizing: border-box;
  }

  /* img-left variant: flip columns */
  .mmspx-{{ section.id }} .mmspx-layout.img-left {
    grid-template-columns: 1fr {{ section.settings.text_col_width }}px;
  }
  .mmspx-{{ section.id }} .mmspx-layout.img-left .mmspx-text-panel {
    grid-column: 2;
  }
  .mmspx-{{ section.id }} .mmspx-layout.img-left .mmspx-img-panel {
    grid-column: 1;
    padding-right: 0;
    padding-left: {{ section.settings.right_padding_r }}px;
  }
  .mmspx-{{ section.id }} .mmspx-layout.img-left .mmspx-controls-panel {
    grid-column: 1;
    padding-right: 0;
    padding-left: {{ section.settings.right_padding_r }}px;
  }





  .mmspx-template--28063329124734__cs_maditation_HUDMNn .mmspx-slide-img {
    position: absolute !important;
    height: 512px;
}
.mmspx-template--28063329124734__cs_maditation_HUDMNn .mmspx-img-stack {
    position: relative;
    width: 100%;
    height: 512px;
    aspect-ratio: 720 / 535;
    overflow: hidden;
}
.mmspx-template--28063329124734__cs_maditation_HUDMNn .mmspx-slide-text.is-active {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
    position: relative;
    max-width: 720px;
}
.mmspx-template--28063329124734__cs_maditation_HUDMNn .mmspx-image-wrapper img, .mmspx-template--28063329124734__cs_maditation_HUDMNn .mmspx-image-wrapper .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}
  /* ══════════════════════════════════════════════
     STACKING SYSTEM
     Text stack: relative container, active child is relative (sizes parent),
                 others are absolute — text height changes are fine/expected.
     Image stack: FIXED by aspect-ratio on the container itself.
                  ALL slide-imgs are ALWAYS absolute. Container never resizes.
  ══════════════════════════════════════════════ */

  /* TEXT stack — normal flow stacking */
  .mmspx-{{ section.id }} .mmspx-text-stack {
    position: relative;
  }

  .mmspx-{{ section.id }} .mmspx-slide-text {
    display: flex;
    flex-direction: column;
    gap: 20px;
    box-sizing: border-box;
    /* hidden by default */
    position: absolute;
    top: 0; left: 0; width: 100%;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.55s ease;
    visibility: hidden;
  }

  .mmspx-{{ section.id }} .mmspx-slide-text.is-active {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
    position: relative; /* sizes the text-stack container */
  }

  .mmspx-{{ section.id }} .mmspx-slide-text.is-leaving {
    position: absolute;
    opacity: 0;
    pointer-events: none;
    visibility: visible;
  }

  /* IMAGE stack — container is sized by aspect-ratio, NEVER by children */
  .mmspx-{{ section.id }} .mmspx-img-stack {
    position: relative;
    width: 100%;
    /* Lock the height via aspect-ratio — children are all absolute, never affect size */
    aspect-ratio: 720 / 535;
    overflow: hidden;
  }

  /* Every slide-img: always absolutely fills the container — position NEVER changes */
  .mmspx-{{ section.id }} .mmspx-slide-img {
    position: absolute !important;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.55s ease;
    visibility: hidden;
  }

  .mmspx-{{ section.id }} .mmspx-slide-img.is-active {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
  }

  .mmspx-{{ section.id }} .mmspx-slide-img.is-leaving {
    opacity: 0;
    pointer-events: none;
    visibility: visible;
  }

  /* ── TYPOGRAPHY ── */
  .mmspx-{{ section.id }} .mmspx-title {
    font-family: var(--font-heading-family, 'Georgia', serif);
    font-size: {{ section.settings.title_size }}px;
    font-weight: 400;
    line-height: 1.05;
    color: var(--mmspx-title-color);
    margin: 0;
    text-transform: uppercase;
  }

  .mmspx-{{ section.id }} .mmspx-desc {
    font-family: var(--font-body-family, sans-serif);
    font-size: {{ section.settings.desc_size }}px;
    font-weight: 400;
    line-height: 1.65;
    color: var(--mmspx-text-color);
    margin: 0;
  }

  .mmspx-{{ section.id }} .mmspx-divider {
    border: none;
    border-top: 1.5px solid var(--mmspx-divider-color);
    margin: 0;
    width: 100%;
  }

  .mmspx-{{ section.id }} .mmspx-text-blocks {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .mmspx-{{ section.id }} .mmspx-text-block-row {
    font-family: var(--font-body-family, sans-serif);
    font-size: {{ section.settings.block_text_size }}px;
    font-weight: 400;
    line-height: 1.6;
    color: var(--mmspx-text-color);
    margin: 0;
  }

  .mmspx-{{ section.id }} .mmspx-text-block-label {
    font-weight: 700;
    color: var(--mmspx-label-color);
  }

  /* ── BUTTON ── */
  .mmspx-{{ section.id }} .mmspx-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 350px;
    max-width: 100%;
    height: 55px;
    padding: 0 32px;
    background-color: transparent;
    color: var(--mmspx-btn-text);
    border: 1px solid var(--mmspx-btn-border);
    font-family: var(--font-heading-family, 'Georgia', serif);
    font-size: 20px;
    font-weight: 300;
    line-height: 20px;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.25s ease, color 0.25s ease;
    box-sizing: border-box;
  }

  .mmspx-{{ section.id }} .mmspx-btn:hover {
    background: linear-gradient(90deg, #947863 0%, #E9DDD4 50%, #947863 100%);
    color: #FFF;
  }

  /* ── IMAGE WRAPPER — fills the absolute slide-img, no own aspect-ratio ── */
  .mmspx-{{ section.id }} .mmspx-image-wrapper {
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .mmspx-{{ section.id }} .mmspx-image-wrapper img,
  .mmspx-{{ section.id }} .mmspx-image-wrapper .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: ;
    display: block;
  }

  /* ── CONTROLS ── */
  .mmspx-{{ section.id }} .mmspx-controls {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    margin-top: 28px;
  }

  .mmspx-{{ section.id }} .mmspx-arrow-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--mmspx-arrow-color);
    opacity: 0.55;
    transition: opacity 0.2s;
    line-height: 0;
    flex-shrink: 0;
  }
  .mmspx-{{ section.id }} .mmspx-arrow-btn:hover { opacity: 1; }
  .mmspx-{{ section.id }} .mmspx-arrow-btn .mmspx-arrow-img {
    width: {{ section.settings.arrow_icon_size }}px;
    height: {{ section.settings.arrow_icon_size }}px;
    object-fit: contain;
    display: block;
  }
  .mmspx-{{ section.id }} .mmspx-arrow-btn .mmspx-arrow-svg {
    width: 22px;
    height: 16px;
    display: block;
  }

  .mmspx-{{ section.id }} .mmspx-dot-strip {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .mmspx-{{ section.id }} .mmspx-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--mmspx-dot-inactive);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.2s ease;
    flex-shrink: 0;
  }
  .mmspx-{{ section.id }} .mmspx-dot.is-active {
    background-color: var(--mmspx-dot-active);
    transform: scale(1.3);
  }


  /* ══════════════════════════════════════════════
     RESPONSIVE BREAKPOINTS
  ══════════════════════════════════════════════ */

  /* ── MAC / LARGE LAPTOP: 1280px–1400px ── */
  @media (max-width: 1470px) {

    .mmspx-title {
      font-size:36px !important;
    }
    .mmspx-{{ section.id }} .mmspx-layout {
      grid-template-columns: 440px 1fr;
    }
    .mmspx-{{ section.id }} .mmspx-layout.img-left {
      grid-template-columns: 1fr 440px;
    }
    .mmspx-{{ section.id }} .mmspx-title {
      font-size: clamp(38px, 3.2vw, {{ section.settings.title_size }}px);
    }
    .mmspx-{{ section.id }} .mmspx-desc,
    .mmspx-{{ section.id }} .mmspx-text-block-row {
      font-size: clamp(13px, 1.1vw, {{ section.settings.desc_size }}px);
    }
    .mmspx-{{ section.id }} .mmspx-img-stack {
      aspect-ratio: 680 / 520;
    }
  }

  /* ── TABLET / SMALL LAPTOP: 1100px–1279px ── */
  @media (max-width: 1100px) {
    .mmspx-{{ section.id }} {
      padding: 60px 40px;
    }
    .mmspx-{{ section.id }} .mmspx-card {
      padding: 50px 40px;
    }
    .mmspx-{{ section.id }} .mmspx-layout,
    .mmspx-{{ section.id }} .mmspx-layout.img-left {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto auto;
      gap: 40px 0;
    }
    .mmspx-{{ section.id }} .mmspx-text-panel,
    .mmspx-{{ section.id }} .mmspx-layout.img-left .mmspx-text-panel {
      grid-column: 1;
      grid-row: 2;
    }
    .mmspx-{{ section.id }} .mmspx-img-panel,
    .mmspx-{{ section.id }} .mmspx-layout.img-left .mmspx-img-panel {
      grid-column: 1;
      grid-row: 1;
      padding: 0;
    }
    .mmspx-{{ section.id }} .mmspx-controls-panel,
    .mmspx-{{ section.id }} .mmspx-layout.img-left .mmspx-controls-panel {
      grid-column: 1;
      grid-row: 3;
      padding: 0;
    }
    .mmspx-{{ section.id }} .mmspx-img-stack {
      aspect-ratio: 16 / 10;
    }
    .mmspx-{{ section.id }} .mmspx-title {
      font-size: clamp(34px, 4vw, 50px);
    }
    .mmspx-{{ section.id }} .mmspx-desc,
    .mmspx-{{ section.id }} .mmspx-text-block-row {
      font-size: 14px;
    }
  }

  /* ── TABLET PORTRAIT: ≤900px ── */
  @media (max-width: 900px) {
    .mmspx-{{ section.id }} {
      padding: 48px 28px;
    }
    .mmspx-{{ section.id }} .mmspx-card {
      padding: 40px 28px;
    }
    .mmspx-{{ section.id }} .mmspx-title {
      font-size: clamp(32px, 4.5vw, 46px);
    }
    .mmspx-{{ section.id }} .mmspx-img-stack {
      aspect-ratio: 16 / 10;
    }
    .mmspx-{{ section.id }} .mmspx-btn {
      width: 100%;
    }
  }

  /* ── MOBILE: ≤768px ── */
  @media (max-width: 768px) {
    .mmspx-{{ section.id }} {
      padding: 32px 16px;
    }
    .mmspx-{{ section.id }} .mmspx-card {
      padding: 28px 18px;
    }
    .mmspx-{{ section.id }} .mmspx-layout,
    .mmspx-{{ section.id }} .mmspx-layout.img-left {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto auto;
      gap: 24px 0;
    }
    .mmspx-{{ section.id }} .mmspx-img-panel,
    .mmspx-{{ section.id }} .mmspx-layout.img-left .mmspx-img-panel {
      grid-column: 1;
      grid-row: 1;
      padding: 0;
    }
    .mmspx-{{ section.id }} .mmspx-text-panel,
    .mmspx-{{ section.id }} .mmspx-layout.img-left .mmspx-text-panel {
      grid-column: 1;
      grid-row: 2;
    }
    .mmspx-{{ section.id }} .mmspx-controls-panel,
    .mmspx-{{ section.id }} .mmspx-layout.img-left .mmspx-controls-panel {
      grid-column: 1;
      grid-row: 3;
      padding: 0;
    }
    .mmspx-{{ section.id }} .mmspx-title {
      font-size: 28px;
      line-height: 1.1;
    }
    .mmspx-{{ section.id }} .mmspx-desc,
    .mmspx-{{ section.id }} .mmspx-text-block-row {
      font-size: 16px;
      line-height: 1.7;
    }
    .mmspx-{{ section.id }} .mmspx-img-stack {
      aspect-ratio: 4 / 3;
    }
    .mmspx-{{ section.id }} .mmspx-btn {
      width: 100%;
      height: 50px;
      font-size: 16px;
    }
    .mmspx-{{ section.id }} .mmspx-controls {
      gap: 14px;
      margin-top: 16px;
    }
    .mmspx-{{ section.id }} .mmspx-text-blocks {
      gap: 12px;
    }
  }

  /* ── SMALL MOBILE: ≤480px ── */
  @media (max-width: 480px) {
    .mmspx-{{ section.id }} {
      padding: 24px 12px;
    }
    .mmspx-{{ section.id }} .mmspx-card {
      padding: 22px 14px;
    }
    .mmspx-{{ section.id }} .mmspx-title {
      font-size: 28px;
    }
    .mmspx-{{ section.id }} .mmspx-desc,
    .mmspx-{{ section.id }} .mmspx-text-block-row {
      font-size: 16px;
    }
    .mmspx-{{ section.id }} .mmspx-img-stack {
      aspect-ratio: 1 / 1;
    }
    .mmspx-{{ section.id }} .mmspx-controls {
      gap: 10px;
      margin-top: 12px;
    }
  }

{%- endstyle -%}

{%- assign slide_blocks = section.blocks | where: "type", "slide" -%}
{%- assign first_slide  = slide_blocks | first -%}
{%- assign img_pos_first = first_slide.settings.image_position | default: 'right' -%}

<section class="mmspx-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="mmspx-card">

    <div class="mmspx-layout{% if img_pos_first == 'left' %} img-left{% endif %}" id="mmspx-layout-{{ section.id }}">

      <!-- TEXT STACK -->
      <div class="mmspx-text-panel mmspx-text-stack" id="mmspx-texts-{{ section.id }}">
        {%- for block in slide_blocks -%}
          {%- assign slide_title = block.settings.title       | default: section.settings.title -%}
          {%- assign slide_desc  = block.settings.description | default: section.settings.description -%}
          {%- assign slide_btn   = block.settings.btn_text    | default: section.settings.btn_text -%}
          {%- assign slide_link  = block.settings.btn_link    | default: section.settings.btn_link -%}

          {%- assign has_rows = false -%}
          {%- if block.settings.row1_text != blank -%}{%- assign has_rows = true -%}{%- endif -%}
          {%- if block.settings.row2_text != blank -%}{%- assign has_rows = true -%}{%- endif -%}
          {%- if block.settings.row3_text != blank -%}{%- assign has_rows = true -%}{%- endif -%}
          {%- if block.settings.row4_text != blank -%}{%- assign has_rows = true -%}{%- endif -%}
          {%- if block.settings.row5_text != blank -%}{%- assign has_rows = true -%}{%- endif -%}

          <div class="mmspx-slide-text {% if forloop.first %}is-active{% endif %}"
               data-slide-index="{{ forloop.index0 }}"
               {{ block.shopify_attributes }}>

            {%- if slide_title != blank -%}
              <h2 class="mmspx-title">{{ slide_title }}</h2>
            {%- endif -%}

            {%- if slide_desc != blank -%}
              <p class="mmspx-desc">{{ slide_desc }}</p>
            {%- endif -%}

            {%- if has_rows -%}
              <hr class="mmspx-divider">
              <div class="mmspx-text-blocks">
                {%- if block.settings.row1_text != blank -%}
                  <p class="mmspx-text-block-row">
                    {%- if block.settings.row1_label != blank -%}<span class="mmspx-text-block-label">{{ block.settings.row1_label }}: </span>{%- endif -%}
                    {{- block.settings.row1_text -}}
                  </p>
                {%- endif -%}
                {%- if block.settings.row2_text != blank -%}
                  <p class="mmspx-text-block-row">
                    {%- if block.settings.row2_label != blank -%}<span class="mmspx-text-block-label">{{ block.settings.row2_label }}: </span>{%- endif -%}
                    {{- block.settings.row2_text -}}
                  </p>
                {%- endif -%}
                {%- if block.settings.row3_text != blank -%}
                  <p class="mmspx-text-block-row">
                    {%- if block.settings.row3_label != blank -%}<span class="mmspx-text-block-label">{{ block.settings.row3_label }}: </span>{%- endif -%}
                    {{- block.settings.row3_text -}}
                  </p>
                {%- endif -%}
                {%- if block.settings.row4_text != blank -%}
                  <p class="mmspx-text-block-row">
                    {%- if block.settings.row4_label != blank -%}<span class="mmspx-text-block-label">{{ block.settings.row4_label }}: </span>{%- endif -%}
                    {{- block.settings.row4_text -}}
                  </p>
                {%- endif -%}
                {%- if block.settings.row5_text != blank -%}
                  <p class="mmspx-text-block-row">
                    {%- if block.settings.row5_label != blank -%}<span class="mmspx-text-block-label">{{ block.settings.row5_label }}: </span>{%- endif -%}
                    {{- block.settings.row5_text -}}
                  </p>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if slide_btn != blank -%}
              <div>
                <a href="{{ slide_link | default: '#' }}" class="mmspx-btn">{{ slide_btn }}</a>
              </div>
            {%- endif -%}

          </div><!-- /.mmspx-slide-text -->
        {%- endfor -%}
      </div><!-- /.mmspx-text-panel -->

      <!-- IMAGE STACK -->
      <div class="mmspx-img-panel mmspx-img-stack" id="mmspx-imgs-{{ section.id }}">
        {%- for block in slide_blocks -%}
          {%- assign slide_title = block.settings.title | default: section.settings.title -%}
          <div class="mmspx-slide-img {% if forloop.first %}is-active{% endif %}"
               data-slide-index="{{ forloop.index0 }}">
            <div class="mmspx-image-wrapper">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 1440 }}"
                  alt="{{ block.settings.image.alt | default: slide_title | escape }}"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  width="720" height="535">
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
          </div><!-- /.mmspx-slide-img -->
        {%- endfor -%}
      </div><!-- /.mmspx-img-panel -->

      <!-- CONTROLS — outside slides, always interactive -->
      {%- if slide_blocks.size > 1 -%}
        <div class="mmspx-controls-panel">
          <div class="mmspx-controls">

            <button class="mmspx-arrow-btn" id="mmspx-prev-{{ section.id }}" aria-label="Previous slide">
              {%- if section.settings.arrow_prev_image != blank -%}
                <img class="mmspx-arrow-img" src="{{ section.settings.arrow_prev_image | image_url: width: 80 }}" alt="Previous" width="{{ section.settings.arrow_icon_size }}" height="{{ section.settings.arrow_icon_size }}" loading="lazy">
              {%- else -%}
                <svg class="mmspx-arrow-svg" viewBox="0 0 22 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M10 2L3 8L10 14"/><path d="M19 2L12 8L19 14"/>
                </svg>
              {%- endif -%}
            </button>

            <div class="mmspx-dot-strip" id="mmspx-dots-{{ section.id }}">
              {%- for block in slide_blocks -%}
                <button class="mmspx-dot {% if forloop.first %}is-active{% endif %}" data-dot-index="{{ forloop.index0 }}" aria-label="Slide {{ forloop.index }}"></button>
              {%- endfor -%}
            </div>

            <button class="mmspx-arrow-btn" id="mmspx-next-{{ section.id }}" aria-label="Next slide">
              {%- if section.settings.arrow_next_image != blank -%}
                <img class="mmspx-arrow-img" src="{{ section.settings.arrow_next_image | image_url: width: 80 }}" alt="Next" width="{{ section.settings.arrow_icon_size }}" height="{{ section.settings.arrow_icon_size }}" loading="lazy">
              {%- else -%}
                <svg class="mmspx-arrow-svg" viewBox="0 0 22 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2L19 8L12 14"/><path d="M3 2L10 8L3 14"/>
                </svg>
              {%- endif -%}
            </button>



          </div>
        </div>
      {%- endif -%}

    </div><!-- /.mmspx-layout -->
  </div><!-- /.mmspx-card -->
</section>

<script>
(function () {
  'use strict';

  function initMmspx(sid) {
    var textEls = Array.prototype.slice.call(document.querySelectorAll('#mmspx-texts-' + sid + ' .mmspx-slide-text'));
    var imgEls  = Array.prototype.slice.call(document.querySelectorAll('#mmspx-imgs-'  + sid + ' .mmspx-slide-img'));
    var total   = textEls.length;
    if (total < 2) return;

    var dotsEl = document.getElementById('mmspx-dots-' + sid);
    var dots   = dotsEl ? Array.prototype.slice.call(dotsEl.querySelectorAll('.mmspx-dot')) : [];
    var cur    = 0;
    var locked = false;
    var FADE_MS = 550; /* must match CSS transition: opacity 0.55s */

    /* ── Clean crossfade — zero transform, zero bounce ── */
    function goTo(i) {
      if (locked) return;
      var next = (i % total + total) % total;
      if (next === cur) return;
      locked = true;

      var prevIdx = cur;

      /* 1. Mark outgoing as "leaving": stays visible (absolute) and fades out */
      textEls[prevIdx].classList.add('is-leaving');
      imgEls[prevIdx].classList.add('is-leaving');
      textEls[prevIdx].classList.remove('is-active');
      imgEls[prevIdx].classList.remove('is-active');
      if (dots[prevIdx]) dots[prevIdx].classList.remove('is-active');

      /* 2. On next paint, activate incoming — it fades in cleanly */
      requestAnimationFrame(function () {
        textEls[next].classList.add('is-active');
        imgEls[next].classList.add('is-active');
        if (dots[next]) dots[next].classList.add('is-active');
        cur = next;
      });

      /* 3. After fade completes, fully hide outgoing */
      setTimeout(function () {
        textEls[prevIdx].classList.remove('is-leaving');
        imgEls[prevIdx].classList.remove('is-leaving');
        locked = false;
      }, FADE_MS);
    }

    /* ── Arrow / dot controls ── */
    var prevBtn = document.getElementById('mmspx-prev-' + sid);
    var nextBtn = document.getElementById('mmspx-next-' + sid);
    if (prevBtn) prevBtn.addEventListener('click', function () { goTo(cur - 1); resetTimer(); });
    if (nextBtn) nextBtn.addEventListener('click', function () { goTo(cur + 1); resetTimer(); });
    dots.forEach(function (d) {
      d.addEventListener('click', function () { goTo(+d.getAttribute('data-dot-index')); resetTimer(); });
    });

    /* ── Touch / swipe ── */
    var imgPanel = document.getElementById('mmspx-imgs-' + sid);
    var tx = 0;
    if (imgPanel) {
      imgPanel.addEventListener('touchstart', function (e) { tx = e.changedTouches[0].clientX; }, { passive: true });
      imgPanel.addEventListener('touchend', function (e) {
        var dx = e.changedTouches[0].clientX - tx;
        if (Math.abs(dx) > 40) { goTo(dx < 0 ? cur + 1 : cur - 1); resetTimer(); }
      }, { passive: true });
    }

    /* ── Keyboard ── */
    document.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowLeft')  { goTo(cur - 1); resetTimer(); }
      if (e.key === 'ArrowRight') { goTo(cur + 1); resetTimer(); }
    });

    /* ── Autoplay (no pause button — just pauses on hover) ── */
    var autoplayEnabled = {{ section.settings.autoplay_enabled | json }};
    var autoplayDelay   = {{ section.settings.autoplay_delay | times: 1000 }};
    var timer = null;

    function startTimer() {
      if (!autoplayEnabled) return;
      stopTimer();
      timer = setInterval(function () { goTo(cur + 1); }, autoplayDelay);
    }
    function stopTimer() {
      if (timer) { clearInterval(timer); timer = null; }
    }
    function resetTimer() {
      if (autoplayEnabled) startTimer();
    }

    /* Pause on hover */
    var card = document.querySelector('[data-section-id="{{ section.id }}"] .mmspx-card');
    if (card && autoplayEnabled) {
      card.addEventListener('mouseenter', stopTimer);
      card.addEventListener('mouseleave', startTimer);
    }

    /* Pause when tab hidden */
    document.addEventListener('visibilitychange', function () {
      if (document.hidden) stopTimer(); else if (autoplayEnabled) startTimer();
    });

    if (autoplayEnabled) startTimer();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () { initMmspx('{{ section.id }}'); });
  } else {
    initMmspx('{{ section.id }}');
  }
})();
</script>

