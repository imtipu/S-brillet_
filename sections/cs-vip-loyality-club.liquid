/* =========================================================
   RESPONSIVE STABILITY + BOTTOM CARD GLOW
   Targeted overrides only; existing markup and JS stay intact.
========================================================= */
.vip-loyalty-app,
.vip-loyalty-app *,
.vip-loyalty-app *::before,
.vip-loyalty-app *::after {
  box-sizing: border-box;
}

.vip-loyalty-app img,
.vip-loyalty-app svg {
  max-width: 100%;
}

.vip-loyalty-app a,
.vip-loyalty-app p,
.vip-loyalty-app h1,
.vip-loyalty-app h2,
.vip-loyalty-app h3,
.vip-loyalty-app span {
  overflow-wrap: anywhere;
}

.content-grid > *,
.earn-points-inner > *,
.flex-between > *,
.flex-align-center,
.points-box-container,
.tier-inner-container,
.rewards-grid > *,
.vip-bottom-copy-row > *,
.vip-bottom-actions > *,
.vip-benefits-grid > * {
  min-width: 0;
}

/* Animated image overlay and soft glow for the five bottom cards */
.vip-benefit-card {
  isolation: isolate;
  animation: vip-benefit-card-glow 4.8s ease-in-out infinite;
}

.vip-benefit-card img,
.vip-benefit-placeholder {
  position: relative;
  z-index: 0;
}

.vip-benefit-card::after {
  z-index: 1;
  background:
    linear-gradient(180deg, rgba(12, 5, 23, 0.02) 12%, rgba(25, 10, 42, 0.2) 56%, rgba(8, 3, 17, 0.9) 100%);
}

.vip-benefit-card::before {
  content: "";
  position: absolute;
  z-index: 2;
  top: -55%;
  bottom: -55%;
  left: -90%;
  width: 58%;
  pointer-events: none;
  opacity: 0;
  transform: rotate(13deg) translate3d(0, 0, 0);
  background: linear-gradient(
    90deg,
    rgba(255, 255, 255, 0) 0%,
    rgba(255, 255, 255, 0.08) 28%,
    rgba(244, 222, 255, 0.48) 50%,
    rgba(255, 255, 255, 0.1) 72%,
    rgba(255, 255, 255, 0) 100%
  );
  filter: blur(8px);
  mix-blend-mode: screen;
  animation: vip-benefit-overlay-sweep 4.8s ease-in-out infinite;
}

.vip-benefit-card:nth-child(2),
.vip-benefit-card:nth-child(2)::before { animation-delay: .35s; }
.vip-benefit-card:nth-child(3),
.vip-benefit-card:nth-child(3)::before { animation-delay: .7s; }
.vip-benefit-card:nth-child(4),
.vip-benefit-card:nth-child(4)::before { animation-delay: 1.05s; }
.vip-benefit-card:nth-child(5),
.vip-benefit-card:nth-child(5)::before { animation-delay: 1.4s; }

.vip-benefit-caption {
  z-index: 3;
  max-width: calc(100% - 20px);
}

@keyframes vip-benefit-overlay-sweep {
  0%, 14% {
    left: -90%;
    opacity: 0;
  }
  28% {
    opacity: .78;
  }
  58% {
    left: 138%;
    opacity: .34;
  }
  72%, 100% {
    left: 138%;
    opacity: 0;
  }
}

@keyframes vip-benefit-card-glow {
  0%, 100% {
    border-color: rgba(255,255,255,.2);
    box-shadow: 0 10px 30px rgba(6,2,15,.14), 0 0 0 rgba(221,184,255,0);
  }
  50% {
    border-color: rgba(239,218,255,.58);
    box-shadow: 0 12px 34px rgba(6,2,15,.2), 0 0 24px rgba(207,166,238,.2);
  }
}

