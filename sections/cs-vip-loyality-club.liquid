/* =========================================================
   PRESERVE THE TRUE INITIAL SPEND-CARD HEIGHT
   Capture the layout BEFORE autoplay can reach Ultra Galaxy.
   offsetHeight is intentional: unlike getBoundingClientRect(), it is not
   distorted by the desktop `zoom` used for the 1920px composition canvas.
========================================================= */
function preserveInitialSpendCardHeight() {
  var lockedState = document.getElementById("spend-points-locked-container-" + SID);
  var spendCard = lockedState ? lockedState.closest(".glass-card-spend") : null;
  if (!spendCard || spendCard.dataset.vipInitialHeightLocked === "true") return;

  /* Measure the original first-frame layout, not the later slider state. */
  spendCard.classList.remove("vip-preserve-initial-height");
  spendCard.style.removeProperty("--vip-spend-initial-height");

  var initialHeight = spendCard.offsetHeight;
  if (!initialHeight) return;

  spendCard.style.setProperty("--vip-spend-initial-height", initialHeight + "px");
  spendCard.classList.add("vip-preserve-initial-height");
  spendCard.dataset.vipInitialHeightLocked = "true";
}

preserveInitialSpendCardHeight();

if (AUTOPLAY_ENABLED) {
tick(progress);
}
  // Stable responsive zoom: only the real viewport width may change scale.
  // Internal autoplay/content height changes are intentionally ignored so the
  // page can never zoom in/out or visually jump during tier progression.
  var appWrapper = document.getElementById("vip-loyalty-app-{{ section.id }}");
  function applyStableVipZoom() {
    if (!appWrapper) return;
    var width = window.innerWidth || document.documentElement.clientWidth || 1920;
    if (width >= 1025 && width < 1920) {
      appWrapper.style.setProperty("--vip-zoom", (width / 1920).toFixed(4));
    } else {
      appWrapper.style.removeProperty("--vip-zoom");
    }
  }
  applyStableVipZoom();
  window.addEventListener("resize", applyStableVipZoom, { passive: true });

  // Keep the four animated Earn Sparkle Points tier panels at one natural
  // maximum height. Their typography/design is untouched; this only prevents
  // the active relative panel from changing the document height between tiers.
  function stabilizeVipTierPanelHeight() {
    var panels = [
      document.getElementById("tier-section-s-brillet-" + SID),
      document.getElementById("tier-section-shiny-" + SID),
      document.getElementById("tier-section-starlight-" + SID),
      document.getElementById("tier-section-galaxy-" + SID)
    ].filter(Boolean);
    if (!panels.length) return;
    var host = panels[0].parentElement;
    if (!host) return;
    var maxHeight = 0;
    panels.forEach(function(panel) {
      maxHeight = Math.max(maxHeight, panel.scrollHeight || 0);
    });
    if (maxHeight > 0) host.style.minHeight = maxHeight + "px";
  }
  stabilizeVipTierPanelHeight();
  requestAnimationFrame(stabilizeVipTierPanelHeight);
  if (document.fonts && document.fonts.ready) {
    document.fonts.ready.then(stabilizeVipTierPanelHeight);
  }
  window.addEventListener("resize", stabilizeVipTierPanelHeight, { passive: true });
})();

