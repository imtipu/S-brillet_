/* =========================================================
   MEETING ICON CONTROLS — SHARP IMAGE/SVG OUTPUT
   Uploaded files replace only the requested icon; existing
   layout, sizing, animation and responsive design stay intact.
========================================================= */
.vip-meeting-icon,
.vip-meeting-icon-slot img,
.vip-meeting-icon-slot svg {
  display: block !important;
  width: 100% !important;
  height: 100% !important;
  max-width: 100% !important;
  max-height: 100% !important;
  object-fit: contain !important;
  object-position: center !important;
  opacity: 1 !important;
  filter: none !important;
  -webkit-filter: none !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
  transform: none !important;
  image-rendering: auto;
}
.vip-meeting-icon-slot {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  line-height: 0;
}
.vip-tier-meeting-slot { width: 32px; height: 32px; }
