/* =========================================================
   FINAL RESPONSIVE BOTTOM UNIVERSE
   Keeps the upper mobile/tablet area white, while restoring
   the desktop-style galaxy benefits area, tree and tagline.
========================================================= */

.vip-bottom-tagline-wrap {
  position: absolute;
  z-index: 7;
  left: 790px;
  right: 100px;
  bottom: 8px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.vip-bottom-tagline-wrap .vip-bottom-tagline {
  position: static !important;
  inset: auto !important;
  width: 100%;
  margin: 0;
  padding: 0;
  text-align: center;
}

.vip-bottom-ellipse {
  display: block;
  width: min(var(--vip-bottom-ellipse-width, 1070px), 100%);
  max-width: 100%;
  height: auto;
  margin: -2px auto 0;
  object-fit: contain;
  opacity: .96;
  pointer-events: none;
}

.vip-bottom-tagline-wrap.is-heartbeat {
  transform-origin: 50% 50%;
  animation: vip-tagline-heartbeat var(--vip-tree-heartbeat-speed, 3.2s) ease-in-out infinite;
}

@keyframes vip-tagline-heartbeat {
  0%, 100% {
    transform: scale(1);
    filter: drop-shadow(0 0 0 rgba(255,255,255,0));
  }
  12% {
    transform: scale(1.012);
    filter: drop-shadow(0 0 9px rgba(255,255,255,.18));
  }
  24% {
    transform: scale(1);
    filter: drop-shadow(0 0 2px rgba(255,255,255,.08));
  }
  36% {
    transform: scale(1.008);
    filter: drop-shadow(0 0 7px rgba(255,255,255,.14));
  }
  52%, 88% {
    transform: scale(1);
    filter: drop-shadow(0 0 0 rgba(255,255,255,0));
  }
}

/* Restore the root heartbeat that an older override disabled. */
.vip-tree-root-image.is-heartbeat {
  animation: vip-tree-heartbeat var(--vip-tree-heartbeat-speed, 3.2s) ease-in-out infinite !important;
  transform-origin: 50% 30% !important;
  will-change: transform, filter !important;
}

