<div class="vip-benefits-content">
<h2 class="vip-benefits-heading">{{ section.settings.bottom_heading | escape }}</h2>
{% assign vip_benefit_blocks = section.blocks | where: 'type', 'benefit' %}
{% assign vip_benefit_count = vip_benefit_blocks.size %}
{% if vip_benefit_count == 0 %}
  {% assign vip_benefit_count = 4 %}
{% endif %}
{% assign vip_benefit_remainder = vip_benefit_count | modulo: 2 %}
<div class="vip-benefits-grid{% if vip_benefit_remainder == 1 %} has-odd-benefits{% endif %}" data-benefit-count="{{ vip_benefit_count }}">
{% if vip_benefit_blocks.size > 0 %}
  {% for block in vip_benefit_blocks %}
    {% assign benefit_collection = block.settings.benefit_collection %}
    {% assign benefit_card_link = block.settings.benefit_link %}
    {% if benefit_card_link == blank and benefit_collection != blank %}
      {% assign benefit_card_link = benefit_collection.url %}
    {% endif %}

    {% assign benefit_card_image = block.settings.benefit_image %}
    {% if benefit_card_image == blank and benefit_collection != blank %}
      {% assign benefit_card_image = benefit_collection.featured_image %}
    {% endif %}

    {% assign benefit_card_title = block.settings.benefit_title %}
    {% if benefit_card_title == blank and benefit_collection != blank %}
      {% assign benefit_card_title = benefit_collection.title %}
    {% endif %}

    <article class="vip-benefit-card" {{ block.shopify_attributes }}>
      {% if benefit_card_link != blank %}
        <a class="vip-benefit-card-link" href="{{ benefit_card_link }}" aria-label="{{ benefit_card_title | strip_html | escape }}">
      {% endif %}

      {% if benefit_card_image %}
        <img
          src="{{ benefit_card_image | image_url: width: 700 }}"
          alt="{{ benefit_card_title | strip_html | escape }}"
          width="{{ benefit_card_image.width }}"
          height="{{ benefit_card_image.height }}"
          loading="lazy"
        >
      {% else %}
        <div class="vip-benefit-placeholder" aria-hidden="true"></div>
      {% endif %}

      <div class="vip-benefit-caption">{{ benefit_card_title | escape | newline_to_br }}</div>

      {% if benefit_card_link != blank %}
        </a>
      {% endif %}
    </article>
  {% endfor %}
{% else %}
  {%- comment -%}
    Backward-compatible fallback: preserves the current live section until
    Bottom benefit blocks are added in the theme editor.
  {%- endcomment -%}
  {% assign legacy_benefit_numbers = '1,2,4,5' | split: ',' %}
  {% for benefit_number in legacy_benefit_numbers %}
    {% capture legacy_image_key %}benefit_{{ benefit_number }}_image{% endcapture %}
    {% capture legacy_title_key %}benefit_{{ benefit_number }}_title{% endcapture %}
    {% assign legacy_image = section.settings[legacy_image_key] %}
    {% assign legacy_title = section.settings[legacy_title_key] %}
    <article class="vip-benefit-card">
      {% if legacy_image %}
        <img
          src="{{ legacy_image | image_url: width: 700 }}"
          alt="{{ legacy_title | escape }}"
          width="{{ legacy_image.width }}"
          height="{{ legacy_image.height }}"
          loading="lazy"
        >
      {% else %}
        <div class="vip-benefit-placeholder" aria-hidden="true"></div>
      {% endif %}
      <div class="vip-benefit-caption">{{ legacy_title | escape | newline_to_br }}</div>
    </article>
  {% endfor %}
{% endif %}
</div>
