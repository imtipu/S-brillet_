  .vip-bottom-copy-text,
  .vip-bottom-faq-label,
  .vip-bottom-faq-link {
    color: #2c2c2c !important;
    text-shadow: none !important;
  }

  .vip-benefit-caption {
    color: #ffffff !important;
  }

  .vip-bottom-button {
    color: #2c2c2c !important;
