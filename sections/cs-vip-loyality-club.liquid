/* =========================================================
   FINAL LOWER-SECTION + NO-JUMP FIX — 2026-08-08
   IMPORTANT:
   - Upper dashboard styling is left intact.
   - Only layout stability is added so autoplay/state changes cannot
     resize the page and push the lower universe up/down.
   - The root/crystal layer is blended as one transformed layer so the
     opaque black pixels around the six stones disappear against the
     Figma galaxy artwork.
   - Mobile lower benefits remain white and the handwritten tagline /
     ellipse stay removed as requested.
========================================================= */

/* ----- STATE HEIGHT STABILITY: no visual redesign ----- */
/* The active Spend state swaps between these two nodes. Giving both the
   same box height prevents the section from changing height at the exact
   moment Ultra Galaxy activates the slider. */
.spend-slider-container,
.spend-locked-container {
  height: 76px !important;
  min-height: 76px !important;
  max-height: 76px !important;
  box-sizing: border-box !important;
}

/* Do not animate dimensions on the locked state. */
.spend-locked-container {
  transition: filter 1s ease-in-out, opacity 1s ease-in-out !important;
}

@media (max-width: 767px) {
  .spend-slider-container,
  .spend-locked-container {
    height: 72px !important;
    min-height: 72px !important;
    max-height: 72px !important;
  }
}

/* =========================================================
   INITIAL-POSITION NO-JUMP CORRECTION — 2026-08-14
   Keep the Spend card at the exact height it has on the FIRST frame.
   The locked state is allowed to use its original/natural height again;
   when Ultra Galaxy swaps to the taller 76px progress slider, the parent
   card stays locked to that first-frame height, so the lower universe
   never moves and the page never jumps.
========================================================= */
.spend-locked-container {
  height: auto !important;
  min-height: 0 !important;
  max-height: none !important;
}

.glass-card-spend.vip-preserve-initial-height {
  height: var(--vip-spend-initial-height) !important;
  min-height: var(--vip-spend-initial-height) !important;
  max-height: var(--vip-spend-initial-height) !important;
}

/* Keep both visual states centered inside the preserved first-frame box. */
.glass-card-spend.vip-preserve-initial-height > .spend-slider-container,
.glass-card-spend.vip-preserve-initial-height > .spend-locked-container {
  flex: 0 0 auto !important;
}

@media (max-width: 767px) {
  .spend-locked-container {
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
  }
}

/* ----- DESKTOP ROOT / CRYSTAL BACKGROUND CLEANUP ----- */
/* vip-tree-root-media itself is transformed and therefore forms the
   useful compositing layer. Blending the wrapper (not only the child
   image) lets the dark/black crystal backgrounds screen into the
   existing galaxy/ground while retaining the bright stones and roots. */
@media (min-width: 768px) {
  .vip-tree-root-column {
    isolation: auto !important;
  }

  .vip-tree-root-media {
    background: transparent !important;
    mix-blend-mode: screen !important;
    isolation: auto !important;
  }

  .vip-tree-root-image {
    background: transparent !important;
    mix-blend-mode: normal !important;
  }
}

/* Mobile lower section only. The upper dashboard remains exactly as
   defined above in the original code. */
@media (max-width: 767px) {
  .vip-bottom-universe,
  .vip-bottom-inner {
    background-color: #ffffff !important;
    background-image: none !important;
    color: #2c2c2c !important;
