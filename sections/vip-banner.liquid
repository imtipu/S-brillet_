{% comment %} {% comment %}
  VIP Banner with fading gradients, floating sparkles, 
  and highly responsive text that prevents overflow on laptops/tablets.
{% endcomment %}

{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Libre+Caslon+Text:wght@400&display=swap');

  /* 1. Main Container */
  .vip-banner-{{ section.id }} {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden; 
    background: {{ section.settings.gradient_1 }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: 20px;
    padding-right: 20px;
    width: 100%;
    box-sizing: border-box; /* Ensures padding doesn't push the width out */
  }

  /* 2. Secondary Overlay */
  .vip-banner__overlay-{{ section.id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: {{ section.settings.gradient_2 }};
    z-index: 1;
    animation: fadeGradient {{ section.settings.fade_time }}s ease-in-out infinite alternate;
  }

  /* 3. Sparkle Image Overlay */
  {%- if section.settings.bg_image != blank -%}
  .vip-banner__sparkles-{{ section.id }} {
    position: absolute;
    top: -15%;
    left: -15%;
    width: 130%;
    height: 130%;
    background-image: url('{{ section.settings.bg_image | image_url: width: 2500 }}');
    background-size: cover;
    background-position: center;
    z-index: 2;
    mix-blend-mode: screen; 
    opacity: {{ section.settings.image_opacity | divided_by: 100.0 }};
    animation: complexSparkleMove-{{ section.id }} {{ section.settings.anim_duration }}s ease-in-out infinite;
  }

  @keyframes complexSparkleMove-{{ section.id }} {
    0% { transform: scale(1) translate(0px, 0px); }
    30% { transform: scale({{ section.settings.zoom_out }}) translate({{ section.settings.pan_distance }}px, 10px); }
    60% { transform: scale({{ section.settings.zoom_in }}) translate(-{{ section.settings.pan_distance }}px, -10px); }
    85% { transform: scale(1.02) translate(10px, 5px); }
    100% { transform: scale(1) translate(0px, 0px); }
  }
  {%- endif -%}

  /* 4. Base Text Styling (Desktop 1441px and above) */
  .vip-banner__text-{{ section.id }} {
    font-family: var(--font-heading-family, 'Libre Caslon Text', serif);
    font-weight: 400;
    line-height: 1.23;
    text-transform: uppercase;
    text-align: center;
    color: {{ section.settings.text_color }};
    text-shadow: 0px 0px {{ section.settings.shadow_blur }}px {{ section.settings.shadow_color }};
    margin: 0;
    position: relative;
    z-index: 3;
    white-space: nowrap; /* Forces ONE line always */
    font-size: {{ section.settings.font_size }}px;
    max-width: 100%; /* Prevents text from pushing past the screen edges */
  }

  @keyframes fadeGradient {
    0% { opacity: 0; }
    100% { opacity: 1; }
  }

  /* --- DEVICE RESPONSIVENESS (Fixes the cut-off text issue) --- */

  /* Laptop & Small Desktop (1025px to 1440px) */
  @media screen and (max-width: 1440px) {
    .vip-banner__text-{{ section.id }} {
      /* Uses 4.5% of the screen width, but never larger than the desktop setting */
      font-size: clamp(36px, 4.5vw, {{ section.settings.font_size }}px);
    }
  }

  /* Tablet & iPad (769px to 1024px) */
  @media screen and (max-width: 1024px) {
    .vip-banner__text-{{ section.id }} {
      /* Smoothly shrinks down for tablet screens */
      font-size: clamp(24px, 4.2vw, 46px);
    }
  }

  /* Mobile Devices (768px and below) */
  @media screen and (max-width: 768px) {
    .vip-banner-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      padding-left: 10px;
      padding-right: 10px;
    }
    .vip-banner__text-{{ section.id }} {
      /* Very small phones will use 4.5vw to ensure it stays on one line */
      font-size: clamp(12px, 4.5vw, {{ section.settings.font_size_mobile }}px);
    }
  }
{%- endstyle -%}

<div class="vip-banner-{{ section.id }}">
  <div class="vip-banner__overlay-{{ section.id }}"></div>
  
  {%- if section.settings.bg_image != blank -%}
    <div class="vip-banner__sparkles-{{ section.id }}"></div>
  {%- endif -%}

  <h2 class="vip-banner__text-{{ section.id }}">
    {{ section.settings.banner_text }}
  </h2>
</div>

