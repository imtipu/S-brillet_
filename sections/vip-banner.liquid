{% comment %}
  VIP Banner with fading gradients, floating sparkles, 
  and bulletproof auto-shrinking typography to prevent any overflow.
{% endcomment %}

{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Libre+Caslon+Text:wght@400&display=swap');

  /* 1. Main Container */
  .vip-banner-{{ section.id }} {
    position: relative;
    display: flex;
