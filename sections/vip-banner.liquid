  }

  @keyframes complexSparkleMove-{{ section.id }} {
    0% { transform: scale(1) translate(0px, 0px); }
    30% { transform: scale({{ section.settings.zoom_out }}) translate({{ section.settings.pan_distance }}px, 10px); }
    60% { transform: scale({{ section.settings.zoom_in }}) translate(-{{ section.settings.pan_distance }}px, -10px); }
    85% { transform: scale(1.02) translate(10px, 5px); }
    100% { transform: scale(1) translate(0px, 0px); }
  }
  {%- endif -%}

  /* 4. Base Text Styling & Bulletproof Auto-Shrink */
  .vip-banner__text-{{ section.id }} {
    font-family: var(--font-heading-family, 'Libre Caslon Text', serif);
    font-weight: 400;
    line-height: 1.23;
    text-transform: uppercase;
    text-align: center;
    color: {{ section.settings.text_color }};
    text-shadow: 0px 0px {{ section.settings.shadow_blur }}px {{ section.settings.shadow_color }};
    margin: 0;
    position: relative;
    z-index: 3;
    
    /* Forces ONE line always */
    white-space: nowrap; 
    
    /* THE SAFEGUARD: 
      It tries to use your Desktop Font Size setting. 
      BUT if the screen is too narrow, it forces the text to be 3.8vw 
      (3.8% of the screen width) so it never touches the edges.
    */
    font-size: min({{ section.settings.font_size }}px, 3.8vw); 
  }

  @keyframes fadeGradient {
    0% { opacity: 0; }
    100% { opacity: 1; }
  }

  /* --- DEVICE RESPONSIVENESS (With Safeguards) --- */

  /* Tablet & Small Laptop (1199px and below) */
  @media screen and (max-width: 1199px) {
    .vip-banner__text-{{ section.id }} {
      /* Uses tablet setting, but never allows it to grow larger than 4vw */
      font-size: min({{ section.settings.font_size_tablet }}px, 4vw);
    }
  }

  /* Mobile Devices (768px and below) */
  @media screen and (max-width: 768px) {
    .vip-banner-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
    .vip-banner__text-{{ section.id }} {
      /* Uses mobile setting, but never allows it to grow larger than 4.2vw */
      font-size: min({{ section.settings.font_size_mobile }}px, 4vw);
    }
  }
{%- endstyle -%}

<div class="vip-banner-{{ section.id }}">
  <div class="vip-banner__overlay-{{ section.id }}"></div>
  
  {%- if section.settings.bg_image != blank -%}
    <div class="vip-banner__sparkles-{{ section.id }}"></div>
