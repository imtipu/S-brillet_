    background: {{ section.settings.gradient_1 }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    
    /* This creates the guaranteed empty space (faka) on the left and right */
    padding-left: 5%; 
    padding-right: 5%;
    
    width: 100%;
    box-sizing: border-box;
  }

  /* 2. Secondary Overlay (Fade Effect) */
  .vip-banner__overlay-{{ section.id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: {{ section.settings.gradient_2 }};
