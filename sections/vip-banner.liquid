  /* 3. Sparkle Image Overlay (Floating Animation) */
  {%- if section.settings.bg_image != blank -%}
  .vip-banner__sparkles-{{ section.id }} {
    position: absolute;
    top: -15%;
    left: -15%;
    width: 130%;
