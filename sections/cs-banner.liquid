{% schema %}
{
  "name": "CS Banner",
  "settings": [
    {
      "type": "select",
      "id": "container",
      "label": "Section Width",
      "options": [
        { "value": "m-container-fluid", "label": "Full Width" },
        { "value": "m-container", "label": "Boxed (Theme Width)" }
      ],
      "default": "m-container-fluid"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop Image (1920x1080)"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Banner Title"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Sub Text",
      "default": "Add your description here"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Now"
    }
  ],
  "presets": [
    {
      "name": "CS Banner"
    }
  ]
}
{% endschema %}

<style>
.custom-banner {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
}

.custom-banner img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.custom-banner__content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  color: #fff;
  padding: 20px;
  max-width: 800px;
}

.custom-banner__heading {
  font-size: 48px;
  margin-bottom: 10px;
}

.custom-banner__subtext {
  font-size: 18px;
  margin-bottom: 20px;
}

.custom-banner__btn {
  display: inline-block;
  padding: 12px 30px;
  background: #fff;
  color: #000;
  text-decoration: none;
  font-weight: 600;
  border-radius: 4px;
}

/* Mobile */
@media (max-width: 768px) {
  .custom-banner {
    height: 70vh;
  }

  .custom-banner__heading {
    font-size: 28px;
  }

  .custom-banner__subtext {
    font-size: 14px;
  }
}
</style>

<div class="{{ section.settings.container }}">
  <div class="custom-banner">

    {% if section.settings.mobile_image != blank %}
      <picture>
        <source media="(max-width: 768px)" srcset="{{ section.settings.mobile_image | image_url }}">
        <img src="{{ section.settings.desktop_image | image_url }}" alt="Banner Image" loading="lazy">
      </picture>
    {% else %}
      <img src="{{ section.settings.desktop_image | image_url }}" alt="Banner Image" loading="lazy">
    {% endif %}

    <div class="custom-banner__content">
      {% if section.settings.heading != blank %}
        <h2 class="custom-banner__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.subtext != blank %}
        <p class="custom-banner__subtext">{{ section.settings.subtext }}</p>
      {% endif %}

      {% if section.settings.button_label != blank and section.settings.button_link != blank %}
        <a href="{{ section.settings.button_link }}" class="custom-banner__btn">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>

  </div>
</div>