{% comment %} {%- style -%}
  /* ==================================================================
     Sourced From Around The World - Pixel Perfect Section
     ================================================================== */
  .sourced-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px; /* Figma: 80px */
    padding-bottom: {{ section.settings.padding_bottom }}px; /* Figma: 80px */
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    box-sizing: border-box;
    overflow: hidden;
  }

  /* --- HEADER AREA --- */
  .sourced-header-{{ section.id }} {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding: 0 20px;
    margin-bottom: {{ section.settings.gap_after_header }}px; /* Space between text and map */
  }

  .sourced-heading-{{ section.id }} {
    margin: 0;
    font-family: var(--font-heading-family, serif);
    font-size: {{ section.settings.heading_size }}px; /* Figma: 64px */
    font-weight: 400;
    line-height: 1.23; /* Figma: 123% */
    color: {{ section.settings.text_color }};
    text-transform: uppercase;
    max-width: 1307px; /* Figma matched */
  }

  .sourced-subtext-{{ section.id }} {
    margin: 0;
    font-family: var(--font-body-family, sans-serif);
    font-size: {{ section.settings.subtext_size }}px; /* Figma: 20px */
    font-weight: 400;
    line-height: 1.5; /* Figma: 30px (150%) */
    color: {{ section.settings.text_color }};
    max-width: 1148px; /* Figma matched */
  }

  /* --- MAP IMAGE AREA --- */
  .sourced-map-{{ section.id }} {
    width: 100%;
    max-width: {{ section.settings.map_max_width }}px; /* Figma: 1440px */
    padding: 0 20px;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    margin-bottom: {{ section.settings.gap_after_map }}px; /* Space between map and lists */
  }

  .sourced-map-{{ section.id }} img {
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
  }

  /* --- COLUMNS AREA (CSS COLUMNS FOR PERFECT FLOW) --- */
  .sourced-list-container-{{ section.id }} {
    width: 100%;
    max-width: {{ section.settings.list_max_width }}px; /* Figma: 1680px */
    padding: 0 20px;
    box-sizing: border-box;
  }

  .sourced-columns-{{ section.id }} {
    column-count: {{ section.settings.column_count }};
    column-gap: {{ section.settings.column_gap }}px; /* Figma: 120px */
    column-rule: 2px solid {{ section.settings.text_color }}; /* Figma: 2px Divider */
    width: 100%;
  }

  /* Individual Location Item */
  .sourced-item-{{ section.id }} {
    display: flex;
    align-items: flex-start;
    gap: 8px; /* Space between bullet and text */
    margin-bottom: {{ section.settings.item_gap }}px; /* Figma: 40px gap between rows */
    break-inside: avoid; /* Prevents item from splitting across columns */
    page-break-inside: avoid;
    color: {{ section.settings.text_color }};
  }

  .sourced-item-bullet-{{ section.id }} {
    font-size: 35px;
    line-height: 1.5;
    font-weight: 500;
    margin-top: 0px; /* Align bullet perfectly with title */
  }

  .sourced-item-content-{{ section.id }} {
    display: flex;
    flex-direction: column;
    font-family: var(--font-body-family, sans-serif);
    font-size: {{ section.settings.subtext_size }}px; /* Figma: 20px */
    line-height: 1.5; /* Figma: 30px */
  }

  .sourced-item-title-{{ section.id }} {
    font-weight: 500; /* Figma: Medium */
    margin: 0;
  }

  .sourced-item-desc-{{ section.id }} {
    font-weight: 400; /* Figma: Regular */
    margin: 0;
  }

  /* --- RESPONSIVE ADJUSTMENTS --- */
  @media screen and (max-width: 1024px) {
    .sourced-heading-{{ section.id }} {
      font-size: calc({{ section.settings.heading_size }}px * 0.75);
    }
    .sourced-columns-{{ section.id }} {
      column-count: 2; /* 2 Columns on Tablet */
      column-gap: 60px;
    }
  }

  @media screen and (max-width: 768px) {
    .sourced-heading-{{ section.id }} {
      font-size: calc({{ section.settings.heading_size }}px * 0.55);
    }
    .sourced-subtext-{{ section.id }},
    .sourced-item-content-{{ section.id }} {
      font-size: 16px; /* Smaller text for mobile */
    }
    .sourced-columns-{{ section.id }} {
      column-count: 1; /* 1 Column on Mobile */
      column-rule: none; /* Hide divider lines on mobile */
    }
    .sourced-item-{{ section.id }} {
      margin-bottom: 25px;
    }
  }
{%- endstyle -%}

<div class="sourced-section-{{ section.id }}">
  
  <!-- Heading & Subtext -->
  <div class="sourced-header-{{ section.id }}">
    {%- if section.settings.heading != blank -%}
      <h2 class="sourced-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subtext != blank -%}
      <p class="sourced-subtext-{{ section.id }}">{{ section.settings.subtext }}</p>
    {%- endif -%}
  </div>

  <!-- Map Image -->
  <div class="sourced-map-{{ section.id }}">
    {%- if section.settings.map_image != blank -%}
      {{ section.settings.map_image | image_url: width: 1440 | image_tag: loading: 'lazy', alt: 'Crystal Map Locations' }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>

  <!-- 3-Column List Grid -->
  <div class="sourced-list-container-{{ section.id }}">
    <div class="sourced-columns-{{ section.id }}">
      
      {%- for block in section.blocks -%}
        <div class="sourced-item-{{ section.id }}" {{ block.shopify_attributes }}>
          <div class="sourced-item-bullet-{{ section.id }}">&bull;</div>
          <div class="sourced-item-content-{{ section.id }}">
            {%- if block.settings.crystal_name != blank -%}
              <span class="sourced-item-title-{{ section.id }}">{{ block.settings.crystal_name }}</span>
            {%- endif -%}
            
            {%- if block.settings.region != blank or block.settings.mine != blank -%}
              <span class="sourced-item-desc-{{ section.id }}">
                {{ block.settings.region }}
                {%- if block.settings.region != blank and block.settings.mine != blank -%}<br>{%- endif -%}
                {{ block.settings.mine }}
              </span>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}

    </div>
  </div>

</div>

