{%- style -%}
  /* ==================================================================
     Sourced From Around The World - Pixel Perfect Section
     ================================================================== */
  .sourced-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px; 
    padding-bottom: {{ section.settings.padding_bottom }}px; 
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    box-sizing: border-box;
    overflow: hidden;
  }

  /* --- HEADER AREA --- */
  .sourced-header-{{ section.id }} {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding-left: 20px;
    padding-right: 20px;
    margin-bottom: {{ section.settings.gap_after_header }}px; 
  }

  .sourced-heading-{{ section.id }} {
    margin: 0;
    font-family: var(--font-heading-family, serif);
    font-size: {{ section.settings.heading_size }}px; 
    font-weight: 400;
    line-height: 1.23; 
    color: {{ section.settings.text_color }};
    text-transform: uppercase;
    max-width: 1307px; 
  }

  .sourced-subtext-{{ section.id }} {
    margin: 0;
    font-family: var(--font-body-family, sans-serif);
    font-size: {{ section.settings.subtext_size }}px; 
    font-weight: 400;
    line-height: 1.5; 
    color: {{ section.settings.text_color }};
    max-width: 1148px; 
  }

  /* --- MAP IMAGE AREA --- */
  .sourced-map-{{ section.id }} {
    width: 100%;
    max-width: {{ section.settings.map_max_width }}px; 
    padding-left: 20px;
    padding-right: 20px;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    margin-bottom: {{ section.settings.gap_after_map }}px; 
  }

  .sourced-map-{{ section.id }} img {
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
  }

  /* --- COLUMNS AREA (CSS COLUMNS FOR PERFECT FLOW) --- */
  .sourced-list-container-{{ section.id }} {
    width: 100%;
    max-width: {{ section.settings.list_max_width }}px; 
    padding-left: 20px;
    padding-right: 20px;
    box-sizing: border-box;
  }

  .sourced-columns-{{ section.id }} {
    column-count: {{ section.settings.column_count }};
    column-gap: {{ section.settings.column_gap }}px; 
    column-rule: 2px solid {{ section.settings.text_color }}; 
    width: 100%;
  }

  /* Wrapper to prevent Shopify Editor crash (Layout Thrashing fix) */
  .sourced-item-wrapper-{{ section.id }} {
    display: inline-block;
    width: 100%;
    break-inside: avoid; 
    page-break-inside: avoid;
    margin-bottom: {{ section.settings.item_gap }}px; 
  }

  /* Individual Location Item */
  .sourced-item-{{ section.id }} {
    display: flex;
    align-items: flex-start;
    gap: 8px; 
    color: {{ section.settings.text_color }};
  }

  .sourced-item-bullet-{{ section.id }} {
    font-size: 35px;
    line-height: 1.5;
    font-weight: 500;
    margin-top: 0px; 
  }

  .sourced-item-content-{{ section.id }} {
    display: flex;
    flex-direction: column;
    font-family: var(--font-body-family, sans-serif);
    font-size: {{ section.settings.subtext_size }}px; 
    line-height: 1.5; 
  }

  .sourced-item-title-{{ section.id }} {
    font-weight: 500; 
    margin: 0;
  }

  .sourced-item-desc-{{ section.id }} {
    font-weight: 400; 
    margin: 0;
  }

  /* ==================================================================
     RESPONSIVE ADJUSTMENTS (Macbook, Tablet, Mobile)
     ================================================================== */
     

     /* ─── MacBook Air 15 inch M2 (1441px - 1728px) ───────────────── */
@media screen and (min-width: 1441px) and (max-width: 1728px) {
  .sourced-heading-{{ section.id }} {
    font-size: 54px !important;
  }
  .sourced-subtext-{{ section.id }},
  .sourced-item-content-{{ section.id }} {
    font-size: 18px;
  }
  .sourced-item-bullet-{{ section.id }} {
    font-size: 28px;
  }
  .sourced-header-{{ section.id }},
  .sourced-map-{{ section.id }},
  .sourced-list-container-{{ section.id }} {
    padding-left: 120px;
    padding-right: 120px;
  }
  .sourced-columns-{{ section.id }} {
    column-gap: 100px;
  }
}

  /* Laptop & Macbook (up to 1440px) */
  @media screen and (max-width: 1440px) {
    .sourced-heading-{{ section.id }} {
      font-size: 46px !important; /* Forced 46px for Macbook */
    }
    .sourced-subtext-{{ section.id }},
    .sourced-item-content-{{ section.id }} {
      font-size: 16px; /* Updated text to 16px for Macbook */
    }
    .sourced-item-bullet-{{ section.id }} {
      font-size: 24px; /* Scaled down bullet to match 16px text */
    }
    .sourced-header-{{ section.id }},
    .sourced-map-{{ section.id }},
    .sourced-list-container-{{ section.id }} {
      padding-left: 120px; /* 120px padding left/right as requested */
      padding-right: 120px;
    }
    .sourced-columns-{{ section.id }} {
      column-gap: 80px; /* Scaled down gap proportionally */
    }
  }

  /* Tablets (up to 1024px) */
  @media screen and (max-width: 1024px) {
    .sourced-heading-{{ section.id }} {
      font-size: 38px !important;
    }
    .sourced-header-{{ section.id }},
    .sourced-map-{{ section.id }},
    .sourced-list-container-{{ section.id }} {
      padding-left: 40px;
      padding-right: 40px;
    }
    .sourced-columns-{{ section.id }} {
      column-count: 2; /* 2 Columns on Tablet */
      column-gap: 40px;
    }
  }

  /* Mobile (up to 768px) */
  @media screen and (max-width: 768px) {
    .sourced-heading-{{ section.id }} {
      font-size: 28px !important; /* Forced 28px for Mobile */
    }
    .sourced-subtext-{{ section.id }},
    .sourced-item-content-{{ section.id }} {
      font-size: 14px; /* Reduced text size slightly to fit 2 columns perfectly */
    }
    .sourced-item-bullet-{{ section.id }} {
      font-size: 20px; /* Scaled down bullet point */
    }
    .sourced-header-{{ section.id }},
    .sourced-map-{{ section.id }},
    .sourced-list-container-{{ section.id }} {
      padding-left: 15px;
      padding-right: 15px;
    }
    .sourced-columns-{{ section.id }} {
      column-count: 2; /* Changed to 2 Columns on Mobile */
      column-gap: 20px; /* Added appropriate gap for mobile */
      column-rule: none; /* Hide divider lines on mobile */
    }
    .sourced-item-wrapper-{{ section.id }} {
      margin-bottom: 20px; /* Updated to target the wrapper */
    }
  }
{%- endstyle -%}

