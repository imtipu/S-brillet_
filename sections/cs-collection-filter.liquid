{% schema %}
{
  "name": "CS Collection Filter",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "header",
      "content": "Section Heading"
    },
    {
      "type": "text",
      "id": "section_heading",
      "label": "Heading",
      "default": "Our Collection"
    },
    {
      "type": "textarea",
      "id": "section_description",
      "label": "Description",
      "default": "Description"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "default": "left",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right" }
      ]
    },
    {
      "type": "header",
      "content": "Filter Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show Vendor Filter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Show Tags Filter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_gem",
      "label": "Show Gem Filter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_material",
      "label": "Show Material Filter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_category",
      "label": "Show Category Filter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_size",
      "label": "Show Size Filter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show Price Filter",
      "default": true
    },
    {
      "type": "header",
      "content": "Filter Group Icon"
    },
    {
      "type": "select",
      "id": "toggle_icon",
      "label": "Icon Style (used when no custom image set)",
      "default": "arrow",
      "options": [
        { "value": "arrow",   "label": "Arrow ▾" },
        { "value": "chevron", "label": "Chevron ›" },
        { "value": "plus",    "label": "Plus +" },
        { "value": "dash",    "label": "Dash −" }
      ]
    },
    {
      "type": "image_picker",
      "id": "icon_open_img",
      "label": "Custom Icon — Group Open (expanded state)"
    },
    {
      "type": "image_picker",
      "id": "icon_closed_img",
      "label": "Custom Icon — Group Closed (collapsed state)"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Custom Icon Size (px)",
      "min": 10,
      "max": 40,
      "step": 1,
      "default": 18
    },
    {
      "type": "header",
      "content": "Pagination Icons"
    },
    {
      "type": "image_picker",
      "id": "prev_icon_img",
      "label": "Previous Page Icon"
    },
    {
      "type": "image_picker",
      "id": "next_icon_img",
      "label": "Next Page Icon"
    },
    {
      "type": "range",
      "id": "pagination_icon_size",
      "label": "Pagination Icon Size (px)",
      "min": 10,
      "max": 40,
      "step": 1,
      "default": 18
    },
    {
      "type": "header",
      "content": "Filter Close Icon"
    },
    {
      "type": "image_picker",
      "id": "close_icon_img",
      "label": "Custom Close Icon (replaces ✕)"
    },
    {
      "type": "range",
      "id": "close_icon_size",
      "label": "Close Icon Size (px)",
      "min": 10,
      "max": 40,
      "step": 1,
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "CS Collection Filter"
    }
  ]
}
{% endschema %}

{% assign collection = section.settings.collection %}
{% assign toggle_icon = section.settings.toggle_icon %}
{% case toggle_icon %}
  {% when 'chevron' %}{% assign icon_open_char = '›' %}{% assign icon_closed_char = '›' %}
  {% when 'plus' %}{% assign icon_open_char = '−' %}{% assign icon_closed_char = '+' %}
  {% when 'dash' %}{% assign icon_open_char = '−' %}{% assign icon_closed_char = '−' %}
  {% else %}{% assign icon_open_char = '▾' %}{% assign icon_closed_char = '▾' %}
{% endcase %}
{% assign icon_open_img = section.settings.icon_open_img %}
{% assign icon_closed_img = section.settings.icon_closed_img %}
{% assign icon_size = section.settings.icon_size %}
{% assign prev_icon_img = section.settings.prev_icon_img %}
{% assign next_icon_img = section.settings.next_icon_img %}
{% assign pagination_icon_size = section.settings.pagination_icon_size %}
{% assign close_icon_img = section.settings.close_icon_img %}
{% assign close_icon_size = section.settings.close_icon_size %}
{% assign text_alignment = section.settings.text_alignment | default: 'left' %}

<!-- OVERLAY: placed OUTSIDE .layout so clicking it never collapses the grid -->
<div class="filter-overlay" id="filterOverlay"></div>

<section class="custom-collection cs-icon-{{ section.settings.toggle_icon }}">
  <div class="page-width">

    <!-- SECTION HEADING & DESCRIPTION -->
    {% if section.settings.section_heading != blank or section.settings.section_description != blank %}
    <div class="section-intro" style="text-align:{{ text_alignment }};">
      {% if section.settings.section_heading != blank %}
        <h1 class="section-heading">{{ section.settings.section_heading }}</h1>
      {% endif %}
      {% if section.settings.section_description != blank %}
        <p class="section-description" style="margin-{{ text_alignment }}: {% if text_alignment == 'center' %}auto{% else %}0{% endif %}; margin-{% if text_alignment == 'left' %}right{% elsif text_alignment == 'right' %}left{% else %}right{% endif %}: {% if text_alignment == 'center' %}auto{% else %}0{% endif %};">{{ section.settings.section_description }}</p>
      {% endif %}
    </div>
    {% endif %}

    <!-- TOOLBAR -->
    <div class="toolbar">
      <button id="toggleFilter" aria-label="Toggle Filters">&#9776; FILTERS</button>
      <select id="sortProducts">
        <option value="">SORT</option>
        <option value="title-asc">A TO Z</option>
        <option value="title-desc">Z TO A</option>
        <option value="price-asc">PRICE LOW TO HIGH</option>
        <option value="price-desc">PRICE HIGH TO LOW</option>
        <option value="date-desc">NEWEST</option>
      </select>
    </div>

    <div class="layout" id="mainLayout">

      <!-- FILTER SIDEBAR -->
      <div class="filters" id="filterSidebar">

        <div class="filter-header">
          <h4>Filter</h4>
          <button class="filter-close" id="closeFilter" aria-label="Close Filters">
            {%- if close_icon_img -%}
              <img src="{{ close_icon_img | image_url: width: 40 }}" alt="Close" style="width:{{ close_icon_size }}px;height:{{ close_icon_size }}px;object-fit:contain;display:block;">
            {%- else -%}
              &#10005;
            {%- endif -%}
          </button>
        </div>

        <!-- VENDOR -->
        {% if section.settings.show_vendor %}
        <div class="filter-group">
          <div class="filter-group-header" data-target="body-vendor">
            <h5>Vendor</h5>
            <span class="toggle-icon cs-toggle-icon"
              data-open-char="{{ icon_open_char }}"
              data-closed-char="{{ icon_closed_char }}"
              {% if icon_open_img %}data-open-img="{{ icon_open_img | image_url: width: 40 }}"{% endif %}
              {% if icon_closed_img %}data-closed-img="{{ icon_closed_img | image_url: width: 40 }}"{% endif %}>
              {%- if icon_open_img -%}
                <img src="{{ icon_open_img | image_url: width: 40 }}" alt="" class="cs-icon-img" style="width:{{ icon_size }}px;height:{{ icon_size }}px;object-fit:contain;display:block;">
              {%- else -%}
                {{- icon_open_char -}}
              {%- endif -%}
            </span>
          </div>
          <div class="filter-group-body" id="body-vendor">
            {% assign vendors = collection.products | map: 'vendor' | uniq %}
            {% for vendor in vendors %}
              <label class="filter-right">
                <span>{{ vendor }}</span>
                <input type="checkbox" class="filter-vendor" value="{{ vendor }}">
              </label>
            {% endfor %}
          </div>
        </div>
        {% endif %}

        <!-- TAGS -->
        {% if section.settings.show_tags %}
        <div class="filter-group">
          <div class="filter-group-header" data-target="body-tags">
            <h5>Tags</h5>
            <span class="toggle-icon cs-toggle-icon"
              data-open-char="{{ icon_open_char }}"
              data-closed-char="{{ icon_closed_char }}"
              {% if icon_open_img %}data-open-img="{{ icon_open_img | image_url: width: 40 }}"{% endif %}
              {% if icon_closed_img %}data-closed-img="{{ icon_closed_img | image_url: width: 40 }}"{% endif %}>
              {%- if icon_open_img -%}
                <img src="{{ icon_open_img | image_url: width: 40 }}" alt="" class="cs-icon-img" style="width:{{ icon_size }}px;height:{{ icon_size }}px;object-fit:contain;display:block;">
              {%- else -%}
                {{- icon_open_char -}}
              {%- endif -%}
            </span>
          </div>
          <div class="filter-group-body" id="body-tags">
            {% assign used_tags = '' %}
            {% for product in collection.products %}
              {% for tag in product.tags %}
                {% unless used_tags contains tag %}
                  {% assign used_tags = used_tags | append: tag | append: '||' %}
                  <label class="filter-right">
                    <span>{{ tag }}</span>
                    <input type="checkbox" class="filter-tag" value="{{ tag }}">
                  </label>
                {% endunless %}
              {% endfor %}
            {% endfor %}
          </div>
        </div>
        {% endif %}

        <!-- GEMSTONES (MEANINGS) -->
        {% if section.settings.show_gem %}
        <div class="filter-group">
          <div class="filter-group-header" data-target="body-gem">
            <h5>GEMSTONES (MEANINGS)</h5>
            <span class="toggle-icon cs-toggle-icon"
              data-open-char="{{ icon_open_char }}"
              data-closed-char="{{ icon_closed_char }}"
              {% if icon_open_img %}data-open-img="{{ icon_open_img | image_url: width: 40 }}"{% endif %}
              {% if icon_closed_img %}data-closed-img="{{ icon_closed_img | image_url: width: 40 }}"{% endif %}>
              {%- if icon_open_img -%}
                <img src="{{ icon_open_img | image_url: width: 40 }}" alt="" class="cs-icon-img" style="width:{{ icon_size }}px;height:{{ icon_size }}px;object-fit:contain;display:block;">
              {%- else -%}
                {{- icon_open_char -}}
              {%- endif -%}
            </span>
          </div>
          <div class="filter-group-body" id="body-gem">
            {% assign used_gems = '' %}
            {% for product in collection.products %}
              {% assign gem = product.metafields.custom.filter_gem_title %}
              {% unless gem == blank or used_gems contains gem %}
                {% assign used_gems = used_gems | append: gem | append: '||' %}
                <label class="filter-right">
                  <span class="filter-item">
                    <img src="{{ product.metafields.custom.filter_gem_image | image_url: width: 40 }}" alt="{{ gem }}">
                    <span>{{ gem }}</span>
                  </span>
                  <input type="checkbox" class="filter-gem" value="{{ gem }}">
                </label>
              {% endunless %}
            {% endfor %}
          </div>
        </div>
        {% endif %}

        <!-- MATERIAL -->
        {% if section.settings.show_material %}
        <div class="filter-group">
          <div class="filter-group-header" data-target="body-material">
            <h5>MATERIAL</h5>
            <span class="toggle-icon cs-toggle-icon"
              data-open-char="{{ icon_open_char }}"
              data-closed-char="{{ icon_closed_char }}"
              {% if icon_open_img %}data-open-img="{{ icon_open_img | image_url: width: 40 }}"{% endif %}
              {% if icon_closed_img %}data-closed-img="{{ icon_closed_img | image_url: width: 40 }}"{% endif %}>
              {%- if icon_open_img -%}
                <img src="{{ icon_open_img | image_url: width: 40 }}" alt="" class="cs-icon-img" style="width:{{ icon_size }}px;height:{{ icon_size }}px;object-fit:contain;display:block;">
              {%- else -%}
                {{- icon_open_char -}}
              {%- endif -%}
            </span>
          </div>
          <div class="filter-group-body" id="body-material">
            {% assign used_materials = '' %}
            {% for product in collection.products %}
              {% assign material = product.metafields.custom.filter_meterial_title %}
              {% unless material == blank or used_materials contains material %}
                {% assign used_materials = used_materials | append: material | append: '||' %}
                <label class="filter-right">
                  <span class="filter-item">
                    <img src="{{ product.metafields.custom.filter_meterial_img | image_url: width: 40 }}" alt="{{ material }}">
                    <span>{{ material }}</span>
                  </span>
                  <input type="checkbox" class="filter-material" value="{{ material }}">
                </label>
              {% endunless %}
            {% endfor %}
          </div>
        </div>
        {% endif %}

        <!-- CATEGORY -->
        {% if section.settings.show_category %}
        <div class="filter-group">
          <div class="filter-group-header" data-target="body-category">
            <h5>CATEGORY</h5>
            <span class="toggle-icon cs-toggle-icon"
              data-open-char="{{ icon_open_char }}"
              data-closed-char="{{ icon_closed_char }}"
              {% if icon_open_img %}data-open-img="{{ icon_open_img | image_url: width: 40 }}"{% endif %}
              {% if icon_closed_img %}data-closed-img="{{ icon_closed_img | image_url: width: 40 }}"{% endif %}>
              {%- if icon_open_img -%}
                <img src="{{ icon_open_img | image_url: width: 40 }}" alt="" class="cs-icon-img" style="width:{{ icon_size }}px;height:{{ icon_size }}px;object-fit:contain;display:block;">
              {%- else -%}
                {{- icon_open_char -}}
              {%- endif -%}
            </span>
          </div>
          <div class="filter-group-body" id="body-category">
            {% assign used_categories = '' %}
            {% for product in collection.products %}
              {% assign category = product.metafields.custom.filter_category_title %}
              {% unless category == blank or used_categories contains category %}
                {% assign used_categories = used_categories | append: category | append: '||' %}
                <label class="filter-right">
                  <span class="filter-item">
                    <img src="{{ product.metafields.custom.filter_category_img | image_url: width: 40 }}" alt="{{ category }}">
                    <span>{{ category }}</span>
                  </span>
                  <input type="checkbox" class="filter-category" value="{{ category }}">
                </label>
              {% endunless %}
            {% endfor %}
          </div>
        </div>
        {% endif %}

        <!-- SIZE (from metaobject) — placed BEFORE price -->
        {% if section.settings.show_size %}
        <div class="filter-group">
          <div class="filter-group-header" data-target="body-size">
            <h5>SIZE</h5>
            <span class="toggle-icon cs-toggle-icon"
              data-open-char="{{ icon_open_char }}"
              data-closed-char="{{ icon_closed_char }}"
              {% if icon_open_img %}data-open-img="{{ icon_open_img | image_url: width: 40 }}"{% endif %}
              {% if icon_closed_img %}data-closed-img="{{ icon_closed_img | image_url: width: 40 }}"{% endif %}>
              {%- if icon_open_img -%}
                <img src="{{ icon_open_img | image_url: width: 40 }}" alt="" class="cs-icon-img" style="width:{{ icon_size }}px;height:{{ icon_size }}px;object-fit:contain;display:block;">
              {%- else -%}
                {{- icon_open_char -}}
              {%- endif -%}
            </span>
          </div>
          <div class="filter-group-body" id="body-size">
            {% assign used_sizes = '' %}
            {% for product in collection.products %}
              {% assign size_val = product.metafields.custom.filter_size %}
              {% unless size_val == blank or used_sizes contains size_val %}
                {% assign used_sizes = used_sizes | append: size_val | append: '||' %}
                <label class="filter-right">
                  <span>{{ size_val }}</span>
                  <input type="checkbox" class="filter-size" value="{{ size_val }}">
                </label>
              {% endunless %}
            {% endfor %}
          </div>
        </div>
        {% endif %}

        <!-- PRICE -->
        {% if section.settings.show_price %}
        <div class="filter-group">
          <div class="filter-group-header" data-target="body-price">
            <h5>PRICE</h5>
            <span class="toggle-icon cs-toggle-icon"
              data-open-char="{{ icon_open_char }}"
              data-closed-char="{{ icon_closed_char }}"
              {% if icon_open_img %}data-open-img="{{ icon_open_img | image_url: width: 40 }}"{% endif %}
              {% if icon_closed_img %}data-closed-img="{{ icon_closed_img | image_url: width: 40 }}"{% endif %}>
              {%- if icon_open_img -%}
                <img src="{{ icon_open_img | image_url: width: 40 }}" alt="" class="cs-icon-img" style="width:{{ icon_size }}px;height:{{ icon_size }}px;object-fit:contain;display:block;">
              {%- else -%}
                {{- icon_open_char -}}
              {%- endif -%}
            </span>
          </div>
          <div class="filter-group-body" id="body-price">
            <!-- Dual-handle price range styled like reference image -->
            <div class="price-range-widget">
              <div class="price-range-track-wrap">
                <div class="price-range-track" id="priceTrack">
                  <div class="price-range-fill" id="priceFill"></div>
                  <input type="range" id="priceMin" min="0" max="1000" value="0" class="price-thumb price-thumb-min" aria-label="Minimum price">
                  <input type="range" id="priceMax" min="0" max="1000" value="1000" class="price-thumb price-thumb-max" aria-label="Maximum price">
                </div>
              </div>
              <div class="price-inputs-row">
                <div class="price-input-box">
                  <span class="price-input-prefix">$</span>
                  <input type="number" id="priceMinInput" min="0" max="1000" value="0" class="price-num-input" aria-label="Min price input">
                </div>
                <div class="price-input-box">
                  <span class="price-input-prefix">$</span>
                  <input type="number" id="priceMaxInput" min="0" max="1000" value="1000" class="price-num-input" aria-label="Max price input">
                </div>
              </div>
            </div>
          </div>
        </div>
        {% endif %}

      </div>
      <!-- END FILTERS -->

      <!-- PRODUCTS -->
      <div class="products-area">

        <div class="grid" id="productGrid">
          {% paginate collection.products by 250 %}
            {% for product in collection.products %}
              <div class="product-item"
                data-vendor="{{ product.vendor }}"
                data-price="{{ product.price | divided_by: 100 }}"
                data-title="{{ product.title | downcase }}"
                data-date="{{ product.created_at }}"
                data-tags="{{ product.tags | join: '||' }}"
                data-gem="{{ product.metafields.custom.filter_gem_title }}"
                data-material="{{ product.metafields.custom.filter_meterial_title }}"
                data-category="{{ product.metafields.custom.filter_category_title }}"
                data-size="{{ product.metafields.custom.filter_size }}">
                {%- render 'product-card-1',
                  product: product,
                  section_id: section.id,
                  product_card_style: 'style-1'
                -%}
              </div>
            {% endfor %}
          {% endpaginate %}
        </div>

        <!-- PAGINATION -->
        <div class="pagination-wrapper" id="paginationWrapper" style="display:none;">
          {%- if prev_icon_img -%}
          <button class="page-btn cs-page-btn-img" id="prevPage" aria-label="Previous">
            <img src="{{ prev_icon_img | image_url: width: 40 }}" alt="Previous" style="width:{{ pagination_icon_size }}px;height:{{ pagination_icon_size }}px;object-fit:contain;display:block;">
          </button>
          {%- else -%}
          <button class="page-btn" id="prevPage" aria-label="Previous">&#8249;</button>
          {%- endif -%}
          <div class="page-numbers" id="pageNumbers"></div>
          {%- if next_icon_img -%}
          <button class="page-btn cs-page-btn-img" id="nextPage" aria-label="Next">
            <img src="{{ next_icon_img | image_url: width: 40 }}" alt="Next" style="width:{{ pagination_icon_size }}px;height:{{ pagination_icon_size }}px;object-fit:contain;display:block;">
          </button>
          {%- else -%}
          <button class="page-btn" id="nextPage" aria-label="Next">&#8250;</button>
          {%- endif -%}
        </div>

      </div>
      <!-- END PRODUCTS -->

    </div>
  </div>
</section>

<style>

@import url('https://fonts.googleapis.com/css2?family=Libre+Caslon+Text:wght@400&family=Inter:wght@400;500&display=swap');

/* ===== BASE ===== */
.custom-collection { max-width: 1920px; margin: auto; }
.page-width { max-width: 1500px; padding: 70px 20px; margin: auto; }

/* ===== SECTION INTRO ===== */
.section-intro {
  margin-bottom: 32px;
}
.section-heading {
  font-family: 'Libre Caslon Text', Georgia, serif;
  font-size: 64px;
  font-weight: 400;
  line-height: 1.1;
  margin: 0 0 16px 0;
  color: #111;
  letter-spacing: -0.5px;
}
.section-description {
  font-family: 'Inter', sans-serif;
  font-size: 20px;
  font-weight: 400;
  line-height: 1.6;
  color: #555;
  margin: 0;
 
}

/* ===== TOOLBAR ===== */
.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
  gap: 12px;
}
{% comment %} .toolbar button {
  padding: 10px 18px;
  border: 1.5px solid #222;
  background: #fff;
  border-radius: 8px;
  cursor: pointer;
  font-size: 14px;
  font-weight: 600;
  transition: background 0.2s, color 0.2s;
  white-space: nowrap;
} {% endcomment %}
.toolbar button {
    padding: 12px;
    border: 1px solid #F4F3F1;
    background: #fff;
    color: #2C2C2C;
    border-radius: 4px;
    cursor: pointer;
    font-size: 20px;
    font-weight: 400;
    transition: background 0.2s, color 0.2s;
    white-space: nowrap;
}



{% comment %} .toolbar button:hover { background: #222; color: #fff; }
.toolbar select {
  padding: 10px 14px;
  border: 1.5px solid #222;
  border-radius: 8px;
  font-size: 14px;
  cursor: pointer;
  background: #fff;
} {% endcomment %}

/* ===== LAYOUT =====
   DESKTOP: sidebar is a fixed overlay drawer (same UX as mobile).
   Product area always takes full width.
*/
.layout {
  display: block;
  position: relative;
}

/* Products always full width — sidebar overlays on top */
.products-area {
  width: 100%;
}

/* ===== FILTER SIDEBAR — DESKTOP OVERLAY DRAWER ===== */
.filters {
  position: fixed;
  top: 0;
  left: 0;
  width: 360px;
  max-width: 88vw;
  height: 100dvh;
  background: #fff;
  z-index: 999;
  padding: 24px 32px;
  box-shadow: 4px 0 24px rgba(0,0,0,0.15);
  overflow-y: auto;
  overflow-x: hidden;
  pointer-events: none;
  transform: translateX(-105%);
  transition: transform 0.35s cubic-bezier(0.4,0,0.2,1);
  box-sizing: border-box;
}
.layout.active-filter .filters {
  transform: translateX(0);
  pointer-events: auto;
}

/* ===== FILTER HEADER ===== */
.filter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
  padding: 0 4px;
  border-bottom:2px solid #F4F3F1;
  padding-bottom:20px;
}



.filter-header h4 {
    font-family: 'Inter';
    margin: 0;
    font-size: 22px;
    font-weight: 400;
}

.filter-close {
  display: flex;
  align-items: center;
  justify-content: center;
  background: none;
  border: none;
  font-size: 20px;
  cursor: pointer;
  {% comment %} padding: 4px 8px; {% endcomment %}
  border-radius: 6px;
  line-height: 1;
  transition: background 0.2s;
  
}
.filter-close:hover { background: #f0f0f0; }

/* ===== COLLAPSIBLE GROUPS ===== */
.filter-group {
  border-bottom: 1px solid #eee;
  padding: 8px 0;
}
.filter-group-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
  padding: 6px 4px;
  border-radius: 6px;
  user-select: none;
  transition: background 0.15s;
}
.filter-group-header:hover { background: #f5f5f5; }
.filter-group-header h5 { margin: 0; font-size: 18px; font-weight: 400; }
.toggle-icon {
  font-size: 13px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 20px;
  height: 20px;
  flex-shrink: 0;
  color: #666;
  transition: transform 0.25s ease;
}
.cs-icon-arrow .filter-group-header.is-collapsed .toggle-icon {
  transform: rotate(-90deg);
}
.cs-icon-chevron .filter-group-header:not(.is-collapsed) .toggle-icon {
  transform: rotate(90deg);
}
.cs-icon-chevron .filter-group-header.is-collapsed .toggle-icon {
  transform: rotate(0deg);
}
.filter-group-body {
  overflow: hidden;
  max-height: 600px;
  opacity: 1;
  padding: 24px 0px;
  transition: max-height 0.35s ease, opacity 0.25s ease, padding-top 0.25s ease;
}
.filter-group-body.is-collapsed {
  max-height: 0 !important;
  opacity: 0;
  padding-top: 0;
}

/* ===== FILTER LABELS ===== */
.filter-right {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 6px 8px;
  border-radius: 10px;
  cursor: pointer;
  transition: background 0.15s;
  gap: 8px;
}
.filter-right:hover { background: #f5f5f5; }
.filter-right > span:first-child { font-size: 16px; flex: 1; min-width: 0; }

.filter-right input[type="checkbox"] {
  appearance: none;
  -webkit-appearance: none;
  width: 18px;
  height: 18px;
  border: 2px solid #bbb;
  border-radius: 50%;
  position: relative;
  cursor: pointer;
  flex-shrink: 0;
  transition: border-color 0.2s, background 0.2s;
  margin: 0;
}
.filter-right input[type="checkbox"]:checked {
  background: #222;
  border-color: #222;
}
.filter-right input[type="checkbox"]:checked::after {
  content: "";
  width: 6px;
  height: 6px;
  background: #fff;
  border-radius: 50%;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.filter-item { display: flex; align-items: center; gap: 8px; }
.filter-item img {
  width: 26px;
  height: 26px;
  border-radius: 6px;
  object-fit: cover;
  flex-shrink: 0;
}

/* Toggle icon: image mode */
.cs-toggle-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.cs-toggle-icon .cs-icon-img {
  display: block;
  transition: transform 0.25s ease;
}
.cs-icon-arrow .filter-group-header:not(.is-collapsed) .cs-toggle-icon .cs-icon-img {
  transform: rotate(0deg);
}
.cs-icon-arrow .filter-group-header.is-collapsed .cs-toggle-icon .cs-icon-img {
  transform: rotate(-90deg);
}

/* Pagination image buttons */
.cs-page-btn-img {
  background: transparent;
  border-color: transparent;
  padding: 4px;
}
.cs-page-btn-img:hover:not(:disabled) {
  background: #f5f5f5;
  border-color: #ddd;
}
.cs-page-btn-img img {
  display: block;
  object-fit: contain;
}

/* ===== PRICE RANGE WIDGET ===== */
.price-range-widget {
  padding: 8px 4px 12px;
}
.price-range-track-wrap {
  position: relative;
  margin-bottom: 16px;
}
.price-range-track {
  position: relative;
  height: 4px;
  background: #e0e0e0;
  border-radius: 2px;
  margin: 18px 0 6px;
}
.price-range-fill {
  position: absolute;
  height: 100%;
  background: #111;
  border-radius: 2px;
  pointer-events: none;
}

/* Shared thumb styles */
.price-thumb {
  -webkit-appearance: none;
  appearance: none;
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 100%;
  height: 20px;
  background: transparent;
  pointer-events: none;
  margin: 0;
  padding: 0;
  outline: none;
  cursor: pointer;
}
.price-thumb::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: #111;
  border: none;
  pointer-events: all;
  cursor: grab;
  box-shadow: 0 1px 4px rgba(0,0,0,0.18);
  transition: transform 0.15s;
}
.price-thumb::-webkit-slider-thumb:active {
  cursor: grabbing;
  transform: scale(1.15);
}
.price-thumb::-moz-range-thumb {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: #111;
  border: none;
  pointer-events: all;
  cursor: grab;
  box-shadow: 0 1px 4px rgba(0,0,0,0.18);
}
/* Ensure max thumb is on top when crossing */
.price-thumb-min { z-index: 3; }
.price-thumb-max { z-index: 4; }

/* Price number input boxes */
.price-inputs-row {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  margin-top: 4px;
}
{% comment %} .price-input-box {
  display: flex;
  align-items: center;
  border: 1.5px solid #d0d0d0;
  border-radius: 6px;
  padding: 5px 8px;
  flex: 1;
  background: #fff;
  gap: 2px;
  transition: border-color 0.2s;
} {% endcomment %}


.price-input-box {
    display: flex;
    align-items: center;
    border: 1.5px solid #d0d0d0;
    border-radius: 6px;
    padding: 5px 8px;
    /* flex: 1; */
    background: #fff;
    gap: 2px;
    width: 60px !important;
