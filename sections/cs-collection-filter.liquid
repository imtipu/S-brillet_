}



.price-input-box:focus-within {
  border-color: #111;
}
.price-input-prefix {
  font-size: 13px;
  color: #777;
  user-select: none;
}
.price-num-input {
  border: none;
  outline: none;
  font-size: 13px;
  width: 100%;
  color: #111;
  background: transparent;
