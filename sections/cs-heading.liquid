{% style %}
.custom-heading-{{ section.id }} {
  width: 100%;
  background-color: {{ section.settings.bg_color }};
}

.custom-heading-{{ section.id }} .container {
  max-width: 1920px;
  margin: 0 auto;
}

.custom-heading-{{ section.id }} .inner {
  max-width: 1720px;
  margin: 0 auto;
  padding: 60px 120px;
}

/* Heading */
.custom-heading-{{ section.id }} h2 {
  font-size: clamp(28px, 5vw, 64px);
  color: {{ section.settings.text_color }};
  font-family: 'Libre Caslon Text', serif !important;
  text-align: center;
  margin: 0;
  line-height: 1.2;
  letter-spacing: 0.5px;
}


/* ─── MacBook Air 15 inch M2 (1441px - 1728px) ───────────────── */
@media screen and (min-width: 1441px) and (max-width: 1728px) {
  .custom-heading-{{ section.id }} h2 {
    font-size: 54px;
  }
}

  @media screen and (max-width: 1440px) {

    .custom-heading-{{ section.id }} h2 {
      font-size : 46px;
    }
  }


/* Tablet */
@media (max-width: 1024px) {
  .custom-heading-{{ section.id }} .inner {
    padding: 50px 60px;
  }
}

/* Mobile */
@media (max-width: 768px) {
 .custom-heading-{{ section.id }} h2 {
      font-size : 28px;
    }
  .custom-heading-{{ section.id }} .inner {
    padding: 40px 20px;
  }

  .custom-heading-{{ section.id }} h2 {
    line-height: 1.3;
    letter-spacing: 0.3px;
  }
}

/* Small Mobile */
@media (max-width: 480px) {
  .custom-heading-{{ section.id }} .inner {
    padding: 30px 16px;
  }
}
{% endstyle %}

<div class="custom-heading-{{ section.id }}">
  <div class="container">
    <div class="inner">
      <h2>{{ section.settings.heading }}</h2>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom Heading Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Text",
      "default": "WAYS TO HEALING FROM CRYSTALS"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#EDE7E3"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2C2C2C"
    }
  ],
  "presets": [
    {
      "name": "Custom Heading"
    }
  ]
}
{% endschema %}