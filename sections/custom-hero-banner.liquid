{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Licorice&display=swap');

  /* Main Container */
  .hero-banner-{{ section.id }} {
    width: 100%;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    height: {{ section.settings.mobile_height }}px;
  }

  /* Background Image Setup */
  .hero-banner-{{ section.id }} .hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hero-banner-{{ section.id }} .hero-bg img,
  .hero-banner-{{ section.id }} .hero-bg svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Foreground Content Overlay */
  .hero-banner-{{ section.id }} .hero-content {
    position: relative;
    z-index: 2; /* Keeps content on top of the background */
    display: flex;
    align-items: center;
    justify-content: center;
    gap: {{ section.settings.mobile_gap }}px; /* Spacing between elements */
    padding: 0 15px;
  }

  /* Typography matching Figma */
  .hero-banner-{{ section.id }} .hero-text {
    font-family: 'Licorice', cursive;
    font-size: {{ section.settings.mobile_font_size }}px;
    font-weight: 400;
    color: {{ section.settings.text_color }};
    /* Figma Drop Shadow: X:0, Y:0, Blur: 4, Color: #FFFFFF 70% */
   text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.3);
    line-height: 1.25;
    margin: 0;
  }

  /* Center Logo Image */
  .hero-banner-{{ section.id }} .hero-logo {
    width: {{ section.settings.mobile_logo_width }}px;
    height: auto;
    object-fit: contain;
    /* CSS magic to turn ANY color into solid white */
    filter: brightness(0) invert(1);
    /* Figma Blend Mode */
    mix-blend-mode: plus-lighter; 
  }

  /* Desktop Responsive Settings */
  @media screen and (min-width: 769px) {
    .hero-banner-{{ section.id }} {
      height: {{ section.settings.desktop_height }}px;
    }
    .hero-banner-{{ section.id }} .hero-content {
      gap: {{ section.settings.desktop_gap }}px;
    }
    .hero-banner-{{ section.id }} .hero-text {
      font-size: {{ section.settings.desktop_font_size }}px;
    }
    .hero-banner-{{ section.id }} .hero-logo {
      width: {{ section.settings.desktop_logo_width }}px;
    }
  }
{%- endstyle -%}

<div class="hero-banner-{{ section.id }}">
  <!-- Background Layer -->
  <div class="hero-bg">
    {%- if section.settings.bg_image != blank -%}
      {{ section.settings.bg_image | image_url: width: 2000 | image_tag: loading: 'lazy', sizes: '100vw', widths: '375, 750, 1100, 1500, 2000' }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>

  <!-- Foreground Layer -->
  <div class="hero-content">
    {%- if section.settings.text_1 != blank -%}
      <h2 class="hero-text">{{ section.settings.text_1 }}</h2>
    {%- endif -%}

    {%- if section.settings.center_logo != blank -%}
      {{ section.settings.center_logo | image_url: width: 300 | image_tag: class: 'hero-logo', loading: 'lazy' }}
    {%- endif -%}

    {%- if section.settings.text_2 != blank -%}
      <h2 class="hero-text">{{ section.settings.text_2 }}</h2>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Magical Hero Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Background Image"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "header",
      "content": "Overlay Content"
    },
    {
      "type": "text",
      "id": "text_1",
      "label": "First Text",
      "default": "Magical"
    },
    {
      "type": "image_picker",
      "id": "center_logo",
      "label": "Center Logo/Image (e.g., The 'S')"
    },
    {
      "type": "text",
      "id": "text_2",
      "label": "Second Text",
      "default": "Articles"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Desktop Settings"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "min": 200,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "label": "Banner Height",
      "default": 400
    },
    {
      "type": "range",
      "id": "desktop_font_size",
      "min": 40,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Text Font Size",
      "default": 128
    },
    {
      "type": "range",
      "id": "desktop_logo_width",
      "min": 20,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Center Logo Width",
      "default": 80
    },
    {
      "type": "range",
      "id": "desktop_gap",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Space Between Items",
      "default": 20
    },
    {
      "type": "header",
      "content": "Mobile Settings"
    },
    {
      "type": "range",
      "id": "mobile_height",
      "min": 150,
      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "Banner Height",
      "default": 250
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Text Font Size",
      "default": 64
    },
    {
      "type": "range",
      "id": "mobile_logo_width",
      "min": 20,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Center Logo Width",
      "default": 45
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Space Between Items",
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "Magical Hero Banner"
    }
  ]
}
{% endschema %}