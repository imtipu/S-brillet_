<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sectionId = '{{ section.id }}';
    const menuItems = document.querySelectorAll(`#menu-list-${sectionId} .menu-item`);
    const allMessages = Array.from(document.querySelectorAll(`#message-display-${sectionId} .card-desc`));
    const allDots = Array.from(document.querySelectorAll(`#dots-${sectionId} .dot`));
    const prevBtn = document.getElementById(`prev-${sectionId}`);
    const nextBtn = document.getElementById(`next-${sectionId}`);
    const controlsContainer = document.getElementById(`slider-controls-${sectionId}`);
    const fixedTextContainer = document.getElementById(`category-fixed-text-${sectionId}`);
    
    if (menuItems.length === 0) return;

    let currentCategory = menuItems[0].getAttribute('data-category');
    let currentIndex = 0;
    
    function updateSlider() {
      const activeMessages = allMessages.filter(msg => msg.getAttribute('data-category') === currentCategory);
      const activeDots = allDots.filter(dot => dot.getAttribute('data-category') === currentCategory);

      if (activeMessages.length <= 1) {
        controlsContainer.style.visibility = 'hidden';
      } else {
        controlsContainer.style.visibility = 'visible';
      }

      // Update Fixed Text for the Category (uses &nbsp; if empty to keep space)
      if (activeMessages.length > 0) {
        const fixedText = activeMessages[0].getAttribute('data-fixedtext');
        fixedTextContainer.innerHTML = (fixedText && fixedText.trim() !== '') ? fixedText : '&nbsp;';
      }

      allMessages.forEach(msg => msg.classList.remove('active'));
      
      allDots.forEach(dot => {
        dot.classList.remove('visible', 'active');
      });

      if (currentIndex >= activeMessages.length) currentIndex = 0;
      if (currentIndex < 0) currentIndex = activeMessages.length - 1;

      if (activeMessages.length > 0) {
        activeMessages[currentIndex].classList.add('active');
        
        activeDots.forEach((dot, index) => {
          dot.classList.add('visible'); 
          if (index === currentIndex) dot.classList.add('active'); 
        });
      }


      // --- NEW CODE: Append category to the button URL ---
      const shopBtn = document.querySelector(`.custom-message-${sectionId} .btn-outline`);
      const baseUrl = "{{ section.settings.btn_link }}";
      
      if (shopBtn && baseUrl && baseUrl.trim() !== '' && baseUrl !== '#') {
        try {
          const url = new URL(baseUrl, window.location.origin);
          url.searchParams.set('theme', currentCategory);
          shopBtn.href = url.toString();
        } catch (e) {
          console.error("Invalid URL for button link");
        }
      }
      // --- END NEW CODE ---
    }

    updateSlider();

    menuItems.forEach((item) => {
      item.addEventListener('click', (e) => {
        e.preventDefault();
        menuItems.forEach(m => m.classList.remove('active'));
        item.classList.add('active');
        currentCategory = item.getAttribute('data-category');
        currentIndex = 0;
        updateSlider();
      });
    });

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        currentIndex--;
        updateSlider();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        currentIndex++;
        updateSlider();
      });
    }

    allDots.forEach((dot) => {
      dot.addEventListener('click', (e) => {
        if (dot.getAttribute('data-category') === currentCategory) {
          const activeDots = allDots.filter(d => d.getAttribute('data-category') === currentCategory);
          currentIndex = activeDots.indexOf(dot);
          updateSlider();
        }
      });
    });
  });



// Force card-white-box to perfect square
function squareWhiteBox() {
  const whiteBox = document.querySelector('.custom-message-{{ section.id }} .card-white-box');
  const outermost = document.querySelector('.custom-message-{{ section.id }} .card-outermost');
  if (whiteBox && outermost && window.innerWidth <= 768) {
    const w = whiteBox.offsetWidth;
    whiteBox.style.height = w + 'px';
    whiteBox.style.flexShrink = '0';
    outermost.style.height = 'auto';
  }
}
squareWhiteBox();
window.addEventListener('resize', squareWhiteBox);

</script>


