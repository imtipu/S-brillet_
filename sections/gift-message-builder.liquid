

{%- style -%}
  /* =========================================================
     Transfer Your Own Message - Pixel Perfect Custom CSS
     ========================================================= */
  
  /* Loading Custom Fonts if selected */
  {%- if section.settings.title_font != blank -%}
    {{ section.settings.title_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if section.settings.desc_font != blank -%}
    {{ section.settings.desc_font | font_face: font_display: 'swap' }}
  {%- endif -%}

  .custom-message-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --title-color: {{ section.settings.title_color }};
    --text-color: {{ section.settings.text_color }};
    
    --card-outer-bg: {{ section.settings.card_outer_bg_color }};
    --card-bg: {{ section.settings.card_bg_color }};
    
    --border-grad-1: {{ section.settings.border_color_1 }};
    --border-grad-2: {{ section.settings.border_color_2 }};
    --border-grad-3: {{ section.settings.border_color_3 }};
    --border-width: {{ section.settings.card_border_width }}px;
    
    --divider-color: {{ section.settings.divider_color }};
    --active-color: {{ section.settings.active_item_color }};
    
    --btn-bg: transparent;
    --btn-text: {{ section.settings.btn_text_color }};
    --btn-border: {{ section.settings.btn_border_color }};
    --btn-hover-bg: {{ section.settings.btn_hover_bg }};
    --btn-hover-text: {{ section.settings.btn_hover_text }};

    --dot-inactive: {{ section.settings.dot_inactive_color }};
    --dot-grad-1: {{ section.settings.dot_active_grad_1 }};
    --dot-grad-2: {{ section.settings.dot_active_grad_2 }};
    --dot-grad-3: {{ section.settings.dot_active_grad_3 }};
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    width: 100%;
    display: block;
    box-sizing: border-box;
    overflow: hidden;
  }

  .custom-message-{{ section.id }} * {
    box-sizing: border-box;
  }

  .custom-message-{{ section.id }} .message-container {
    max-width: 1920px;
    margin: 0 auto;
    padding-left: {{ section.settings.padding_sides }}px;
    padding-right: {{ section.settings.padding_sides }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: {{ section.settings.layout_gap }}px; 
  }

  /* --- LEFT COLUMN: MENU & TEXT --- */
  .custom-message-{{ section.id }} .message-left {
    flex: 1;
    max-width: 720px;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .custom-message-{{ section.id }} .left-title {
    font-family: {% if section.settings.title_font != blank %}{{ section.settings.title_font.family }}, {{ section.settings.title_font.fallback_families }}{% else %}var(--font-heading-family, 'Libre Caslon Text', serif){% endif %};
    font-size: {{ section.settings.title_size }}px;
    font-weight: 400;
    line-height: 1.2;
    color: var(--title-color);
    margin: 0 0 20px 0;
    text-transform: uppercase;
    max-width: 680px;
  }

  .custom-message-{{ section.id }} .left-desc {
    font-family: {% if section.settings.desc_font != blank %}{{ section.settings.desc_font.family }}, {{ section.settings.desc_font.fallback_families }}{% else %}var(--font-body-family, sans-serif){% endif %};
    font-size: {{ section.settings.desc_size }}px;
    font-weight: 400;
    line-height: 30px;
    color: var(--text-color);
    margin: 0 0 25px 0;
    max-width: 572px;
  }

  .custom-message-{{ section.id }} .left-divider {
    border: none;
    border-top: 2px solid var(--divider-color);
    margin: 0 0 25px 0;
    width: 100%;
    max-width: 720px;
  }

  .custom-message-{{ section.id }} .menu-list {
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin-bottom: 50px;
    width: 100%;
    max-width: 342px;
  }

  .custom-message-{{ section.id }} .menu-item {
    font-family: {% if section.settings.desc_font != blank %}{{ section.settings.desc_font.family }}, {{ section.settings.desc_font.fallback_families }}{% else %}var(--font-body-family, sans-serif){% endif %};
    font-size: 18px;
    font-weight: 500;
    line-height: 37.5px;
    color: var(--text-color);
    text-decoration: none;
    cursor: pointer;
    transition: opacity 0.2s ease, color 0.2s ease;
    width: fit-content;
  }

  .custom-message-{{ section.id }} .menu-item:hover {
    opacity: 0.7;
  }

  .custom-message-{{ section.id }} .menu-item.active {
    color: var(--active-color);
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-thickness: 1.5px;
  }

  /* --- BUTTON STYLING --- */
  .custom-message-{{ section.id }} .btn-container {
    display: flex;
  }
  .custom-message-{{ section.id }} .btn-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 280px;
    height: 55px;
    background-color: var(--btn-bg);
    color: var(--btn-text);
    border: 1px solid var(--btn-border);
    font-family: var(--font-body-family, 'Inter', sans-serif);
    font-size: 16px;
    font-weight: 400;
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all 0.3s ease;
    box-sizing: border-box;
    position: relative;
    z-index: 1;
  }

  .custom-message-{{ section.id }} .btn-outline .btn-text {
    display: inline-block;
    transition: all 0.3s ease;
  }

  .custom-message-{{ section.id }} .btn-outline:hover {
    background-color: transparent;
    border: 1px solid transparent;
    border-image: linear-gradient(135deg, var(--border-grad-1), var(--border-grad-2), var(--border-grad-3)) 1;
  }

  .custom-message-{{ section.id }} .btn-outline:hover .btn-text {
    background: linear-gradient(135deg, var(--border-grad-1), var(--border-grad-2), var(--border-grad-3));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* --- RIGHT COLUMN: THE CARD --- */
  .custom-message-{{ section.id }} .message-right {
    flex: 1;
    max-width: 840px; 
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 0;
  }

  /* Layer 1: Outermost Background Box */
  .custom-message-{{ section.id }} .card-outermost {
    width: 100%;
    max-width: 840px;
    aspect-ratio: 1 / 1;
    background-color: var(--card-outer-bg);
    padding: 35px 60px 40px 60px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column; 
    align-items: center;
    justify-content: center;
    box-shadow: inset 0 0 10px 5px rgba(44, 44, 44, 0.05);
  }

  /* Layer 2: Inner White Box */
  .custom-message-{{ section.id }} .card-white-box {
    width: 100%;
    flex: 1; 
    min-height: 0;
    background-color: var(--card-bg); 
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px; 
    box-sizing: border-box;
  }

  /* Layer 3: Pixel Perfect Gradient Border Inner Box */
  .custom-message-{{ section.id }} .card-inner {
    width: 100%;
    max-width: 640px; 
    height: 100%;
    max-height: 100%;
    aspect-ratio: 1 / 1; 
    border: var(--border-width) solid;
    margin: 0 auto;
    
    border-image: linear-gradient(
      225deg,
      rgba(148, 120, 99, 1),
      rgba(233, 221, 212, 1),
      rgba(148, 120, 99, 1)
    ) 1;
    
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20px; 
    box-sizing: border-box;
    text-align: center;
  }

  /* --- DUAL ICON SETUP --- */
  .custom-message-{{ section.id }} .card-icon-container {
    position: relative;
    width: 220px; 
    height: 220px; 
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .custom-message-{{ section.id }} .card-icon-shape {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .custom-message-{{ section.id }} .card-icon-logo {
    position: relative;
    z-index: 2;
    width: 55%; 
    height: auto; 
    object-fit: contain;
  }

  /* Right Card Title */
  .custom-message-{{ section.id }} .card-title {
    font-family: {% if section.settings.title_font != blank %}{{ section.settings.title_font.family }}, {{ section.settings.title_font.fallback_families }}{% else %}var(--font-heading-family, 'Libre Caslon Text', serif){% endif %};
    font-size: 64px; 
    font-weight: 400;
    line-height: 1; 
    color: var(--title-color);
    margin: 0 0 16px 0;
    text-transform: uppercase;
    width: 100%;
    max-width: 544px;
    flex-shrink: 0;
  }

  /* Card Inner Divider */
  .custom-message-{{ section.id }} .card-divider {
    width: 360px; 
    max-width: 100%;
    height: 2px; 
    min-height: 2px; 
    background-color: {{ section.settings.card_divider_color | default: '#BFAB9C' }};
    margin: 0 0 20px 0;
    border: none;
    flex-shrink: 0; 
  }

  /* Right Card Dynamic Sliding Description */
  .custom-message-{{ section.id }} .card-desc-container {
    width: 100%;
    max-width: 544px;
    height: 80px; 
    display: grid;
    align-items: center;
    justify-items: center;
  }

  .custom-message-{{ section.id }} .card-desc {
    grid-area: 1 / 1; 
    font-family: {% if section.settings.desc_font != blank %}{{ section.settings.desc_font.family }}, {{ section.settings.desc_font.fallback_families }}{% else %}var(--font-body-family, sans-serif){% endif %};
    font-size: 20px; 
    font-weight: 300; 
    line-height: 1.4; 
    color: var(--text-color);
    margin: 0;
    width: 100%;
    text-align: center;
    
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.5s ease-in-out, visibility 0.5s ease-in-out;
  }

  .custom-message-{{ section.id }} .card-desc.active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    z-index: 2;
  }

  /* Fixed Custom Text */
  .custom-message-{{ section.id }} .category-fixed-text {
    font-family: {% if section.settings.desc_font != blank %}{{ section.settings.desc_font.family }}, {{ section.settings.desc_font.fallback_families }}{% else %}var(--font-body-family, sans-serif){% endif %};
    font-size: 20px; 
    font-weight: 300; 
    color: var(--text-color);
    margin: 10px 0 0 0;
    width: 100%;
    max-width: 544px;
    min-height: 30px; 
    text-align: center;
  }

  /* --- SLIDER CONTROLS --- */
  .custom-message-{{ section.id }} .slider-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 25px; 
    margin-top: 25px; 
    width: 100%;
    height: 24px;
    flex-shrink: 0; 
  }

  .custom-message-{{ section.id }} .slider-arrow {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-color);
    opacity: 0.6;
    transition: opacity 0.2s;
  }

  .custom-message-{{ section.id }} .slider-arrow:hover {
    opacity: 1;
  }

  .custom-message-{{ section.id }} .slider-arrow svg,
  .custom-message-{{ section.id }} .slider-arrow img {
    width: 24px; 
    height: 20px; 
    object-fit: contain;
  }

  .custom-message-{{ section.id }} .slider-dots {
    display: flex;
    gap: 20px; 
    align-items: center;
  }

  .custom-message-{{ section.id }} .dot {
    width: 10px; 
    height: 10px; 
    border-radius: 50%;
    background-color: var(--dot-inactive);
    transition: background 0.3s ease, transform 0.2s ease;
    cursor: pointer;
    display: none; 
  }

  .custom-message-{{ section.id }} .dot.visible {
    display: inline-block;
  }

  .custom-message-{{ section.id }} .dot.active,
  .custom-message-{{ section.id }} .dot:hover {
    background: linear-gradient(135deg, var(--dot-grad-1), var(--dot-grad-2), var(--dot-grad-3));
  }

  /* =========================================================
     RESPONSIVE DESIGN (Pixel Perfect Scaling for MacBook & Mobile)
     ========================================================= */
  
  /* MacBook & Smaller Desktops (1025px - 1440px) */



  /* ─── MacBook 13 inch (1440px) ───────────────────────────────── */
@media (min-width: 1025px) and (max-width: 1440px) {
  .custom-message-{{ section.id }} .message-container { gap: 50px; }
  .custom-message-{{ section.id }} .message-left,
  .custom-message-{{ section.id }} .message-right { max-width: 50%; }

  .custom-message-{{ section.id }} .left-title { font-size: 46px; margin-bottom: 15px; }
  .custom-message-{{ section.id }} .left-desc { font-size: 16px; margin-bottom: 25px; line-height: 26px; }
  .custom-message-{{ section.id }} .left-divider { margin-bottom: 25px; }
  .custom-message-{{ section.id }} .menu-list { margin-bottom: 30px; gap: 12px; }
  .custom-message-{{ section.id }} .menu-item { font-size: 16px; line-height: 28px; }
  .custom-message-{{ section.id }} .btn-outline { width: 240px; height: 50px; font-size: 14px; }

  .custom-message-{{ section.id }} .card-outermost { padding: 30px 45px; max-width: 540px; aspect-ratio: 1 / 1; min-height: unset; height: auto; margin: 0 auto; }
  .custom-message-{{ section.id }} .card-white-box { padding: 20px; width: 100%; height: 100%; min-height: 0; }
  .custom-message-{{ section.id }} .card-inner { padding: 20px; aspect-ratio: 1 / 1; height: 100%; width: 100%; justify-content: center; overflow: hidden; }
  .custom-message-{{ section.id }} .card-icon-container { width: 130px; height: 130px; margin-bottom: 15px; }
  .custom-message-{{ section.id }} .card-title { font-size: 42px; margin-bottom: 10px; }
  .custom-message-{{ section.id }} .card-divider { margin-bottom: 15px; width: 100%; max-width: 250px; }
  .custom-message-{{ section.id }} .card-desc-container { height: 70px; }
  .custom-message-{{ section.id }} .card-desc { font-size: 16px; line-height: 1.4; }
  .custom-message-{{ section.id }} .category-fixed-text { font-size: 15px; min-height: 24px; margin-top: 6px; }
  .custom-message-{{ section.id }} .slider-controls { margin-top: 15px; }
}

/* ─── MacBook Air 15 inch M2 (1441px - 1728px) ───────────────── */
@media (min-width: 1441px) and (max-width: 1728px) {
  .custom-message-{{ section.id }} .message-container { gap: 60px; }
  .custom-message-{{ section.id }} .message-left,
  .custom-message-{{ section.id }} .message-right { max-width: 50%; }

  .custom-message-{{ section.id }} .left-title { font-size: 54px; margin-bottom: 15px; }
  .custom-message-{{ section.id }} .left-desc { font-size: 18px; margin-bottom: 25px; line-height: 28px; }
  .custom-message-{{ section.id }} .left-divider { margin-bottom: 25px; }
  .custom-message-{{ section.id }} .menu-list { margin-bottom: 35px; gap: 13px; }
  .custom-message-{{ section.id }} .menu-item { font-size: 17px; line-height: 30px; }
  .custom-message-{{ section.id }} .btn-outline { width: 260px; height: 52px; font-size: 15px; }

  .custom-message-{{ section.id }} .card-outermost { padding: 32px 50px; max-width: 600px; aspect-ratio: 1 / 1; min-height: unset; height: auto; margin: 0 auto; }
  .custom-message-{{ section.id }} .card-white-box { padding: 25px; width: 100%; height: 100%; min-height: 0; }
  .custom-message-{{ section.id }} .card-inner { padding: 22px; aspect-ratio: 1 / 1; height: 100%; width: 100%; justify-content: center; overflow: hidden; }
  .custom-message-{{ section.id }} .card-icon-container { width: 150px; height: 150px; margin-bottom: 18px; }
  .custom-message-{{ section.id }} .card-title { font-size: 50px; margin-bottom: 12px; }
  .custom-message-{{ section.id }} .card-divider { margin-bottom: 16px; width: 100%; max-width: 280px; }
  .custom-message-{{ section.id }} .card-desc-container { height: 75px; }
  .custom-message-{{ section.id }} .card-desc { font-size: 18px; line-height: 1.4; }
  .custom-message-{{ section.id }} .category-fixed-text { font-size: 16px; min-height: 26px; margin-top: 7px; }
  .custom-message-{{ section.id }} .slider-controls { margin-top: 18px; }
}




  /* Tablets (769px - 1024px) */
  @media (max-width: 1024px) {
    .custom-message-{{ section.id }} .message-container { 
      flex-direction: column-reverse; 
      padding-left: 40px;
      padding-right: 40px;
      gap: 60px;
    }
    .custom-message-{{ section.id }} .message-left,
    .custom-message-{{ section.id }} .message-right {
      max-width: 100%;
      width: 100%;
      align-items: flex-start; 
      text-align: left;
    }
    .custom-message-{{ section.id }} .left-title,
    .custom-message-{{ section.id }} .left-desc {
      text-align: left;
      margin-left: 0;
      margin-right: 0;
    }
    .custom-message-{{ section.id }} .menu-list {
      align-items: flex-start;
    }
    .custom-message-{{ section.id }} .btn-container {
      justify-content: flex-start;
    }
    
    .custom-message-{{ section.id }} .card-outermost {
      max-width: 540px; /* Limits the size to be like Macbook */
      aspect-ratio: 1 / 1;
      margin: 0 auto;
    }
  }

/* Tablets (769px - 1024px) */
@media (min-width: 769px) and (max-width: 1024px) {
  .custom-message-{{ section.id }} .message-container { 
    flex-direction: column; 
    padding-left: 40px;
    padding-right: 40px;
    gap: 0;
    display: flex;
    align-items: start;
    justify-content: start;
  }



  

  /* Use display:contents so child elements can be ordered freely */
  .custom-message-{{ section.id }} .message-left,
  .custom-message-{{ section.id }} .message-right { 
    display: contents; 
  }

  /* Order: 1=title, 2=desc, 3=divider, 4=card, 5=menu, 6=button */
  .custom-message-{{ section.id }} .left-title { 
    order: 1; 
    font-size: 42px; 
    text-align: left; 
    margin-bottom: 16px;
  }
  .custom-message-{{ section.id }} .left-desc { 
    order: 2; 
    font-size: 17px; 
    line-height: 28px; 
    text-align: left; 
    margin-bottom: 22px; 
  }
  .custom-message-{{ section.id }} .left-divider { 
    order: 3; 
    margin-bottom: 30px; 
    width: 100%; 
  }

  /* Card below divider */
.custom-message-{{ section.id }} .card-outermost { 
    order: 4; 
    max-width: 100%; 
    width: 100%;
    aspect-ratio: auto;
    height: auto;
    margin: 0 auto 35px auto;
    padding: 30px;
    box-sizing: border-box;
  }
  .custom-message-{{ section.id }} .card-white-box { 
    padding: 30px; 
    width: 100%; 
    height: auto;
    min-height: 0;
    box-sizing: border-box;
  }
  .custom-message-{{ section.id }} .card-inner { 
    padding: 28px; 
    aspect-ratio: auto;
    width: 100%;
    height: auto;
    justify-content: center;
    overflow: hidden;
  }
  .custom-message-{{ section.id }} .card-icon-container { width: 180px !important; height: 180px !important; margin-bottom: 20px; }
  .custom-message-{{ section.id }} .card-title { font-size: 52px !important; margin-bottom: 12px; }
  .custom-message-{{ section.id }} .card-divider { margin-bottom: 16px; width: 100%; max-width: 320px; }
  .custom-message-{{ section.id }} .card-desc-container { height: auto; min-height: 80px; }
  .custom-message-{{ section.id }} .card-desc { font-size: 20px !important; line-height: 1.6; }
  .custom-message-{{ section.id }} .category-fixed-text { font-size: 17px !important; min-height: 26px; margin-top: 8px; }
  .custom-message-{{ section.id }} .slider-controls { margin-top: 20px; }

  /* Menu as 2x2 grid */
  .custom-message-{{ section.id }} .menu-list { 
    order: 5;
    display: grid; 
    grid-template-columns: 1fr 1fr; 
    gap: 15px 20px; 
    width: 100%; 
    max-width: 100%;
    margin-bottom: 30px;
    align-items: flex-start;
  }
  .custom-message-{{ section.id }} .menu-item { 
    font-size: 16px; 
    line-height: 1.4; 
    width: auto;
  }

  /* Button at the bottom */
  .custom-message-{{ section.id }} .btn-container { 
    order: 6; 
    justify-content: flex-start; 
    width: 100%; 
  }
  .custom-message-{{ section.id }} .btn-outline { 
    width: 280px; 
    height: 52px; 
    font-size: 15px; 
  }
}




/* new  */


@media (min-width: 768px) and (max-width: 991px) {
    .custom-message-{{ section.id }} { padding-top: 50px; padding-bottom: 50px; }
    
    .custom-message-{{ section.id }} .message-container { 
      display: flex;
      flex-direction: column; 
      align-items: stretch; 
      padding-left: 40px; 
      padding-right: 40px; 
      gap: 0; 
    }
    
    /* Using display: contents to stack elements like mobile */
    .custom-message-{{ section.id }} .message-left,
    .custom-message-{{ section.id }} .message-right { display: contents; }
    
    .custom-message-{{ section.id }} .left-title { order: 1; font-size: 42px; text-align: left; margin-bottom: 12px; max-width: 100%; }
    .custom-message-{{ section.id }} .left-desc { order: 2; font-size: 18px; line-height: 28px; text-align: left; margin-bottom: 25px; max-width: 100%; }
    .custom-message-{{ section.id }} .left-divider { order: 3; margin-bottom: 35px; width: 100%; max-width: 100%; }
    
    /* Card below divider - FORCING DESKTOP LOOK (Perfect Square) */
    .custom-message-{{ section.id }} .card-outermost { 
      order: 4; 
      padding: 30px; 
      max-width: 600px; /* Desktop-like size */
      width: 100%;
      aspect-ratio: 1 / 1 !important; /* Perfect Square */
      height: auto; 
      margin: 0 auto 40px auto;
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
    }

    .custom-message-{{ section.id }} .card-white-box { 
      padding: 25px;
      width: 100%;
      height: 100%;
      min-height: 0;
      box-sizing: border-box;
    }
    
    .custom-message-{{ section.id }} .card-inner { 
      padding: 20px; 
      aspect-ratio: 1 / 1 !important; /* Perfect Square */
      border: var(--border-width) solid; /* Keep Desktop Border Width */
      border-image: linear-gradient(225deg, rgba(148, 120, 99, 1), rgba(233, 221, 212, 1), rgba(148, 120, 99, 1)) 1;
      height: 100%; 
      width: 100%; 
      justify-content: center;
      overflow: hidden; 
      box-sizing: border-box;
    }
    
    /* Inside Card - Desktop Sizes */
