{%- style -%}
  /* --- Custom Article Page CSS (Pixel Perfect to Image) --- */
  
  .custom-article-section-{{ section.id }} {
    background-color: #f9f8f6; /* Matching the beige background */
    width: 100%;
    overflow-x: hidden;
  }

  /* --- 1. Hero Split Layout --- */
  .custom-hero-split {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .custom-hero-image {
    width: 100%;
    height: 60vh;
    min-height: 400px;
  }

  .custom-hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .custom-hero-text {
    width: 100%;
    padding: 3rem 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @media screen and (min-width: 990px) {
    .custom-hero-split {
      flex-direction: row;
      height: auto;
      min-height: 85vh; /* Makes it tall like the image */
    }
    .custom-hero-image {
      width: 50%;
      height: auto;
      min-height: unset;
    }
    .custom-hero-text {
      width: 50%;
      padding: 5rem;
    }
  }

  @media screen and (min-width: 1200px) {
    .custom-hero-text {
      padding: 8rem;
    }
  }

  /* --- Hero Typography --- */
  .custom-article-meta {
    font-family: var(--font-heading-family, 'Libre Caslon Text', serif);
    font-size: 11px;
    color: #2c2c2c;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 8px;
    text-transform: none;
    letter-spacing: 0.5px;
  }

  .custom-article-meta .dot {
    font-size: 8px;
    color: #2c2c2c;
  }
  
  .custom-article-meta .divider {
    color: #999;
    font-weight: 300;
  }

  .custom-hero-title {
    font-family: var(--font-heading-family, 'Libre Caslon Text', serif);
    font-size: 40px;
    line-height: 1.1;
    color: #2c2c2c;
    margin: 0;
    font-weight: 400;
  }

  @media screen and (min-width: 768px) {
    .custom-hero-title {
      font-size: 64px;
    }
  }
  
  @media screen and (min-width: 1200px) {
    .custom-hero-title {
      font-size: 82px; /* Massive title as seen in image */
    }
  }

  /* --- 2. Article Content --- */
  .custom-content-wrapper {
    max-width: 750px; /* Narrow text column for readability */
    margin: 0 auto;
    padding: 4rem 2rem;
    font-family: var(--font-body-family, 'Inter', sans-serif);
  }

  .custom-content-wrapper .rte {
    font-size: 14px;
    line-height: 1.6;
    color: #2c2c2c;
  }

  .custom-content-wrapper .rte p {
    margin-bottom: 1.5rem;
  }

  /* --- 3. Share Block --- */
  .custom-share-block {
    margin-top: 4rem;
    padding-top: 2rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .custom-share-block .share-label {
    font-family: var(--font-heading-family, 'Libre Caslon Text', serif);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    color: #2c2c2c;
  }

  .custom-share-icons {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .custom-share-icons a {
    color: #2c2c2c;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.3s;
  }

  .custom-share-icons a:hover {
    opacity: 0.6;
  }
  
  .custom-share-icons svg {
    width: 16px;
    height: 16px;
  }

  /* --- 4. Related Articles (Matching your Blog Grid) --- */
  .custom-related-wrapper {
    max-width: 1300px;
    margin: 0 auto;
    padding: 4rem 2rem 8rem 2rem;
  }

  .custom-related-header {
    font-family: var(--font-heading-family, 'Libre Caslon Text', serif);
    font-size: 42px;
    color: #2c2c2c;
    margin-bottom: 3rem;
    font-weight: 400;
    display: flex;
    align-items: center;
    gap: 15px;
  }
  
  .custom-related-header svg {
    width: 35px;
    height: 35px;
    margin-top: 5px;
  }

  .custom-related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem 2.5rem;
  }

  @media screen and (min-width: 768px) {
    .custom-related-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 1024px) {
    .custom-related-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Grid Items (Copied from previous perfect design) */
  .custom-related-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }
  .custom-related-image-wrapper {
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    margin-bottom: 1rem;
    display: block;
  }
  .custom-related-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .custom-related-card:hover img {
    transform: scale(1.04);
  }
  .custom-related-meta {
    font-family: var(--font-heading-family, 'Libre Caslon Text', serif);
    font-size: 11px;
    color: #2c2c2c;
    margin-bottom: 0.6rem;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .custom-related-meta .dot { font-size: 8px; color: #2c2c2c; }
  .custom-related-meta .divider { color: #999; }
  .custom-related-title {
    font-family: var(--font-heading-family, 'Libre Caslon Text', serif);
    font-size: 24px;
    font-weight: 400;
    margin: 0 0 0.6rem 0;
    line-height: 1.25;
    color: #2c2c2c;
    text-decoration: none;
  }
  .custom-related-card a { text-decoration: none; }
  .custom-related-excerpt {
    font-family: var(--font-heading-family, 'Libre Caslon Text', serif);
    font-size: 13px;
    color: #2c2c2c;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
  }
{%- endstyle -%}

{%- liquid
  # Calculate Read Time (assuming 200 words per minute)
  assign word_count = article.content | strip_html | split: ' ' | size
  assign read_time = word_count | divided_by: 200 | plus: 1
-%}

<section data-section-type="article-template" data-section-id="{{ section.id }}" class="custom-article-section-{{ section.id }}">
  
  <!-- 1. Hero Split Section -->
  <div class="custom-hero-split">
    <div class="custom-hero-image">
      {%- if article.image -%}
        <img src="{{ article.image | image_url: width: 1500 }}" alt="{{ article.title | escape }}" loading="eager">
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
    <div class="custom-hero-text">
      <div class="custom-article-meta">
        <span class="dot">&#9679;</span>
        <span>{{ article.published_at | date: "%b %d, %Y" }}</span>
        <span class="divider">|</span>
        <span>{{ read_time }} min read</span>
      </div>
      <h1 class="custom-hero-title">{{ article.title }}</h1>
    </div>
  </div>

  <!-- 2. Article Content -->
  <div class="custom-content-wrapper">
    <div class="rte">
      {{ article.content }}
    </div>

    <!-- 3. Share Block -->
    {%- if section.settings.blog_show_social -%}
      {%- assign share_url = shop.url | append: article.url -%}
      {%- assign share_title = article.title | url_param_escape -%}
      
      <div class="custom-share-block">
        <span class="share-label">SHARE</span>
        <div class="custom-share-icons">
          <!-- Facebook -->
          <a target="_blank" href="//www.facebook.com/sharer.php?u={{ share_url }}" title="Share on Facebook">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
          </a>
          <!-- X (Twitter) -->
          <a target="_blank" href="//twitter.com/share?text={{ share_title }}&url={{ share_url }}" title="Share on X">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.008 4.15H5.078z"></path></svg>
          </a>
          <!-- Pinterest -->
          <a target="_blank" href="//pinterest.com/pin/create/button/?url={{ share_url }}&media={{ article.image | image_url: width: 1024 }}&description={{ share_title }}" title="Share on Pinterest">
             <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.951-7.252 4.168 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.366 18.605 0 12.017 0z"></path></svg>
          </a>
          <!-- Email -->
          <a href="mailto:?subject={{ share_title }}&body=Check this out: {{ share_url }}" title="Share via Email">
             <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          </a>
        </div>
      </div>
    {%- endif -%}
  </div>

  <!-- 4. Related Articles -->
  {%- if section.settings.show_related_articles -%}
    <div class="custom-related-wrapper">
      <h2 class="custom-related-header">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        Read more
      </h2>
      
      <div class="custom-related-grid">
        {%- assign currentID = article.id -%}
        {%- assign counter = 0 -%}

        {%- for rel_article in blog.articles -%}
          {%- if counter > 3 -%}{%- break -%}{%- endif -%}
          {%- if rel_article.id == currentID -%}{%- continue -%}{%- endif -%}
          
          {%- assign rel_word_count = rel_article.content | strip_html | split: ' ' | size -%}
          {%- assign rel_read_time = rel_word_count | divided_by: 200 | plus: 1 -%}

          <div class="custom-related-card">
            <a href="{{ rel_article.url }}" class="custom-related-image-wrapper">
              {%- if rel_article.image -%}
                <img src="{{ rel_article.image | image_url: width: 800 }}" alt="{{ rel_article.image.alt | escape }}" loading="lazy">
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </a>
            <div class="custom-related-meta">
              <span class="dot">&#9679;</span>
              <span>{{ rel_article.published_at | date: "%b %d, %Y" }}</span>
              <span class="divider">|</span>
              <span>{{ rel_read_time }} min read</span>
            </div>
            <a href="{{ rel_article.url }}">
              <h3 class="custom-related-title">{{ rel_article.title }}</h3>
            </a>
            <p class="custom-related-excerpt">
              {%- if rel_article.excerpt.size > 0 -%}
                {{ rel_article.excerpt | strip_html | truncatewords: 22 }}
              {%- else -%}
                {{ rel_article.content | strip_html | truncatewords: 22 }}
              {%- endif -%}
            </p>
          </div>
          
          {%- assign counter = counter | plus: 1 -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

</section>

<!-- SEO Script (Unchanged) -->
<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Article",
    "articleBody": {{ article.content | strip_html | json }},
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": {{ shop.url | append: page.url | json }}
    },
    "headline": {{ article.title | json }},
    {% if article.excerpt != blank %}
      "description": {{ article.excerpt | strip_html | json }},
    {% endif %}
    {% if article.image %}
  {% assign image_size = article.image.width %}
      "image": [
        {{ article | image_url: width: image_size | prepend: "https:" | json }}
      ],
    {% endif %}
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
    "dateCreated": {{ article.created_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
    "author": {
      "@type": "Person",
      "name": {{ article.author | json }}
    },
    "publisher": {
      "@type": "Organization",
      {% if page_image %}
  {% assign image_size = page_image.width %}
        "logo": {
          "@type": "ImageObject",
          "height": {{ page_image.height | json }},
          "url": {{ page_image | image_url: width: image_size | prepend: "https:" | json }},
          "width": {{ page_image.width | json }}
        },
      {% endif %}
      "name": {{ shop.name | json }}
    }
  }
</script>

{% schema %}
{
  "name": "Blog post",
  "settings": [
    {
      "type": "header",
      "content": "Display Settings"
    },
    {
      "type": "checkbox",
      "id": "blog_show_social",
      "label": "Show social share buttons",
      "default": true
    },
    {
      "type": "header",
      "content": "Related articles"
    },
    {
      "type": "checkbox",
      "id": "show_related_articles",
      "label": "Show related articles",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Custom Blog Post"
    }
  ]
}
{% endschema %}

