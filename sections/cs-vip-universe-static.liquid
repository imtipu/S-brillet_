{% comment %} {% comment %} {%- style -%}
  /* =========================================================
     VIP Universe Static Section CSS
     ========================================================= */
  .vip-uni-{{ section.id }} {
    --vu-bg: {{ section.settings.bg_color }};
    --vu-title-clr: {{ section.settings.title_color }};
    --vu-text-clr: {{ section.settings.text_color }};
    --vu-card-bg: {{ section.settings.card_bg_color }};
    --vu-card-text: {{ section.settings.card_text_color }};
    --vu-divider-clr: {{ section.settings.divider_color }};
    --vu-grad-start: {{ section.settings.card_hover_grad_start }};
    --vu-grad-end: {{ section.settings.card_hover_grad_end }};
    --vu-grad-angle: {{ section.settings.card_hover_grad_angle }}deg;
    --vu-hover-text: {{ section.settings.card_hover_text_color }};

    background-color: var(--vu-bg);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    width: 100%;
    display: block;
    box-sizing: border-box;
    overflow: hidden;
    max-width: 100vw;
  }

  .vip-uni-{{ section.id }} * {
    box-sizing: border-box;
  }

  /* ── Two-column grid layout ── */
  .vip-uni-{{ section.id }} .vu-wrap {
    max-width: 1920px;
    margin: 0 auto;
    padding-left: {{ section.settings.padding_sides }}px;
    padding-right: {{ section.settings.padding_sides }}px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: {{ section.settings.layout_gap }}px;
  }

  /* ── LEFT COLUMN ── */
  .vip-uni-{{ section.id }} .vu-left {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .vip-uni-{{ section.id }} .vu-title {
    font-family: var(--font-heading-family, 'Libre Caslon Text', serif);
    font-size: {{ section.settings.title_size }}px;
    font-weight: 400;
    line-height: 1.15;
    color: var(--vu-title-clr);
    margin: 0 0 20px 0;
    text-transform: uppercase;
  }

  .vip-uni-{{ section.id }} .vu-desc-top {
    font-family: var(--font-body-family, 'Inter', sans-serif);
    font-size: {{ section.settings.desc_top_size }}px;
    font-weight: 400;
    line-height: 1.5;
    color: var(--vu-text-clr);
    margin: 0 0 30px 0;
    max-width: 900px;
  }

  .vip-uni-{{ section.id }} .vu-divider {
    border: none;
    border-top: 1px solid var(--vu-divider-clr);
    margin: 0 0 30px 0;
    width: 100%;
  }

  /* ── Card grid ── */
  .vip-uni-{{ section.id }} .vu-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px 24px;
    margin-bottom: 24px;
    width: 100%;
  }

  /* ── Card base ── */
 .vip-uni-{{ section.id }} .vu-card {
  position: relative;
  background-color: var(--vu-card-bg);
  border-radius: 4px;
  display: flex;
  align-items: center;
  padding: 18px 20px;
  gap: 14px;
  width: 100%;
  cursor: pointer;
}

.vip-uni-{{ section.id }} .vu-card::before {
  content: "";
  position: absolute;
  inset: 0;
  padding: 1px;
  border-radius: inherit;
  background: linear-gradient(
    to right,
    #ab9482ff, #E9DDD4, #ab9483ff
  );

  -webkit-mask:
    linear-gradient(#fff 0 0) content-box,
    linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;

  pointer-events: none;
}

  /* ── Icon wrapper — stacks image + svg so they can crossfade ── */
  .vip-uni-{{ section.id }} .vu-icon-wrap {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  /* Both layers sit absolutely, full-size */
  .vip-uni-{{ section.id }} .vu-icon-img,
  .vip-uni-{{ section.id }} .vu-icon-svg-wrap {
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.3s ease;
  }

  .vip-uni-{{ section.id }} .vu-icon-img img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .vip-uni-{{ section.id }} .vu-icon-svg-wrap svg {
    width: 100%;
    height: 100%;
  }

  /* Default: image visible, svg hidden */
  .vip-uni-{{ section.id }} .vu-icon-img    { opacity: 1; }
  .vip-uni-{{ section.id }} .vu-icon-svg-wrap { opacity: 0; }

  /* Hover: image hides, svg appears */
  .vip-uni-{{ section.id }} .vu-card:hover .vu-icon-img    { opacity: 0; }
  .vip-uni-{{ section.id }} .vu-card:hover .vu-icon-svg-wrap { opacity: 1; }

  /* ── Card title ── */
  .vip-uni-{{ section.id }} .vu-card-title {
    font-family: var(--font-body-family, 'Inter', sans-serif);
    font-size: {{ section.settings.card_title_size }}px;
    font-weight: 400;
    line-height: 1.4;
    color: var(--vu-card-text);
    margin: 0;
    text-transform: uppercase;
    max-width: 160px;
    /* Prep gradient text — transparent clip masks only activate on hover */
    -webkit-background-clip: text;
    background-clip: text;
    transition: color 0.35s ease, -webkit-text-fill-color 0.35s ease;
    max-width: 300px;
  }

  /* On hover: gradient text, card bg stays unchanged */
  .vip-uni-{{ section.id }} .vu-card:hover .vu-card-title {
    background-image:linear-gradient(135deg, #947863, #E9DDD4, #947863);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
   text-decoration: underline;
  }

  /* ── Static bottom description — always visible ── */
 .vip-uni-{{ section.id }} .vu-desc-bottom-box {
  position: relative;
  background-color: var(--vu-card-bg);
  border-radius: 4px;
  padding: 20px 24px;
  width: 100%;
}

.vip-uni-{{ section.id }} .vu-desc-bottom-box::before {
  content: "";
  position: absolute;
  inset: 0;
  padding: 1px;
  border-radius: inherit;
  background: linear-gradient(
    to right,
    #ab9482ff, #E9DDD4, #ab9483ff
  );

  -webkit-mask:
    linear-gradient(#fff 0 0) content-box,
    linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;

  pointer-events: none;
}

  .vip-uni-{{ section.id }} .vu-desc-bottom {
    font-family: var(--font-body-family, 'Inter', sans-serif);
    font-size: {{ section.settings.desc_bottom_size }}px;
    font-weight: 400;
    line-height: 1.5;
    color: var(--vu-text-clr);
    margin: 0;
  }

  /* ── RIGHT COLUMN — Static image, cropped from TOP (shows bottom) ── */
  .vip-uni-{{ section.id }} .vu-right {
    position: relative;
    width: 100%;
    border-radius: {{ section.settings.image_radius }}px;
    overflow: hidden;
    aspect-ratio: {{ section.settings.image_aspect_ratio }};
  }

  .vip-uni-{{ section.id }} .vu-static-img {
    width: 100%;
    height: 100%;
    object-fit: content;
    object-position: bottom center; /* anchor to top — bottom never gets cut */
    display: block;
  }

  .vip-uni-{{ section.id }} .vu-static-placeholder {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* =========================================================
     Responsive
     ========================================================= */

  /* MacBook 1441–1728 */
  @media (min-width: 1441px) and (max-width: 1728px) {
    .vip-uni-{{ section.id }} .vu-wrap { gap: 60px; }
    .vip-uni-{{ section.id }} .vu-title { font-size: 58px; }
    .vip-uni-{{ section.id }} .vu-desc-top { font-size: 17px; }
    .vip-uni-{{ section.id }} .vu-card { padding: 16px 18px; gap: 12px; }
    .vip-uni-{{ section.id }} .vu-icon-wrap { width: 54px; height: 54px; }
    .vip-uni-{{ section.id }} .vu-card-title { font-size: 16px; }
  }

  /* 1025–1440 */
  @media (max-width: 1440px) {
    .vip-uni-{{ section.id }} .vu-wrap { gap: 40px; padding-left: 80px; padding-right: 80px; }
    .vip-uni-{{ section.id }} .vu-title { font-size: 48px; }
    .vip-uni-{{ section.id }} .vu-desc-top { font-size: 15px; }
    .vip-uni-{{ section.id }} .vu-card { padding: 14px 16px; gap: 10px; }
    .vip-uni-{{ section.id }} .vu-icon-wrap { width: 52px; height: 52px; }
    .vip-uni-{{ section.id }} .vu-card-title { font-size: 14px; max-width: 130px; }
    .vip-uni-{{ section.id }} .vu-desc-bottom { font-size: 14px; }
  }

  /* Tablet 769–1024: stack, image on top */
  @media (max-width: 1024px) {
    .vip-uni-{{ section.id }} .vu-wrap {
      grid-template-columns: 1fr;
      padding-left: 40px;
      padding-right: 40px;
      gap: 32px;
      align-items: start;
    }
    .vip-uni-{{ section.id }} .vu-left { order: 2; }
    .vip-uni-{{ section.id }} .vu-right {
      order: 1;
      aspect-ratio: 16 / 9;
    }
  }

  /* Mobile ≤768 */
  @media (max-width: 768px) {
    .vip-uni-{{ section.id }} {
      padding-top: 40px;
      padding-bottom: 40px;
    }
    .vip-uni-{{ section.id }} .vu-wrap {
      display: flex !important;
      flex-direction: column !important;
      padding: 20px !important;
      gap: 0 !important;
    }
    .vip-uni-{{ section.id }} .vu-left {
      display: contents !important;
      order: unset;
    }
    .vip-uni-{{ section.id }} .vu-title { order: 1; font-size: 28px; margin-bottom: 14px; }
    .vip-uni-{{ section.id }} .vu-desc-top { order: 2; font-size: 13px; margin-bottom: 18px; max-width: 100%; }
    .vip-uni-{{ section.id }} .vu-divider { order: 3; margin-bottom: 20px; }
    .vip-uni-{{ section.id }} .vu-right {
      order: 4 !important;
      aspect-ratio: 4 / 3;
      border-radius: 6px;
      margin-bottom: 20px;
    }
    .vip-uni-{{ section.id }} .vu-grid {
      order: 5 !important;
      gap: 10px !important;
      margin-bottom: 18px !important;
    }
    .vip-uni-{{ section.id }} .vu-desc-bottom-box { order: 6; padding: 14px 16px; }
    .vip-uni-{{ section.id }} .vu-card { padding: 10px 12px; gap: 8px; }
    .vip-uni-{{ section.id }} .vu-icon-wrap { width: 38px; height: 38px; }
    .vip-uni-{{ section.id }} .vu-card-title { font-size: 11px; max-width: 100%; line-height: 1.3; }
    .vip-uni-{{ section.id }} .vu-desc-bottom { font-size: 13px; }
  }
{%- endstyle -%}

<section class="vip-uni-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="vu-wrap">

    <!-- LEFT COLUMN -->
    <div class="vu-left">

      {%- if section.settings.title != blank -%}
        <h2 class="vu-title">{{ section.settings.title }}</h2>
      {%- endif -%}

      {%- if section.settings.desc_top != blank -%}
        <p class="vu-desc-top">{{ section.settings.desc_top }}</p>
      {%- endif -%}

      {%- if section.settings.show_divider -%}
        <hr class="vu-divider">
      {%- endif -%}

      <!-- Card Grid -->
      <div class="vu-grid">
        {%- for block in section.blocks -%}
          <div class="vu-card" {{ block.shopify_attributes }}>

            <div class="vu-icon-wrap">

              <!-- Layer 1: Uploaded image (visible by default) -->
              {%- if block.settings.icon != blank -%}
                <div class="vu-icon-img">
                  <img src="{{ block.settings.icon | image_url: width: 128 }}"
                       alt="{{ block.settings.title | escape }}"
                       loading="lazy">
                </div>
              {%- endif -%}

              <!-- Layer 2: SVG (shown on hover) -->
              {%- if block.settings.icon_svg != blank -%}
                <div class="vu-icon-svg-wrap">
                  {{ block.settings.icon_svg }}
                </div>
              {%- endif -%}

              <!-- Fallback: only if neither image nor svg is provided -->
              {%- if block.settings.icon == blank and block.settings.icon_svg == blank -%}
                <div class="vu-icon-img">
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {%- endif -%}

            </div>

            {%- if block.settings.title != blank -%}
              <h3 class="vu-card-title">{{ block.settings.title }}</h3>
            {%- endif -%}

          </div>
        {%- endfor -%}
      </div>

      <!-- Static bottom description — always visible -->
      {%- if section.settings.desc_bottom != blank -%}
        <div class="vu-desc-bottom-box">
          <p class="vu-desc-bottom">{{ section.settings.desc_bottom }}</p>
        </div>
      {%- endif -%}

    </div>

    <!-- RIGHT COLUMN — single static image, anchored top so bottom never crops -->
    <div class="vu-right">
      {%- if section.settings.static_image != blank -%}
        <img src="{{ section.settings.static_image | image_url: width: 1600 }}"
             alt="{{ section.settings.static_image_alt | default: section.settings.title | escape }}"
             class="vu-static-img"
             loading="lazy">
      {%- else -%}
        {{ 'collection-1' | placeholder_svg_tag: 'vu-static-placeholder' }}
      {%- endif -%}
    </div>

  </div>
</section>

