  width: 100%;
  cursor: pointer;
  transition: all 0.3s ease;
}

.vip-uni-{{ section.id }} .vu-card::before {
  content: "";
  position: absolute;
  inset: 0;
  padding: 1px;
  border-radius: inherit;
  background: linear-gradient(
    to right,
    #ab9482ff, #E9DDD4, #ab9483ff
  );

  -webkit-mask:
    linear-gradient(#fff 0 0) content-box,
    linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;

  pointer-events: none;
}

  /* ── Icon wrapper — stacks image + svg so they can crossfade ── */
  .vip-uni-{{ section.id }} .vu-icon-wrap {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  /* Both layers sit absolutely, full-size */
  .vip-uni-{{ section.id }} .vu-icon-img,
  .vip-uni-{{ section.id }} .vu-icon-svg-wrap {
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.3s ease;
  }

  .vip-uni-{{ section.id }} .vu-icon-img img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .vip-uni-{{ section.id }} .vu-icon-svg-wrap svg {
    width: 100%;
    height: 100%;
  }

  /* Default: image visible, svg hidden */
  .vip-uni-{{ section.id }} .vu-icon-img    { opacity: 1; }
  .vip-uni-{{ section.id }} .vu-icon-svg-wrap { opacity: 0; }

  /* Hover & Active State: image hides, svg appears */
  .vip-uni-{{ section.id }} .vu-card:hover .vu-icon-img,
  .vip-uni-{{ section.id }} .vu-card.is-active .vu-icon-img { opacity: 0; }
  
  .vip-uni-{{ section.id }} .vu-card:hover .vu-icon-svg-wrap,
  .vip-uni-{{ section.id }} .vu-card.is-active .vu-icon-svg-wrap { opacity: 1; }

  /* ── Card title ── */
  .vip-uni-{{ section.id }} .vu-card-title {
    font-family: var(--font-body-family, 'Inter', sans-serif);
    font-size: {{ section.settings.card_title_size }}px;
    font-weight: 400;
    line-height: 1.4;
    color: var(--vu-card-text);
    margin: 0;
    text-transform: uppercase;
    max-width: 160px;
    /* Prep gradient text — transparent clip masks only activate on hover */
    -webkit-background-clip: text;
    background-clip: text;
    transition: color 0.35s ease, -webkit-text-fill-color 0.35s ease;
    max-width: 300px;
  }

  /* On hover & Active State: gradient text, card bg stays unchanged */
  .vip-uni-{{ section.id }} .vu-card:hover .vu-card-title,
  .vip-uni-{{ section.id }} .vu-card.is-active .vu-card-title {
    background-image:linear-gradient(135deg, #947863, #E9DDD4, #947863);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    text-decoration: underline;
  }

  /* ── Static bottom description — always visible ── */
 .vip-uni-{{ section.id }} .vu-desc-bottom-box {
  position: relative;
  background-color: var(--vu-card-bg);
  border-radius: 4px;
  padding: 20px 24px;
  width: 100%;
}

.vip-uni-{{ section.id }} .vu-desc-bottom-box::before {
  content: "";
  position: absolute;
  inset: 0;
  padding: 1px;
  border-radius: inherit;
  background: linear-gradient(
    to right,
    #ab9482ff, #E9DDD4, #ab9483ff
  );

  -webkit-mask:
    linear-gradient(#fff 0 0) content-box,
    linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;

  pointer-events: none;
}

  .vip-uni-{{ section.id }} .vu-desc-bottom {
    font-family: var(--font-body-family, 'Inter', sans-serif);
    font-size: {{ section.settings.desc_bottom_size }}px;
    font-weight: 400;
    line-height: 1.5;
    color: var(--vu-text-clr);
    margin: 0;
    transition: opacity 0.25s ease;
  }

  /* ── RIGHT COLUMN — Static image, cropped from TOP (shows bottom) ── */
  .vip-uni-{{ section.id }} .vu-right {
    position: relative;
    width: 100%;
    border-radius: {{ section.settings.image_radius }}px;
    overflow: hidden;
    aspect-ratio: {{ section.settings.image_aspect_ratio }};
  }

  .vip-uni-{{ section.id }} .vu-static-img {
    width: 100%;
    height: 100%;
    object-fit: content;
    object-position: bottom center; /* anchor to top — bottom never gets cut */
    display: block;
  }

  .vip-uni-{{ section.id }} .vu-static-placeholder {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* =========================================================
     Responsive
     ========================================================= */

  /* MacBook 1441–1728 */
  @media (min-width: 1441px) and (max-width: 1728px) {
    .vip-uni-{{ section.id }} .vu-wrap { gap: 60px; }
    .vip-uni-{{ section.id }} .vu-title { font-size: 58px; }
    .vip-uni-{{ section.id }} .vu-desc-top { font-size: 17px; }
    .vip-uni-{{ section.id }} .vu-card { padding: 16px 18px; gap: 12px; }
    .vip-uni-{{ section.id }} .vu-icon-wrap { width: 54px; height: 54px; }
    .vip-uni-{{ section.id }} .vu-card-title { font-size: 16px; }
  }

  /* 1025–1440 */
  @media (max-width: 1440px) {
    .vip-uni-{{ section.id }} .vu-wrap { gap: 40px; padding-left: 80px; padding-right: 80px; }
    .vip-uni-{{ section.id }} .vu-title { font-size: 48px; }
    .vip-uni-{{ section.id }} .vu-desc-top { font-size: 15px; }
    .vip-uni-{{ section.id }} .vu-card { padding: 14px 16px; gap: 10px; }
    .vip-uni-{{ section.id }} .vu-icon-wrap { width: 52px; height: 52px; }
    .vip-uni-{{ section.id }} .vu-card-title { font-size: 14px; max-width: 130px; }
    .vip-uni-{{ section.id }} .vu-desc-bottom { font-size: 14px; }
  }

  /* iPad / Tablet 769–1024: same content order as mobile */
  @media (min-width: 769px) and (max-width: 1024px) {
    .vip-uni-{{ section.id }} .vu-wrap {
      display: flex !important;
      flex-direction: column !important;
      padding-left: 40px;
      padding-right: 40px;
      gap: 0 !important;
      align-items: stretch;
    }

    /* Allow title, description, divider, cards and bottom box
       to participate in the same flex order as the image */
    .vip-uni-{{ section.id }} .vu-left {
      display: contents !important;
      order: unset;
    }

    .vip-uni-{{ section.id }} .vu-title {
      order: 1;
    }

    .vip-uni-{{ section.id }} .vu-desc-top {
      order: 2;
    }

    .vip-uni-{{ section.id }} .vu-divider {
      order: 3;
    }

    /* Image now sits directly below the divider, like mobile */
    .vip-uni-{{ section.id }} .vu-right {
      order: 4 !important;
      width: 100%;
      aspect-ratio: auto;
      height: auto;
      overflow: hidden;
      margin-bottom: 24px;
    }

    .vip-uni-{{ section.id }} .vu-static-img {
      width: 100%;
      height: 500px;
      object-fit: contain;
      object-position: center center;
      display: block;
    }

    .vip-uni-{{ section.id }} .vu-grid {
      order: 5 !important;
    }

    .vip-uni-{{ section.id }} .vu-desc-bottom-box {
      order: 6;
    }
  }

  /* Mobile ≤768 */
  @media (max-width: 768px) {
    .vip-uni-{{ section.id }} {
      padding-top: 40px;
      padding-bottom: 40px;
    }
    .vip-uni-{{ section.id }} .vu-wrap {
      display: flex !important;
      flex-direction: column !important;
      padding: 20px !important;
      gap: 0 !important;
    }
    .vip-uni-{{ section.id }} .vu-left {
      display: contents !important;
      order: unset;
    }
    .vip-uni-{{ section.id }} .vu-title { order: 1; font-size: 28px; margin-bottom: 14px; }
    .vip-uni-{{ section.id }} .vu-desc-top { order: 2; font-size: 13px; margin-bottom: 18px; max-width: 100%; }
    .vip-uni-{{ section.id }} .vu-divider { order: 3; margin-bottom: 20px; }
    .vip-uni-{{ section.id }} .vu-right {
      order: 4 !important;
      aspect-ratio: 4 / 3;
      border-radius: 6px;
      margin-bottom: 20px;
    }
    .vip-uni-{{ section.id }} .vu-grid {
      order: 5 !important;
      gap: 10px !important;
      margin-bottom: 18px !important;
    }
    .vip-uni-{{ section.id }} .vu-desc-bottom-box { order: 6; padding: 14px 16px; }
    .vip-uni-{{ section.id }} .vu-card { padding: 10px 12px; gap: 8px; }
    .vip-uni-{{ section.id }} .vu-icon-wrap { width: 38px; height: 38px; }
    .vip-uni-{{ section.id }} .vu-card-title { font-size: 11px; max-width: 100%; line-height: 1.3; }
    .vip-uni-{{ section.id }} .vu-desc-bottom { font-size: 13px; }
  }

{%- endstyle -%}

<section class="vip-uni-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="vu-wrap">

    <div class="vu-left">

      {%- if section.settings.title != blank -%}
        <h2 class="vu-title">{{ section.settings.title }}</h2>
      {%- endif -%}

      {%- if section.settings.desc_top != blank -%}
        <p class="vu-desc-top">{{ section.settings.desc_top }}</p>
      {%- endif -%}

      {%- if section.settings.show_divider -%}
        <hr class="vu-divider">
      {%- endif -%}

      <div class="vu-grid" id="vu-card-grid-{{ section.id }}">
        {%- for block in section.blocks -%}
          <div class="vu-card" data-card-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>

            <div class="vu-icon-wrap">

              {%- if block.settings.icon != blank -%}
                <div class="vu-icon-img">
                  <img src="{{ block.settings.icon | image_url: width: 128 }}"
                       alt="{{ block.settings.title | escape }}"
                       loading="lazy">
                </div>
              {%- endif -%}

              {%- if block.settings.icon_svg != blank -%}
                <div class="vu-icon-svg-wrap">
                  {{ block.settings.icon_svg }}
                </div>
              {%- endif -%}

              {%- if block.settings.icon == blank and block.settings.icon_svg == blank -%}
                <div class="vu-icon-img">
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {%- endif -%}

            </div>

            {%- if block.settings.title != blank -%}
              <h3 class="vu-card-title">{{ block.settings.title }}</h3>
            {%- endif -%}

          </div>
        {%- endfor -%}
      </div>

      <script type="application/json" id="vu-bottom-texts-{{ section.id }}">
        [
          {%- for block in section.blocks -%}
            {{ block.settings.bottom_text | default: section.settings.desc_bottom | json }}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      </script>

      {%- if section.settings.desc_bottom != blank -%}
        <div class="vu-desc-bottom-box">
          <p class="vu-desc-bottom" id="vu-desc-bottom-{{ section.id }}">{{ section.settings.desc_bottom }}</p>
        </div>
      {%- endif -%}

    </div>

    <div class="vu-right">
      {%- if section.settings.static_image != blank -%}
        <img src="{{ section.settings.static_image | image_url: width: 1600 }}"
             alt="{{ section.settings.static_image_alt | default: section.settings.title | escape }}"
             class="vu-static-img"
             loading="lazy">
      {%- else -%}
        {{ 'collection-1' | placeholder_svg_tag: 'vu-static-placeholder' }}
      {%- endif -%}
    </div>

  </div>
</section>

<script>
  (function() {
    function initVuSection() {
      const grid = document.getElementById('vu-card-grid-{{ section.id }}');
      if (!grid) return;

      const cards = grid.querySelectorAll('.vu-card');
      if (cards.length === 0) return;

      const bottomTextEl = document.getElementById('vu-desc-bottom-{{ section.id }}');
      const jsonEl = document.getElementById('vu-bottom-texts-{{ section.id }}');
      if (!bottomTextEl || !jsonEl) return;

      let bottomTexts = [];
      try {
        bottomTexts = JSON.parse(jsonEl.textContent);
      } catch (e) {
        bottomTexts = [];
      }

      const defaultBottomText = bottomTextEl.textContent;

      // Helper: update the bottom description text (with a soft fade)
      const setBottomText = (index) => {
        const newText = bottomTexts[index] || defaultBottomText;
        if (bottomTextEl.textContent.trim() === newText.trim()) return;
        bottomTextEl.style.opacity = '0';
        setTimeout(() => {
          bottomTextEl.textContent = newText;
          bottomTextEl.style.opacity = '1';
        }, 150);
      };

      const enableAutoPlay = {{ section.settings.enable_auto_hover | json }};
      const speed = {{ section.settings.auto_hover_speed }} * 1000; // Convert seconds to milliseconds

      if (enableAutoPlay) {
        let currentIndex = 0;
        let intervalId;

        const activateCard = (index) => {
          cards.forEach(card => card.classList.remove('is-active'));
          cards[index].classList.add('is-active');
          setBottomText(index);
        };

        const startPlay = () => {
          clearInterval(intervalId);
          intervalId = setInterval(() => {
            currentIndex = (currentIndex + 1) % cards.length;
            activateCard(currentIndex);
          }, speed);
        };

        const stopPlay = () => clearInterval(intervalId);

        activateCard(currentIndex);
        startPlay();

        cards.forEach((card, i) => {
          card.addEventListener('mouseenter', () => {
            stopPlay();
            cards.forEach(c => c.classList.remove('is-active'));
            setBottomText(i);
          });

          card.addEventListener('mouseleave', () => {
            currentIndex = i;
            startPlay();
          });
        });
      } else {
        cards.forEach((card, i) => {
          card.addEventListener('mouseenter', () => setBottomText(i));
          card.addEventListener('mouseleave', () => setBottomText(-1));
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initVuSection);
    } else {
      initVuSection();
    }

    // Re-init when this section is reloaded in the Shopify theme editor
    document.addEventListener('shopify:section:load', function(evt) {
      if (evt.target && evt.target.querySelector('#vu-card-grid-{{ section.id }}')) {
        initVuSection();
      }
    });
  })();
</script>

