    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.gap_mobile }}px;
    align-items: center;
  }

  /* --- MOBILE SPECIFIC ORDERING --- */
  @media screen and (max-width: 989px) {
    .shining-image-box-{{ section.id }} {
      order: -1; /* Forces Image to be on top */
    }
    .shining-content-box-{{ section.id }} {
      order: 1; /* Forces Content to be at the bottom */
    }
  }

  /* --- DESKTOP SETUP --- */
  @media screen and (min-width: 990px) {
    .shining-wrapper-{{ section.id }} {
      flex-direction: {% if section.settings.image_position == 'left' %}row-reverse{% else %}row{% endif %};
      gap: {{ section.settings.gap_desktop }}px;
    }
    .shining-image-box-{{ section.id }},
    .shining-content-box-{{ section.id }} {
      order: 0; /* Resets order back to normal for desktop */
    }
  }

  /* Typography Styles - EXACT FIGMA MATCH */
  .shining-title-{{ section.id }} {
    font-family: var(--font-heading-family, serif);
    font-size: {{ section.settings.title_size_mb }}px;
