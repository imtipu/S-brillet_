    color: {{ section.settings.text_color }};
    margin: 0;
    max-width: {{ section.settings.subtitle_max_width }}px;
    text-align: {{ section.settings.text_align_mb }};
  }
@media screen and (min-width: 769px) and (max-width: 1024px) {
   .section-{{ section.id }}-padding {
   
    padding-left: 40px;
    padding-right: 40px;
   
  }
}
  @media screen and (min-width: 750px) {
    .shining-title-{{ section.id }} {
      font-size: {{ section.settings.title_size }}px;
      text-align: {{ section.settings.text_align }};
    }
    .shining-subtitle-{{ section.id }},
    .shining-subtitle-{{ section.id }} p {
      font-size: {{ section.settings.subtitle_size }}px;
      text-align: {{ section.settings.text_align }};
    }
  }

  /* ==================================================================
     RESPONSIVE ADJUSTMENTS (Macbook & Mobile Overrides)
     ================================================================== */
     

/* ─── MacBook Air 15 inch M2 (1441px - 1728px) ───────────────── */
@media screen and (min-width: 1441px) and (max-width: 1728px) {
  .shining-title-{{ section.id }} {
    font-size: 54px !important;
  }
  .shining-subtitle-{{ section.id }},
  .shining-subtitle-{{ section.id }} p {
    font-size: 18px !important;
    line-height: 1.5 !important;
  }
}


  /* Laptop & Macbook (up to 1440px) */
  @media screen and (max-width: 1440px) {
    .shining-title-{{ section.id }} {
      font-size: 46px !important; /* Forced 46px for Macbook */
    }
    .shining-subtitle-{{ section.id }},
    .shining-subtitle-{{ section.id }} p {
      font-size: 16px !important; /* Forced 16px for Macbook description */
      line-height: 1.5 !important;
    }
  }

  /* Mobile (up to 768px) */
  @media screen and (max-width: 768px) {
    .shining-title-{{ section.id }} {
      font-size: 28px !important; /* Forced 28px for Mobile */
    }
    .shining-subtitle-{{ section.id }},
    .shining-subtitle-{{ section.id }} p {
      font-size: 14px !important; /* Adjusted gracefully for mobile based on 16px desktop */
    }
  }

  .shining-content-box-{{ section.id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.content_gap }}px;
  }

  /* Image Box Styles */
  .shining-image-box-{{ section.id }} {
    flex: 1;
    width: 100%;
    max-width: {{ section.settings.image_max_width }}px;
    height: auto;
    overflow: hidden;
    line-height: 0;
  }

  .shining-image-box-{{ section.id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    {% if section.settings.image_height_fix %}
      aspect-ratio: 840 / 770;
    {% endif %}
  }
{%- endstyle -%}

<section class="section-{{ section.id }}-padding">
  <div class="shining-wrapper-{{ section.id }}">
    
    <!-- Content Column -->
    <div class="shining-content-box-{{ section.id }}">
      {% if section.settings.heading != blank %}
        <h2 class="shining-title-{{ section.id }}">
          {{ section.settings.heading }}
        </h2>
