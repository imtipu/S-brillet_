<script>
  document.addEventListener('DOMContentLoaded', () => {
    const interactors = document.querySelectorAll('.vip-hover-target');
    
    interactors.forEach(el => {
      el.addEventListener('mouseenter', function() {
        const colId = this.getAttribute('data-col');
        document.querySelectorAll(`.vip-tier-card[data-col="${colId}"], .vip-banner-pill-wrapper[data-col="${colId}"], .vip-col-overlay[data-col="${colId}"]`).forEach(target => {
          target.classList.add('is-hovered');
        });
      });
      
      el.addEventListener('mouseleave', function() {
        const colId = this.getAttribute('data-col');
        document.querySelectorAll(`.vip-tier-card[data-col="${colId}"], .vip-banner-pill-wrapper[data-col="${colId}"], .vip-col-overlay[data-col="${colId}"]`).forEach(target => {
          target.classList.remove('is-hovered');
        });
      });

      el.addEventListener('touchstart', function() {
        document.querySelectorAll('.vip-tier-card, .vip-banner-pill-wrapper, .vip-col-overlay').forEach(target => {
          target.classList.remove('is-hovered');
        });
        const colId = this.getAttribute('data-col');
        document.querySelectorAll(`.vip-tier-card[data-col="${colId}"], .vip-banner-pill-wrapper[data-col="${colId}"], .vip-col-overlay[data-col="${colId}"]`).forEach(target => {
          target.classList.add('is-hovered');
        });
      }, { passive: true });
    });
  });
</script>

