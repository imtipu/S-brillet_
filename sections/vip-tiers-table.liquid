<script>
  (() => {
    const initVipTiers = () => {
      const root = document.querySelector('#shopify-section-{{ section.id }} .vip-section-wrapper');
      if (!root || root.dataset.vipInitialized === 'true') return;

      root.dataset.vipInitialized = 'true';

      const wrapper = root.querySelector('.vip-table-scroll-wrapper');
      const interactors = root.querySelectorAll('.vip-hover-target');
      const overlays = root.querySelectorAll('.vip-col-overlay');

      if (!wrapper) return;

      /*
        iPad/Safari can round a duplicated CSS grid differently.
        Measure each REAL top card and make the full-height hover border
        use exactly that card's left position and width.
      */
      const syncColumnOverlays = () => {
        const wrapperRect = wrapper.getBoundingClientRect();

        overlays.forEach(overlay => {
          const colId = overlay.getAttribute('data-col');
          const card = root.querySelector(`.vip-tier-card[data-col="${colId}"]`);
          if (!card) return;

          const cardRect = card.getBoundingClientRect();
          overlay.style.left = `${cardRect.left - wrapperRect.left}px`;
          overlay.style.width = `${cardRect.width}px`;
        });

        /*
          iPad only: position each highlighted banner title from the same REAL top-card
          measurement as the full-height border. This keeps the left/right titles centered
          inside their borders without changing desktop or mobile layout.
        */
        if (window.matchMedia('(min-width: 768px) and (max-width: 1024px)').matches) {
          root.querySelectorAll('.vip-banner-row').forEach(row => {
            const rowRect = row.getBoundingClientRect();

            row.querySelectorAll('.vip-banner-pill-wrapper[data-col]').forEach(pillWrapper => {
              const colId = pillWrapper.getAttribute('data-col');
              const card = root.querySelector(`.vip-tier-card[data-col="${colId}"]`);
              if (!card) return;

              const cardRect = card.getBoundingClientRect();
              pillWrapper.style.left = `${cardRect.left - rowRect.left}px`;
              pillWrapper.style.width = `${cardRect.width}px`;
            });
          });
        } else {
          root.querySelectorAll('.vip-banner-pill-wrapper[data-col]').forEach(pillWrapper => {
            pillWrapper.style.removeProperty('left');
            pillWrapper.style.removeProperty('width');
          });
        }
      };

      const setColumnState = (colId, active) => {
        root.querySelectorAll(`.vip-tier-card[data-col="${colId}"], .vip-banner-pill-wrapper[data-col="${colId}"], .vip-col-overlay[data-col="${colId}"]`).forEach(target => {
          target.classList.toggle('is-hovered', active);
        });
      };

      const clearColumns = () => {
        root.querySelectorAll('.vip-tier-card, .vip-banner-pill-wrapper, .vip-col-overlay').forEach(target => {
          target.classList.remove('is-hovered');
        });
      };

      interactors.forEach(el => {
        el.addEventListener('mouseenter', function() {
          const colId = this.getAttribute('data-col');
          if (colId) setColumnState(colId, true);
        });

        el.addEventListener('mouseleave', function() {
          const colId = this.getAttribute('data-col');
          if (colId) setColumnState(colId, false);
        });

        el.addEventListener('touchstart', function() {
          clearColumns();
          const colId = this.getAttribute('data-col');
          if (colId) setColumnState(colId, true);
        }, { passive: true });
      });

      syncColumnOverlays();
      requestAnimationFrame(syncColumnOverlays);

      window.addEventListener('resize', syncColumnOverlays, { passive: true });
      window.addEventListener('orientationchange', () => {
        setTimeout(syncColumnOverlays, 120);
      }, { passive: true });

      if ('ResizeObserver' in window) {
        const resizeObserver = new ResizeObserver(syncColumnOverlays);
        resizeObserver.observe(wrapper);
      }
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initVipTiers, { once: true });
    } else {
      initVipTiers();
    }

    document.addEventListener('shopify:section:load', initVipTiers);
  })();
</script>

