{% comment %} {%- comment -%}
  VIP Tiers Comparison Table - Granular Device-Specific Image Positioning
{%- endcomment -%}

<style>
  /* Import Libre Caslon Text from Google Fonts for the BRILLET Title */
  @import url('https://fonts.googleapis.com/css2?family=Libre+Caslon+Text:wght@400;500;700&display=swap');

  :root {
    --vip-bg-color: {{ section.settings.bg_color }};
    --vip-text-color: {{ section.settings.text_color }};
    --vip-accent-color: {{ section.settings.accent_color }};
    --vip-border-color: {{ section.settings.border_color }};
  }

  .vip-section-wrapper {
    background-color: var(--vip-bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    font-family: 'Inter', sans-serif;
    width: 100%;
    overflow: hidden;
    /* Master Gap Variable controlled by Shopify Settings */
    --vip-grid-gap: {{ section.settings.column_gap }}px; 
  }

  .vip-container {
    max-width: 1920px;
    margin: 0 auto;
    padding-left: 120px;
    padding-right: 120px;
    box-sizing: border-box;
  }

  /* Table Wrapper holding the Overlays */
  .vip-table-scroll-wrapper {
    position: relative;
    width: 100%;
  }

  /* --- Full Column Hover Overlays --- */
  .vip-column-overlays {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    display: grid;
    grid-template-columns: 301px repeat(3, 1fr);
    column-gap: var(--vip-grid-gap);
    pointer-events: none;
    z-index: 10;
  }

  .vip-col-overlay {
    height: 100%;
    width: 100%;
    border-radius: 14px;
    opacity: 0;
    transition: opacity 0.4s ease;
    padding: 3px;
    background: var(--card-border-gradient);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
  }

  .vip-col-overlay.is-hovered {
    opacity: 1;
  }

  /* --- Top Cards Row --- */
  .vip-cards-row {
    display: grid;
    grid-template-columns: 301px repeat(3, 1fr);
    column-gap: var(--vip-grid-gap);
    margin-bottom: 30px;
  }

  /* FIRST CARD FIX: Figma Accurate Styling */
  .vip-header-spacer-card {
    background-color: var(--vip-accent-color);
    border-radius: 12px;
    padding: 40px 20px;
    box-sizing: border-box;
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    min-height: 250px;
    position: relative;
  }
  
  .vip-spacer-logo {
    width: 80px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 15px;
  }

  .vip-spacer-logo svg {
    width: 100%;
    height: 100%;
  }

  .vip-spacer-title {
    font-family: 'Libre Caslon Text', serif;
    font-size: 40px;
    font-weight: 500;
    color: #FFFFFF;
    letter-spacing: 0;
    margin: 0;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .vip-spacer-subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 20px;
    font-weight: 600;
    color: #FFFFFF;
    opacity: 0.8;
    margin-top: 5px;
    text-transform: uppercase;
    line-height: 1.2;
  }

  /* DYNAMIC VERTICAL DIVIDERS (Persistent on hover) */
  .vip-divider-right::after {
    content: "";
    position: absolute;
    top: 0;
    right: calc(var(--vip-grid-gap) / -2); 
    transform: translateX(50%);
    width: 2px;
    height: 100%;
    background-color: var(--vip-border-color);
    z-index: 15;
  }

  /* Interactive Top Cards */
  .vip-tier-card {
    position: relative;
    border-radius: 12px;
    background-color: #FFFFFF;
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    box-sizing: border-box;
    min-height: 250px;
    padding: 40px 20px;
    cursor: pointer;
    z-index: 1;
  }

  /* Initial State: 4px Gradient Border on Cards */
  .vip-tier-card::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 12px;
    padding: 4px;
    background: var(--card-border-gradient);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
    z-index: 2;
    transition: opacity 0.4s ease;
  }

  /* Hover State: Background Color Gradient Overlay */
  .vip-card-hover-bg {
    position: absolute;
    inset: 0;
    border-radius: 12px;
    background: var(--card-hover-gradient);
    opacity: 0;
    z-index: -1;
    transition: opacity 0.4s ease-in-out;
  }

  /* Hover State: Background Image Overlay (Default Desktop Position) */
  .vip-card-hover-image {
    position: absolute;
    inset: 0;
    border-radius: 12px;
    background-size: 160% 160%;
    background-position: var(--bg-pos-x, 50%) var(--bg-pos-y, 50%);
    background-repeat: no-repeat;
    opacity: 0;
    z-index: 0;
    filter: grayscale(100%) brightness(var(--bg-brightness, 1));
    transition: opacity 0.4s ease-in-out;
  }

  /* Card Content wrapper */
  .vip-card-content {
    position: relative;
    z-index: 3;
        display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    width: 100%;
  }

  .vip-tier-icon-container {
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 15px;
    transition: filter 0.4s ease-in-out;
  }

  .vip-tier-icon-container svg, .vip-tier-icon-container img {
    width: auto;
    height: 90px;
    max-width: 100%;
  }

  .vip-tier-name {
    font-family: 'Libre Caslon Text';
    font-size: 40px;
    font-weight: 500;
    text-transform: uppercase;
    margin: 0;
    letter-spacing: 0.03em;
    color: #1A1A1A;
    transition: color 0.4s ease-in-out;
}

  .vip-tier-sparkles {
    font-size: 20px;
    font-weight: 600;
    opacity: 0.8;
    margin-top: 5px;
    text-transform: uppercase;
    color: #1A1A1A;
    transition: color 0.4s ease-in-out;
  }

  /* -------------------------------------
     HOVER TRIGGER LOGIC
  ------------------------------------- */
  .vip-tier-card.is-hovered { background-color: transparent; }
  .vip-tier-card.is-hovered::before { opacity: 0; }
  .vip-tier-card.is-hovered .vip-card-hover-bg { opacity: 1; }
  .vip-tier-card.is-hovered .vip-card-hover-image { opacity: var(--target-opacity, 1); }
  
  .vip-tier-card.is-hovered .vip-tier-name,
  .vip-tier-card.is-hovered .vip-tier-sparkles {
    color: #FFFFFF !important;
  }
  
  .vip-tier-card.is-hovered .vip-tier-icon-container {
    filter: brightness(0) invert(1) !important;
  }

  /* --- Table Data Area --- */
  .vip-table-area {
    display: flex;
    flex-direction: column;
  }

  /* Interactive Banner Rows */
  .vip-banner-row {
    display: grid;
    grid-template-columns: 301px repeat(3, 1fr);
    column-gap: var(--vip-grid-gap);
    position: relative;
    margin-top: 20px;
    margin-bottom: 10px;
    height: 44px;
  }

  .vip-banner-bg {
    position: absolute;
    top: 0; bottom: 0; left: 0; right: 0;
    background-color: var(--vip-accent-color);
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: flex;
    align-items: center;
    padding-left: 20px;
    border-radius: 4px;
    z-index: 1;
  }

  .vip-banner-pill-wrapper {
    z-index: 2;
    padding: 3px 0;
    opacity: 0;
    visibility: hidden;
    transition: all 0.4s ease-in-out;
    cursor: default;
  }
  
  .vip-banner-pill-wrapper[data-col="1"] { grid-column: 2; }
  .vip-banner-pill-wrapper[data-col="2"] { grid-column: 3; }
  .vip-banner-pill-wrapper[data-col="3"] { grid-column: 4; }

  .vip-banner-pill-wrapper.is-hovered {
    opacity: 1;
    visibility: visible;
  }

  .vip-banner-pill {
    background: var(--pill-color);
    color: #FFFFFF;
    border-radius: 6px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
  }

  /* Data Rows */
  .vip-data-row {
    display: grid;
    grid-template-columns: 301px repeat(3, 1fr);
    column-gap: var(--vip-grid-gap);
    padding:  0px;
    align-items: center;
  }

  .vip-cell-label {
    font-size: 20px;
    font-weight: 500;
    color: #2C2C2C;
    padding-right: 15px;
  }

  .vip-cell-value {
    font-size: 20px;
    font-weight: 500;
    color: #1A1A1A;
    text-align: center;
    position: relative;
    padding: 10px 0;
  }

  /* Inner Vertical Borders for the Rows */
  .vip-cell-value.has-border::before {
    content: '';
    position: absolute;
    left: calc(var(--vip-grid-gap) / -2); 
    transform: translateX(-50%);
    top: 0;
    bottom: 0;
    width: 1px;
    background-color: #E2D3C7;
    opacity: 0.6;
  }

  .vip-empty-dash { color: #CCCCCC; }

  .vip-check-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
  }

  .vip-check-icon svg {
    width: 16px; height: 16px;
    fill: none; stroke: #1A1A1A;
    stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round;
  }

  /* ----------------------------------------------------
     RESPONSIVE MEDIA QUERIES & BACKGROUND OVERRIDES
  ---------------------------------------------------- */
  @media (min-width: 1441px) and (max-width: 1728px) {
    .vip-container { padding-left: 120px; padding-right: 120px; }
    .vip-cards-row, .vip-banner-row, .vip-data-row, .vip-column-overlays { grid-template-columns: 260px repeat(3, 1fr); }
    .vip-header-spacer-card, .vip-tier-card { min-height: 220px; padding: 30px 15px; }

    /* Large MacBook Pro (14"/16") Image Position Override - uses Laptop values */
    .vip-card-hover-image {
      background-size: 160% 160%;
      background-position: var(--bg-pos-x-laptop, 50%) var(--bg-pos-y-laptop, 50%);
    }

    .vip-spacer-title { font-size: 34px; }
    .vip-spacer-subtitle { font-size: 18px; }
    .vip-spacer-logo { width: 70px; height: 70px; }
    .vip-tier-name { font-size: 36px; }
    .vip-cell-label { font-size: 18px; }
    .vip-cell-value { font-size: 18px; }
  }

  /* MACBOOK & LAPTOP (1025px - 1440px) */
  @media (min-width: 1025px) and (max-width: 1440px) {
    .vip-section-wrapper { --vip-grid-gap: 15px; }
    .vip-container { padding-left: 120px; padding-right: 120px; }
    .vip-cards-row, .vip-banner-row, .vip-data-row, .vip-column-overlays { grid-template-columns: 220px repeat(3, 1fr); }
    .vip-header-spacer-card, .vip-tier-card { min-height: 200px; padding: 25px 10px; }
    .vip-divider-right::after { right: -8.5px; } 
    
    /* Laptop Image Position Override */
    .vip-card-hover-image {
      background-size: 160% 160%;
      background-position: var(--bg-pos-x-laptop, 50%) var(--bg-pos-y-laptop, 50%);
    }

    .vip-spacer-title { font-size: 28px; }
    .vip-spacer-subtitle { font-size: 14px; }
    .vip-spacer-logo { width: 60px; height: 60px; }
    .vip-tier-name { font-size: 32px; }
    .vip-cell-label { font-size: 16px; }
    .vip-cell-value { font-size: 16px; }
    .vip-banner-bg { font-size: 13px; padding-left: 15px; }
    .vip-banner-pill { font-size: 12px; }
  }

  /* iPAD & TABLET (768px - 1024px) */
  @media (min-width: 768px) and (max-width: 1024px) {
    .vip-section-wrapper { --vip-grid-gap: 10px; }
    .vip-container { padding-left: 40px; padding-right: 40px; }
    .vip-cards-row, .vip-banner-row, .vip-data-row, .vip-column-overlays { grid-template-columns: 180px repeat(3, 1fr); }
    .vip-header-spacer-card, .vip-tier-card { min-height: 180px; padding: 20px 8px; }
    .vip-divider-right::after { right: -6px; }

    /* Tablet Image Position Override */
    .vip-card-hover-image {
      background-size: 160% 160%;
      background-position: var(--bg-pos-x-tablet, 50%) var(--bg-pos-y-tablet, 50%);
    }

    .vip-spacer-title { font-size: 22px; }
    .vip-spacer-subtitle { font-size: 11px; }
    .vip-spacer-logo { width: 50px; height: 50px; margin-bottom: 8px; }
    .vip-tier-name { font-size: 28px; }
    .vip-tier-sparkles { font-size: 11px; }
    .vip-cell-label { font-size: 14px; }
    .vip-cell-value { font-size: 14px; }
    .vip-banner-row { height: 38px; }
    .vip-banner-bg { font-size: 12px; padding-left: 10px; }
    .vip-banner-pill { font-size: 11px; }
  }

  /* MOBILE LAYOUT */
  @media (max-width: 767px) {
    .vip-section-wrapper { --vip-grid-gap: 4px; }
    .vip-container { padding-left: 5px; padding-right: 5px; }
    .vip-table-scroll-wrapper { width: 100%; overflow-x: hidden; padding-bottom: 10px; }
    
    .vip-cards-row, .vip-banner-row, .vip-data-row, .vip-column-overlays { 
      grid-template-columns: 1.4fr 1fr 1fr 1fr; 
      width: 100%; 
    }
    
    .vip-col-overlay { border-radius: 8px; padding: 2px; }
    .vip-cards-row { margin-bottom: 15px; }
    .vip-divider-right::after { width: 1px; right: -2.5px; }

    .vip-header-spacer-card { display: flex; min-height: 100px; padding: 10px 2px; border-radius: 6px; }
    .vip-spacer-logo { display: flex; width: 28px; height: 28px; margin-bottom: 4px; border: none; }
    .vip-spacer-title { font-size: 10px; letter-spacing: 0; line-height: 1.2; word-break: break-word;}
    .vip-spacer-subtitle { font-size: 6.5px; margin-top: 2px; }

    .vip-tier-card { min-height: 100px; padding: 10px 2px; border-radius: 6px; }
    .vip-tier-card::before { border-radius: 6px; padding: 2px; }
    .vip-card-hover-bg, .vip-card-hover-image { border-radius: 6px; }
    
    /* Mobile Image Position Override */
    /* Oversized (160%) instead of `cover` so both axes always have overflow room to pan -
       `cover` alone can leave zero vertical overflow on short/square mobile cards, which is
       why the Y-axis slider looked "stuck" in the center before. */
    .vip-card-hover-image {
      background-size: 160% 160%;
      background-position: var(--bg-pos-x-mobile, 50%) var(--bg-pos-y-mobile, 50%);
    }

    .vip-tier-name { font-size: 9px; letter-spacing: 0; word-break: break-word; line-height: 1.1;}
    .vip-tier-sparkles { font-size: 6px; margin-top: 4px; }
    .vip-tier-icon-container { height: 26px; margin-bottom: 6px; }
    .vip-tier-icon-container svg, .vip-tier-icon-container img { height: 22px; max-width: 100%; }

    .vip-banner-row { height: auto; min-height: 26px; margin-top: 15px; margin-bottom: 5px; }
    .vip-banner-bg { font-size: 7.5px; padding-left: 4px; border-radius: 3px; letter-spacing: 0; line-height: 1.2; }
    .vip-banner-pill-wrapper { padding: 1px 0; }
    .vip-banner-pill { font-size: 7px; border-radius: 3px; letter-spacing: 0; padding: 2px; line-height: 1.2; text-align: center; }

    .vip-data-row { padding: 4px 0; }
    .vip-cell-label { font-size: 8px; padding-right: 2px; line-height: 1.3; }
    .vip-cell-value { font-size: 8.5px; padding: 6px 1px; line-height: 1.3; word-break: break-word; }

    .vip-check-icon { width: 14px; height: 14px; }
    .vip-check-icon svg { width: 12px; height: 12px; stroke-width: 2; }
  }
</style>

<section class="vip-section-wrapper">
  <div class="vip-container">
    <div class="vip-table-scroll-wrapper">
      
      <div class="vip-column-overlays">
        <div></div> <div class="vip-col-overlay vip-hover-target" data-col="1" style="--card-border-gradient: {{ section.settings.tier1_border_grad }};"></div>
        <div class="vip-col-overlay vip-hover-target" data-col="2" style="--card-border-gradient: {{ section.settings.tier2_border_grad }};"></div>
        <div class="vip-col-overlay vip-hover-target" data-col="3" style="--card-border-gradient: {{ section.settings.tier3_border_grad }};"></div>
      </div>

      <div class="vip-cards-row">
        
        <div class="vip-header-spacer-card vip-divider-right">
          <div class="vip-spacer-logo">
            <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M29.2893 3H70.7107L97 29.2893V70.7107L70.7107 97H29.2893L3 70.7107V29.2893L29.2893 3Z" stroke="#FFFFFF" stroke-width="4"/>
              <text x="50%" y="54%" dominant-baseline="middle" text-anchor="middle" fill="#FFFFFF" font-size="44" font-family="'Libre Caslon Text', serif" font-weight="500">S</text>
            </svg>
          </div>
          <h3 class="vip-spacer-title">{{ section.settings.spacer_title }}</h3>
          <p class="vip-spacer-subtitle">{{ section.settings.spacer_subtitle }}</p>
        </div>

        <div class="vip-tier-card vip-hover-target vip-divider-right" data-col="1" style="
            --card-border-gradient: {{ section.settings.tier1_border_grad }}; 
            --card-hover-gradient: {{ section.settings.tier1_hover_grad }}; 
            --bg-pos-x: {{ section.settings.tier1_pos_x }}%; 
            --bg-pos-y: {{ section.settings.tier1_pos_y }}%; 
            --bg-pos-x-laptop: {{ section.settings.tier1_pos_x_laptop }}%; 
            --bg-pos-y-laptop: {{ section.settings.tier1_pos_y_laptop }}%; 
            --bg-pos-x-tablet: {{ section.settings.tier1_pos_x_tablet }}%; 
            --bg-pos-y-tablet: {{ section.settings.tier1_pos_y_tablet }}%; 
            --bg-pos-x-mobile: {{ section.settings.tier1_pos_x_mobile }}%; 
            --bg-pos-y-mobile: {{ section.settings.tier1_pos_y_mobile }}%;
        ">
          <div class="vip-card-hover-bg"></div>
          {% if section.settings.tier1_hover_img != blank %}
          <div class="vip-card-hover-image" style="background-image: url('{{ section.settings.tier1_hover_img | img_url: '400x' }}'); mix-blend-mode: {{ section.settings.tier1_blend }}; --target-opacity: {{ section.settings.tier1_opacity | divided_by: 100.0 }}; --bg-brightness: {{ section.settings.tier1_brightness | divided_by: 100.0 }};"></div>
          {% endif %}
          <div class="vip-card-content">
            <div class="vip-tier-icon-container">
              {% if section.settings.tier1_svg != blank %}
                {{ section.settings.tier1_svg }}
              {% elsif section.settings.tier1_icon != blank %}
                <img src="{{ section.settings.tier1_icon | img_url: '120x' }}" alt="{{ section.settings.tier1_name }}" loading="lazy">
              {% else %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              {% endif %}
            </div>
            <div>
              <h3 class="vip-tier-name">{{ section.settings.tier1_name }}</h3>
              <div class="vip-tier-sparkles">{{ section.settings.tier1_sub }}</div>
            </div>
          </div>
        </div>

        <div class="vip-tier-card vip-hover-target vip-divider-right" data-col="2" style="
            --card-border-gradient: {{ section.settings.tier2_border_grad }}; 
            --card-hover-gradient: {{ section.settings.tier2_hover_grad }};
            --bg-pos-x: {{ section.settings.tier2_pos_x }}%; 
            --bg-pos-y: {{ section.settings.tier2_pos_y }}%; 
            --bg-pos-x-laptop: {{ section.settings.tier2_pos_x_laptop }}%; 
            --bg-pos-y-laptop: {{ section.settings.tier2_pos_y_laptop }}%; 
            --bg-pos-x-tablet: {{ section.settings.tier2_pos_x_tablet }}%; 
            --bg-pos-y-tablet: {{ section.settings.tier2_pos_y_tablet }}%; 
            --bg-pos-x-mobile: {{ section.settings.tier2_pos_x_mobile }}%; 
            --bg-pos-y-mobile: {{ section.settings.tier2_pos_y_mobile }}%;
        ">
          <div class="vip-card-hover-bg"></div>
          {% if section.settings.tier2_hover_img != blank %}
          <div class="vip-card-hover-image" style="background-image: url('{{ section.settings.tier2_hover_img | img_url: '400x' }}'); mix-blend-mode: {{ section.settings.tier2_blend }}; --target-opacity: {{ section.settings.tier2_opacity | divided_by: 100.0 }}; --bg-brightness: {{ section.settings.tier2_brightness | divided_by: 100.0 }};"></div>
          {% endif %}
          <div class="vip-card-content">
            <div class="vip-tier-icon-container">
              {% if section.settings.tier2_svg != blank %}
                {{ section.settings.tier2_svg }}
              {% elsif section.settings.tier2_icon != blank %}
                <img src="{{ section.settings.tier2_icon | img_url: '120x' }}" alt="{{ section.settings.tier2_name }}" loading="lazy">
              {% else %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v20M2 12h20M12 2l4 6 6 4-6 4-4 6-4-6-6-4 6-4z"/></svg>
              {% endif %}
            </div>
            <div>
              <h3 class="vip-tier-name">{{ section.settings.tier2_name }}</h3>
              <div class="vip-tier-sparkles">{{ section.settings.tier2_sub }}</div>
            </div>
          </div>
        </div>

