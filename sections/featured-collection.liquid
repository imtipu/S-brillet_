{{ 'component-product-inventory.css' | asset_url | stylesheet_tag }}
{{ 'featured-collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'featured-collection.js' | asset_url }}" defer="defer"></script>

{% liquid
  assign enable_slider = section.settings.enable_slider
  assign mobile_disable_slider = section.settings.mobile_disable_slider
  assign current_collection = collections[section.settings.collection]
  assign items_per_row = section.settings.items_per_row
  assign product_to_show = section.settings.product_to_show | default: 8
  
  comment
    Keep Swiper enabled when the section slider setting is enabled.
    This prevents fewer than 5 products from stretching to full width.
  endcomment

  assign card_style = section.settings.pcard_layout | default: settings.pcard_layout
  assign image_ratio = section.settings.pcard_image_ratio
  assign show_vendor = section.settings.show_vendor
  assign hide_title = section.settings.hide_title
  assign use_scroll_mobile = section.settings.use_scroll_mobile
  
  assign container = section.settings.container
  if container == 'w-full'
    assign container = 'container-full'
  endif

  assign classes = 'm-featured-collection m-swiper-overflow'
  if section.settings.custom_class != blank
    assign classes = classes | append: ' ' | append: section.settings.custom_class
  endif
%}

<style>
  #m-section--{{ section.id }} {
    --column-gap: {{ section.settings.item_gap }}px;
    --column-gap-mobile: {{ section.settings.item_gap_mobile }}px;
    --items: {{ items_per_row }};
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
    overflow: visible !important;
  }

  #m-section--{{ section.id }} .m-section-py {
    max-width: 1920px;
    margin-left: auto;
    margin-right: auto;
    padding-top: var(--section-padding-top, 80px);
    padding-bottom: var(--section-padding-bottom, 80px);
    overflow: visible !important;
  }

  /* ─── Section header ─────────────────────────────────────────── */
  #m-section--{{ section.id }} .m-section-header-custom {
    padding: 0 120px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 40px;
    position: relative;
    z-index: 5;
  }

  #m-section--{{ section.id }} .m-section__heading {
    font-family: "Libre Caslon Text", serif;
    font-size: 64px;
    font-weight: 400;
    line-height: 1.23;
    color: #2C2C2C;
    text-transform: uppercase;
    margin: 0;
  }

  /* ─── Nav arrows ─────────────────────────────────────────────── */
  #m-section--{{ section.id }} .m-slider-nav-custom {
    display: flex;
    gap: 12px;
  }

  #m-section--{{ section.id }} .m-slider-btn {
    cursor: pointer;
    width: 24px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.3s ease;
    z-index: 10;
    position: relative;
    pointer-events: auto;
    opacity: 1;
  }

  #m-section--{{ section.id }} .m-slider-btn.swiper-button-disabled {
    opacity: 0.2 !important;
    cursor: default !important;
    pointer-events: none !important;
  }

  #m-section--{{ section.id }} .m-slider-btn img,
  #m-section--{{ section.id }} .m-slider-btn svg {
    width: 100%;
    height: auto;
    pointer-events: none;
    display: block;
  }

  /*
    ─── .m-slider-clip-x ─────────────────────────────────────────
    Clips horizontally (peek card cut at edge) but keeps vertical
    space open for the wishlist heart above card top.
    padding-top + negative margin-top trick extends clip window upward.
  */
  #m-section--{{ section.id }} .m-slider-clip-x {
    overflow: hidden;
    padding-top: 22px;
    margin-top: -22px;
    padding-bottom: 2px;
    margin-bottom: -2px;
  }

  /* ─── Product list wrapper ───────────────────────────────────── */
  #m-section--{{ section.id }} .m-product-list-wrapper {
    padding: 0 120px;
    overflow: visible;
  }

  #m-section--{{ section.id }} .m-mixed-layout__wrapper {
    overflow: visible !important;
  }

  /* No CSS gap — Swiper spaceBetween handles spacing */
  #m-section--{{ section.id }} .swiper-wrapper {
    gap: 0 !important;
  }

  #m-section--{{ section.id }} .swiper-slide {
    box-sizing: border-box;
    overflow: visible;
  }

  /* ─── CTA button ─────────────────────────────────────────────── */
  #m-section--{{ section.id }} .m-bestseller-btn-wrapper {
    padding-left: 120px;
    padding-right: 120px;
    margin-top: 40px;
  }

  #m-section--{{ section.id }} .m-custom-btn {
    
    width: 390px;
    height: 55px;
    background: #2C2C2C;
    color: #FFFFFF;
    font-size: 20px;
    font-weight: 300;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: background 0.3s;
  }

  #m-section--{{ section.id }} .m-custom-btn:hover {
    background:   linear-gradient(135deg, #947863, #E9DDD4, #947863) !important;

  
  }


  /* ─── MacBook Air 15" M2 ─────────────────────────────────────── */
@media (min-width: 144px) and (max-width: 1728px) {
  #m-section--{{ section.id }} .m-section__heading {
    font-size: 54px;
  }

  #m-section--{{ section.id }} .m-custom-btn {
    width: 320px;
    height: 55px;
    font-size: 18px;
  }
}


  /* ─── mac ≤1470px ─────────────────────────────────────────── */
   @media (max-width: 1440px) {

     #m-section--{{ section.id }} .m-section__heading {
      font-size : 46px;
    }

     #m-section--{{ section.id }} .m-custom-btn {
    width: 240px;
    height: 55px;
    font-size : 16px;
    
  }
  }



  /* ─── Tablet ≤1023px ─────────────────────────────────────────── */
  @media (max-width: 1023px) {
    #m-section--{{ section.id }} .m-section-header-custom,
    #m-section--{{ section.id }} .m-product-list-wrapper,
    #m-section--{{ section.id }} .m-bestseller-btn-wrapper {
      padding-left: 40px;
      padding-right: 40px;
    }
    #m-section--{{ section.id }} .m-section__heading {
      font-size: 40px;
    }
  }

  /* ─── Mobile ≤767px ──────────────────────────────────────────── */
  @media (max-width: 767px) {
    #m-section--{{ section.id }} .m-section-header-custom,
    #m-section--{{ section.id }} .m-product-list-wrapper,
    #m-section--{{ section.id }} .m-bestseller-btn-wrapper {
      padding-left: 20px !important;
      padding-right: 20px !important;
    }
    #m-section--{{ section.id }} .m-section__heading {
      font-size: 28px;
    }

    /* Extra vertical room so wishlist heart is never clipped */
    #m-section--{{ section.id }} .m-slider-clip-x {
      padding-top: 28px;
      margin-top: -28px;
    }

    /* Shop button full width on mobile */
    #m-section--{{ section.id }} .m-custom-btn {
      width: 100%;
      box-sizing: border-box;
    }
    
  }
</style>

{% paginate current_collection.products by product_to_show %}
  <section id="m-section--{{ section.id }}" class="m-section m-featured-collection-section">
    <m-featured-collection
      class="{{ classes }}"
      data-id="{{ section.id }}"
      data-enable-slider="{{ enable_slider }}"
      data-items="{{ items_per_row }}"
      {% if enable_slider %}
        data-show-navigation="{{ section.settings.show_navigation }}"
      {% endif %}
    >
      <div class="m-section-py">

        <!-- Header: heading + nav arrows side by side -->
        <div class="m-section-header-custom">
          <h2 class="m-section__heading">
            {{ section.settings.heading }}
          </h2>

          {% if enable_slider and section.settings.show_navigation %}
            <div class="m-slider-controls m-slider-nav-custom">
              <div class="m-slider-controls__button-prev m-slider-btn swiper-button-disabled" aria-label="Previous slide">
                {% if section.settings.icon_left != blank %}
                  {% comment %} <img src="{{ section.settings.icon_left | image_url: width: 48 }}" alt="Previous" width="24" height="20" loading="lazy"> {% endcomment %}
                  <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24" height="20" viewBox="0 0 24 20" fill="none">
<rect width="17" height="20" transform="matrix(-1 0 0 1 24 0)" fill="url(#pattern0_7751_6052)" fill-opacity="0.5"/>
<rect width="17" height="20" transform="matrix(-1 0 0 1 17 0)" fill="url(#pattern1_7751_6052)" fill-opacity="0.5"/>
<defs>
<pattern id="pattern0_7751_6052" patternContentUnits="objectBoundingBox" width="1" height="1">
<use xlink:href="#image0_7751_6052" transform="matrix(0.00452489 0 0 0.00384615 0 -0.00384615)"/>
</pattern>
<pattern id="pattern1_7751_6052" patternContentUnits="objectBoundingBox" width="1" height="1">
<use xlink:href="#image0_7751_6052" transform="matrix(0.00452489 0 0 0.00384615 0 -0.00384615)"/>
</pattern>
<image id="image0_7751_6052" width="221" height="262" preserveAspectRatio="none" xlink:href="data:image/png;base64,"/>
</defs>
</svg>
                {% else %}
             <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24" height="20" viewBox="0 0 24 20" fill="none">
<rect width="17" height="20" transform="matrix(-1 0 0 1 24 0)" fill="url(#pattern0_7751_6052)" fill-opacity="0.5"/>
<rect width="17" height="20" transform="matrix(-1 0 0 1 17 0)" fill="url(#pattern1_7751_6052)" fill-opacity="0.5"/>
<defs>
<pattern id="pattern0_7751_6052" patternContentUnits="objectBoundingBox" width="1" height="1">
<use xlink:href="#image0_7751_6052" transform="matrix(0.00452489 0 0 0.00384615 0 -0.00384615)"/>
</pattern>
<pattern id="pattern1_7751_6052" patternContentUnits="objectBoundingBox" width="1" height="1">
<use xlink:href="#image0_7751_6052" transform="matrix(0.00452489 0 0 0.00384615 0 -0.00384615)"/>
</pattern>
<image id="image0_7751_6052" width="221" height="262" preserveAspectRatio="none" xlink:href="data:image/png;base64,"/>
</defs>
</svg>
                {% endif %}
              </div>
              <div class="m-slider-controls__button-next m-slider-btn" aria-label="Next slide">
                {% if section.settings.icon_right != blank %}
                  {% comment %} <img src="{{ section.settings.icon_right | image_url: width: 48 }}" alt="Next" width="24" height="20" loading="lazy"> {% endcomment %}
                   <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24" height="20" viewBox="0 0 24 20" fill="none">
<rect width="17" height="20" fill="url(#pattern0_7751_6057)" fill-opacity="0.5"/>
<rect x="7" width="17" height="20" fill="url(#pattern1_7751_6057)" fill-opacity="0.5"/>
<defs>
<pattern id="pattern0_7751_6057" patternContentUnits="objectBoundingBox" width="1" height="1">
<use xlink:href="#image0_7751_6057" transform="matrix(0.00452489 0 0 0.00384615 0 -0.00384615)"/>
</pattern>
<pattern id="pattern1_7751_6057" patternContentUnits="objectBoundingBox" width="1" height="1">
<use xlink:href="#image0_7751_6057" transform="matrix(0.00452489 0 0 0.00384615 0 -0.00384615)"/>
</pattern>
<image id="image0_7751_6057" width="221" height="262" preserveAspectRatio="none" xlink:href="data:image/png;base64,"/>
</defs>
</svg>
                {% else %}
                 <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24" height="20" viewBox="0 0 24 20" fill="none">
<rect width="17" height="20" fill="url(#pattern0_7751_6057)" fill-opacity="0.5"/>
<rect x="7" width="17" height="20" fill="url(#pattern1_7751_6057)" fill-opacity="0.5"/>
<defs>
<pattern id="pattern0_7751_6057" patternContentUnits="objectBoundingBox" width="1" height="1">
<use xlink:href="#image0_7751_6057" transform="matrix(0.00452489 0 0 0.00384615 0 -0.00384615)"/>
</pattern>
<pattern id="pattern1_7751_6057" patternContentUnits="objectBoundingBox" width="1" height="1">
<use xlink:href="#image0_7751_6057" transform="matrix(0.00452489 0 0 0.00384615 0 -0.00384615)"/>
</pattern>
<image id="image0_7751_6057" width="221" height="262" preserveAspectRatio="none" xlink:href="data:image/png;base64,"/>
</defs>
</svg>
                {% endif %}
              </div>
            </div>
          {% endif %}
        </div>

        <div class="m-slider-clip-x">
          <div class="m-product-list-wrapper">
            <div class="m-mixed-layout__wrapper m-product-list">
              <div class="swiper-wrapper">
                {% if current_collection != blank %}
                  {% for product in current_collection.products limit: product_to_show %}
                    <div class="swiper-slide m:column">
                      {% render 'product-card-1',
                        product: product,
                        image_ratio: image_ratio,
                        show_vendor: show_vendor,
                        hide_title: hide_title
                      %}
                    </div>
                  {% endfor %}
                {% else %}
                  {% for i in (1..product_to_show) %}
                    <div class="swiper-slide">
                      <div class="m-product-card--placeholder">
                        {{ 'product-' | append: i | placeholder_svg_tag: 'm-placeholder-svg' }}
                      </div>
                    </div>
                  {% endfor %}
                {% endif %}
              </div>
            </div>
          </div>
        </div>

        {% if section.settings.button_text != blank %}
          <div class="m-bestseller-btn-wrapper">
            <a href="{{ current_collection.url | default: '#' }}" class="m-custom-btn">
              {{ section.settings.button_text }}
            </a>
          </div>
        {% endif %}

      </div>
    </m-featured-collection>
  </section>
{% endpaginate %}

<script>
(function () {
  var SECTION_ID = '{{ section.id }}';
  var GAP        = {{ section.settings.item_gap | default: 20 }};

  /*
    Breakpoints:
      ≥1280px  → 4.15 slides, group 1  (4 full + peek of 5th)
      768-1279 → 3.15 slides, group 1  (MacBook / tablet)
      <768px   → 1.2  slides, group 1  (1 full card + clear peek of next;
                                         each swipe advances exactly 1 card
                                         so the new card becomes full + its
                                         neighbour is the peek)
  */

  function getSwiperInstance (sectionEl) {
    var el = sectionEl.querySelector('m-featured-collection');
    if (!el) return null;

    if (el.swiper && el.swiper.wrapperEl) return el.swiper;

    var keys = Object.keys(el);
    for (var i = 0; i < keys.length; i++) {
      var v = el[keys[i]];
      if (v && typeof v === 'object' && v.wrapperEl && v.slides) return v;
    }

    var containers = sectionEl.querySelectorAll(
      '.swiper-container, .m-mixed-layout__wrapper, .m-product-list'
    );
    for (var j = 0; j < containers.length; j++) {
      if (containers[j].swiper && containers[j].swiper.wrapperEl) {
        return containers[j].swiper;
      }
    }

    return null;
  }

  function patchSwiper () {
    var sectionEl = document.getElementById('m-section--' + SECTION_ID);
    if (!sectionEl) return false;

    var swiper = getSwiperInstance(sectionEl);
    if (!swiper) return false;

    swiper.params.slidesPerView  = 4.15;
    swiper.params.slidesPerGroup = 1;
    swiper.params.spaceBetween   = GAP;
    swiper.params.breakpoints    = {
      0: {
        slidesPerView  : 1.2,
        slidesPerGroup : 1,
        spaceBetween   : GAP
      },
      768: {
        slidesPerView  : 3.15,
        slidesPerGroup : 1,
        spaceBetween   : GAP
      },
      1280: {
        slidesPerView  : 4.15,
        slidesPerGroup : 1,
        spaceBetween   : GAP
      }
    };

    swiper.update();
    return true;
  }

  function tryPatch (attempts) {
    if (attempts <= 0) return;
    if (!patchSwiper()) {
      setTimeout(function () { tryPatch(attempts - 1); }, 200);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () { tryPatch(30); });
  } else {
    tryPatch(30);
  }

  document.addEventListener('shopify:section:load', function (e) {
    if (e.detail && e.detail.sectionId === SECTION_ID) {
      setTimeout(function () { tryPatch(30); }, 300);
    }
  });
})();
</script>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "BEST SELLING BRILLIANT DESIGNS"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_to_show",
      "label": "Products to show",
      "min": 2, "max": 20, "step": 1, "default": 8
    },
    {
      "type": "range",
      "id": "items_per_row",
      "label": "Products per row",
      "min": 2, "max": 6, "step": 1, "default": 5
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "Column gap",
      "min": 0, "max": 100, "step": 2, "default": 20, "unit": "px"
    },
    {
      "type": "header",
      "content": "Slider Settings"
    },
    {
      "type": "checkbox",
      "id": "enable_slider",
      "label": "Enable slider",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "icon_left",
      "label": "Custom Left Icon (Image)"
    },
    {
      "type": "image_picker",
      "id": "icon_right",
      "label": "Custom Right Icon (Image)"
    },
    {
      "type": "header",
      "content": "Button Settings"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button label",
      "default": "SHOP BESTSELLERS"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "default": 80, "min": 0, "max": 150, "step": 2, "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "default": 80, "min": 0, "max": 150, "step": 2, "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
