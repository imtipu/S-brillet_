{% comment %} {%- liquid 
  assign st = section.settings

  assign animation_effect = settings.animations
  assign animated = false
  if animation_effect != 'none'
    assign animated = true
    if section.settings.animations != 'inherit'
      assign animation_effect = section.settings.animations
    endif
  endif

  assign container = section.settings.container
  if container == 'w-full'
    assign container = 'container-full'
  endif
-%}
<section data-section-type="contact-page" data-section-id={{ section.id }} class="m-section m-contact-form">
  <div class="{{ container }}">
    <div class="m-row{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}">
      <div class="m-contact-form__main{% if section.blocks.size > 0 %} xl:m:w-8/12 m:w-full{% else %} m-contact-form__main--full xl:m:w-6/12 m:w-full{% endif %}">
        {%- if st.title != blank -%}
        <h3 class="m-contact-form__heading">{{ st.title }}</h3>
        {%- endif -%}
        {%- if st.description != blank -%}
        <div class="m-contact-form__description rte">{{ st.description }}</div>
        {%- endif -%}
        {%- form 'contact' -%}
          {%- capture success_message -%}
            {{ 'contact.form.post_success' | t }}
          {%- endcapture -%}
          {% render 'form__success', form: form, success_message: success_message %}
          {% render 'form__error', form: form %}
          <div class="m-contact-form__form-fields m:flex m:flex-wrap">
            {% if section.settings.show_name %}
            <div class="m-contact-form__name m:column m:w-full md:m:w-1/2">
              <input type="text" class="form-field form-field--input" name="contact[name]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" id="inputName" placeholder="{{ 'contact.form.name' | t }}">
            </div>
            {% endif %}
            <div class="m-contact-form__email m:column m:w-full md:m:w-1/2">
              <input type="email" class="form-field form-field--input" name="contact[email]" required autocorrect="off" autocapitalize="off" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" id="inputEmail" placeholder="{{ 'contact.form.email' | t }}">
            </div>
            {% if section.settings.show_phone %}
            <div class="m-contact-form__phone m:column m:w-full">
              <input type="tel" class="form-field form-field--input" name="contact[phone]" autocorrect="off" autocapitalize="off" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}" id="inputPhone" placeholder="{{ 'contact.form.phone' | t }}">
            </div>
            {% endif %}
          </div>
          <div class="m-contact-form__message m:w-full">
            <textarea class="form-field form-field--input" name="contact[body]" rows="6" required placeholder="{{ 'contact.form.message' | t }}" id="textareaMessage">{%- if form.body -%}{{ form.body }}{%- endif -%}</textarea>
          </div>
          {% if section.settings.show_signup_email %}
          <div class="m-contact-form__save">
            <label class="form-field--checkbox">
              <input type="checkbox" name="contact[saveInfo]">
              <span class="form-field--checkbox__label">{{ 'contact.form.save_infor_message' | t }}</span>
              <span class="form-field--checkbox__icon">
                <svg
                  class="m-svg-icon--medium"
                  xmlns="http://www.w3.org/2000/svg"
                  aria-hidden="true"
                  focusable="false"
                  fill="none"
                  viewBox="0 0 20 20"
                >
                  <path d="M18.5 1.5H1.5L1.5 18.5H18.5V1.5ZM1.5 0.5C0.947715 0.5 0.5 0.947715 0.5 1.5V18.5C0.5 19.0523 0.947715 19.5 1.5 19.5H18.5C19.0523 19.5 19.5 19.0523 19.5 18.5V1.5C19.5 0.947715 19.0523 0.5 18.5 0.5H1.5Z" fill-rule="evenodd" fill="currentColor"/>
                  <path d="M14.9975 6.09084C15.201 6.27746 15.2147 6.59375 15.0281 6.79728L8.91631 13.4627C8.82231 13.5652 8.68987 13.6239 8.55079 13.6247C8.41172 13.6256 8.27857 13.5684 8.18335 13.4671L4.99513 10.0731C4.80606 9.87179 4.81596 9.55536 5.01723 9.3663C5.21849 9.17723 5.53492 9.18713 5.72399 9.3884L8.54335 12.3897L14.291 6.12145C14.4776 5.91791 14.7939 5.90421 14.9975 6.09084Z" fill="currentColor"/>
                </svg>
              </span>
            </label>
          </div>
          {% endif %}
          <button type="submit" class="m-button m-button--primary">{{ 'contact.form.send' | t }}</button>
        {%- endform -%}
      </div>
      {% if section.blocks.size > 0 %}
      <div class="m-contact-form__info m:flex m:flex-wrap m:w-full xl:m:w-4/12">
        {% for block in section.blocks %}
          <div class="m-info-box m:column m:w-full md:m:w-1/2 lg:m:w-3/12 xl:m:w-full">
            <h3>{{ block.settings.title }}</h3>
            {% case block.type %}
              {% when 'textblock' %}
                <div class="m-info-box__content rte">{{ block.settings.content }}</div>
              {% else %}
                {% render 'social-media-links' %}
            {% endcase %}
          </div>
        {% endfor %}
      </div>
      {% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Contact form",
  "settings": [
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container type",
      "default": "container-fluid",
      "options": [
        {
          "value": "container-fluid",
          "label": "Default"
        },
        {
          "value": "w-full",
          "label": "Full width"
        },
        {
          "value": "container",
          "label": "Use container box"
        }
      ]
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "We would love to hear from you."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>If you’ve got great products your making or looking to work with us then drop us a line.</p>"
    },
    {
      "type": "header",
      "content": "Contact form"
    },
    {
      "type": "checkbox",
      "id": "show_name",
      "label": "Show field name",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Show field phone number",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_signup_email",
      "label": "Show email sign up",
      "default": true
    },
    {
      "type": "header",
      "content": "Animations"
    },
    {
      "type": "select",
      "id": "animations",
      "label": "Visible in the view animation",
      "default": "inherit",
      "options": [
        {
          "value": "inherit",
          "label": "Inherit global setting"
        },
        {
          "value": "fade-in",
          "label": "Fade in"
        },
        {
          "value": "fade-in-up",
          "label": "Fade in up"
        },
        {
          "value": "fade-in-left",
          "label": "Fade in left"
        },
        {
          "value": "fade-in-right",
          "label": "Fade in right"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "textblock",
      "name": "Text block",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Block Title"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>7895 Piermont Dr NE Albuquerque, NM 198866, <a href='#'>See Our Stores</a></p>"
        }
      ]
    },
    {
      "type": "socialmedia",
      "name": "Social media",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Social Media"
        }
      ]
    }
  ]
}
{% endschema %} {% endcomment %}




{% style %}
.section-{{ section.id }} {
  max-width: 1920px;
  margin: 0 auto;
  padding: 80px 20px;
  background: {{ section.settings.bg_color }};
}

.section-{{ section.id }} .container {
  max-width: 1720px;
  margin: 0 auto;
  text-align: center;
}

/* Heading */
.section-{{ section.id }} .section-heading {
  font-size: 64px;
  font-weight: 400;
  font-family: 'Libre Caslon Text', serif;
  color: #2C2C2C;
  margin-bottom: 10px;
}

/* Description */
.section-{{ section.id }} .section-description {
  font-size: 20px;
  font-family: 'Inter', sans-serif;
  font-weight: 400;
  color: #2C2C2C;
  margin-bottom: 10px;
}

.section-{{ section.id }} .section-description-2 {
  font-size: 20px;
  font-family: 'Inter', sans-serif;
  font-weight: 400;
  color: #2C2C2C;
  margin-bottom: 40px;
}

/* Cards */
.section-{{ section.id }} .contact-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-bottom: 60px;
}



.section-{{ section.id }} .contact-card {
    border: 1px solid #E5E5E5;
    padding: 30px 20px;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
        background: #ffff;
}
.contact-card img {
    width: 123px;
    
}
.section-{{ section.id }} .contact-card h4 {
  margin: 15px 0 10px;
  font-size: 20px;
  font-weight: 500;
  font-family: 'Inter', sans-serif;
  color: #2C2C2C;
}

.section-{{ section.id }} .contact-card p {
  font-size: 20px;
  font-family: 'Inter', sans-serif;
  font-weight:400;
  color: #2C2C2C;
  max-width:240px;
}

/* Button */
.section-{{ section.id }} .btn {
  width: 275px;
  height: 55px;
  background: #2C2C2C;
  color: #FFFFFF;
  font-size: 20px;
  font-weight: 300;
  text-transform: uppercase;
  display: flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  transition: background 0.3s ease;
  margin: 20px auto;
}

.section-{{ section.id }} .btn:hover {
  background: linear-gradient(90deg, #947863 0%, #E9DDD4 50%, #947863 100%);
    color: #FFF;
}

/* Bottom text */
.section-{{ section.id }} .after-btn-text {
  font-size: 20px;
  color: #2C2C2C;
  margin-top: 10px;
  font-family: 'Inter', sans-serif;
  font-weight:400;
}

/* Form */
.section-{{ section.id }} .form-wrapper {
  margin-top: 40px;
}

.section-{{ section.id }} form {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 15px;
}

.section-{{ section.id }} input,
.section-{{ section.id }} textarea {
  width: 100%;
  padding: 12px;
  border: 1px solid #ddd;
  border-radius: 6px;
  font-size: 14px;
}

.section-{{ section.id }} textarea {
  grid-column: span 2;
  min-height: 120px;
}

/* Center submit button */
.section-{{ section.id }} .form-submit {
  grid-column: span 2;
  display: flex;
  justify-content: center;
}

/* Responsive */
@media (max-width: 768px) {
  .section-{{ section.id }} .contact-grid {
    grid-template-columns: 1fr;
  }

  .section-{{ section.id }} form {
    grid-template-columns: 1fr;
  }

  .section-{{ section.id }} textarea {
    grid-column: span 1;
  }

  .section-{{ section.id }} .form-submit {
    grid-column: span 1;
  }

  .section-{{ section.id }} .section-heading {
    font-size: 36px;
  }
}
{% endstyle %}

<div class="section-{{ section.id }}">
  <div class="container">

    {% if section.settings.show_heading %}
      <h2 class="section-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.show_description %}
      <p class="section-description">{{ section.settings.description }}</p>
      <p class="section-description-2">{{ section.settings.description_2 }}</p>
    {% endif %}

    <!-- Cards -->
    <div class="contact-grid">
      {% for block in section.blocks %}
        <div class="contact-card">
          {% if block.settings.icon != blank %}
            <img src="{{ block.settings.icon | image_url: width: 80 }}" alt="" />
          {% endif %}
          <h4>{{ block.settings.title }}</h4>
          <p>{{ block.settings.text }}</p>

          {% if block.settings.button_text != blank %}
            <a href="{{ block.settings.button_link }}" class="btn">
              {{ block.settings.button_text }}
            </a>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    <!-- Form -->
    <div class="form-wrapper">
      {% comment %} <h2 class="section-heading">Send Us a Message</h2> {% endcomment %}

      {% form 'contact' %}
        <input type="text" name="contact[first_name]" placeholder="First Name" required>
        <input type="text" name="contact[last_name]" placeholder="Last Name">

        <input type="email" name="contact[email]" placeholder="Email Address" required>
        <input type="text" name="contact[order_number]" placeholder="Order Number (optional)">

        <textarea name="contact[body]" placeholder="Message Text" required></textarea>

        <div class="form-submit">
          <button type="submit" class="btn">Send Message</button>
        </div>
      {% endform %}

      {% if section.settings.after_button_text != blank %}
        <p class="after-btn-text">{{ section.settings.after_button_text }}</p>
      {% endif %}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Custom Contact Section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show Heading",
      "default": true
    },
    {
      "type": "text",
