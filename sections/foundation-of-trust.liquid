{%- style -%}
  /* =========================================================
     Foundation of Trust - Pixel Perfect Auto Slider CSS
     ========================================================= */
  .custom-fot-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --title-color: {{ section.settings.title_color }};
    --text-color: {{ section.settings.text_color }};
    --card-bg: {{ section.settings.card_bg_color }};
    --card-text-color: {{ section.settings.card_text_color }};
    --divider-color: {{ section.settings.divider_color }};
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    width: 100%;
    display: block;
    box-sizing: border-box;
    overflow: hidden;
    max-width: 100vw;
  }

  .custom-fot-{{ section.id }} * {
    box-sizing: border-box;
  }

  /* Using CSS Grid for STRICT 50/50 layout */
  .custom-fot-{{ section.id }} .fot-container {
    max-width: 1920px;
    margin: 0 auto;
    padding-left: {{ section.settings.padding_sides }}px;
    padding-right: {{ section.settings.padding_sides }}px;
    display: grid;
    grid-template-columns: 1fr 1fr; /* Exactly equal halves */
    align-items: stretch; /* THIS FORCES BOTH COLUMNS TO BE THE EXACT SAME HEIGHT */
    gap: {{ section.settings.layout_gap }}px; /* Figma: 80px */
  }

  /* --- LEFT COLUMN CONTENT --- */
  .custom-fot-{{ section.id }} .fot-left {
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 100%;
  }

  .custom-fot-{{ section.id }} .fot-title {
    font-family: var(--font-heading-family, 'Libre Caslon Text', serif);
    font-size: {{ section.settings.title_size }}px; /* Figma: 74px */
    font-weight: 400;
    line-height: 1.23; /* Figma: 123% */
    color: var(--title-color);
    margin: 0 0 20px 0;
    text-transform: uppercase;
  }

  .custom-fot-{{ section.id }} .fot-desc-top {
    font-family: var(--font-body-family, 'Inter', sans-serif);
    font-size: {{ section.settings.desc_top_size }}px; /* Figma: 20px */
    font-weight: 400;
    line-height: 1.5; 
    color: var(--text-color);
    margin: 0 0 30px 0;
  }

  .custom-fot-{{ section.id }} .fot-divider {
    border: none;
    border-top: 1px solid var(--divider-color);
    margin: 0 0 40px 0;
    width: 100%;
  }

  /* Grid Layout for Features */
  .custom-fot-{{ section.id }} .fot-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px 40px; /* Row gap: 24px, Col gap: 40px */
    margin-bottom: 40px;
    width: 100%;
    max-width: 800px;
  }

  /* Feature Card (Slide Trigger) */
  .custom-fot-{{ section.id }} .fot-card {
    background-color: var(--card-bg);
    border-radius: 4px;
    box-shadow: 0px 2px 8px rgba(0, 0, 0, 0.06); 
    display: flex;
    align-items: center;
    padding: 20px 24px; 
    gap: 18px; 
    width: 100%;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .custom-fot-{{ section.id }} .fot-card:hover {
    transform: translateY(-2px);
    box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.08);
  }

  .custom-fot-{{ section.id }} .fot-icon-wrapper {
    width: 84px; 
    height: 84px; 
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  /* SVG & Image common styles */
  .custom-fot-{{ section.id }} .fot-icon-wrapper img,
  .custom-fot-{{ section.id }} .fot-icon-wrapper .custom-svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
    position: absolute;
    top: 0;
    left: 0;
    transition: opacity 0.3s ease;
  }

  .custom-fot-{{ section.id }} .fot-icon-wrapper .custom-svg {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .custom-fot-{{ section.id }} .fot-icon-wrapper .custom-svg svg {
    width: 100%;
    height: 100%;
  }

  /* Active/Inactive Icon Swap Logic */
  .custom-fot-{{ section.id }} .icon-active { opacity: 0; visibility: hidden; }
  .custom-fot-{{ section.id }} .icon-normal { opacity: 1; visibility: visible; }
  
  .custom-fot-{{ section.id }} .fot-card.active .icon-active { opacity: 1; visibility: visible; }
  .custom-fot-{{ section.id }} .fot-card.active .icon-normal { opacity: 0; visibility: hidden; }

  .custom-fot-{{ section.id }} .fot-card-title {
    font-family: var(--font-body-family, 'Inter', sans-serif);
    font-size: {{ section.settings.card_title_size }}px; /* Figma: 20px */
    font-weight: 400;
    line-height: 1.5; 
    color: var(--card-text-color);
    margin: 0;
    text-transform: uppercase; 
    max-width: 160px; 
    text-decoration: underline;
    text-decoration-color: transparent; /* Hidden by default */
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    transition: text-decoration-color 0.3s ease;
  }

  /* Active State (Underline from Figma) */
  .custom-fot-{{ section.id }} .fot-card.active .fot-card-title {
    text-decoration-color: var(--card-text-color);
  }

  /* Bottom Description Area (Stacked for Crossfade) */
  .custom-fot-{{ section.id }} .fot-desc-bottom-wrapper {
    display: grid;
    width: 100%;
    max-width: 800px;
  }

  .custom-fot-{{ section.id }} .fot-bottom-box {
    grid-area: 1 / 1;
    background-color: var(--card-bg);
    border-radius: 4px;
    box-shadow: 0px 1px 4px rgba(0, 0, 0, 0.04); 
    padding: 20px 24px; 
    width: 100%;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.5s ease, visibility 0.5s ease;
  }

  .custom-fot-{{ section.id }} .fot-bottom-box.active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .custom-fot-{{ section.id }} .fot-desc-bottom {
    font-family: var(--font-body-family, 'Inter', sans-serif);
    font-size: {{ section.settings.desc_bottom_size }}px;
    font-weight: 400;
    line-height: 1.5;
    color: var(--text-color);
    margin: 0;
  }

  /* --- RIGHT COLUMN (MEDIA & DASHES) --- */
  .custom-fot-{{ section.id }} .fot-right {
    position: relative;
    overflow: hidden;
    width: 100%;
  }

  /* Shared class for both image and video */
  .custom-fot-{{ section.id }} .fot-main-media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover; /* Ensures media fills the space without distortion */
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s ease-in-out, visibility 0.5s ease-in-out;
  }

  .custom-fot-{{ section.id }} .fot-main-media.active {
    opacity: 1;
    visibility: visible;
    z-index: 2;
  }

  /* Slider Dash Controls with Progress Animation */
  .custom-fot-{{ section.id }} .fot-dashes {
    position: absolute;
    bottom: 30px; 
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 20px; /* Figma gap */
    width: 100%;
    max-width: 800px;
    padding: 0 40px; 
    z-index: 10;
  }

  .custom-fot-{{ section.id }} .dash-item {
    cursor: pointer;
    flex: 1;
    height: 4px;
    background: rgba(255, 255, 255, 0.4);
    border-radius: 4px;
    position: relative;
    overflow: hidden;
  }

  .custom-fot-{{ section.id }} .dash-progress {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 0%;
    background: #FFFFFF;
    border-radius: 4px;
  }




/* ─── MacBook Air 15 inch M2 (1441px - 1728px) ───────────────── */
