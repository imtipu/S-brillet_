{% comment %} {%- style -%}
  /* =========================================================
     Foundation of Trust - Pixel Perfect Auto Slider CSS
     ========================================================= */
  .custom-fot-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --title-color: {{ section.settings.title_color }};
    --text-color: {{ section.settings.text_color }};
    --card-bg: {{ section.settings.card_bg_color }};
    --card-text-color: {{ section.settings.card_text_color }};
    --divider-color: {{ section.settings.divider_color }};
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    width: 100%;
    display: block;
    box-sizing: border-box;
    overflow: hidden;
    max-width: 100vw;
  }

  .custom-fot-{{ section.id }} * {
    box-sizing: border-box;
  }

  /* Using CSS Grid for STRICT 50/50 layout */
  .custom-fot-{{ section.id }} .fot-container {
    max-width: 1920px;
    margin: 0 auto;
    padding-left: {{ section.settings.padding_sides }}px;
    padding-right: {{ section.settings.padding_sides }}px;
    display: grid;
    grid-template-columns: 1fr 1fr; /* Exactly equal halves */
    align-items: stretch; /* THIS FORCES BOTH COLUMNS TO BE THE EXACT SAME HEIGHT */
    gap: {{ section.settings.layout_gap }}px; /* Figma: 80px */
  }

  /* --- LEFT COLUMN CONTENT --- */
  .custom-fot-{{ section.id }} .fot-left {
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 100%;
  }

  .custom-fot-{{ section.id }} .fot-title {
    font-family: var(--font-heading-family, 'Libre Caslon Text', serif);
    font-size: {{ section.settings.title_size }}px; /* Figma: 74px */
    font-weight: 400;
    line-height: 1.23; /* Figma: 123% */
    color: var(--title-color);
    margin: 0 0 20px 0;
    text-transform: uppercase;
  }

  .custom-fot-{{ section.id }} .fot-desc-top {
    font-family: var(--font-body-family, 'Inter', sans-serif);
    font-size: {{ section.settings.desc_top_size }}px; /* Figma: 20px */
    font-weight: 400;
    line-height: 1.5; 
    color: var(--text-color);
    margin: 0 0 30px 0;
  }

  .custom-fot-{{ section.id }} .fot-divider {
    border: none;
    border-top: 1px solid var(--divider-color);
    margin: 0 0 40px 0;
    width: 100%;
  }

  /* Grid Layout for Features */
  .custom-fot-{{ section.id }} .fot-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px 40px; /* Row gap: 24px, Col gap: 40px */
    margin-bottom: 40px;
    width: 100%;
    max-width: 800px;
  }

  /* Feature Card (Slide Trigger) */
  .custom-fot-{{ section.id }} .fot-card {
    background-color: var(--card-bg);
    border-radius: 4px;
    box-shadow: 0px 2px 8px rgba(0, 0, 0, 0.06); 
    display: flex;
    align-items: center;
    padding: 20px 24px; 
    gap: 18px; 
    width: 100%;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .custom-fot-{{ section.id }} .fot-card:hover {
    transform: translateY(-2px);
    box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.08);
  }

  .custom-fot-{{ section.id }} .fot-icon-wrapper {
    width: 84px; 
    height: 84px; 
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .custom-fot-{{ section.id }} .fot-icon-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    position: absolute;
    top: 0;
    left: 0;
    transition: opacity 0.3s ease;
  }

  /* Active/Inactive Icon Swap Logic */
  .custom-fot-{{ section.id }} .icon-active { opacity: 0; visibility: hidden; }
  .custom-fot-{{ section.id }} .icon-normal { opacity: 1; visibility: visible; }
  
  .custom-fot-{{ section.id }} .fot-card.active .icon-active { opacity: 1; visibility: visible; }
  .custom-fot-{{ section.id }} .fot-card.active .icon-normal { opacity: 0; visibility: hidden; }

  .custom-fot-{{ section.id }} .fot-card-title {
    font-family: var(--font-body-family, 'Inter', sans-serif);
    font-size: {{ section.settings.card_title_size }}px; /* Figma: 20px */
    font-weight: 400;
    line-height: 1.5; 
    color: var(--card-text-color);
    margin: 0;
    text-transform: uppercase; 
    max-width: 160px; 
    text-decoration: underline;
    text-decoration-color: transparent; /* Hidden by default */
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    transition: text-decoration-color 0.3s ease;
  }

  /* Active State (Underline from Figma) */
  .custom-fot-{{ section.id }} .fot-card.active .fot-card-title {
    text-decoration-color: var(--card-text-color);
  }

  /* Bottom Description Area (Stacked for Crossfade) */
  .custom-fot-{{ section.id }} .fot-desc-bottom-wrapper {
    display: grid;
    width: 100%;
    max-width: 800px;
  }

  .custom-fot-{{ section.id }} .fot-bottom-box {
    grid-area: 1 / 1;
    background-color: var(--card-bg);
    border-radius: 4px;
    box-shadow: 0px 1px 4px rgba(0, 0, 0, 0.04); 
    padding: 20px 24px; 
    width: 100%;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.5s ease, visibility 0.5s ease;
  }

  .custom-fot-{{ section.id }} .fot-bottom-box.active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .custom-fot-{{ section.id }} .fot-desc-bottom {
    font-family: var(--font-body-family, 'Inter', sans-serif);
    font-size: {{ section.settings.desc_bottom_size }}px;
    font-weight: 400;
    line-height: 1.5;
    color: var(--text-color);
    margin: 0;
  }

  /* --- RIGHT COLUMN (IMAGES & SLIDER DASHES) --- */
  .custom-fot-{{ section.id }} .fot-right {
    position: relative;
    /* border-radius: 4px; */
    overflow: hidden;
    width: 100%;
    /* Intrinsic height removed so it strictly matches the Left Column's height */
  }

  .custom-fot-{{ section.id }} .fot-main-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover; /* Ensures image fills the space without distortion */
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s ease-in-out, visibility 0.5s ease-in-out;
  }

  .custom-fot-{{ section.id }} .fot-main-image.active {
    opacity: 1;
    visibility: visible;
    z-index: 2;
  }

  /* Slider Dash Control Container */
  .custom-fot-{{ section.id }} .fot-dashes {
    position: absolute;
    bottom: 30px; 
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 12px;
    z-index: 10;
  }

  .custom-fot-{{ section.id }} .dash-item {
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .custom-fot-{{ section.id }} .dash-inactive,
  .custom-fot-{{ section.id }} .dash-active {
    height: auto;
    object-fit: contain;
    transition: opacity 0.3s ease;
  }

  .custom-fot-{{ section.id }} .dash-active { display: none; }
  .custom-fot-{{ section.id }} .dash-item.active .dash-active { display: block; }
  .custom-fot-{{ section.id }} .dash-item.active .dash-inactive { display: none; }

  /* Fallback dashes if images aren't uploaded */
  .custom-fot-{{ section.id }} .fallback-dash {
    width: 40px;
    height: 4px;
    background-color: rgba(255,255,255,0.4);
    border-radius: 5px;
    transition: background-color 0.3s ease;
  }
  .custom-fot-{{ section.id }} .dash-item.active .fallback-dash {
    background-color: #FFFFFF;
  }

  /* --- RESPONSIVE DESIGN (Pixel Perfect Scaling) --- */
  
  /* MacBook & Laptops (1025px - 1440px) */
  @media (max-width: 1440px) {
    .custom-fot-{{ section.id }} .fot-container { gap: 50px; padding: 60px 80px; }
    
    /* Scaled down cleanly for MacBook */
    .custom-fot-{{ section.id }} .fot-title { font-size: 48px; margin-bottom: 15px; }
    .custom-fot-{{ section.id }} .fot-desc-top { font-size: 16px; margin-bottom: 20px; line-height: 1.5; }
    .custom-fot-{{ section.id }} .fot-divider { margin-bottom: 25px; }
    
    .custom-fot-{{ section.id }} .fot-grid { gap: 16px 20px; margin-bottom: 25px; }
    .custom-fot-{{ section.id }} .fot-card { padding: 15px 20px; gap: 12px; }
    .custom-fot-{{ section.id }} .fot-icon-wrapper { width: 60px; height: 60px; }
    .custom-fot-{{ section.id }} .fot-card-title { font-size: 15px; max-width: 140px; }
    
    .custom-fot-{{ section.id }} .fot-bottom-box { padding: 18px 22px; }
    .custom-fot-{{ section.id }} .fot-desc-bottom { font-size: 15px; }
  }

  /* Tablets (769px - 1024px) */
  @media (max-width: 1024px) {
    .custom-fot-{{ section.id }} .fot-container { 
      grid-template-columns: 1fr; /* Switch to single column */
      padding: 60px 40px;
      gap: 40px;
      align-items: start; /* Disable stretch for stacked view */
    }
    .custom-fot-{{ section.id }} .fot-left {
      order: 2; /* Text moves to bottom */
    }
    .custom-fot-{{ section.id }} .fot-right {
      order: 1; /* Image moves to top */
      height: 500px; /* Specific height since we lost the left-column reference */
    }
  }

  /* Mobile Phones (up to 768px) */
  @media (max-width: 768px) {

    

    .custom-fot-{{ section.id }} .fot-card.active .fot-card-title{ 
    text-decoration-thickness:1px;
  }


    .custom-fot-{{ section.id }} { padding-top: 40px; padding-bottom: 40px; overflow: hidden; width: 100vw; max-width: 100%; }
    
    .custom-fot-{{ section.id }} .fot-container { 
      grid-template-columns: 1fr; /* Keeps single column */
      padding: 20px !important; 
      /* padding-right: 20px !important;  */
      gap: 30px; 
      align-items: start;
      max-width: 100%;
      box-sizing: border-box;
    }
    
    .custom-fot-{{ section.id }} .fot-left {
      order: 2; /* Text bottom */
      width: 100%;
    }
    
    .custom-fot-{{ section.id }} .fot-right {
      order: 1; /* Image Top */
      height: 350px; 
      /* border-radius: 8px; */
      width: 100%;
    }

    .custom-fot-{{ section.id }} .fot-dashes { bottom: 15px; }
    .custom-fot-{{ section.id }} .fallback-dash { width: 25px; height: 3px; }

    .custom-fot-{{ section.id }} .fot-title { font-size: 28px; margin-bottom: 15px; }
    .custom-fot-{{ section.id }} .fot-desc-top { font-size: 14px; line-height: 1.5; margin-bottom: 20px; }
    .custom-fot-{{ section.id }} .fot-divider { margin-bottom: 25px; }
    
    .custom-fot-{{ section.id }} .fot-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important; /* minmax forces grid to shrink on small screens without blowing out */
      gap: 10px;
      margin-bottom: 25px;
      width: 100%;
    }
    
    .custom-fot-{{ section.id }} .fot-card { 
      padding: 10px; 
      gap: 8px;
      width: 100%;
    }
    .custom-fot-{{ section.id }} .fot-icon-wrapper { width: 40px; height: 40px; }
    .custom-fot-{{ section.id }} .fot-card-title { 
      font-size: 12px; 
      max-width: 100%; 
      line-height: 1.3;
      word-wrap: break-word; /* Helps wrap long words */
    }
    
    .custom-fot-{{ section.id }} .fot-bottom-box { padding: 15px; width: 100%; box-sizing: border-box; }
    .custom-fot-{{ section.id }} .fot-desc-bottom { font-size: 13px; line-height: 1.5; }
  }
{%- endstyle -%}

<section class="custom-fot-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="fot-container">
    
    <!-- LEFT COLUMN: Content & Grid Features -->
    <div class="fot-left">
      {%- if section.settings.title != blank -%}
        <h2 class="fot-title">{{ section.settings.title }}</h2>
      {%- endif -%}

      {%- if section.settings.desc_top != blank -%}
        <p class="fot-desc-top">{{ section.settings.desc_top }}</p>
      {%- endif -%}

      {%- if section.settings.show_divider -%}
        <hr class="fot-divider">
      {%- endif -%}

      <!-- Feature Grid (Clickable Slider Controls) -->
      <div class="fot-grid" id="fot-grid-{{ section.id }}">
        {%- for block in section.blocks -%}
          <div class="fot-card {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <div class="fot-icon-wrapper">
              
              <!-- Normal Icon -->
              {%- if block.settings.icon != blank -%}
                <img src="{{ block.settings.icon | image_url: width: 168 }}" alt="{{ block.settings.title | escape }}" class="icon-normal" loading="lazy">
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg icon-normal' }}
              {%- endif -%}

              <!-- Active Icon -->
              {%- if block.settings.icon_active != blank -%}
                <img src="{{ block.settings.icon_active | image_url: width: 168 }}" alt="{{ block.settings.title | escape }} Active" class="icon-active" loading="lazy">
              {%- else -%}
                <!-- Fallback to normal icon if active icon is not provided -->
                {%- if block.settings.icon != blank -%}
                  <img src="{{ block.settings.icon | image_url: width: 168 }}" alt="{{ block.settings.title | escape }}" class="icon-active" loading="lazy">
                {%- else -%}
                   {{ 'image' | placeholder_svg_tag: 'placeholder-svg icon-active' }}
                {%- endif -%}
              {%- endif -%}

            </div>
            {%- if block.settings.title != blank -%}
              <h3 class="fot-card-title">{{ block.settings.title }}</h3>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      <!-- Bottom Dynamic Description Box -->
      <div class="fot-desc-bottom-wrapper" id="fot-desc-wrapper-{{ section.id }}">
        {%- for block in section.blocks -%}
          <div class="fot-bottom-box {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}">
            <p class="fot-desc-bottom">{{ block.settings.desc_bottom }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>

    <!-- RIGHT COLUMN: Auto-Sliding Images & Dashes -->
    <div class="fot-right" id="fot-right-{{ section.id }}">
      
      <!-- Crossfading Images -->
      {%- for block in section.blocks -%}
        {%- if block.settings.main_image != blank -%}
          <img src="{{ block.settings.main_image | image_url: width: 1600 }}" alt="{{ block.settings.title | escape }}" class="fot-main-image {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}" loading="lazy">
        {%- else -%}
          {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg fot-main-image' | replace: '<svg', '<svg class="fot-main-image' | replace: '>', ' data-index="' | append: forloop.index0 | append: '">' }}
        {%- endif -%}
      {%- endfor -%}

      <!-- Overlay Slider Dashes -->
      <div class="fot-dashes" id="fot-dashes-{{ section.id }}">
        {%- for block in section.blocks -%}
          <div class="dash-item {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}">
            {%- if section.settings.dash_active_image != blank and section.settings.dash_inactive_image != blank -%}
              <img class="dash-active" src="{{ section.settings.dash_active_image | image_url: width: 80 }}" alt="Active Slide" style="width: {{ section.settings.dash_width }}px;">
              <img class="dash-inactive" src="{{ section.settings.dash_inactive_image | image_url: width: 80 }}" alt="Inactive Slide" style="width: {{ section.settings.dash_width }}px;">
            {%- else -%}
              <span class="fallback-dash" style="width: {{ section.settings.dash_width }}px;"></span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

    </div>

  </div>
</section>

<!-- Advanced Slider Auto-Play & Click Logic -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sectionId = '{{ section.id }}';
    const gridCards = document.querySelectorAll(`#fot-grid-${sectionId} .fot-card`);
    const mainImages = document.querySelectorAll(`#fot-right-${sectionId} .fot-main-image`);
    const bottomDescs = document.querySelectorAll(`#fot-desc-wrapper-${sectionId} .fot-bottom-box`);
    const dashes = document.querySelectorAll(`#fot-dashes-${sectionId} .dash-item`);
    
    if (gridCards.length === 0) return;

    let currentIndex = 0;
    const totalSlides = gridCards.length;
    let autoSlideInterval;
    const isAutoPlay = {{ section.settings.enable_auto_slide | json }};
    const intervalTime = {{ section.settings.slide_interval }} * 1000;

    // Function to update UI Elements (Crossfade effect)
    function changeSlide(index) {
      // 1. Remove active class from all elements
      gridCards.forEach(card => card.classList.remove('active'));
      mainImages.forEach(img => img.classList.remove('active'));
      bottomDescs.forEach(desc => desc.classList.remove('active'));
      dashes.forEach(dash => dash.classList.remove('active'));

      // 2. Safeguard Index
      if (index >= totalSlides) index = 0;
      if (index < 0) index = totalSlides - 1;
      
      // 3. Apply active class to the current target index
      if(gridCards[index]) gridCards[index].classList.add('active');
      if(mainImages[index]) mainImages[index].classList.add('active');
      if(bottomDescs[index]) bottomDescs[index].classList.add('active');
      if(dashes[index]) dashes[index].classList.add('active');

      currentIndex = index;
    }

    // Function for Auto Slide
    function nextSlide() {
      changeSlide(currentIndex + 1);
    }

    // Start Timer
    function startAutoSlide() {
      if (isAutoPlay) {
        clearInterval(autoSlideInterval);
        autoSlideInterval = setInterval(nextSlide, intervalTime);
      }
    }

    // Grid Card Clicks
    gridCards.forEach((card, index) => {
      card.addEventListener('click', () => {
        changeSlide(index);
        startAutoSlide(); // Reset timer on manual click
      });
    });

    // Dash Line Clicks
    dashes.forEach((dash, index) => {
      dash.addEventListener('click', () => {
        changeSlide(index);
        startAutoSlide(); // Reset timer on manual click
      });
    });

    // Initialize Slider
    changeSlide(0);
    startAutoSlide();
  });
</script>

