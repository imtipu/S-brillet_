<section class="custom-fot-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="fot-container">
    
    <div class="fot-left">
      {%- if section.settings.title != blank -%}
        <h2 class="fot-title">{{ section.settings.title }}</h2>
      {%- endif -%}

      {%- if section.settings.desc_top != blank -%}
        <p class="fot-desc-top">{{ section.settings.desc_top }}</p>
      {%- endif -%}

      {%- if section.settings.show_divider -%}
        <hr class="fot-divider">
      {%- endif -%}

      <div class="fot-grid" id="fot-grid-{{ section.id }}">
        {%- for block in section.blocks -%}
          <div class="fot-card {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <div class="fot-icon-wrapper">
              
              {%- if block.settings.icon_svg != blank -%}
                <div class="custom-svg icon-normal">
                  {{ block.settings.icon_svg }}
                </div>
              {%- elsif block.settings.icon != blank -%}
                <img src="{{ block.settings.icon | image_url: width: 168 }}" alt="{{ block.settings.title | escape }}" class="icon-normal" loading="lazy">
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg icon-normal' }}
              {%- endif -%}

              {%- if block.settings.icon_active_svg != blank -%}
                <div class="custom-svg icon-active">
                  {{ block.settings.icon_active_svg }}
                </div>
              {%- elsif block.settings.icon_active != blank -%}
                <img src="{{ block.settings.icon_active | image_url: width: 168 }}" alt="{{ block.settings.title | escape }} Active" class="icon-active" loading="lazy">
              {%- elsif block.settings.icon_svg != blank -%}
                <div class="custom-svg icon-active">
                  {{ block.settings.icon_svg }}
                </div>
              {%- elsif block.settings.icon != blank -%}
                <img src="{{ block.settings.icon | image_url: width: 168 }}" alt="{{ block.settings.title | escape }}" class="icon-active" loading="lazy">
              {%- else -%}
                 {{ 'image' | placeholder_svg_tag: 'placeholder-svg icon-active' }}
              {%- endif -%}

            </div>
            {%- if block.settings.title != blank -%}
              <h3 class="fot-card-title">{{ block.settings.title }}</h3>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      <div class="fot-desc-bottom-wrapper" id="fot-desc-wrapper-{{ section.id }}">
        {%- for block in section.blocks -%}
          <div class="fot-bottom-box {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}">
            <p class="fot-desc-bottom">{{ block.settings.desc_bottom }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>

    <div class="fot-right" id="fot-right-{{ section.id }}">
      
      {%- for block in section.blocks -%}
        {%- if block.settings.main_video != blank -%}
          {%- capture video_replace_string -%}<video playsinline data-index="{{ forloop.index0 }}"{%- endcapture -%}
          {{ block.settings.main_video | video_tag: class: 'fot-main-media fot-main-video', autoplay: false, loop: false, muted: true, controls: false, image_size: '1600x' | replace: '<video', video_replace_string }}
        {%- elsif block.settings.main_image != blank -%}
          <img src="{{ block.settings.main_image | image_url: width: 1600 }}" alt="{{ block.settings.title | escape }}" class="fot-main-media fot-main-image {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}" loading="lazy">
        {%- else -%}
          {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg fot-main-media fot-main-image' | replace: '<svg', '<svg class="fot-main-media fot-main-image' | replace: '>', ' data-index="' | append: forloop.index0 | append: '">' }}
        {%- endif -%}
      {%- endfor -%}

      <div class="fot-dashes" id="fot-dashes-{{ section.id }}">
        {%- for block in section.blocks -%}
          <div class="dash-item {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}">
             <div class="dash-progress"></div>
          </div>
        {%- endfor -%}
      </div>

    </div>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sectionId = '{{ section.id }}';
    const gridCards = document.querySelectorAll(`#fot-grid-${sectionId} .fot-card`);
    const mainMedia = document.querySelectorAll(`#fot-right-${sectionId} .fot-main-media`);
    const bottomDescs = document.querySelectorAll(`#fot-desc-wrapper-${sectionId} .fot-bottom-box`);
    const dashes = document.querySelectorAll(`#fot-dashes-${sectionId} .dash-item`);
    
    if (gridCards.length === 0) return;

    let currentIndex = 0;
    const totalSlides = gridCards.length;
    let autoSlideTimeout; 
    const isAutoPlay = {{ section.settings.enable_auto_slide | json }};
    const intervalTime = {{ section.settings.slide_interval }} * 1000;

    function changeSlide(index) {
      clearTimeout(autoSlideTimeout);

      gridCards.forEach(card => card.classList.remove('active'));
      bottomDescs.forEach(desc => desc.classList.remove('active'));
      dashes.forEach(dash => {
        dash.classList.remove('active');
        const progress = dash.querySelector('.dash-progress');
        if (progress) {
          progress.style.transition = 'none'; 
          progress.style.width = '0%'; 
        }
      });
      
      mainMedia.forEach(media => {
        media.classList.remove('active');
        if (media.tagName === 'VIDEO') {
          media.pause(); 
        }
      });

      if (index >= totalSlides) index = 0;
      if (index < 0) index = totalSlides - 1;
      
      if(gridCards[index]) gridCards[index].classList.add('active');
      if(bottomDescs[index]) bottomDescs[index].classList.add('active');
      if(dashes[index]) dashes[index].classList.add('active');

      const activeMedia = mainMedia[index];
      const activeProgress = dashes[index] ? dashes[index].querySelector('.dash-progress') : null;

      if (activeProgress) void activeProgress.offsetWidth;

      if (activeMedia) {
        activeMedia.classList.add('active');

        if (activeMedia.tagName === 'VIDEO') {
          activeMedia.currentTime = 0; 
          
          activeMedia.play().then(() => {
            let duration = (activeMedia.duration && !isNaN(activeMedia.duration)) ? activeMedia.duration * 1000 : intervalTime;
            
            if (activeProgress && isAutoPlay) {
              activeProgress.style.transition = `width ${duration}ms linear`;
              activeProgress.style.width = '100%';
            }

            if (isAutoPlay) {
              activeMedia.onended = nextSlide;
            }
          }).catch((error) => {
            if (isAutoPlay) {
              if (activeProgress) {
                 activeProgress.style.transition = `width ${intervalTime}ms linear`;
                 activeProgress.style.width = '100%';
              }
              autoSlideTimeout = setTimeout(nextSlide, intervalTime);
            }
          });
        } else {
          if (isAutoPlay) {
            if (activeProgress) {
              activeProgress.style.transition = `width ${intervalTime}ms linear`;
              activeProgress.style.width = '100%';
            }
            autoSlideTimeout = setTimeout(nextSlide, intervalTime);
          }
        }
      }

      currentIndex = index;
    }

    function nextSlide() {
      changeSlide(currentIndex + 1);
    }

    gridCards.forEach((card, index) => {
      card.addEventListener('click', () => {
        changeSlide(index);
      });
    });

    dashes.forEach((dash, index) => {
      dash.addEventListener('click', () => {
        changeSlide(index);
      });
    });

    const firstMedia = mainMedia[0];
    const firstProgress = dashes[0] ? dashes[0].querySelector('.dash-progress') : null;
    if (firstProgress) void firstProgress.offsetWidth;

    if (firstMedia && firstMedia.tagName === 'VIDEO') {
        firstMedia.classList.add('active');
        firstMedia.play().then(() => {
            let duration = (firstMedia.duration && !isNaN(firstMedia.duration)) ? firstMedia.duration * 1000 : intervalTime;
            if (firstProgress && isAutoPlay) {
                firstProgress.style.transition = `width ${duration}ms linear`;
                firstProgress.style.width = '100%';
            }
            if (isAutoPlay) firstMedia.onended = nextSlide;
        }).catch(() => {
            if (firstProgress && isAutoPlay) {
                firstProgress.style.transition = `width ${intervalTime}ms linear`;
                firstProgress.style.width = '100%';
            }
            if (isAutoPlay) autoSlideTimeout = setTimeout(nextSlide, intervalTime);
        });
    } else {
        if (firstProgress && isAutoPlay) {
            firstProgress.style.transition = `width ${intervalTime}ms linear`;
            firstProgress.style.width = '100%';
        }
        if (isAutoPlay) {
            autoSlideTimeout = setTimeout(nextSlide, intervalTime);
        }
    }

  });
</script>

