{% comment %} 


{%- style -%}
  /* =========================================================
     Discover Your Birthstone - Pure Proportional Figma Scaling
     ========================================================= */
  .custom-birthstone-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --title-color: {{ section.settings.title_color }};
    --text-color: {{ section.settings.text_color }};
    
    --card-outer-bg: {{ section.settings.card_outer_bg_color }};
    --card-bg: {{ section.settings.card_bg_color }};
    
    --card-divider-color: {{ section.settings.card_divider_color }};
    --accent-text-color: {{ section.settings.accent_text_color }};
    
    --highlight-color: {{ section.settings.highlight_color }};
    --dot-inactive: {{ section.settings.dot_inactive_color }};
    
    /* Font Families fallback */
    --font-heading: {{ section.settings.heading_font.family | default: "'Libre Caslon Text', serif" }};
    --font-body: {{ section.settings.body_font.family | default: "'Inter', sans-serif" }};

    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    width: 100%;
    display: block;
    box-sizing: border-box;
    overflow: hidden;
  }

  .custom-birthstone-{{ section.id }} * {
    box-sizing: border-box;
  }

  /* --- MOBILE SPECIFIC HEADER (Hidden on Desktop) --- */
  .custom-birthstone-{{ section.id }} .mobile-section-header {
    display: none;
    text-align: center;
    padding: 0 15px;
    margin-bottom: 30px;
  }
  
  .custom-birthstone-{{ section.id }} .mobile-section-header .right-divider {
    margin: 25px auto 0 auto;
  }

  .custom-birthstone-{{ section.id }} .birthstone-container {
    max-width: 1920px;
    margin: 0 auto;
    padding-left: clamp(20px, 5vw, {{ section.settings.padding_sides }}px);
    padding-right: clamp(20px, 5vw, {{ section.settings.padding_sides }}px);
    display: flex;
    align-items: center; 
    justify-content: center;
    gap: clamp(40px, 8vw, {{ section.settings.layout_gap }}px); /* Fluid gap for MacBooks */
  }

  /* --- LEFT COLUMN: THE CARD --- */
  .custom-birthstone-{{ section.id }} .birthstone-left {
    flex: 1 1 840px;
    max-width: 840px; 
    display: flex;
    justify-content: flex-end;
    min-width: 0;
    /* iPad Landscape Safari Fix */
    align-self: center;
    min-height: 0;
  }

  /* Layer 1: Outermost Shadow Box (840x840 mathematically defined) */
  .custom-birthstone-{{ section.id }} .stone-card-outermost {
    width: 100%;
    max-width: 840px;
    aspect-ratio: 1 / 1 !important; /* Guarantees perfect square on ALL devices */
    background-color: var(--card-outer-bg);
    /* 60px padding out of 840px = 7.142857% */
    padding: 7.14%; 
    box-shadow: inset 0px 0px 8px 4px rgba(44, 44, 44, 0.05); 
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative; /* Essential so the absolute slider controls stay inside */
    container-type: inline-size; /* Enables CQI units for perfect fluid scaling */
    /* Safari Vertical Stretching Fixes */
    align-self: center !important;
    min-height: 0 !important;
  }

  /* Layer 2: White Box (720x720) */
  .custom-birthstone-{{ section.id }} .stone-card-white-box {
    width: 100%;
    height: 100%;
    background-color: var(--card-bg);
    display: flex;
    flex-direction: column;
    padding: calc(40 / 840 * 100cqi); /* 40px exact padding from Figma */
  }

  /* Layer 3: Padded Area for Slides */
  .custom-birthstone-{{ section.id }} .stone-card-padded-area {
    width: 100%;
    height: 100%;
  }

  /* Slides Viewport */
  .custom-birthstone-{{ section.id }} .slides-viewport {
    width: 100%;
    height: 100%; 
    display: grid; 
  }

  /* Layer 4: Individual Slide */
  .custom-birthstone-{{ section.id }} .stone-card-slide {
    grid-area: 1 / 1; 
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition: opacity 0.5s ease-in-out, visibility 0.5s ease-in-out;
  }

  .custom-birthstone-{{ section.id }} .stone-card-slide.active {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
    z-index: 2;
  }

  /* Outer Gradient Border (6px border, 10px inner padding per Figma) */
  .custom-birthstone-{{ section.id }} .stone-card-outer-border {
    width: 100%;
    height: 100%;
    border-width: max(1px, calc(6 / 840 * 100cqi));
    border-style: solid;
    border-color: transparent;
    background: linear-gradient(var(--card-bg), var(--card-bg)) padding-box,
                linear-gradient(var(--gradient-deg, 135deg), var(--border-grad-1), var(--border-grad-2), var(--border-grad-3)) border-box;
    padding: calc(10 / 840 * 100cqi); 
  }

  /* Inner Gradient Border Box (4px border, 44px inner padding per Figma) */
  .custom-birthstone-{{ section.id }} .stone-card-inner-border {
    width: 100%;
    height: 100%;
    border-width: max(1px, calc(4 / 840 * 100cqi));
    border-style: solid;
    border-color: transparent;
    background: linear-gradient(var(--card-bg), var(--card-bg)) padding-box,
                linear-gradient(var(--gradient-deg, 135deg), var(--border-grad-1), var(--border-grad-2), var(--border-grad-3)) border-box;
    padding: calc(44 / 840 * 100cqi); 
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: calc(40 / 840 * 100cqi); /* 40px gap from Figma between header and middle */
  }

  /* --- CARD CONTENT STRUCTURE (Exact Figma Maths) --- */
  .custom-birthstone-{{ section.id }} .card-header { display: flex; flex-direction: column; }
  .custom-birthstone-{{ section.id }} .card-title {
    font-family: var(--font-heading-family, 'Libre Caslon Text', serif);
    font-size: calc(53 / 840 * 100cqi);
    font-weight: 400; line-height: 1; color: var(--title-color);
    margin: 0; text-transform: uppercase;
  }
  .custom-birthstone-{{ section.id }} .card-title-divider {
    width: 100%; max-width: calc(400 / 840 * 100cqi);
    height: calc(2 / 840 * 100cqi); background-color: var(--card-divider-color);
    margin: calc(12 / 840 * 100cqi) 0; border: none;
  }
  .custom-birthstone-{{ section.id }} .card-subtitle {
    font-family: var(--font-body-family, 'Inter', sans-serif);
    font-size: calc(27 / 840 * 100cqi); font-weight: 500;
    line-height: calc(33 / 27); color: #2c2c2c; margin: 0; text-transform: uppercase;
  }
  .custom-birthstone-{{ section.id }} .card-middle {
    display: flex; gap: calc(30 / 840 * 100cqi); align-items: center;
  }
  .custom-birthstone-{{ section.id }} .stone-image {
    width: calc(240 / 840 * 100cqi); height: calc(240 / 840 * 100cqi);
    aspect-ratio: 1 / 1; object-fit: contain; flex-shrink: 0;
  }
  .custom-birthstone-{{ section.id }} .energy-effects {
    display: flex; flex-direction: column; gap: calc(12 / 840 * 100cqi);
  }
  .custom-birthstone-{{ section.id }} .energy-title {
    font-family: var(--font-body-family, 'Inter', sans-serif);
    font-size: calc(27 / 840 * 100cqi); font-weight: 500; line-height: 1.2; 
    color: var(--accent-text-color); margin: 0; text-transform: uppercase;
  }
  .custom-birthstone-{{ section.id }} .energy-list {
    list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: calc(12 / 840 * 100cqi);
  }
  .custom-birthstone-{{ section.id }} .energy-item {
    display: flex; align-items: center; gap: calc(8 / 840 * 100cqi);
    font-family: var(--font-body-family, 'Inter', sans-serif);
    font-size: calc(16 / 840 * 100cqi); font-weight: 400; line-height: calc(33 / 16); color: var(--text-color);
  }
  .custom-birthstone-{{ section.id }} .energy-icon-mask {
    width: calc(19 / 840 * 100cqi); height: calc(24 / 840 * 100cqi);
    background-color: var(--accent-text-color); -webkit-mask-size: contain; -webkit-mask-repeat: no-repeat;
    -webkit-mask-position: center; mask-size: contain; mask-repeat: no-repeat; mask-position: center; flex-shrink: 0;
  }
  .custom-birthstone-{{ section.id }} .card-bottom { display: flex; flex-direction: column; }
  .custom-birthstone-{{ section.id }} .card-description {
    font-family: var(--font-body-family, 'Inter', sans-serif);
    font-size: calc(20 / 840 * 100cqi); font-weight: 300; line-height: calc(33 / 20); color: var(--text-color);
    margin: 0 0 calc(15 / 840 * 100cqi) 0; max-width: calc(532 / 840 * 100cqi);
  }
  .custom-birthstone-{{ section.id }} .zodiac-match {
    display: flex; align-items: center; gap: calc(20 / 840 * 100cqi);
    font-family: var(--font-body-family, 'Inter', sans-serif); font-size: calc(20 / 840 * 100cqi); 
    line-height: 1.2; font-weight: 500; color: var(--text-color); flex-wrap: wrap;
  }
  .custom-birthstone-{{ section.id }} .zodiac-title {
    font-weight: 500; line-height: calc(33 / 20); color: var(--accent-text-color); text-transform: uppercase; margin: 0;
  }
  .custom-birthstone-{{ section.id }} .zodiac-item { display: flex; align-items: center; gap: calc(6 / 840 * 100cqi); }
  .custom-birthstone-{{ section.id }} .zodiac-icon-mask {
    width: calc(25 / 840 * 100cqi); height: calc(20 / 840 * 100cqi);
    background-color: var(--accent-text-color); -webkit-mask-size: contain; -webkit-mask-repeat: no-repeat;
    -webkit-mask-position: center; mask-size: contain; mask-repeat: no-repeat; mask-position: center; flex-shrink: 0;
  }

  /* --- SLIDER CONTROLS (OUTSIDE WHITE BOX, IN BOTTOM SHADOW) --- */
  .custom-birthstone-{{ section.id }} .slider-controls {
    position: absolute; 
    bottom: calc(20 / 840 * 100cqi); 
    left: 0; width: 100%; display: flex; align-items: center; justify-content: center;
    gap: calc(25 / 840 * 100cqi); z-index: 10;
  }
  .custom-birthstone-{{ section.id }} .slider-arrow {
    background: none; border: none; cursor: pointer; padding: 0; display: flex; align-items: center;
    justify-content: center; color: var(--text-color); opacity: 0.6; transition: opacity 0.2s ease;
    position: relative; width: calc(24 / 840 * 100cqi); height: calc(20 / 840 * 100cqi);
  }
  .custom-birthstone-{{ section.id }} .slider-arrow:hover { opacity: 1; }
  .custom-birthstone-{{ section.id }} .slider-arrow.has-hover-img { opacity: 1; }
  .custom-birthstone-{{ section.id }} .slider-arrow svg, .custom-birthstone-{{ section.id }} .slider-arrow img {
    width: 100%; height: 100%; object-fit: contain;
  }
  .custom-birthstone-{{ section.id }} .arrow-hover {
    display: none; position: absolute; top: 0; left: 0; width: 100%; height: 100%;
  }
  .custom-birthstone-{{ section.id }} .slider-arrow.has-hover-img:hover .arrow-default { display: none; }
  .custom-birthstone-{{ section.id }} .slider-arrow.has-hover-img:hover .arrow-hover { display: block; }

  .custom-birthstone-{{ section.id }} .slider-dots { display: flex; gap: calc(20 / 840 * 100cqi); align-items: center; }
  .custom-birthstone-{{ section.id }} .dot {
    width: calc(10 / 840 * 100cqi); height: calc(10 / 840 * 100cqi); border-radius: 50%;
    background-color: var(--dot-inactive); transition: background 0.3s ease, transform 0.2s ease;
    cursor: pointer; display: none; 
  }
  .custom-birthstone-{{ section.id }} .dot.visible { display: inline-block; }
  .custom-birthstone-{{ section.id }} .dot.active, .custom-birthstone-{{ section.id }} .dot:hover {
    background: linear-gradient(var(--gradient-deg, 135deg), var(--dot-grad-1), var(--dot-grad-2), var(--dot-grad-3));
  }

  /* --- RIGHT COLUMN: THE TEXT & MONTHS --- */
  .custom-birthstone-{{ section.id }} .birthstone-right {
    flex: 1 1 720px; width: 100%; max-width: 720px; 
    aspect-ratio: 720 / 640; 
    display: flex; flex-direction: column; justify-content: flex-start; min-width: 0;
  }
  .custom-birthstone-{{ section.id }} .right-content-top { display: flex; flex-direction: column; }
  .custom-birthstone-{{ section.id }} .right-title {
    font-family: var(--font-heading-family, 'Libre Caslon Text', serif);
    font-size: clamp(32px, 4.5vw, {{ section.settings.title_size }}px); 
    font-weight: 400; line-height: 1.23; color: var(--title-color);
    margin: 0 0 clamp(12px, 1.5vw, 20px) 0; text-transform: uppercase;
  }
  .custom-birthstone-{{ section.id }} .right-desc {
    font-family: var(--font-body-family, 'Inter', sans-serif);
    font-size: clamp(14px, 1.4vw, 20px); font-weight: 400; line-height: 1.6; color: var(--text-color);
    margin: 0 0 clamp(20px, 2.5vw, 40px) 0; max-width: 572px; 
  }
  .custom-birthstone-{{ section.id }} .right-divider {
    border: none; border-top: 2px solid #2C2C2C; margin: 0 0 clamp(20px, 2.5vw, 39px) 0; width: 100%; max-width: 720px;
  }
  .custom-birthstone-{{ section.id }} .months-grid {
    display: grid; grid-template-columns: repeat(2, max-content);
    row-gap: clamp(15px, 2vw, 30px); column-gap: clamp(40px, 10vw, 159px); max-width: 720px; margin-bottom: 0; 
  }
  .custom-birthstone-{{ section.id }} .month-item {
    font-family: var(--font-body-family, 'Inter', sans-serif);
    font-size: clamp(14px, 1.4vw, {{ section.settings.month_font_size }}px);
    font-weight: 400; color: var(--text-color); text-decoration: none; position: relative;
    display: inline-block; width: fit-content; transition: opacity 0.2s ease; cursor: pointer;
  }
  .custom-birthstone-{{ section.id }} .month-item:hover { opacity: 0.7; }
  .custom-birthstone-{{ section.id }} .month-item.active { color: var(--highlight-color); font-weight: 600; }
  .custom-birthstone-{{ section.id }} .month-item.active::after {
    content: ''; position: absolute; left: 0; bottom: -4px; width: 100%; height: 2px; background-color: var(--highlight-color);
  }

  /* Dynamic Button (Seamless Crossfade Update) */
  .custom-birthstone-{{ section.id }} .btn-container { 
    width: 100%; display: grid; justify-items: start;
    margin-top: auto; padding-top: clamp(20px, 3vw, 40px);
  }
  .custom-birthstone-{{ section.id }} .btn-outline {
    grid-area: 1 / 1; opacity: 0; visibility: hidden; pointer-events: none; align-items: center; justify-content: center;
    width: clamp(220px, 18vw, 280px); height: clamp(45px, 3.5vw, 55px);
    font-family: var(--font-body-family, 'Inter', sans-serif); font-size: clamp(12px, 1.1vw, 16px);
    font-weight: 400; text-transform: uppercase; text-decoration: none; letter-spacing: 1px;
    cursor: pointer; transition: opacity 0.5s ease-in-out, visibility 0.5s ease-in-out, border 0.3s ease; 
    border: 1px solid var(--btn-border); position: relative; z-index: 1; display: inline-flex; 
  }
  .custom-birthstone-{{ section.id }} .btn-outline.active { opacity: 1; visibility: visible; pointer-events: auto; z-index: 2; }
  .custom-birthstone-{{ section.id }} .btn-outline .btn-text {
    display: inline-block; transition: all 0.3s ease; color: var(--btn-text); font-size: 20px !important;
  }
  .custom-birthstone-{{ section.id }} .btn-outline:hover {
    background-color: transparent; border: 1px solid transparent;
    border-image: linear-gradient(var(--gradient-deg, 135deg), var(--border-grad-1), var(--border-grad-2), var(--border-grad-3)) 1;
  }
  .custom-birthstone-{{ section.id }} .btn-outline:hover .btn-text {
    background: linear-gradient(var(--gradient-deg, 135deg), var(--border-grad-1), var(--border-grad-2), var(--border-grad-3));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  }

  /* =========================================================
     RESPONSIVE DESIGN (Cleaned up constraints)
     ========================================================= */
  
  /* Large Screens */
  @media (min-width: 1441px) and (max-width: 1728px) {
    .custom-birthstone-{{ section.id }} .card-title { font-size: 40px !important; }
    .custom-birthstone-{{ section.id }} .birthstone-left { max-width: 55%; flex: 1 1 55%; }
    .custom-birthstone-{{ section.id }} .birthstone-right { max-width: 45%; flex: 1 1 45%; }
    .custom-birthstone-{{ section.id }} .right-title { font-size: 54px; }
    .custom-birthstone-{{ section.id }} .right-desc { font-size: 18px; margin: 0 0 clamp(20px, 2vw, 40px) 0; }
    .custom-birthstone-{{ section.id }} .month-item { font-size: 18px; }
    .custom-birthstone-{{ section.id }} .stone-card-outermost { max-width: 700px; padding: 52px; }
    .custom-birthstone-{{ section.id }} .stone-card-white-box,
    .custom-birthstone-{{ section.id }} .stone-card-outer-border,
    .custom-birthstone-{{ section.id }} .stone-card-inner-border { overflow: hidden; }
    .custom-birthstone-{{ section.id }} .months-grid { row-gap: clamp(15px, 2vw, 20px); }
  }

  /* MacBook & iPad Landscape (992px - 1440px) */
  @media (min-width: 992px) and (max-width: 1440px) {
    .custom-birthstone-{{ section.id }} .birthstone-container { gap: 30px; padding-left: 60px; padding-right: 60px; }
    .custom-birthstone-{{ section.id }} .birthstone-left { max-width: 55%; flex: 1 1 55%; }
    .custom-birthstone-{{ section.id }} .birthstone-right { max-width: 45%; flex: 1 1 45%; aspect-ratio: auto; }
    .custom-birthstone-{{ section.id }} .card-title { font-size: 33px !important; }
    .custom-birthstone-{{ section.id }} .right-title { font-size: clamp(28px, 3.5vw, 46px); }
    .custom-birthstone-{{ section.id }} .right-desc { font-size: clamp(14px, 1.5vw, 16px); }
    .custom-birthstone-{{ section.id }} .month-item { font-size: clamp(14px, 1.5vw, 16px); }
    .custom-birthstone-{{ section.id }} .btn-outline { width: clamp(180px, 18vw, 220px); height: 48px; font-size: 14px; }
    .custom-birthstone-{{ section.id }} .btn-outline .btn-text { font-size: 16px !important; }
  }

  /* =========================================================
     iPad Portrait & Mobile Phones (Up to 991px)
     ========================================================= */
  @media (max-width: 991px) {
    .custom-birthstone-{{ section.id }} { padding-top: 50px; padding-bottom: 50px; }
    
    .custom-birthstone-{{ section.id }} .birthstone-container { 
      display: flex; flex-direction: column; align-items: stretch; 
      padding-left: 30px; padding-right: 30px; gap: 0; 
    }
    
    .custom-birthstone-{{ section.id }} .birthstone-left,
    .custom-birthstone-{{ section.id }} .birthstone-right,
    .custom-birthstone-{{ section.id }} .right-content-top { display: contents; }
    
    /* Header Reordering */
    .custom-birthstone-{{ section.id }} .mobile-section-header { display: none !important; }
    .custom-birthstone-{{ section.id }} .desktop-section-header {
      display: flex !important; flex-direction: column; order: 1; width: 100%; text-align: left; margin-bottom: 28px;
    }
    
    .custom-birthstone-{{ section.id }} .right-title { font-size: clamp(32px, 5vw, 44px); margin: 0 0 14px 0; max-width: 100%; text-align: left;}
    .custom-birthstone-{{ section.id }} .right-desc { font-size: clamp(16px, 2.5vw, 18px); line-height: 1.6; margin: 0 0 25px 0; max-width: 100%; text-align: left;}
    .custom-birthstone-{{ section.id }} .right-divider { margin-bottom: 35px; width: 100%; max-width: 100%; }

    /* 1. Perfect Proportional Square Card - iPad */
    .custom-birthstone-{{ section.id }} .stone-card-outermost { 
      order: 2; 
      width: 100%;
      max-width: 100%; 
      aspect-ratio: 1 / 1 !important; /* Guaranteed Square */
      height: auto !important; 
      margin: 0 auto 40px auto;
      
      /* THE SAFARI FIX */
      min-height: 0 !important;
      align-self: center !important;
      
      /* CQI setup continues natively */
      padding: calc(60 / 840 * 100cqi) !important;
      box-sizing: border-box;
      position: relative !important;
      display: flex !important;
    }

    /* Keep inner boxes flexible without stretching vertically out of bounds */
    .custom-birthstone-{{ section.id }} .stone-card-white-box,
    .custom-birthstone-{{ section.id }} .stone-card-padded-area,
    .custom-birthstone-{{ section.id }} .slides-viewport,
    .custom-birthstone-{{ section.id }} .stone-card-slide,
    .custom-birthstone-{{ section.id }} .stone-card-outer-border,
    .custom-birthstone-{{ section.id }} .stone-card-inner-border {
       height: 100% !important; 
    }

    /* Remove manual PX overrides inside CQI so it scales perfectly like desktop */
    /* Everything inside `.stone-card-outermost` naturally relies on the cqi math defined at the top */
    
    /* 3. Slider Controls (Fixed Position) */
    .custom-birthstone-{{ section.id }} .slider-controls {
      position: absolute !important;
      bottom: calc(20 / 840 * 100cqi) !important;
      left: 0; width: 100%; display: flex; align-items: center; justify-content: center;
      gap: calc(25 / 840 * 100cqi) !important;
      z-index: 10; margin: 0 !important;
    }

    /* 4. Months Grid Restyled for Order */
    .custom-birthstone-{{ section.id }} .months-grid { 
      order: 3; display: grid !important; grid-template-columns: repeat(3, 1fr) !important; 
      gap: 20px !important; width: 100%; max-width: 100%; margin-bottom: 35px; justify-items: center;
    }


    /* new  */
    /* Force Sequential Order (Update the numbers to match your block order) */
/* You must identify each month's index */
.custom-birthstone-{{ section.id }} .month-item:nth-child(1) { order: 1; } /* January */
.custom-birthstone-{{ section.id }} .month-item:nth-child(2) { order: 2; } /* February */
.custom-birthstone-{{ section.id }} .month-item:nth-child(3) { order: 3; } /* March */
.custom-birthstone-{{ section.id }} .month-item:nth-child(4) { order: 4; } /* April */
.custom-birthstone-{{ section.id }} .month-item:nth-child(5) { order: 5; } /* May */
.custom-birthstone-{{ section.id }} .month-item:nth-child(6) { order: 6; } /* June */
/* ... continue for all 12 months */




    .custom-birthstone-{{ section.id }} .month-item { 
      font-size: clamp(16px, 2.5vw, 18px); text-align: center; justify-content: center; width: 100%; display: flex;
    }

    /* 5. Button */
    .custom-birthstone-{{ section.id }} .btn-container { 
      order: 4; display: flex; justify-content: center; width: 100%; margin-top: 0; padding-top: 0; 
    }
    .custom-birthstone-{{ section.id }} .btn-outline { 
      width: 100% !important; max-width: 320px; display: inline-flex !important; margin: 0 auto; height: 50px; opacity: 1 !important; visibility: visible !important; pointer-events: auto !important; 
    }
    .custom-birthstone-{{ section.id }} .btn-outline:not(.active) { display: none !important; }
  }

  /* Mobile Phones Specific Overrides (max-width: 767px) */
  @media (max-width: 767px) {
    .custom-birthstone-{{ section.id }} { padding-top: 40px; padding-bottom: 40px; }
    .custom-birthstone-{{ section.id }} .birthstone-container { padding-left: 20px; padding-right: 20px; }
    
    .custom-birthstone-{{ section.id }} .mobile-section-header { display: block !important; text-align: left; }
    .custom-birthstone-{{ section.id }} .desktop-section-header { display: none !important; }
    
    .custom-birthstone-{{ section.id }} .right-title { font-size: 28px; text-align: left; margin-bottom: 12px; }
    .custom-birthstone-{{ section.id }} .right-desc { font-size: 14px; text-align: left; margin-bottom: 20px; }
    .custom-birthstone-{{ section.id }} .right-divider { border-top: 1px solid #2C2C2C; margin-bottom: 30px; }
    
    .custom-birthstone-{{ section.id }} .months-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 15px !important; margin-bottom: 30px; }
    .custom-birthstone-{{ section.id }} .month-item { font-size: 14px; }
    
    /* Slightly less padding on mobile outermost card */
    .custom-birthstone-{{ section.id }} .stone-card-outermost { padding: 30px !important; margin-bottom: 30px; }
  }
{%- endstyle -%}

{%- assign unique_categories = "" -%}
{%- for block in section.blocks -%}
  {%- unless unique_categories contains block.settings.month_name -%}
    {%- assign unique_categories = unique_categories | append: block.settings.month_name | append: "||" -%}
  {%- endunless -%}
{%- endfor -%}
{%- assign categories_array = unique_categories | split: "||" -%}

<section class="custom-birthstone-{{ section.id }}" data-section-id="{{ section.id }}">
  
  <div class="mobile-section-header">
    <h2 class="right-title">{{ section.settings.title }}</h2>
    <p class="right-desc">{{ section.settings.description }}</p>
    <hr class="right-divider">
  </div>

  <div class="birthstone-container">
    
    <div class="birthstone-left" id="card-slider-{{ section.id }}">
      <div class="stone-card-outermost">
        
        <div class="stone-card-white-box">
          <div class="stone-card-padded-area">
            <div class="slides-viewport">
              {%- for block in section.blocks -%}
                <div class="stone-card-slide {% if forloop.first %}active{% endif %}" 
                     data-category="{{ block.settings.month_name | escape }}"
                     data-index="{{ forloop.index0 }}" 
                     style="
                        --gradient-deg: {{ block.settings.gradient_deg }}deg;
                        --card-bg: {{ block.settings.card_bg_color }};
                        --border-grad-1: {{ block.settings.border_color_1 }};
                        --border-grad-2: {{ block.settings.border_color_2 }};
                        --border-grad-3: {{ block.settings.border_color_3 }};
                        --card-divider-color: {{ block.settings.card_divider_color }};
                        --accent-text-color: {{ block.settings.accent_text_color }};
                     "
                     {{ block.shopify_attributes }}>
                  
                  <div class="stone-card-outer-border">
                    <div class="stone-card-inner-border">
                      
                      <div class="card-header">
                        <h3 class="card-title">{{ block.settings.card_title }}</h3>
                        <hr class="card-title-divider">
                        <p class="card-subtitle">{{ block.settings.card_subtitle }}</p>
                      </div>

                      <div class="card-middle">
                        {%- if block.settings.stone_image != blank -%}
                          <img src="{{ block.settings.stone_image | image_url: width: 600 }}" alt="{{ block.settings.card_title }}" class="stone-image" loading="lazy">
                        {%- else -%}
                          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg stone-image' }}
                        {%- endif -%}

                        <div class="energy-effects">
                          <h4 class="energy-title">ENERGY EFFECTS:</h4>
                          <ul class="energy-list">
                            {%- for i in (1..3) -%}
                              {%- capture effect_text_key -%}effect_{{ i }}_text{%- endcapture -%}
                              {%- capture effect_icon_key -%}effect_{{ i }}_icon{%- endcapture -%}
                              
                              {%- assign effect_text = block.settings[effect_text_key] -%}
                              {%- assign effect_icon = block.settings[effect_icon_key] -%}
                              
                              {%- if effect_text != blank -%}
                                <li class="energy-item">
                                  {%- if effect_icon != blank -%}
                                    <div class="energy-icon-mask" style="-webkit-mask-image: url({{ effect_icon | image_url: width: 40 }}); mask-image: url({{ effect_icon | image_url: width: 40 }});"></div>
                                  {%- else -%}
                                    <div class="energy-icon-mask" style="-webkit-mask-image: url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 24 24%22 fill=%22none%22 stroke=%22currentColor%22 stroke-width=%222%22><path d=%22M5 13l4 4L19 7%22/></svg>');"></div>
                                  {%- endif -%}
                                  <span>{{ effect_text }}</span>
                                </li>
                              {%- endif -%}
                            {%- endfor -%}
                          </ul>
                        </div>
                      </div>

                      <div class="card-bottom">
                        <p class="card-description">{{ block.settings.card_description }}</p>

                        <div class="zodiac-match">
                          <span class="zodiac-title">ZODIAC MATCH:</span>
                          {%- for i in (1..3) -%}
                            {%- capture zodiac_text_key -%}zodiac_{{ i }}_text{%- endcapture -%}
                            {%- capture zodiac_icon_key -%}zodiac_{{ i }}_icon{%- endcapture -%}
                            
                            {%- assign zodiac_text = block.settings[zodiac_text_key] -%}
                            {%- assign zodiac_icon = block.settings[zodiac_icon_key] -%}
                            
                            {%- if zodiac_text != blank -%}
                              <div class="zodiac-item">
                                {%- if zodiac_icon != blank -%}
                                  <div class="zodiac-icon-mask" style="-webkit-mask-image: url({{ zodiac_icon | image_url: width: 50 }}); mask-image: url({{ zodiac_icon | image_url: width: 50 }});"></div>
                                {%- endif -%}
                                <span>{{ zodiac_text }}</span>
                              </div>
                            {%- endif -%}
                          {%- endfor -%}
                        </div>
                      </div>

                    </div>
                  </div>
                </div>
              {%- endfor -%}
            </div>
          </div>
        </div>

        <div class="slider-controls" id="slider-controls-{{ section.id }}">
          <button class="slider-arrow prev-arrow {% if section.settings.arrow_left_hover_icon != blank %}has-hover-img{% endif %}" id="prev-{{ section.id }}">
