               class="btn-outline {% if forloop.first %}active{% endif %}" 
               data-category="{{ block.settings.month_name | escape }}"
               data-index="{{ forloop.index0 }}"
               style="
                 background-color: {{ block.settings.btn_bg_color | default: 'transparent' }}; 
                 --btn-text: {{ block.settings.btn_text_color }}; 
                 --btn-border: {{ block.settings.btn_border_color }};
                 --gradient-deg: {{ block.settings.gradient_deg }}deg;
                 --border-grad-1: {{ block.settings.border_color_1 }};
                 --border-grad-2: {{ block.settings.border_color_2 }};
                 --border-grad-3: {{ block.settings.border_color_3 }};
               ">
               <span class="btn-text">{{ block.settings.btn_text }}</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>

    </div>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sectionId = '{{ section.id }}';
    const monthItems = document.querySelectorAll(`#months-grid-${sectionId} .month-item`);
    const cardSlides = Array.from(document.querySelectorAll(`#card-slider-${sectionId} .stone-card-slide`));
    const buttons = Array.from(document.querySelectorAll(`#btn-container-${sectionId} .btn-outline`));
    const allDots = Array.from(document.querySelectorAll(`#dots-${sectionId} .dot`));
    const prevBtn = document.getElementById(`prev-${sectionId}`);
    const nextBtn = document.getElementById(`next-${sectionId}`);
    const controlsContainer = document.getElementById(`slider-controls-${sectionId}`);

    if (monthItems.length === 0 || cardSlides.length === 0) return;

    let currentCategory = monthItems[0].getAttribute('data-category');
    let currentIndex = 0;

    function updateSlider() {
      const activeSlides = cardSlides.filter(slide => slide.getAttribute('data-category') === currentCategory);
      const activeButtons = buttons.filter(btn => btn.getAttribute('data-category') === currentCategory);
      const activeDots = allDots.filter(dot => dot.getAttribute('data-category') === currentCategory);

      if (activeSlides.length <= 1) {
        controlsContainer.style.display = 'none';
      } else {
        controlsContainer.style.display = 'flex';
      }

      cardSlides.forEach(s => s.classList.remove('active'));
      buttons.forEach(b => b.classList.remove('active'));
      allDots.forEach(d => d.classList.remove('visible', 'active'));

      if (currentIndex >= activeSlides.length) currentIndex = 0;
      if (currentIndex < 0) currentIndex = activeSlides.length - 1;

      if (activeSlides.length > 0) {
        activeSlides[currentIndex].classList.add('active');
        if (activeButtons[currentIndex]) activeButtons[currentIndex].classList.add('active');
        
        activeDots.forEach((dot, index) => {
          dot.classList.add('visible');
          if (index === currentIndex) dot.classList.add('active');
        });
      }
    }

    updateSlider();

    monthItems.forEach((item) => {
      item.addEventListener('click', (e) => {
        e.preventDefault();
        monthItems.forEach(m => m.classList.remove('active'));
        item.classList.add('active');
        currentCategory = item.getAttribute('data-category');
        currentIndex = 0;
        updateSlider();
      });
    });

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        currentIndex--;
        updateSlider();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        currentIndex++;
        updateSlider();
      });
    }

    allDots.forEach((dot) => {
      dot.addEventListener('click', (e) => {
        if (dot.getAttribute('data-category') === currentCategory) {
          const activeDots = allDots.filter(d => d.getAttribute('data-category') === currentCategory);
          currentIndex = activeDots.indexOf(dot);
          updateSlider();
        }
      });
    });
  });
</script>

