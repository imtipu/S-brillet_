{%- style -%}
  .shine-brighter-wrapper-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    /* Top 80px, Right 120px, Bottom 80px, Left 120px from Figma Frame 153 */
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_side }}px {{ section.settings.padding_bottom }}px {{ section.settings.padding_side }}px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .shine-brighter-content-{{ section.id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: {{ section.settings.gap }}px; /* 40px gap from Figma */
    max-width: 688px; /* Exact width from Figma screenshot */
    width: 100%;
    text-align: center;
  }

  .shine-brighter-content-{{ section.id }} h2 {
    margin: 0;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.heading_size }}px;
    /* This forces the heading to use your active Shopify theme's heading font */
   font-family: var(--font-heading-family, 'Libre Caslon Text', serif);
    font-weight: 400;
    line-height: 1.23;
    color: #2C2C2C;
  }

  .shine-brighter-content-{{ section.id }} p {
    margin: 0;
    color: {{ section.settings.text_color }};
    /* Exact font family from Figma */
    font-family: 'Licorice', cursive; 
    font-size: {{ section.settings.subtext_size }}px;
    font-weight: 400; /* Regular weight from Figma */
    line-height: {{ section.settings.subtext_line_height }}px; /* 38px from Figma */
    letter-spacing: 0px; /* 0px from Figma */
    -webkit-font-smoothing: antialiased;
  }



  @media (min-width: 1441px) and (max-width: 1728px) {

    .shine-brighter-content-{{ section.id }} h2 {
        font-size: 54px;

      }
  }



  @media screen and (max-width: 1440px){

      .shine-brighter-content-{{ section.id }} h2 {
        font-size: 46px;
      }

      
  }

  /* Responsive adjustments (Mobile view) */
  @media screen and (max-width: 768px) {
    .shine-brighter-wrapper-{{ section.id }} {
      padding: 40px 20px; /* Smaller padding on phones */
    }
    .shine-brighter-content-{{ section.id }} h2 {
      font-size: calc({{ section.settings.heading_size }}px * 0.7);
    }
    .shine-brighter-content-{{ section.id }} p {
      font-size: calc({{ section.settings.subtext_size }}px * 0.8);
      line-height: normal;
    }
  }
{%- endstyle -%}

<!-- Importing the Licorice font specifically for the subtext -->
<link href="https://fonts.googleapis.com/css2?family=Licorice&display=swap" rel="stylesheet">

<div class="shine-brighter-wrapper-{{ section.id }}">
  <div class="shine-brighter-content-{{ section.id }}">
    {% if section.settings.heading != blank %}
      <h2>{{ section.settings.heading }}</h2>
    {% endif %}
    
    {% if section.settings.subtext != blank %}
      <p>{{ section.settings.subtext }}</p>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Shine Brighter Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shine Brighter"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Connecting You to the Energy Within You"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFF9F5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2C2C2C"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Heading Font Size",
      "default": 64
    },
    {
      "type": "range",
      "id": "subtext_size",
      "min": 20,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Subtext Font Size",
      "default": 55
    },
    {
      "type": "range",
      "id": "subtext_line_height",
      "min": 20,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Subtext Line Height",
      "default": 38
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_side",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Side Padding",
      "default": 120
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Gap between heading and text",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Shine Brighter Hero"
    }
  ]
}
{% endschema %}