<section class="custom-hero">
  <div class="custom-hero__container">
    
    <h1 class="custom-hero__heading">
      {{ section.settings.heading }}
    </h1>

    <p class="custom-hero__subtext">
      {{ section.settings.subtext }}
    </p>

    <div class="custom-hero__buttons">
      <a href="{{ section.settings.btn1_link }}" class="btn btn-primary">
        {{ section.settings.btn1_text }}
      </a>
      <a href="{{ section.settings.btn2_link }}" class="btn btn-outline">
        {{ section.settings.btn2_text }}
      </a>
    </div>

  </div>
</section>

<style>
.custom-hero {
  padding: 10px 20px;
}

.custom-hero__container {
  max-width: 1720px;
  margin: 0 auto;
  text-align: center;
}

/* Heading */
.custom-hero__heading {
  font-size: 64px;
  font-weight: 400;
  text-transform: uppercase;
  line-height: 1.2;
  margin-bottom: 15px;
}

/* Subtext */
.custom-hero__subtext {
  font-size: 18px;
  color: #555;
  margin-bottom: 30px;
}

/* Buttons */
.custom-hero__buttons {
  display: flex;
  justify-content: center;
  gap: 20px;
  flex-wrap: wrap;
}

.btn {
  padding: 14px 30px;
  font-size: 14px;
  text-decoration: none;
  letter-spacing: 1px;
  transition: 0.3s;
}

.btn-primary {
  background: #333;
  color: #fff;
}

.btn-outline {
  border: 1px solid #333;
  color: #333;
}

/* Hover */
.btn-primary:hover {
  background: #000;
}

.btn-outline:hover {
  background: #333;
  color: #fff;
}

/* =========================
   Responsive
========================= */

/* Laptop */
@media (max-width: 1200px) {
  .custom-hero__heading {
    font-size: 48px;
  }
}

/* Tablet */
@media (max-width: 768px) {
  .custom-hero__heading {
    font-size: 36px;
  }

  .custom-hero__subtext {
    font-size: 16px;
  }
}

/* Mobile */
@media (max-width: 480px) {
  .custom-hero__heading {
    font-size: 28px;
  }

  .btn {
    width: 100%;
    text-align: center;
  }
}
</style>

{% schema %}
{
  "name": "Custom Elegant Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shine bright with elegant style"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Discover our collection of magical jewellery crafted to make every moment unforgettable"
    },
    {
      "type": "text",
      "id": "btn1_text",
      "label": "Primary Button Text",
      "default": "READY TO SHIP"
    },
    {
      "type": "url",
      "id": "btn1_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "btn2_text",
      "label": "Secondary Button Text",
      "default": "SHOP ALL"
    },
    {
      "type": "url",
      "id": "btn2_link",
      "label": "Secondary Button Link"
    }
  ],
  "presets": [
    {
      "name": "Custom Elegant Hero"
    }
  ]
}
{% endschema %}