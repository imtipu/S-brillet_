    .certified-title-{{ section.id }} {
      font-size: 28px !important; /* Forced 28px for Mobile */
    }
    .certified-text-{{ section.id }},
    .certified-text-{{ section.id }} p {
      font-size: 14px !important; /* Proportionately smaller for mobile */
    }
  }
  /* ─── iPad / Tablet (769px - 1024px) ─────────────────────────── */
@media screen and (min-width: 769px) and (max-width: 1024px) {
  .section-{{ section.id }}-padding {
    
    padding-left: 40px;
    padding-right: 40px;
   
  } 
