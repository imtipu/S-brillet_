{% comment %}  
{%- style -%}
  /* Section Spacing */
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mb }}px;
    padding-bottom: {{ section.settings.padding_bottom_mb }}px;
    padding-left: 20px;
    padding-right: 20px;
    background-color: {{ section.settings.bg_color }};
    overflow: hidden;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      padding-left: {{ section.settings.padding_left }}px;
      padding-right: {{ section.settings.padding_right }}px;
    }
  }

  .shining-wrapper-{{ section.id }} {
    max-width: {{ section.settings.container_max_width }}px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 40px;
    align-items: center;
    text-align: center;
  }

  /* Typography Styles (Desktop Defaults) */
  .shining-title-{{ section.id }} {
    font-family: var(--font-heading-family, serif);
    font-size: {{ section.settings.title_size }}px;
    font-weight: 400;
    line-height: {{ section.settings.title_lh }};
    color: {{ section.settings.title_color }};
    margin: 0;
    text-transform: uppercase;
    max-width: {{ section.settings.title_max_width }}px;
    text-align: center;
  }

  /* Rings Display - Premium Smooth logic */
  .rings-carousel-{{ section.id }} {
    position: relative;
    width: 100%;
    max-width: 1100px;
    height: 480px;
    margin: 40px 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ring-container {
    position: absolute;
    /* Professional 'ease-out' timing to remove the 'dhakka' (bounce) */
    transition: all 1.2s cubic-bezier(0.25, 1, 0.5, 1);
    line-height: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    pointer-events: none;
  }

  .ring-container.pos-left {
    left: 0;
    width: 182px;
    z-index: 1;
    opacity: 0.2;
    transform: scale(0.65);
  }

  .ring-container.pos-center {
    left: 50%;
    width: 364px;
    z-index: 5;
    opacity: 1;
    transform: translateX(-50%) scale(1);
  }

  .ring-container.pos-right {
    left: 100%;
    width: 182px;
    z-index: 1;
    opacity: 0.2;
    transform: translateX(-100%) scale(0.65);
  }

  .ring-container img {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  /* Info Cards Section */
  .info-cards-{{ section.id }} {
    display: flex;
    justify-content: center;
    gap: 40px;
    width: 100%;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }

  .info-card-item {
    flex: 1;
    min-width: 280px;
    max-width: 440px;
    border: 1px solid #E5E5E5;
    background: #FFFFFF;
    padding: 30px 35px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    cursor: pointer;
    transition: all 0.6s ease;
    border-radius: 4px;
  }

  .info-card-item.is-selected {
    border: 1px solid #000000;
    box-shadow: 0 15px 40px rgba(0,0,0,0.06);
  }

  .card-icon { width: 90px; height: 90px; }
  .card-icon img { width: 100%; height: 100%; object-fit: contain; }

  .shining-subtitle-{{ section.id }},
  .shining-subtitle-{{ section.id }} p {
    font-family: var(--font-body-family, sans-serif);
    font-size: {{ section.settings.subtitle_size }}px;
    font-weight: 400;
    line-height: 1.5;
    color: {{ section.settings.text_color }};
    margin: 0;
    text-transform: uppercase;
    text-align: center;
  }

  /* Button with 3-Color Gradient Hover */
  .plating-btn-{{ section.id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 350px;
    height: 55px;
    background-color: {{ section.settings.btn_bg_color }};
    color: #ffffff;
    text-decoration: none;
   font-family: inter, sans-serif;
    font-size: 20px;
    text-transform: uppercase;
    transition: all 0.6s ease;
    border: none;
    cursor: pointer;
    position: relative;
    z-index: 1;
    overflow: hidden;
  }

  .plating-btn-{{ section.id }}:before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, 
      {{ section.settings.btn_grad_1 }} 0%, 
      {{ section.settings.btn_grad_2 }} 50%, 
      {{ section.settings.btn_grad_3 }} 100%
    );
    z-index: -1;
    opacity: 0;
    transition: opacity 0.6s ease; 
  }

  .plating-btn-{{ section.id }}:hover:before {
    opacity: 1;
  }

  .plating-btn-{{ section.id }}:hover {
    color: {{ section.settings.btn_hover_text_color }};
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
  }

  /* ==================================================================
     RESPONSIVE ADJUSTMENTS (Macbook, Tablet, Mobile)
     ================================================================== */
     

     /* ─── MacBook Air 15 inch M2 (1441px - 1728px) ───────────────── */
@media screen and (min-width: 1441px) and (max-width: 1728px) {
  .shining-title-{{ section.id }} { font-size: 54px !important; }
  .shining-subtitle-{{ section.id }}, .shining-subtitle-{{ section.id }} p { font-size: 18px !important; }

  .rings-carousel-{{ section.id }} { height: 430px; }
  .ring-container.pos-center { width: 330px; }
  .ring-container.pos-left, .ring-container.pos-right { width: 165px; }

  .info-cards-{{ section.id }} { gap: 30px; }
}

  /* Laptop & Macbook (up to 1440px) */
  @media screen and (max-width: 1440px) {
    .shining-title-{{ section.id }} { font-size: 46px !important; }
    .shining-subtitle-{{ section.id }}, .shining-subtitle-{{ section.id }} p { font-size: 16px !important; }
    
    /* Scaled down images for Macbook to maintain Desktop vibe */
    .rings-carousel-{{ section.id }} { height: 380px; }
    .ring-container.pos-center { width: 300px; }
    .ring-container.pos-left, .ring-container.pos-right { width: 150px; }
    
    .info-cards-{{ section.id }} { gap: 20px; }
  }

  /* Tablets (up to 1024px) */
  @media screen and (max-width: 1024px) {
    .shining-title-{{ section.id }} { font-size: 38px !important; }
    
    /* Further scaled down for Tablets */
    .rings-carousel-{{ section.id }} { height: 320px; }
    .ring-container.pos-center { width: 250px; }
    .ring-container.pos-left, .ring-container.pos-right { width: 120px; }
  }
/* ─── iPad / Tablet (769px - 1024px) ─────────────────────────── */
@media screen and (min-width: 769px) and (max-width: 1024px) {
  .section-{{ section.id }}-padding {
    padding-left: 40px;
    padding-right: 40px;
  }
  .info-cards-{{ section.id }} {
    flex-wrap: nowrap;
    gap: 16px;
  }
  .info-card-item {
    min-width: 0;
    flex: 1 1 0;
    padding: 20px 12px;
  }
}
  /* Mobile (up to 768px) */
  @media screen and (max-width: 768px) {

      .shining-wrapper-{{ section.id }} {
        gap: 10px;
      }
    .shining-title-{{ section.id }} { font-size: 28px !important; }
    .shining-subtitle-{{ section.id }}, .shining-subtitle-{{ section.id }} p { font-size: 14px !important; }
    
    /* Scaled down perfectly for Mobile screens */
    .rings-carousel-{{ section.id }} { height: 240px; margin: 20px 0; }
    .ring-container.pos-center { width: 180px; }
    .ring-container.pos-left, .ring-container.pos-right { width: 90px; }
    
    /* 3 Cards in a Row for Mobile */
    .info-cards-{{ section.id }} { 
      gap: 8px; /* Tighter gap between cards */
      flex-wrap: nowrap; /* Forces cards into a single row */
    }
    .info-card-item { 
      min-width: 0; /* Removes desktop min-width limitation */
      flex: 1 1 0; /* Distributes width equally among the 3 cards */
      padding: 15px 5px; /* Reduces padding to save space */
      gap: 8px; /* Tighter gap between icon and text */
    }
    .info-card-item .card-icon {
      width: 45px; /* Scaled down icon for mobile row */
      height: 45px;
    }
    .info-card-item .shining-subtitle-{{ section.id }},
    .info-card-item .shining-subtitle-{{ section.id }} p {
      font-size: 10px !important; /* Scaled down font to fit in a narrow card */
      line-height: 1.2;
    }
    
    .plating-btn-{{ section.id }} { width: 100%; }
  }
{%- endstyle -%}

<section class="section-{{ section.id }}-padding" data-section-id="{{ section.id }}">
  <div class="shining-wrapper-{{ section.id }}">
    
    <h2 class="shining-title-{{ section.id }}">
      {{ section.settings.heading }}
    </h2>

    <div class="rings-carousel-{{ section.id }}" id="RingsDisplay-{{ section.id }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign init_pos = 'pos-side'
          if forloop.index == 1
            assign init_pos = 'pos-left'
          elsif forloop.index == 2
            assign init_pos = 'pos-center'
          elsif forloop.index == 3
            assign init_pos = 'pos-right'
          endif
        -%}
        <div class="ring-container {{ init_pos }}" 
             data-index="{{ forloop.index0 }}" 
             id="Ring-{{ section.id }}-{{ forloop.index0 }}">
          {% if block.settings.ring_image != blank %}
            {{ block.settings.ring_image | image_url: width: 800 | image_tag: loading: 'lazy' }}
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </div>
      {%- endfor -%}
    </div>

    <div class="info-cards-{{ section.id }}">
      {%- for block in section.blocks -%}
        <div class="info-card-item {% if forloop.index == 2 %}is-selected{% endif %}" 
             data-index="{{ forloop.index0 }}" 
             {{ block.shopify_attributes }}>
          <div class="card-icon">
            {% if block.settings.icon != blank %}
              {{ block.settings.icon | image_url: width: 200 | image_tag: loading: 'lazy' }}
            {% endif %}
          </div>
          <div class="shining-subtitle-{{ section.id }}">
            {{ block.settings.text }}
          </div>
        </div>
      {%- endfor -%}
    </div>

    {% if section.settings.btn_label != blank %}
      <a href="{{ section.settings.btn_link }}" class="plating-btn-{{ section.id }}">
        {{ section.settings.btn_label }}
      </a>
    {% endif %}

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sectionId = "{{ section.id }}";
    const cards = document.querySelectorAll(`.section-${sectionId}-padding .info-card-item`);
    const rings = document.querySelectorAll(`.section-${sectionId}-padding .ring-container`);

    function animateCarousel(clickedIdx) {
      cards.forEach((c, idx) => {
        if (idx === clickedIdx) c.classList.add('is-selected');
        else c.classList.remove('is-selected');
      });

      rings.forEach((ring, ringIdx) => {
        ring.classList.remove('pos-left', 'pos-center', 'pos-right');
        
        if (clickedIdx === 0) {
          if (ringIdx === 0) ring.classList.add('pos-center');
          if (ringIdx === 1) ring.classList.add('pos-right');
          if (ringIdx === 2) ring.classList.add('pos-left');
        } else if (clickedIdx === 1) {
          if (ringIdx === 0) ring.classList.add('pos-left');
          if (ringIdx === 1) ring.classList.add('pos-center');
          if (ringIdx === 2) ring.classList.add('pos-right');
        } else if (clickedIdx === 2) {
          if (ringIdx === 0) ring.classList.add('pos-right');
          if (ringIdx === 1) ring.classList.add('pos-left');
          if (ringIdx === 2) ring.classList.add('pos-center');
        }
      });
    }

    cards.forEach(card => {
      card.addEventListener('click', function() {
        const index = parseInt(this.getAttribute('data-index'));
        animateCarousel(index);
      });
    });
  });
</script>

