  .shining-subtitle-{{ section.id }}, .shining-subtitle-{{ section.id }} p { font-size: 18px !important; }

  .rings-carousel-{{ section.id }} { height: 430px; }
  .ring-container.pos-center { width: 330px; }
  .ring-container.pos-left, .ring-container.pos-right { width: 165px; }

  .info-cards-{{ section.id }} { gap: 30px; }
}

  /* Laptop & Macbook (up to 1440px) */
  @media screen and (max-width: 1440px) {
    .shining-title-{{ section.id }} { font-size: 46px !important; }
    .shining-subtitle-{{ section.id }}, .shining-subtitle-{{ section.id }} p { font-size: 16px !important; }
    
    /* Scaled down images for Macbook to maintain Desktop vibe */
    .rings-carousel-{{ section.id }} { height: 380px; }
    .ring-container.pos-center { width: 300px; }
    .ring-container.pos-left, .ring-container.pos-right { width: 150px; }
    
    .info-cards-{{ section.id }} { gap: 20px; }
  }

  /* Tablets (up to 1024px) */
  @media screen and (max-width: 1024px) {
    .shining-title-{{ section.id }} { font-size: 38px !important; }
    
    /* Further scaled down for Tablets */
    .rings-carousel-{{ section.id }} { height: 320px; }
    .ring-container.pos-center { width: 250px; }
    .ring-container.pos-left, .ring-container.pos-right { width: 120px; }
  }
/* ─── iPad / Tablet (769px - 1024px) ─────────────────────────── */
@media screen and (min-width: 769px) and (max-width: 1024px) {
  .section-{{ section.id }}-padding {
    padding-left: 40px;
    padding-right: 40px;
  }
  .info-cards-{{ section.id }} {
    flex-wrap: nowrap;
    gap: 16px;
  }
  .info-card-item {
    min-width: 0;
    flex: 1 1 0;
    padding: 20px 12px;
  }
}
  /* Mobile (up to 768px) */
  @media screen and (max-width: 768px) {

      .shining-wrapper-{{ section.id }} {
        gap: 10px;
      }
    .shining-title-{{ section.id }} { font-size: 28px !important; }
    .shining-subtitle-{{ section.id }}, .shining-subtitle-{{ section.id }} p { font-size: 14px !important; }
    
    /* Scaled down perfectly for Mobile screens */
    .rings-carousel-{{ section.id }} { height: 240px; margin: 20px 0; }
    .ring-container.pos-center { width: 180px; }
    .ring-container.pos-left, .ring-container.pos-right { width: 90px; }
    
    /* 3 Cards in a Row for Mobile */
    .info-cards-{{ section.id }} { 
      gap: 8px; /* Tighter gap between cards */
      flex-wrap: nowrap; /* Forces cards into a single row */
    }
    .info-card-item { 
      min-width: 0; /* Removes desktop min-width limitation */
      flex: 1 1 0; /* Distributes width equally among the 3 cards */
      padding: 15px 5px; /* Reduces padding to save space */
      gap: 8px; /* Tighter gap between icon and text */
    }
    .info-card-item .card-icon {
      width: 45px; /* Scaled down icon for mobile row */
      height: 45px;
    }
    .info-card-item .shining-subtitle-{{ section.id }},
    .info-card-item .shining-subtitle-{{ section.id }} p {
      font-size: 10px !important; /* Scaled down font to fit in a narrow card */
      line-height: 1.2;
    }
    
    .plating-btn-{{ section.id }} { width: 100%; }
  }
{%- endstyle -%}

<section class="section-{{ section.id }}-padding" data-section-id="{{ section.id }}">
  <div class="shining-wrapper-{{ section.id }}">
    
    <h2 class="shining-title-{{ section.id }}">
      {{ section.settings.heading }}
    </h2>

    <div class="rings-carousel-{{ section.id }}" id="RingsDisplay-{{ section.id }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign init_pos = 'pos-side'
          if forloop.index == 1
            assign init_pos = 'pos-left'
          elsif forloop.index == 2
            assign init_pos = 'pos-center'
          elsif forloop.index == 3
            assign init_pos = 'pos-right'
          endif
        -%}
        <div class="ring-container {{ init_pos }}" 
             data-index="{{ forloop.index0 }}" 
             id="Ring-{{ section.id }}-{{ forloop.index0 }}">
          {% if block.settings.ring_image != blank %}
            {{ block.settings.ring_image | image_url: width: 800 | image_tag: loading: 'lazy' }}
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </div>
      {%- endfor -%}
    </div>

    <div class="info-cards-{{ section.id }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_link = block.settings.card_link
          if card_link == blank
            assign card_link = section.settings.btn_link
          endif
        -%}
        <div class="info-card-item {% if forloop.index == 2 %}is-selected{% endif %}" 
             data-index="{{ forloop.index0 }}" 
             data-link="{{ card_link | escape }}"
             {{ block.shopify_attributes }}>
          <div class="card-icon">
            {% if block.settings.icon != blank %}
              {{ block.settings.icon | image_url: width: 200 | image_tag: loading: 'lazy' }}
            {% endif %}
          </div>
          <div class="shining-subtitle-{{ section.id }}">
            {{ block.settings.text }}
          </div>
        </div>
      {%- endfor -%}
    </div>

    {% if section.settings.btn_label != blank %}
      <a href="{{ section.settings.btn_link }}" id="CtaBtn-{{ section.id }}" class="plating-btn-{{ section.id }}">
        {{ section.settings.btn_label }}
      </a>
    {% endif %}

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sectionId = "{{ section.id }}";
    const cards = document.querySelectorAll(`.section-${sectionId}-padding .info-card-item`);
    const rings = document.querySelectorAll(`.section-${sectionId}-padding .ring-container`);
    const ctaBtn = document.getElementById(`CtaBtn-${sectionId}`);

    function updateCtaLink(clickedIdx) {
      if (!ctaBtn) return;
      const activeCard = document.querySelector(`.section-${sectionId}-padding .info-card-item[data-index="${clickedIdx}"]`);
      if (!activeCard) return;
      const link = activeCard.getAttribute('data-link');
      if (link) {
        ctaBtn.setAttribute('href', link);
      }
    }

    function animateCarousel(clickedIdx) {
      cards.forEach((c, idx) => {
        if (idx === clickedIdx) c.classList.add('is-selected');
        else c.classList.remove('is-selected');
      });

      rings.forEach((ring, ringIdx) => {
        ring.classList.remove('pos-left', 'pos-center', 'pos-right');
        
        if (clickedIdx === 0) {
          if (ringIdx === 0) ring.classList.add('pos-center');
          if (ringIdx === 1) ring.classList.add('pos-right');
          if (ringIdx === 2) ring.classList.add('pos-left');
        } else if (clickedIdx === 1) {
          if (ringIdx === 0) ring.classList.add('pos-left');
          if (ringIdx === 1) ring.classList.add('pos-center');
          if (ringIdx === 2) ring.classList.add('pos-right');
        } else if (clickedIdx === 2) {
          if (ringIdx === 0) ring.classList.add('pos-right');
          if (ringIdx === 1) ring.classList.add('pos-left');
          if (ringIdx === 2) ring.classList.add('pos-center');
        }
      });

      updateCtaLink(clickedIdx);
    }

    cards.forEach(card => {
      card.addEventListener('click', function() {
        const index = parseInt(this.getAttribute('data-index'));
        animateCarousel(index);
      });
    });

    // Set the CTA link correctly on load, based on whichever card starts selected
    const initiallySelected = document.querySelector(`.section-${sectionId}-padding .info-card-item.is-selected`);
    if (initiallySelected) {
      updateCtaLink(parseInt(initiallySelected.getAttribute('data-index')));
    }
  });
</script>

