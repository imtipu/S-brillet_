        </div>
      {%- endif -%}

    </div>

    {%- if section.settings.btn_text != blank -%}
      <div class="shining-btn-container">
        <a href="{{ section.settings.btn_link | default: '#' }}" class="shining-btn">{{ section.settings.btn_text }}</a>
      </div>
    {%- endif -%}

  </div>
</section>

