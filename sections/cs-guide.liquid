{% style %}
.section-{{ section.id }} {
  max-width: 1920px;
  margin: 0 auto;
  padding: 80px 20px;
}

.section-{{ section.id }} .container {
  max-width: 1720px;
  margin: 0 auto;
  text-align: center;
}

.section-{{ section.id }} .heading {
  font-size: 64px;
  font-weight: 400;
  font-family: 'Libre Caslon Text', serif;
  color: #2C2C2C;
  margin-bottom: 10px;
}

.section-{{ section.id }} .description {
  font-size: 20px;
  font-family: 'Inter', sans-serif;
  font-weight: 400;
  color: #555;
  max-width: 900px;
  margin: 0 auto 30px;
}

.section-{{ section.id }} .image-wrapper img {
  width: 100%;
  height: 560px;
  display: block;
  margin: 30px 0;
}

.section-{{ section.id }} .lists {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  text-align: left;
}


.section-{{ section.id }} .list-title {
  font-size: 36px;
  margin-bottom: 15px;
  font-weight: 500;
}

.section-{{ section.id }} .list-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12px;
  max-width: 599px;
}

.section-{{ section.id }} .list-item img {
  width: 18px;
  height: 18px;
  margin-right: 10px;
  margin-top: 4px;
}


.section-{{ section.id }} .shop-all-btn {
  width: 275px;
  height: 55px;
  background: #2C2C2C;
  color: #FFFFFF;
  font-size: 20px;
  font-weight: 300;
  text-transform: uppercase;
  display: flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  transition: background 0.3s ease;
  margin-top: 40px;
  margin-left: auto;
  margin-right: auto;
}

.section-{{ section.id }} .shop-all-btn:hover {
      background: linear-gradient(135deg, #947863, #E9DDD4, #947863) !important;
}

.section-{{ section.id }} .shop-all-btn:hover {
  opacity: 0.85;
}

@media screen and (max-width: 768px) {
  .section-{{ section.id }} .heading {
    font-size: 36px;
  }

  .section-{{ section.id }} .description {
    font-size: 16px;
  }

  .section-{{ section.id }} .lists {
    grid-template-columns: 1fr;
  }
}
{% endstyle %}

<div class="section-{{ section.id }}">
  <div class="container">

    {% unless section.settings.hide_heading %}
      <h2 class="heading">{{ section.settings.heading }}</h2>
    {% endunless %}

    {% unless section.settings.hide_description %}
      <p class="description">{{ section.settings.description }}</p>
    {% endunless %}

    {% if section.settings.image %}
      <div class="image-wrapper">
        <img src="{{ section.settings.image | image_url: width: 1720 }}" alt="">
      </div>
    {% endif %}

    <div class="lists">

      <!-- DO'S -->
      <div>
        <div class="list-title">{{ section.settings.do_title }}</div>
        {% for block in section.blocks %}
          {% if block.type == 'do' %}
            <div class="list-item">
              {% if block.settings.icon %}
                <img src="{{ block.settings.icon | image_url }}" alt="">
              {% endif %}
              <div>{{ block.settings.text }}</div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <!-- DON'TS -->
      <div>
        <div class="list-title">{{ section.settings.dont_title }}</div>
        {% for block in section.blocks %}
          {% if block.type == 'dont' %}
            <div class="list-item">
              {% if block.settings.icon %}
                <img src="{{ block.settings.icon | image_url }}" alt="">
              {% endif %}
              <div>{{ block.settings.text }}</div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

    </div>

    {% if section.settings.shop_all_link != blank %}
  <div style="text-align:center;">
    <a href="{{ section.settings.shop_all_link }}" class="shop-all-btn">
      {{ section.settings.shop_all_label }}
    </a>
  </div>
{% endif %}

  </div>
</div>

{% schema %}
{
  "name": "Jewelry Care Section",
  "settings": [
    {
      "type": "checkbox",
      "id": "hide_heading",
      "label": "Hide Heading",
      "default": false
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Jewelry & Crystal Care Guide"
    },
    {
      "type": "checkbox",
      "id": "hide_description",
      "label": "Hide Description",
      "default": false
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Taking care of your jewelry and crystals ensures their beauty and energy last a lifetime."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main Image"
    },
    {
      "type": "text",
      "id": "do_title",
      "label": "Do's Title",
      "default": "Do's"
    },
    {
      "type": "text",
      "id": "dont_title",
      "label": "Don'ts Title",
      "default": "Don'ts"
    },
    {
  "type": "text",
  "id": "shop_all_label",
  "label": "Shop All Button Label",
  "default": "Shop All"
},
{
  "type": "url",
  "id": "shop_all_link",
  "label": "Shop All Button Link"
}
  ],
  "blocks": [
    {
      "type": "do",
      "name": "Do Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Your do item"
        }
      ]
    },
    {
      "type": "dont",
      "name": "Don't Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Your don't item"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Jewelry Care Section"
    }
  ]
}
{% endschema %}