{{ 'block-vote-collection-products.css' | asset_url | stylesheet_tag: preload: true }}

{% liquid
  assign storefront_proxy_path = settings.sbrillet_app_proxy_path | default: '/apps/sbrillet'
  assign app_id = settings.sbrillet_app_id | prepend: 'app--'
  assign current_tier = customer.metafields[app_id].loyalty_tier_config.value
  assign current_tier_key = current_tier.level | default: 'SHINY'
  assign selected_collection = block.settings.collection
  assign icon_star_level_shiny = 'icon-star-level-shiny.svg' | inline_asset_content
  assign icon_star_level_starlight = 'icon-star-level-starlight.svg' | inline_asset_content
  assign icon_star_level_galaxy = 'icon-star-level-galaxy.svg' | inline_asset_content
  assign icon_thumbs_up = 'icon-thumbs-up.svg' | asset_url
%}

<block-vote-collection-products
  class="vote-collection-products {% if block.settings.full_width %}vote-collection-products--full{% endif %}"
  data-proxy-path="{{ storefront_proxy_path }}"
  data-tier-level="{{ current_tier_key }}"
  data-icon-thumbs-up="{{ icon_thumbs_up }}"
  style="
    --vote-collection-background: {{ block.settings.background }};
    --vote-collection-max-width: {{ block.settings.content_max_width }}px;
    --vote-collection-padding-block: {{ block.settings.padding_block }}px;
    --vote-collection-grid-gap: {{ block.settings.grid_gap }}px;
    --vote-collection-card-padding: {{ block.settings.card_padding }}px;
    --vote-collection-card-radius: {{ block.settings.card_radius }}px;
    --vote-collection-button-radius: {{ block.settings.button_radius }}px;
  "
>
  <template data-tier-icon="SHINY">{{ icon_star_level_shiny }}</template>
  <template data-tier-icon="STARLIGHT">{{ icon_star_level_starlight }}</template>
  <template data-tier-icon="GALAXY">{{ icon_star_level_galaxy }}</template>
  <template data-tier-icon="ULTRA_GALAXY">{{ icon_star_level_galaxy }}</template>

  <div
    class="vote-collection-products__inner {% if block.settings.content_width == 'full' %}vote-collection-products__inner--full{% endif %}"
    {{ block.shopify_attributes }}
  >
    {% if block.settings.heading != blank %}
      <header class="vote-collection-products__header">
        <div>
          <p class="vote-collection-products__meta">Community picks</p>
          <h2 class="vote-collection-products__heading">{{ block.settings.heading }}</h2>
          {% if block.settings.description != blank %}
            <p class="vote-collection-products__description">{{ block.settings.description }}</p>
          {% endif %}
        </div>
      </header>
    {% endif %}

    {% if selected_collection != blank and selected_collection.products_count > 0 %}
      <div class="vote-collection-products__grid" data-product-grid aria-live="polite">
        {% for product in selected_collection.products %}
          {% liquid
            assign image_alt = product.featured_image.alt | default: product.title
          %}
          <article class="vote-collection-card" data-product-card data-product-id="{{ product.id }}">
            <a class="vote-collection-card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
              {% if product.featured_image %}
                {{
                  product.featured_image
                  | image_url: width: 700
                  | image_tag:
                    loading: 'lazy',
                    widths: '240, 360, 480, 700',
                    sizes: '(min-width: 1200px) 25vw, (min-width: 900px) 33vw, (min-width: 640px) 50vw, 100vw',
                    alt: image_alt
                }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'vote-collection-card__placeholder' }}
              {% endif %}
            </a>

            <div class="vote-collection-card__body">
              <a class="vote-collection-card__title-link" href="{{ product.url }}">
                <h3 class="vote-collection-card__title">{{ product.title }}</h3>
              </a>
              <p class="vote-collection-card__price">
                {% if product.compare_at_price > product.price %}
                  <s>{{ product.compare_at_price | money }}</s>
                {% endif %}
                {{ product.price | money }}
              </p>

              <div class="vote-collection-card__actions">
                <div class="vote-collection-card__vote" data-vote-content>
                  <div class="vote-collection-card__skeleton" aria-hidden="true">
                    <span></span>
                    <span></span>
                  </div>
                </div>
                <a class="vote-collection-card__view-button" href="{{ product.url }}">View Product</a>
              </div>
            </div>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="vote-collection-products__empty">
        Select a collection with products.
      </div>
    {% endif %}
  </div>
</block-vote-collection-products>

<script src="{{ 'block-vote-collection-products.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Vote collection products",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Vote New Collection"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Explore the collection and vote for the pieces you would love to see next."
    },
    {
      "type": "color_background",
      "id": "background",
      "label": "Block background",
      "default": "#FFFFFF"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width block",
      "default": true
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Grid content width",
      "options": [
        { "value": "fixed", "label": "Fixed centered" },
        { "value": "full", "label": "Full width" }
      ],
      "default": "fixed"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Fixed content width",
      "min": 960,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1280
    },
    {
      "type": "range",
      "id": "padding_block",
      "label": "Vertical padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 0,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Vote collection products",
      "category": "SBrillet App"
    }
  ]
}
{% endschema %}
