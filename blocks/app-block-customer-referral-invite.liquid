{{ 'app-block-customer-referral-invite.css' | asset_url | stylesheet_tag }}

{% liquid
  assign proxy_path = block.settings.proxy_path | default: '/apps/storefront/api/customer/referral-accept'
%}

<customer-referral-invite
  class="customer-referral-invite"
  data-proxy-path="{{ proxy_path | escape }}"
  data-title="{{ block.settings.title | escape }}"
  data-loading-label="{{ block.settings.loading_label | escape }}"
  data-success-label="{{ block.settings.success_label | escape }}"
  data-login-label="{{ block.settings.login_label | escape }}"
  data-error-label="{{ block.settings.error_label | escape }}"
  data-button-label="{{ block.settings.button_label | escape }}"
  data-button-url="{{ block.settings.button_url | escape }}"
  style="
    --invite-max-width: {{ block.settings.max_width }}{{ block.settings.max_width_unit }};
    --invite-min-height: {{ block.settings.min_height }}px;
    --invite-padding: {{ block.settings.padding }}px;
    --invite-radius: {{ block.settings.border_radius }}px;
    --invite-shadow: {% if block.settings.show_shadow %}0 14px 34px rgb(31 41 51 / {{ block.settings.shadow_opacity | divided_by: 100.0 }}){% else %}none{% endif %};
    --invite-bg: {{ block.settings.background_color }};
    --invite-border: {{ block.settings.border_color }};
    --invite-text: {{ block.settings.text_color }};
    --invite-title-color: {{ block.settings.title_color }};
    --invite-title-size: {{ block.settings.title_font_size }}px;
    --invite-title-weight: {{ block.settings.title_font_weight }};
    --invite-message-color: {{ block.settings.message_color }};
    --invite-message-size: {{ block.settings.message_font_size }}px;
    --invite-message-weight: {{ block.settings.message_font_weight }};
    --invite-content-gap: {{ block.settings.content_gap }}px;
    --invite-icon-size: {{ block.settings.icon_size }}px;
    --invite-icon-bg: {{ block.settings.icon_background_color }};
    --invite-icon-text: {{ block.settings.icon_text_color }};
    --invite-icon-border: {{ block.settings.icon_border_color }};
    --invite-error-bg: {{ block.settings.error_background_color }};
    --invite-error-text: {{ block.settings.error_text_color }};
    --invite-error-border: {{ block.settings.error_border_color }};
    --invite-button-height: {{ block.settings.button_height }}px;
    --invite-button-padding-x: {{ block.settings.button_padding_x }}px;
    --invite-button-radius: {{ block.settings.button_border_radius }}px;
    --invite-button-size: {{ block.settings.button_font_size }}px;
    --invite-button-weight: {{ block.settings.button_font_weight }};
    --invite-button-bg: {{ block.settings.button_background_color }};
    --invite-button-text: {{ block.settings.button_text_color }};
    --invite-button-border: {{ block.settings.button_border_color }};
    --invite-button-hover-bg: {{ block.settings.button_hover_background_color }};
    --invite-button-hover-text: {{ block.settings.button_hover_text_color }};
    --invite-button-hover-border: {{ block.settings.button_hover_border_color }};
    --invite-spinner-color: {{ block.settings.spinner_color }};
    --invite-spinner-track: {{ block.settings.spinner_track_color }};
    --invite-focus: {{ block.settings.focus_color }};
  "
  {{ block.shopify_attributes }}
>
  <div class="customer-referral-invite__panel" data-referral-invite-panel>
    <div class="customer-referral-invite__state">
      <span class="customer-referral-invite__spinner" aria-hidden="true"></span>
      <span>{{ block.settings.loading_label | escape }}</span>
    </div>
  </div>
</customer-referral-invite>

<script src="{{ 'app-block-customer-referral-invite.js' | asset_url }}" defer></script>

