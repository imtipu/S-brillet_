{% comment %} {%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign material_option_index = -1

  for product_option in product.options_with_values
    assign clean_option_name = product_option.name | downcase | strip
    if clean_option_name == 'material'
      assign material_option_index = forloop.index0
      break
    endif
  endfor

  assign selected_material = ''
  if material_option_index >= 0
    assign selected_material = current_variant.options[material_option_index]
  endif

  assign gemstone_name_meta = product.metafields.custom.product_grouping_option_1_value
  assign gemstone_cut_meta = product.metafields.custom.gemstone_cut
  assign band_meta = product.metafields.custom.band
  assign hand_finished_meta = product.metafields.custom.hand_finished
  assign brand_meta = product.metafields.custom.brand
  assign plating_thickness_meta = current_variant.metafields.custom.plating_thickness

  assign gemstone_name = gemstone_name_meta | metafield_text | strip
  assign gemstone_cut = gemstone_cut_meta | metafield_text | strip
  assign band = band_meta | metafield_text | strip
  assign hand_finished = hand_finished_meta | metafield_text | strip
  assign brand = brand_meta | metafield_text | strip
  assign plating_thickness = plating_thickness_meta | metafield_text | strip

  if brand == blank
    assign brand = product.vendor
  endif
-%}

<div class="product-materials-details" data-product-materials-details>
  <div class="product-materials-details__row">
    <span>• Metal:</span>
    <span data-dynamic-material>{{ selected_material | escape }}</span>
  </div>

  {%- if gemstone_name != blank -%}
    <div class="product-materials-details__row">
      <span>• Gemstones:</span>
      <span>{{ gemstone_name | escape }}</span>
    </div>
  {%- endif -%}

  <div class="product-materials-details__row">
    <span>• Plating Thickness:</span>
    <span data-dynamic-plating-thickness>{{ plating_thickness | escape }}</span>
  </div>

  {%- if gemstone_cut != blank -%}
    <div class="product-materials-details__row">
      <span>• Gemstone Cut:</span>
      <span>{{ gemstone_cut | escape }}</span>
    </div>
  {%- endif -%}

  {%- if brand != blank -%}
    <div class="product-materials-details__row">
      <span>• Brand:</span>
      <span>{{ brand | escape }}</span>
    </div>
  {%- endif -%}

  {%- if band != blank -%}
    <div class="product-materials-details__row">
      <span>• Band:</span>
      <span>{{ band | escape }}</span>
    </div>
  {%- endif -%}

  {%- if hand_finished != blank -%}
    <div class="product-materials-details__row">
      <span>• Hand-Finished:</span>
      <span>{{ hand_finished | escape | newline_to_br }}</span>
    </div>
  {%- endif -%}
</div>

<style>
  .product-materials-details__row {
    display: block;
    margin: 0 0 4px;
  }

  .product-materials-details__row:last-child {
    margin-bottom: 0;
  }
</style> {% endcomment %}





