.yk-msg-switcher {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 4px;
}

.yk-msg-switcher-label {
  font-size: 15px;
  color: #2c2c2c;
}

.yk-msg-switcher-buttons {
  display: flex;
  gap: 6px;
}

.yk-msg-btn {
  position: relative;
  width: 38px;
  height: 38px;
  border: none;
  background: transparent;
  padding: 0;
  margin: 0;
  cursor: pointer;
  filter: drop-shadow(0px 0px 2px rgba(0, 0, 0, 0.10));
}

.yk-msg-btn-ring {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  padding: 1.5px;
  background-color: transparent;
  transition: background-color 0.2s ease;
  clip-path: polygon(18% 0%, 82% 0%, 100% 18%, 100% 82%, 82% 100%, 18% 100%, 0% 82%, 0% 18%);
  -webkit-clip-path: polygon(18% 0%, 82% 0%, 100% 18%, 100% 82%, 82% 100%, 18% 100%, 0% 82%, 0% 18%);
}

.yk-msg-btn:hover .yk-msg-btn-ring,
.yk-msg-btn.is-active .yk-msg-btn-ring {
