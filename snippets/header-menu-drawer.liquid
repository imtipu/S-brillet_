{% style %}
  /* Custom Mega Menu - Mobile/Tablet drawer only. Scoped, does not affect desktop. */
  .m-megamenu-mobile__custom-mega {
    padding: 8px 0;
  }

  .m-megamenu-mobile__custom-mega-col + .m-megamenu-mobile__custom-mega-col {
    margin-top: 24px;
  }

  .m-megamenu-mobile__custom-mega-heading {
    font-size: 16px;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin: 0 0 12px;
    padding: 0 10px;
    color: #2c2c2c;
  }

  .m-megamenu-mobile__custom-mega-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* .m-megamenu-mobile__custom-mega-item + .m-megamenu-mobile__custom-mega-item {
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  } */

  .m-megamenu-mobile__custom-mega-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding:  10px;
    text-decoration: none;
    color: inherit;
  }

  .m-megamenu-mobile__custom-mega-link:not(.m-megamenu-mobile__custom-mega-link--has-icon) {
    padding-left: 20px;
  }

  .m-megamenu-mobile__custom-mega-icon {
    flex: 0 0 auto;
    display: block;
    width: 30px;
    height: 30px;
    
    overflow: hidden;
   
  }

  .m-megamenu-mobile__custom-mega-icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .m-megamenu-mobile__custom-mega-title {
    font-size: 14px;
    font-weight: 400;
    line-height: 1.3;
  }

  .m-megamenu-mobile__custom-mega-banner {
    position: relative;
    margin: 24px 20px 8px;
    border-radius: var(--blocks-radius-md, 8px);
    overflow: hidden;
  }

  .m-megamenu-mobile__custom-mega-banner-image img {
    display: block;
    width: 100%;
    height: auto;
  }

  .m-megamenu-mobile__custom-mega-banner-content {
    padding: 14px 4px 4px;
  }

  .m-megamenu-mobile__custom-mega-banner-content h4 {
    margin: 0 0 8px;
    font-size: 15px;
  }
{% endstyle %}

