{%- if column_wrapper -%}<div class="m:column">{%- endif -%}
<div
  class="{{ product_card_classes }}{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}"
  data-view="card"
  {% if sold_number != blank %}data-sold-number="{{ sold_number }}"{% endif %}
  data-product-id="{{ product.id }}"
  {% if animated %}
    data-cascade
    style="--animation-order: {{ index }};"
  {% endif %}
>

  {%- comment -%}============ IMAGE BLOCK ============{%- endcomment -%}
  <div class="m-product-card__media">

    <div class="m-pcard-img-clip">

      <a class="m-product-card__link m:block m:w-full"
        href="{{ product_url }}"
        aria-label="{{ product.title | default: 'product title' }}"
      >
        {% if preview_image != blank or first_media_type == 'video' %}
          {% unless show_video %}

            {%- comment -%} IMG 1 - Default Main Image {%- endcomment -%}
            <div class="m-product-card__main-image" data-pcard-main-img>
              {%- liquid
                assign asp_rat = image_ratio | default: preview_image.aspect_ratio
                if asp_rat == 'original'
                  assign asp_rat = preview_image.aspect_ratio
                endif
                assign alt = alt | default: preview_image.alt | escape
              -%}
              {%- capture sizes -%}(min-width: {{ settings.container_width }}px) {{ settings.container_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2){%- endcapture -%}
              <responsive-image class="m-image" style="--aspect-ratio: {{ asp_rat }}">
                {{
                  preview_image
                  | image_url: width: 1100
                  | image_tag:
                    loading: loading,
                    fetchpriority: fetchpriority,
                    class: 'm:w-full m:h-full',
                    alt: alt,
                    sizes: sizes,
                    widths: '165, 360, 535, 750, 940, 1100'
                }}
              </responsive-image>
            </div>

            {%- comment -%} IMG 2 - Active Variant Image (Card Hover) {%- endcomment -%}
            <div class="m-product-card__hover-image" aria-hidden="true">
              {%- liquid
                assign asp_rat_h = image_ratio | default: preview_image.aspect_ratio
                if asp_rat_h == 'original'
                  assign asp_rat_h = preview_image.aspect_ratio
                endif
              -%}
              <responsive-image class="m-image" style="--aspect-ratio: {{ asp_rat_h }}">
                <img
                  src="{{ preview_image | image_url: width: 1100 }}"
                  alt="{{ alt }}"
                  width="1100"
                  height="auto"
                  loading="lazy"
                  class="m:w-full m:h-full"
                  data-pcard-hover-img-el
                >
              </responsive-image>
            </div>

            {%- comment -%} IMG 3 - Variant Hover Image (Image Area Hover) {%- endcomment -%}
            {%- if has_sec_img_class -%}
              <div class="m-product-card__second-image" aria-hidden="true">
                {%- liquid
                  assign sec_img_to_render = second_image | default: preview_image
                  assign asp_rat2 = image_ratio | default: sec_img_to_render.aspect_ratio
                  if asp_rat2 == 'original'
                    assign asp_rat2 = sec_img_to_render.aspect_ratio
                  endif
                  assign alt2 = sec_img_to_render.alt | escape
                -%}
                <responsive-image class="m-image" style="--aspect-ratio: {{ asp_rat2 }}">
                  <img
                    src="{{ sec_img_to_render | image_url: width: 1100 }}"
                    alt="{{ alt2 }}"
                    width="1100"
                    height="auto"
                    loading="lazy"
                    class="m:w-full m:h-full"
                    data-pcard-second-img-el
                  >
                </responsive-image>
              </div>
            {%- endif -%}

          {% else %}
            <m-video-component
              class="m:block m-product-card__video"
              data-type="mp4"
              style="--aspect-ratio: {{ image_ratio }}"
            >
              {{
                product.media.first
                | media_tag:
                  image_size: '1500px',
                  autoplay: true,
                  loop: true,
                  controls: false,
                  muted: true,
                  playsinline: true
              }}
            </m-video-component>
          {% endunless %}

        {% else %}
          {% if pcard_default_image != blank %}
            {%- liquid
              assign asp_rat = image_ratio | default: pcard_default_image.aspect_ratio
              if asp_rat == 'original'
                assign asp_rat = pcard_default_image.aspect_ratio
              endif
              assign alt = pcard_default_image.alt | escape
            -%}
            {%- capture sizes -%}(min-width: {{ settings.container_width }}px) {{ settings.container_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2){%- endcapture -%}
            <responsive-image class="m-image" style="--aspect-ratio: {{ asp_rat }}">
              {{
                pcard_default_image
                | image_url: width: 1100
                | image_tag:
                  loading: loading,
                  fetchpriority: fetchpriority,
                  class: 'm:w-full m:h-full',
                  alt: alt,
                  sizes: sizes,
                  widths: '165, 360, 535, 750, 940, 1100'
              }}
            </responsive-image>
          {% else %}
            <div style="--aspect-ratio: {{ image_ratio }}">
              {{ 'product-1' | placeholder_svg_tag: 'm-placeholder-svg' }}
            </div>
          {% endif %}
        {% endif %}
      </a>

      <svg
        class="m-pcard-polygon-border"
        viewBox="0 0 100 100"
        preserveAspectRatio="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <defs>
          <linearGradient id="pcard-border-grad-{{ product.id }}" x1="0%" y1="50%" x2="100%" y2="50%">
            <stop offset="0%"   stop-color="#E6D7CB"/>
            <stop offset="50%"  stop-color="#FFFFFF"/>
            <stop offset="100%" stop-color="#E6D7CB"/>
          </linearGradient>
        </defs>
        <polygon
          points="18,0 82,0 100,18 100,82 82,100 18,100 0,82 0,18"
          fill="none"
          stroke="url(#pcard-border-grad-{{ product.id }})"
          stroke-width="2.5"
          vector-effect="non-scaling-stroke"
        />
      </svg>

    </div>
    {%- comment -%} end .m-pcard-img-clip {%- endcomment -%}

    {%- comment -%} Badges (top-left) {%- endcomment -%}
    <div class="m-product-card__tags">
      {% if settings.show_badge_sale %}
        {% for tag in product.tags %}
          {% if tag contains 'tag__' %}
            {%- liquid
              assign tag_content = tag | split: '__' | last
              assign type = tag_content | split: '_' | first
              assign tag_name = tag_content | split: '_' | last
              assign color_scheme_class = 'm-gradient m-color-'
              case type
                when 'sale':
                  assign color_scheme_class = color_scheme_class | append: settings.sale_badge_color_scheme
                when 'new':
                  assign color_scheme_class = color_scheme_class | append: settings.new_badge_color_scheme
                when 'hot':
                  assign color_scheme_class = color_scheme_class | append: settings.hot_badge_color_scheme
              endcase
            -%}
            <span class="m-product-card__tag-name m-product-tag m-product-tag--{{ type }} {{ color_scheme_class }}">
              {{- tag_name -}}
            </span>
          {% endif %}
        {% endfor %}
      {% endif %}

      {% assign custom_badge_class = 'm-product-card__tag-name m-product-tag m-product-tag--preorder m-gradient m-color-' | append: settings.preorder_badge_color_scheme %}
      {% capture foxkit_preorder_badge %}{% render 'foxkit-preorder-badge', product: product, static: true, custom_class: custom_badge_class %}{% endcapture %}
      {% unless foxkit_preorder_badge contains 'Liquid error' %}
        {{ foxkit_preorder_badge }}
      {% endunless %}

      {% if show_on_sale_badge %}
        <span class="m-product-card__tag-name m-product-tag m-product-tag--sale m-gradient m-color-{{ settings.sale_badge_color_scheme }}">
          {%- if settings.on_sale_badge == 'show_text' -%}
            {{ 'products.product.on_sale' | t }}
          {%- elsif settings.on_sale_badge == 'show_percentage' -%}
            {{ discount | append: '%' | prepend: '-' }}
          {%- endif -%}
        </span>
      {% endif %}
    </div>

    {%- comment -%} Sold-out badge {%- endcomment -%}
    {%- if settings.show_badge_soldout -%}
      <span
        class="m-product-tag m-product-tag--soldout m-gradient m-color-{{ settings.soldout_badge_color_scheme }}"
        {% unless sold_out %}style="display: none;"{% endunless %}
      >
        {{- 'products.product.sold_out' | t -}}
      </span>
    {%- endif -%}

    {%- comment -%} Wishlist heart (top-right) {%- endcomment -%}
    <div class="m-pcard-wishlist-wrap">
      {%- if show_wishlist_button -%}
        {% assign wishlist_app = settings.wishlist_app %}
        {% if wishlist_app == 'growave' %}
          <div class="m-tooltip m-wishlist-button m-button--icon m-tooltip--style-1">
            <span class="m-tooltip-icon m:block">
              {% comment %} theme-check-disable {% endcomment %}
              {% capture the_snippet_fave_icon %}{% render 'ssw-widget-faveicon' with product.id %}{% endcapture %}
              {% unless the_snippet_fave_icon contains 'Liquid error' %}
                {{ the_snippet_fave_icon }}
              {% else %}
                {% render 'mm-ssw-widget-faveicon' with product.id %}
              {% endunless %}
              {% comment %} theme-check-enable {% endcomment %}
            </span>
          </div>
        {% else %}
          <div class="m-pcard-wish-wrapper">
            {% render 'tooltip', type: 'wishlist', product: product, class_name: 'm-tooltip--left', style: 2 %}
            <span class="pcard-wish-icon-default" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#FFFF" stroke="#222222" stroke-width="0.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
              </svg>
            </span>
            <span class="pcard-wish-icon-filled" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#222222" stroke="#222222" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
              </svg>
            </span>
          </div>
        {% endif %}
      {%- else -%}
        <button type="button" aria-label="{{ 'products.product.add_to_wishlist' | t }}" class="m-pcard-wish-wrapper">
          <span class="pcard-wish-icon-default" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#222222" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </span>
          <span class="pcard-wish-icon-filled" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#222222" stroke="#222222" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </span>
        </button>
      {%- endif -%}
    </div>

    {%- comment -%} Countdown timer {%- endcomment -%}
    {% liquid
      assign metafields_time = product.metafields.global.minimog_countdown
      if settings.show_countdown and metafields_time != blank
        render 'countdown-timer', time: metafields_time, separator: false, short_label: true, extra_classes: 'm-product-card__countdown m:hidden'
      endif
    %}

  </div>
  {%- comment -%} end .m-product-card__media {%- endcomment -%}

  {%- comment -%}============ CONTENT BLOCK ============{%- endcomment -%}
  <div class="m-product-card__content m:text-{{ pcard_alignment }}">
    <div class="m-product-card__info">

      {%- comment -%} Gemstone picker {%- endcomment -%}
      {%- if gemstone_metafield != blank -%}
        <div class="m-pcard-gemstone-row">
          {%- for gemstone in gemstone_metafield.value -%}
            {%- liquid
              assign g_src = ''
              assign g_alt = ''
              if gemstone.preview_image != blank
                assign g_src = gemstone.preview_image | image_url: width: 60
                assign g_alt = gemstone.alt | escape
              elsif gemstone.image != blank
                assign g_src = gemstone.image | image_url: width: 60
                assign g_alt = gemstone.image.alt | escape
              elsif gemstone.src != blank
                assign g_src = gemstone | image_url: width: 60
                assign g_alt = gemstone.alt | escape
              endif
            -%}
            {%- if g_src != blank -%}
              <div class="m-pcard-gemstone-item" title="{{ g_alt }}">
                <img src="{{ g_src }}" alt="{{ g_alt }}" width="28" height="28" loading="lazy">
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%} Material title {%- endcomment -%}
      {%- if material_title != blank -%}
        <p class="m-pcard-material-title">{{ material_title.value }}</p>
      {%- endif -%}

      {%- comment -%} Vendor {%- endcomment -%}
      {%- if show_vendor -%}
        <span class="m-product-card__vendor">{{ product.vendor }}</span>
      {%- endif -%}

      {%- comment -%} Product title {%- endcomment -%}
      {% if show_title == true %}
        <h3 class="m-product-card__title">
          <a href="{{ product_url }}"
            class="m-product-card__name{% if settings.uppercase_prd_name %} m:uppercase{% endif %}"
          >
            {{ product.title }}
          </a>
        </h3>
      {% endif %}

      {%- comment -%} Reviews {%- endcomment -%}
      {% if settings.show_review_badge %}
        <div class="m-product-card__reviews m:text-color-body">
          {% render 'product-reviews-app__badge', product: product %}
        </div>
      {% endif %}


      {%- comment -%} Variant swatches {%- endcomment -%}
      {%- liquid
        assign v1_url = ''
        assign v2_url = ''
        assign v3_url = ''

        if variant_img_1 != blank
          if variant_img_1.value != blank
            assign v1_url = variant_img_1.value | image_url: width: 1100
          else
            assign v1_url = variant_img_1 | image_url: width: 1100
          endif
        endif

        if variant_img_2 != blank
          if variant_img_2.value != blank
            assign v2_url = variant_img_2.value | image_url: width: 1100
          else
            assign v2_url = variant_img_2 | image_url: width: 1100
          endif
        endif

        if variant_img_3 != blank
          if variant_img_3.value != blank
            assign v3_url = variant_img_3.value | image_url: width: 1100
          else
            assign v3_url = variant_img_3 | image_url: width: 1100
          endif
        endif

        assign vh1_url = ''
        assign vh2_url = ''
        assign vh3_url = ''

        if variant_hover_img_1 != blank
          if variant_hover_img_1.value != blank
            assign vh1_url = variant_hover_img_1.value | image_url: width: 1100
          else
            assign vh1_url = variant_hover_img_1 | image_url: width: 1100
          endif
        endif

        if variant_hover_img_2 != blank
          if variant_hover_img_2.value != blank
            assign vh2_url = variant_hover_img_2.value | image_url: width: 1100
          else
            assign vh2_url = variant_hover_img_2 | image_url: width: 1100
          endif
        endif

        if variant_hover_img_3 != blank
          if variant_hover_img_3.value != blank
            assign vh3_url = variant_hover_img_3.value | image_url: width: 1100
          else
            assign vh3_url = variant_hover_img_3 | image_url: width: 1100
          endif
        endif
      -%}

      {%- capture swatch_meta_map -%}["{{ v1_url }}","{{ v2_url }}","{{ v3_url }}"]{% endcapture %}
      {%- capture swatch_hover_meta_map -%}["{{ vh1_url }}","{{ vh2_url }}","{{ vh3_url }}"]{% endcapture %}

      {% if product.has_only_default_variant == false and show_variant_options %}
        <div
          class="m-product-card__option-wrapper"
          data-pcard-swatches
          data-meta-imgs='{{ swatch_meta_map }}'
          data-meta-hover-imgs='{{ swatch_hover_meta_map }}'
        >
          {%- liquid
            assign seen_options = ''
            assign swatch_index = 0
          -%}
          {%- for variant in product.variants -%}
            {%- liquid
              assign opt1 = variant.option1
              assign already_seen = false
              if seen_options contains opt1
                assign already_seen = true
              endif
            -%}
            {%- unless already_seen -%}
              {%- liquid
                assign seen_options = seen_options | append: opt1 | append: '|||'
                assign sv_src = ''
                if variant.featured_image != blank
                  assign sv_src = variant.featured_image | image_url: width: 120
                elsif variant.image != blank
                  assign sv_src = variant.image | image_url: width: 120
                endif
              -%}
              {%- if sv_src != blank -%}
                {%- comment -%} ── CHANGE: added data-price, data-compare-price, data-currency on each swatch ── {%- endcomment -%}
                <div
                  class="m-pcard-swatch-wrap{% if swatch_index == 0 %} is-selected{% endif %}"
                  data-swatch-index="{{ swatch_index }}"
                  data-price="{{ variant.price }}"
                  data-compare-price="{{ variant.compare_at_price }}"
                  data-currency="{{ cart.currency.iso_code }}"
                  title="{{ opt1 | escape }}"
                  role="button"
                  tabindex="0"
                  aria-label="{{ opt1 | escape }}"
                >
                  <div class="m-pcard-swatch-gap"></div>
                  <div class="m-pcard-swatch-img-wrap">
                    <img
                      src="{{ sv_src }}"
                      alt="{{ opt1 | escape }}"
                      width="32"
                      height="32"
                      loading="lazy"
                      class="m-pcard-swatch-img"
                    >
                  </div>
                </div>
                {%- assign swatch_index = swatch_index | plus: 1 -%}
              {%- endif -%}
            {%- endunless -%}
            {%- if swatch_index >= 3 -%}{%- break -%}{%- endif -%}
          {%- endfor -%}
        </div>
      {%- elsif product.has_only_default_variant == false and show_variant_options -%}
        {% render 'product-card-option',
          product: product,
          show_variant_options: show_variant_options,
          pcard_alignment: pcard_alignment,
          context: context
        %}
      {% endif %}

      {%- comment -%} Price {%- endcomment -%}
      <div class="m-product-card__price" data-pcard-price>
        {% render 'product-prices', product: product, is_product_card: true %}
        {%- if on_sale and discount != blank -%}
          <span class="m-pcard-discount-badge" data-pcard-discount-badge>SAVE {{ discount }}%</span>
        {%- endif -%}
      </div>

      {%- comment -%} Inventory {%- endcomment -%}
      {%- if show_inventory and selected_variant.inventory_management != blank -%}
        {%- liquid
          assign inventory_threshold = settings.low_inventory_threshold
          assign show_inventory_count = settings.show_inventory_count
          assign inventory_visibility = settings.inventory_visibility
          assign inventory_hide_backordered = settings.inventory_hide_backordered

          assign total = 0
          assign inventory_policy = ''
          for variant in product.variants
            if variant.inventory_quantity > 0
              assign total = total | plus: variant.inventory_quantity
            endif
            if variant.inventory_policy == 'continue'
              assign inventory_policy = 'continue'
            endif
          endfor

          if total <= 0
            if inventory_policy == 'continue'
              assign status = 'backordered'
            elsif product.available
              assign status = 'instock'
            else
              assign status = 'outofstock'
            endif
          elsif total <= inventory_threshold
            assign status = 'low'
          else
            assign status = 'normal'
          endif

          assign show = false
          if inventory_visibility == 'always'
            assign show = true
            if status == 'backordered' and inventory_hide_backordered
              assign show = false
            endif
          else
            if status == 'low'
              assign show = true
            endif
          endif

          if status == 'outofstock'
            assign show = false
          endif

          assign show_inventory_number = true
          if show_inventory_count == 'never' or total <= 0 or show_inventory_count == 'low_inventory' and status != 'low'
            assign show_inventory_number = false
          endif
        -%}
        {%- if show == true -%}
          <div class="m-product-inventory m-product-card__inventory m:text-sm" data-status="{{ status }}">
            <div class="m-product-inventory__inner">
              <span class="m-product-inventory__text">
                <span class="m-product-inventory__pin"></span>
                <span class="m-product-inventory__status">
                  {% liquid
                    case status
                      when 'backordered'
                        render 'new-locale', key: 'products.product.backordered'
                      when 'low'
                        if show_inventory_number
                          render 'new-locale', key: 'products.product.inventory_low_quantity_html', param: '{{ quantity }}', value: total
                        else
                          render 'new-locale', key: 'products.product.low_stock'
                        endif
                      else
                        if show_inventory_number
                          render 'new-locale', key: 'products.product.inventory_quantity_html', param: '{{ quantity }}', value: total
                        else
                          echo 'products.product.in_stock' | t
                        endif
                    endcase
                  %}
                </span>
              </span>
            </div>
          </div>
        {%- endif -%}
      {%- endif -%}

    </div>
    {%- comment -%} end .m-product-card__info {%- endcomment -%}

    {%- comment -%} Hover footer {%- endcomment -%}
    <div class="m-pcard-hover-footer">
      <div class="m-pcard-hover-footer__divider"></div>
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a href="{{ section.settings.button_link }}" class="m-pcard-hover-footer__btn">
          {{ section.settings.button_label }}
        </a>
      {%- elsif sold_out == false -%}
        {% render 'product-card-quick-add-btn',
          product: product,
          quick_add_text: quick_add_text,
          section: section,
          button_style: 'dark'
        %}
      {%- else -%}
        <span class="m-pcard-hover-footer__btn" style="opacity:0.45;cursor:default;">
          {{ 'products.product.sold_out' | t }}
        </span>
      {%- endif -%}
    </div>

  </div>
  {%- comment -%} end .m-product-card__content {%- endcomment -%}

  <input hidden name="id" required value="{{ variant_id }}" data-selected-variant="{{ selected_variant_id }}">

  <script>
  (function () {
    var card = document.currentScript.closest('[data-product-id]');
    if (!card) return;

    var swatchWrap  = card.querySelector('[data-pcard-swatches]');
    var hoverImgEl  = card.querySelector('[data-pcard-hover-img-el]');
    var secondImgEl = card.querySelector('[data-pcard-second-img-el]');
    var mainImgWrap = card.querySelector('[data-pcard-main-img]');
    if (!mainImgWrap) return;

    var mainImg = mainImgWrap.querySelector('img');
    if (!mainImg) return;

    var originalMainSrc   = mainImg.src;
    var originalHoverSrc  = hoverImgEl  ? hoverImgEl.src  : originalMainSrc;
    var originalSecondSrc = secondImgEl ? secondImgEl.src : originalHoverSrc;

    var metaUrls      = [];
    var hoverMetaUrls = [];
    if (swatchWrap) {
      try {
        metaUrls      = JSON.parse(swatchWrap.getAttribute('data-meta-imgs')       || '[]');
        hoverMetaUrls = JSON.parse(swatchWrap.getAttribute('data-meta-hover-imgs') || '[]');
      } catch (e) {}
    }

    /* ── CHANGE: price helper ───────────────────────────────────────────── */
    var priceEl = card.querySelector('[data-pcard-price]');

    function formatMoney(cents, currency) {
      if (!cents && cents !== 0) return '';
      var amount = (parseInt(cents, 10) / 100).toFixed(2);
      /* Use Shopify's global formatter if available, otherwise plain symbol */
      if (window.Shopify && window.Shopify.formatMoney) {
        return window.Shopify.formatMoney(cents, window.theme && window.theme.moneyFormat ? window.theme.moneyFormat : '{{amount}}');
      }
      /* Minimal fallback: prepend currency symbol or code */
      var symbols = { USD: '$', EUR: '€', GBP: '£', CAD: 'CA$', AUD: 'A$' };
      var sym = symbols[currency] || (currency + ' ');
      return sym + amount;
    }

    function updatePrice(sw) {
      if (!priceEl) return;
      var price        = sw.getAttribute('data-price');
      var comparePrice = sw.getAttribute('data-compare-price');
      var currency     = sw.getAttribute('data-currency') || '';

      if (!price) return; /* no data → leave existing markup untouched */

      var priceFormatted        = formatMoney(price, currency);
      var comparePriceFormatted = comparePrice && parseInt(comparePrice, 10) > parseInt(price, 10)
                                  ? formatMoney(comparePrice, currency)
                                  : '';

      /* ── CHANGE: keep discount badge in sync with the active swatch ── */
      var discountBadgeHTML = '';
      if (comparePriceFormatted) {
        var discountPct = Math.round(
          (parseInt(comparePrice, 10) - parseInt(price, 10)) / parseInt(comparePrice, 10) * 100
        );
        discountBadgeHTML = '<span class="m-pcard-discount-badge" data-pcard-discount-badge>SAVE ' + discountPct + '%</span>';
      }

      if (comparePriceFormatted) {
        priceEl.innerHTML =
          '<span class="m-price">' + priceFormatted + '</span>' +
          '<span class="m-price m-price-item--regular">' + comparePriceFormatted + '</span>' +
          discountBadgeHTML;
      } else {
        priceEl.innerHTML = '<span class="m-price">' + priceFormatted + '</span>';
      }
    }
    /* ── end price helper ───────────────────────────────────────────────── */

    if (swatchWrap) {
      var swatches = swatchWrap.querySelectorAll('.m-pcard-swatch-wrap');

      function activate(sw) {
        swatches.forEach(function (s) { s.classList.remove('is-selected'); });
        sw.classList.add('is-selected');

        var idx          = parseInt(sw.getAttribute('data-swatch-index'), 10);
        var metaUrl      = (metaUrls      && metaUrls[idx])      ? metaUrls[idx]      : '';
        var hoverMetaUrl = (hoverMetaUrls && hoverMetaUrls[idx]) ? hoverMetaUrls[idx] : '';
        var swatchImg    = sw.querySelector('.m-pcard-swatch-img');

        /* Layer 2: card hover image */
        if (hoverImgEl) {
          hoverImgEl.src    = metaUrl || (swatchImg ? swatchImg.src : originalHoverSrc);
          hoverImgEl.srcset = '';
        }

        /* Layer 3: image-area hover image */
        if (secondImgEl) {
          secondImgEl.src    = hoverMetaUrl || originalSecondSrc;
          secondImgEl.srcset = '';
        }

        /* ── CHANGE: sync price to active swatch ── */
        updatePrice(sw);
      }

      swatches.forEach(function (sw) {
        sw.addEventListener('click', function (e) {
          e.preventDefault();
          activate(sw);
        });
        sw.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            activate(sw);
          }
        });
      });

      var firstSwatch = swatches[0];
      if (firstSwatch) activate(firstSwatch);
    }
  })();
  </script>

</div>
{%- if column_wrapper -%}</div>{%- endif -%}
