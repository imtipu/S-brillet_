
{%- liquid
  assign menu_id = menu | default: 'main_menu'
  assign show_menu_column_divider = section.settings.show_menu_column_divider
-%}
{% comment %}theme-check-enable UnusedAssign{% endcomment %}

<style>
  :root {
    --mega-max-width: 1720px;
    --mega-padding: 10px 20px;
    --mega-bg: #ffffff;
    --mega-border: #f0f0f0;
    --mega-text: #111111;
    --mega-text-muted: #555555;
    --mega-heading-size: 11px;
    --mega-link-size: 14px;
    --mega-transition: 0.22s ease;
    --mega-shadow: 0 8px 40px rgba(0,0,0,0.08);
    --mega-arrow-color: #aaaaaa;
    --mega-arrow-hover: #111111;
  }

  .m-header__menu .m-menu {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 0;
  }

  .m-menu__item { position: static; }

  .m-menu__link--main {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 16px;
    font-weight: 400;
    {% comment %} letter-spacing: 0.04em; {% endcomment %}
    text-transform: uppercase;
    color: var(--mega-text);
    text-decoration: none;
    padding: 18px 14px;
    white-space: nowrap;
    transition: color var(--mega-transition);
  }
  .m-menu__link--main:hover { color: var(--mega-arrow-hover); }

  .m-menu__arrow,
  .m-menu__sub-arrow {
    {% comment %} display: inline-flex; {% endcomment %}
     display:none;
    align-items: center;
    color: var(--mega-arrow-color);
    transition: transform var(--mega-transition), color var(--mega-transition);
  }
  .m-menu__item--parent:hover > a .m-menu__arrow {
    transform: rotate(180deg);
    color: var(--mega-text);
  }

  /* Mega panel */
  .m-mega-menu {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    z-index: 999;
    background: var(--mega-bg);
    border-top: 1px solid var(--mega-border);
    box-shadow: var(--mega-shadow);
    visibility: hidden;
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity var(--mega-transition), transform var(--mega-transition), visibility var(--mega-transition);
    pointer-events: none;
  }
  .m-menu__item--parent:hover > .m-mega-menu,
  .m-menu__item--parent:focus-within > .m-mega-menu {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  /* Container */
  .m-mega-menu__container--custom {
    max-width: var(--mega-max-width);
    margin: 0 auto;
    padding: var(--mega-padding);
    width: 100%;
  }

  /* Inner flex row */
  .m-mega-menu__inner--custom {
    display: flex;
    align-items: flex-start;
    gap: 0;
  }

  /* Column */
  .m-mega-col {
    flex: 1 1 0;
    padding: 22px 20px;
    min-width: 0;
  }
  .m-show-menu-column-divider .m-mega-col + .m-mega-col {
    border-left: 1px solid var(--mega-border);
  }

  /* Column heading */
  .m-mega-col__heading {
    display: flex;
    align-items: center;
    {% comment %} justify-content: space-between; {% endcomment %}
    font-size: 16px;
    font-weight: 600;
    font-family: 'Inter', sans-serif;
    color: #2C2C2C;
    text-transform: uppercase;
    margin: 0 0 14px;
    white-space: nowrap;
  }

  /* Slider arrows */
  .m-mega-col__arrows {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-left: 8px;
  }
  .m-mega-col__arrows button {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--mega-arrow-color);
    padding: 2px;
    line-height: 1;
    transition: color var(--mega-transition);
    font-size: 13px;
  }
  .m-mega-col__arrows button:hover { color: var(--mega-text); }
  .m-mega-col__arrows button:disabled { opacity: 0.3; cursor: default; }

  /* Links */
  .m-mega-col__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .m-mega-col__item a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 16px;
    font-weight: 400;
    font-family: 'Inter', sans-serif;
    color: #2C2C2C;
    text-decoration: none;
    transition: color var(--mega-transition);
    line-height: 1.3;
  }

  .m-mega-col__item a:hover { color: var(--mega-text); }

  /* Link icon — now image-based */
  .m-mega-col__icon {
    width: 22px;
    height: 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    line-height: 1;
  }
  .m-mega-col__icon img {
    width: 22px;
    height: 22px;
    object-fit: contain;
    display: block;
  }

  /* Hidden items (pagination) */
  .m-mega-col__item--hidden {
    display: none !important;
  }

  /* Banner column */
  .m-mega-col--banner {
    flex: 0 0 260px;
    padding: 16px 16px 16px 20px;
  }
  .m-mega-banner-img {
    width: 100%;
    border-radius: 8px;
    overflow: hidden;
    background: #f5f5f5;
    aspect-ratio: 4/5;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .m-mega-banner-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .m-mega-banner-placeholder {
    width: 100%;
    aspect-ratio: 4/5;
    border-radius: 8px;
    background-image: repeating-conic-gradient(#e8e8e8 0% 25%, #f5f5f5 0% 50%);
    background-size: 20px 20px;
  }
</style>

<div class="m-header__menu{% if custom_classes != blank %} {{ custom_classes }}{% endif %}">
  <ul class="m-menu">
    {% for link in linklists[section.settings[menu_id]].links %}
      {% liquid
        assign li_class = 'm-menu__item'
        assign is_mega = true
        assign title_handle = link.title | handleize
        assign has_mega_item = false
        assign block_type = ''
        assign dropdown_container = section.settings.container
      %}

      {% for block in section.blocks %}
        {% liquid
          assign menu_title = block.settings.heading | handleize
          if menu_title == blank or menu_title != title_handle
            continue
          endif
          assign has_mega_item = true
          if block.settings.container == 'inherit'
            assign dropdown_container = section.settings.container
          else
            assign dropdown_container = block.settings.container
          endif
        %}

        {% case block.type %}

          {% when 'custom_mega' %}
            {%- capture block_type -%}
              <div class="m-mega-menu__inner--custom{% if show_menu_column_divider %} m-show-menu-column-divider{% endif %}">
                {%- assign col_ids = '1,2,3,4,5,6' | split: ',' -%}
                {%- for col_id in col_ids -%}
                  {%- assign col_title_key  = 'col_' | append: col_id | append: '_title' -%}
                  {%- assign col_links_key  = 'col_' | append: col_id | append: '_links' -%}
                  {%- assign col_arrows_key = 'col_' | append: col_id | append: '_show_arrows' -%}
                  {%- assign col_title      = block.settings[col_title_key] -%}
                  {%- assign col_linklist   = block.settings[col_links_key] -%}
                  {%- assign col_arrows     = block.settings[col_arrows_key] -%}
                  {%- if col_title == blank and col_linklist == blank -%}{%- continue -%}{%- endif -%}

                  {%- assign col_uid = block.id | append: '-col' | append: col_id -%}

                  <div class="m-mega-col" {{ block.shopify_attributes }}>
                    <div class="m-mega-col__heading">
                      <span>{{ col_title }}</span>
                      {%- if col_arrows -%}
                        <span class="m-mega-col__arrows" data-col-arrows="{{ col_uid }}">
                          <button
                            aria-label="Previous"
                            data-col-prev="{{ col_uid }}"
                            disabled
                          >
<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="16" height="16" viewBox="0 0 17 20" fill="none">
<rect width="17" height="20" transform="matrix(-1 0 0 1 17 0)" fill="url(#pattern0_6487_16101)" fill-opacity="0.5"/>
<defs>
<pattern id="pattern0_6487_16101" patternContentUnits="objectBoundingBox" width="1" height="1">
<use xlink:href="#image0_6487_16101" transform="matrix(0.00452489 0 0 0.00384615 0 -0.00384615)"/>
</pattern>
<image id="image0_6487_16101" width="221" height="262" preserveAspectRatio="none" xlink:href="data:image/png;base64,"/>
</defs>
</svg>                          </button>
                          <button
                            aria-label="Next"
                            data-col-next="{{ col_uid }}"
                          >
<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="16" height="16" viewBox="0 0 17 20" fill="none">
<rect width="17" height="20" fill="url(#pattern0_6487_16104)" fill-opacity="0.5"/>
<defs>
<pattern id="pattern0_6487_16104" patternContentUnits="objectBoundingBox" width="1" height="1">
<use xlink:href="#image0_6487_16104" transform="matrix(0.00452489 0 0 0.00384615 0 -0.00384615)"/>
</pattern>
<image id="image0_6487_16104" width="221" height="262" preserveAspectRatio="none" xlink:href="data:image/png;base64,"/>
</defs>
</svg>                          </button>
                        </span>
                      {%- endif -%}
                    </div>

                    {%- if col_linklist != blank -%}
                      {%- assign col_links_obj = linklists[col_linklist].links -%}
                      <ul class="m-mega-col__list" data-col-list="{{ col_uid }}">
                        {%- assign icon_base = 'col_' | append: col_id | append: '_icon_' -%}
                        {%- for sublink in col_links_obj -%}
                          {%- assign icon_key = icon_base | append: forloop.index -%}
                          {%- assign icon_img = block.settings[icon_key] -%}
                          {%- assign item_index0 = forloop.index0 -%}
                          {%- if item_index0 >= 7 -%}
                            {%- assign hidden_class = ' m-mega-col__item--hidden' -%}
                          {%- else -%}
                            {%- assign hidden_class = '' -%}
                          {%- endif -%}
                          <li class="m-mega-col__item{{ hidden_class }}" data-col-item="{{ col_uid }}" data-item-index="{{ item_index0 }}">
                            <a href="{{ sublink.url }}">
                              {%- if icon_img != blank -%}
                                <span class="m-mega-col__icon">
                                  <img
                                    src="{{ icon_img | image_url: width: 44 }}"
                                    alt="{{ sublink.title | escape }}"
                                    width="22"
                                    height="22"
                                    loading="lazy"
                                  >
                                </span>
                              {%- endif -%}
                              {{ sublink.title }}
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </div>
                {%- endfor -%}

                {%- if block.settings.banner_image != blank -%}
                  <div class="m-mega-col m-mega-col--banner">
                    {%- if block.settings.banner_link != blank -%}
                      <a href="{{ block.settings.banner_link }}" class="m-hidden-link">
                        <span class="m:visually-hidden">{{ block.settings.banner_title | default: shop.name }}</span>
                      </a>
                    {%- endif -%}
                    <div class="m-mega-banner-img">
                      {% render 'responsive-image', image: block.settings.banner_image, sizes: '300px' %}
                    </div>
                    {%- if block.settings.banner_title != blank -%}
                      <p style="margin:10px 0 4px;font-size:13px;font-weight:600;color:var(--mega-text);">{{ block.settings.banner_title }}</p>
                    {%- endif -%}
                    {%- if block.settings.banner_button_text != blank and block.settings.banner_link != blank -%}
                      <a href="{{ block.settings.banner_link }}" class="m-button m-button--link" style="font-size:13px;">{{ block.settings.banner_button_text }}</a>
                    {%- endif -%}
                  </div>
                {%- else -%}
                  <div class="m-mega-col m-mega-col--banner">
                    <div class="m-mega-banner-placeholder"></div>
                  </div>
                {%- endif -%}
              </div>
            {%- endcapture -%}

          {% when 'banner' %}
            {% capture block_type %}
              {% if block.settings.banner_image != blank %}
                {% liquid
                  assign banner_class = 'm-mega-banner' | append: ' m-mega-banner--' | append: block.settings.banner_style
                  assign banner_link = block.settings.banner_link
                  assign banner_title = block.settings.banner_title
                  assign banner_desc = block.settings.banner_desc
                  assign banner_button_text = block.settings.banner_button_text
                  if banner_title == blank and banner_desc == blank and banner_button_text == blank
                    assign banner_class = banner_class | append: ' m-mega-banner--no-content'
                  endif
                %}
                <div class="{{ banner_class }}">
                  {% if banner_link != blank %}<a href="{{ banner_link }}" class="m-hidden-link"><span class="m:visually-hidden">{{ banner_title | default: shop.name }}</span></a>{% endif %}
                  <div class="m-mega-banner__image m:blocks-radius">{% render 'responsive-image', image: block.settings.banner_image, sizes: '500px' %}</div>
                  <div class="m-mega-banner__inner">
                    <div class="m-mega-banner__conntent">
                      <h4 class="m-mega-banner__title">{{ banner_title }}</h4>
                      <p class="m-mega-banner__description">{{ banner_desc }}</p>
                    </div>
                    {% if banner_link != blank and banner_button_text != blank %}
                      <a href="{{ banner_link }}" class="m-mega-banner__button m-button m-button--link">{{ banner_button_text }}</a>
                    {% endif %}
                  </div>
                </div>
              {% endif %}
            {% endcapture %}

          {% when 'bloglist' %}
            {% capture block_type %}
              {% if block.settings.blog != blank %}
                <div class="m-mega-blog-list">
                  {% assign blog = blogs[block.settings.blog] %}
                  <ul class="m-mega-blog-list__wrapper m:flex m:flex-col">
                    {% for article in blog.articles limit: 3 %}
                      <li class="m-mega-blog-list__item m-mega-article-card m:flex">
                        <a href="{{ article.url }}" class="m-mega-article-card__image m:w-3/12 m:blocks-radius-md m:block">
                          {%- if article.image -%}{% render 'responsive-image', image: article.image, aspect_ratio: '16/9', sizes: '200px' %}{%- else -%}{{ 'image' | placeholder_svg_tag: 'm-placeholder-svg m:w-full m:h-full m:object-cover' }}{%- endif -%}
                        </a>
                        <div class="m-mega-article-card__content m:w-9/12">
                          {% if article.tags != blank %}<span class="m-mega-article-card__tag">{{ article.tags[0] }}</span>{% endif %}
                          <a href="{{ article.url }}" class="m-mega-article-card__title">{{ article.title }}</a>
                        </div>
                      </li>
                    {% endfor %}
                  </ul>
                </div>
              {% endif %}
            {% endcapture %}

          {% when 'product-list' %}
            {% assign stretch_width = block.settings.stretch_width %}
            {% assign collection = block.settings.collection %}
            {% if collection != blank %}
              {% capture block_type %}
                <div class="m-mega-product-list" data-id="{{ block.id }}">
                  {%- assign collection = collections[block.settings.collection] -%}
                  <div class="m-mega-product-list__header">
                    <h3 class="m-mega-product-list__heading">{{ collection.title }}</h3>
                    {% if block.settings.limit > block.settings.columns %}
                      <div id="m-slider-controls-{{ block.id }}" class="m-slider-controls m:flex m:items-center">
                        <button class="m-slider-controls__button m-slider-controls__button-prev" aria-label="Previous"><svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M12.5 15L7.5 10L12.5 5" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
                        <button class="m-slider-controls__button m-slider-controls__button-next" aria-label="Next"><svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M7.5 15L12.5 10L7.5 5" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
                      </div>
                    {% endif %}
                  </div>
                  <div class="m:grid swiper-container m-product-list-{{ block.id }}" data-column="{{ block.settings.columns }}" style="--column-gap: 20px; --items: {{ block.settings.columns }};">
                    <div class="swiper-wrapper">
                      {% for product in collection.products limit: block.settings.limit %}
                        {%- assign image_ratio = product.featured_image.aspect_ratio | default: '1/1' -%}
                        <div class="swiper-slide m:column">
                          <div class="m-product-card m-product-card--style-1">
                            <div class="m-product-card__media">
                              <a class="m-product-card__link m:block m:w-full" href="{{ product.url }}" aria-label="{{ product.title | default: forloop.index }}">
                                <div class="m-product-card__main-image">
                                  {%- if product.featured_image -%}{% render 'responsive-image', image: product.featured_image, aspect_ratio: image_ratio, sizes: '400px' %}{%- else -%}{{ 'product-1' | placeholder_svg_tag: 'm-placeholder-svg m:w-full m:h-full m:object-cover' }}{%- endif -%}
                                </div>
                              </a>
                            </div>
                            <div class="m-product-card__content m:text-left">
                              <div class="m-product-card__info">
                                <h3 class="m-product-card__title"><a href="{{ product.url }}" class="m-product-card__name">{{ product.title }}</a></h3>
                                <div class="m-product-card__price">{% render 'product-prices', product: product, is_product_card: true %}</div>
                              </div>
                            </div>
                          </div>
                        </div>
                      {% endfor %}
                    </div>
                  </div>
                </div>
              {% endcapture %}
            {% else %}
              {%- capture block_type -%}{%- endcapture -%}
            {% endif %}

          {% when 'collection-list' %}
            {% liquid
              assign stretch_width = true
              assign collection_ids = 'collection_1,collection_2,collection_3,collection_4,collection_5,collection_6' | split: ','
              assign content_empty = true
              for collection_id in collection_ids
                if block.settings[collection_id] != blank
                  assign content_empty = false
                endif
              endfor
            %}
            {% capture block_type %}
              {% unless content_empty %}
                {{ 'component-collection-card.css' | asset_url | stylesheet_tag }}
                <div class="m-mega-collection-list" data-id="{{ block.id }}">
                  <div class="m-mega-collection-list__wrapper m:flex" style="--column-gap: 20px">
                    {% for collection_id in collection_ids %}
                      {% liquid
                        if block.settings[collection_id] == blank
                          continue
                        endif
                        assign collection_handle = block.settings[collection_id]
                        assign collection = collections[collection_handle]
                        assign collection_image = collection.image
                        assign image_id = 'image_' | append: forloop.index
                        if block.settings[image_id] != blank
                          assign collection_image = block.settings[image_id]
                        endif
                        assign all_products_count = collection.all_products_count
                      %}
                      <div class="m:column m:flex-1">
                        <div class="m-collection-card m-collection-card--standard">
                          <div class="m-collection-card__inner">
                            <a href="{{ collection.url | default: '#' }}" class="m-collection-card__image m-hover-box m-hover-box--scale-up m:block m:w-full m:blocks-radius">
                              {% if collection_image != blank %}{% render 'responsive-image', image: collection_image, image_class: 'm:w-full', aspect_ratio: aspect_ratio %}{% else %}<div style="--aspect-ratio: 1/1;">{% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}{{ 'collection-' | append: current | placeholder_svg_tag: 'm-placeholder-svg m:w-full m:h-full m:object-cover' }}</div>{% endif %}
                            </a>
                            <div class="m-collection-card__info m:text-left">
                              <h3 class="m-collection-card__title">
                                <a href="{{ collection.url | default: '#' }}" class="m-collection-card__link m:block">{{ title | default: collection.title }}<sup>{{ all_products_count }}</sup></a>
                              </h3>
                            </div>
                          </div>
                        </div>
                      </div>
                    {% endfor %}
                  </div>
                </div>
              {% endunless %}
            {% endcapture %}

          {% when 'custom_html' %}
            {% capture block_type %}
              {% if block.settings.html != blank %}
                <div class="m-mega-html m:text-black">{{ block.settings.html }}</div>
              {% endif %}
            {% endcapture %}

          {% else %}
            {%- capture block_type -%}{%- endcapture -%}

        {% endcase %}
      {% endfor %}

      {% liquid
        assign has_child = false
        if has_mega_item == false
          assign is_mega = false
        endif
        if link.links != blank or block_type != blank
          assign has_child = true
          assign li_class = li_class | append: ' m-menu__item--parent'
        endif
        if link.links != blank
          assign li_class = li_class | append: ' m-menu__item--has-submenu'
          unless is_mega
            assign li_class = li_class | append: ' m-menu__item--dropdown'
          endunless
        endif
        if is_mega and has_child
          assign li_class = li_class | append: ' m-menu__item--mega'
        endif
      %}

      <li class="{{ li_class }}" data-index="{{ forloop.index0 }}">
        <a
          href="{{ link.url }}"
          class="m-menu__link m-menu__link--main{% if section.settings.uppercase_parent_level %} m:uppercase{% endif %}"
        >
          {{ link.title }}
          {% if has_child or block_type != blank %}
            <span class="m-menu__arrow">
              <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          {% endif %}
        </a>

        {% comment %} custom mega menu {% endcomment %}

        {% if has_child or block_type != blank %}
          <div
            class="m-mega-menu{% if is_mega and show_menu_column_divider %} m-show-menu-column-divider{% endif %} m-gradient m-color-{{ section.settings.color_scheme }}"
            style="--total-columns: {{ link.links.size }}"
          >
            <div class="m-mega-menu__container--custom">
              {% if block_type != blank %}
                {{ block_type }}
              {% else %}
                <div class="m-mega-menu__inner--custom">
                  <div class="m-mega-col">
                    <ul class="m-mega-col__list">
                      {% for childlink in link.links %}
                        <li class="m-mega-col__item">
                          <a href="{{ childlink.url }}">
                            {{ childlink.title }}
                            {% if childlink.links != blank %}
                              <span class="m-menu__sub-arrow">
                                <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M3.5 2L6.5 5L3.5 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                              </span>
                            {% endif %}
                          </a>
                          {% if childlink.links != blank %}
                            <div class="m-mega-menu__column">
                              <ul class="m-sub-menu m-sub-menu--level-2">
                                {% for grandlink in childlink.links %}
                                  <li class="m-sub-menu__item m-sub-menu__item--level-2">
                                    <a href="{{ grandlink.url }}" class="m-menu__link">{{ grandlink.title }}</a>
                                  </li>
                                {% endfor %}
                              </ul>
                            </div>
                          {% endif %}
                        </li>
                      {% endfor %}
                    </ul>
                  </div>
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}
      </li>

    {% endfor %}
  </ul>
</div>

<script>
(function () {
  var PAGE_SIZE = 7;

  /**
   * For a given column uid, read all items and current page,
   * then show/hide accordingly and update button states.
   */
  function renderPage(uid, page) {
    var items = document.querySelectorAll('[data-col-item="' + uid + '"]');
    var total = items.length;
    var maxPage = Math.max(0, Math.ceil(total / PAGE_SIZE) - 1);
    page = Math.min(Math.max(page, 0), maxPage);

    items.forEach(function (item) {
      var idx = parseInt(item.getAttribute('data-item-index'), 10);
      if (idx >= page * PAGE_SIZE && idx < (page + 1) * PAGE_SIZE) {
        item.classList.remove('m-mega-col__item--hidden');
      } else {
        item.classList.add('m-mega-col__item--hidden');
      }
    });

    var prevBtn = document.querySelector('[data-col-prev="' + uid + '"]');
    var nextBtn = document.querySelector('[data-col-next="' + uid + '"]');
    if (prevBtn) prevBtn.disabled = page === 0;
    if (nextBtn) nextBtn.disabled = page >= maxPage;

    return page;
  }

  // Track current page per column uid
  var pages = {};

  document.addEventListener('click', function (e) {
    var prevBtn = e.target.closest('[data-col-prev]');
    var nextBtn = e.target.closest('[data-col-next]');

    if (prevBtn) {
      var uid = prevBtn.getAttribute('data-col-prev');
      pages[uid] = renderPage(uid, (pages[uid] || 0) - 1);
    }
    if (nextBtn) {
      var uid = nextBtn.getAttribute('data-col-next');
      pages[uid] = renderPage(uid, (pages[uid] || 0) + 1);
    }
  });

  // Initialise all columns on load
  document.querySelectorAll('[data-col-list]').forEach(function (list) {
    var uid = list.getAttribute('data-col-list');
    pages[uid] = renderPage(uid, 0);
  });
})();
</script>
