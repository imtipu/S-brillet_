<div class="tier-status-content tier-border-color">
    <div class="sparkle-points-stats">
        <div class="logo-box">
            <img
                    src="{{ logo }}" alt="Sbrillet Logo"
                    width="200" height="200">
        </div>
        <div class="sparkle-stats">
            <div class="point-box">
                <div class="points-with-icon">
                    <span class="amount text-gradient">50</span>
                    <img src="{{ point_icon }}" alt="" width="30" height="30">
                </div>
                <span class="label">Sparkle Points</span>
            </div>
            <div class="point-box" data-tier-points>
                <span class="amount text-gradient">$100</span>
                <span class="label">Saved</span>
            </div>
        </div>
    </div>
    <div class="tier-level-content">
        <div class="tier-level">
            <div class="level-with-icon">
                <img src="{{ level_icon }}" alt="Sbrillet Level" width="100" height="100"
                     class="icon"/>
                <span class="font-title level-title">SHINY</span>
            </div>
            <div>
                <span class="text-gradient level-point font-inter">(<span>0</span> Sparkle Points)</span>
            </div>
        </div>
        <div class="divider bg-tier-gradient"></div>
        <div class="tier-point-features">
            <div class="feature-item font-inter">
                <div class="item-label">
                    <img class="label-icon" src="{{ checked_icon }}" alt="" width="30" height="30">
                    <span class="label">Purchase Items</span>
                </div>
                <div class="point-amount text-gradient">
                                    <span data-earning-point-rate>
                                        +1
                                    </span> Sparkle
                    Points
                </div>
            </div>
            <div class="feature-item font-inter" data-tier-feature>
                <div class="item-label">
                    <img class="label-icon" src="{{ checked_icon }}" alt="" width="30" height="30">
                    <span class="label">Refer a Friend</span>
                </div>
                <div class="point-amount text-gradient">
                    <span data-referral-earning-rate>+50</span>
                    Sparkle Points
                </div>
            </div>
        </div>

    </div>
</div>
