{% comment %} {% liquid
  assign is_size = false
  assign size_title_downcase = size_title | downcase
  assign picker_types = ''
  assign option_labels = ''

  for option in product.options_with_values
    assign found_option = false
    assign option_design = ''
    assign option_label = option.name

    for i in (1..5)
      unless found_option == true
        assign option_name_key = 'variant_option_title' | append: i
        assign option_design_key = 'variant_option_design' | append: i
        assign option_label_key = 'variant_option_display_name' | append: i

        assign option_name = settings[option_name_key]
        if option_name == option.name
          assign found_option = true
          assign option_design = settings[option_design_key]
          assign option_label = settings[option_label_key] | default: option.name
        endif
      endunless
    endfor

    assign design = option_design | prepend: ','
    assign option_label = option_label | prepend: ','
    if found_option == false or option_design == ''
      assign design = settings.variant_option_design_default | prepend: ','
    endif

    assign picker_types = picker_types | append: design
    assign option_labels = option_labels | append: option_label
  endfor

  assign picker_types = picker_types | remove_first: ',' | split: ','
  assign option_labels = option_labels | remove_first: ',' | split: ','

  assign has_shape = false
  assign has_material = false
  for option in product.options_with_values
    assign opt_down = option.name | downcase
    if opt_down == 'shape'
      assign has_shape = true
    endif
    if opt_down == 'material'
      assign has_material = true
    endif
  endfor
%}

<style>
  /* ── Gap between swatches ── */
  .m-product-option--content {
    gap: 8px !important;
  }

  /* ── Shared wrapper ── */
  .m-product-option--node[data-option-type="button"],
  .m-product-option--node[data-option-type="color"],
  .m-product-option--node[data-option-type="swatch_color"],
  .m-product-option--node[data-option-type="image"],
  .m-product-option--node[data-option-type="gemstone"] {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 54px;
    height: 54px;
    background: none !important;
    clip-path: none !important;
    box-shadow: none !important;
    border: none !important;
    outline: none !important;
    padding: 0 !important;
    box-sizing: border-box;
    cursor: pointer;
  }

  /* ── Gemstone specific rectangular size ── */
  .m-product-option--node[data-option-type="gemstone"] {
    {% comment %} width: 66px !important; {% endcomment %}
    width: auto !important;

    height: 38px !important;
  }

  /* ── 1. Add the shadow and force remove ALL default theme borders ── */
  .m-product-option--node[data-option-type="gemstone"] {
    filter: drop-shadow(0px 0px 2px rgba(0, 0, 0, 0.10));
    box-shadow: none !important;
    border: none !important;
    background: transparent !important;
  }

  /* Target hidden theme rings */
  .m-product-option--node[data-option-type="gemstone"]::before,
  .m-product-option--node[data-option-type="gemstone"]::after {
    display: none !important;
    box-shadow: none !important;
    border: none !important;
  }

  /* ── 2. Completely kill the zoom/scale effect everywhere ── */
  .m-product-option--node[data-option-type="gemstone"]:hover,
  .m-product-option--node[data-option-type="gemstone"]:hover img,
  .m-product-option--node[data-option-type="gemstone"] img {
    transform: none !important;
    transition: none !important;
  }

  /* ── Octagon-clipped inner shape ── */
  .m-product-option--oct-gap {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    box-sizing: border-box;
    background: none;
  }

  /* Button: white fill */
  .m-product-option--node[data-option-type="button"] .m-product-option--oct-gap {
    background: #fff;
  }

  /* ── Hidden radio ── */
  .m-product-option--node input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  /* ── Button label ── */
  .m-product-option--node[data-option-type="button"] label.m-product-option--node__label {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    font-weight: 500;
    color: #111;
    cursor: pointer;
    margin: 0;
    text-align: center;
    line-height: 1;
  }

  /* ── Material label: Figma anujayi 22x22px centered ── */
  .m-product-option--node[data-option-type="color"] label.m-product-option--node__label,
  .m-product-option--node[data-option-type="swatch_color"] label.m-product-option--node__label,
  .m-product-option--node[data-option-type="image"] label.m-product-option--node__label {
    display: block;
    width: 100%;
    height: 100%;
    cursor: pointer;
    font-size: 0;
    background-size: 22px 22px !important; 
    background-repeat: no-repeat !important;
    background-position: center !important;
    margin: 0;
  }

  /* ── Gemstone label ── */
  .m-product-option--node[data-option-type="gemstone"] label.m-product-option--node__label {
    display: block;
    width: 100%;
    height: 100%;
    cursor: pointer;
    font-size: 0;
    margin: 0;
  }

  /* ── Gemstone img inside label ── */
  .m-product-option--node[data-option-type="gemstone"] label.m-product-option--node__label img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    pointer-events: none;
  }

  /* ── SVG border: hidden by default ── */
  .m-product-option--oct-svg-border {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 4;
    opacity: 0;
    transition: opacity 0.18s ease;
    overflow: visible;
  }

  /* Hover & Selected: show gray border */
  .m-product-option--node:hover .m-product-option--oct-svg-border,
  .m-product-option--node.is-selected .m-product-option--oct-svg-border {
    opacity: 1;
  }

  /* ── Sold-out diagonal strike ── */
  .m-product-option--node__unavailable .m-product-option--oct-gap {
    position: relative;
  }
  .m-product-option--node__unavailable .m-product-option--oct-gap::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top right,
      transparent calc(50% - 0.5px),
      rgba(0,0,0,0.3) calc(50% - 0.5px),
      rgba(0,0,0,0.3) calc(50% + 0.5px),
      transparent calc(50% + 0.5px)
    );
    pointer-events: none;
    z-index: 2;
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .m-product-option--node[data-option-type="button"],
    .m-product-option--node[data-option-type="color"],
    .m-product-option--node[data-option-type="swatch_color"],
    .m-product-option--node[data-option-type="image"],
    .m-product-option--node[data-option-type="gemstone"] {
      width: 44px;
      height: 44px;
    }
    .m-product-option--content {
      gap: 6px !important;
    }
  }

  /* ── 3. Destroy theme circular ghost borders ── */
  .m-product-option--node[data-option-type="gemstone"] label::before,
  .m-product-option--node[data-option-type="gemstone"] label::after,
  .m-product-option--node[data-option-type="gemstone"] .m-product-option--oct-gap::before,
  .m-product-option--node[data-option-type="gemstone"] .m-product-option--oct-gap::after {
    content: none !important;
    display: none !important;
    border: none !important;
    box-shadow: none !important;
    background: none !important;
  }

  /* ── 4. Fix ghost shadow ── */
  .m-product-option--node[data-option-type="gemstone"] .m-product-option--oct-gap,
  .m-product-option--node[data-option-type="gemstone"] label.m-product-option--node__label {
    background: transparent !important;
    background-color: transparent !important;
    border-radius: 0 !important;
  }

  /* ── Universal Drop Shadow ── */
  .m-product-option--node {
    filter: drop-shadow(0px 0px 2px rgba(0, 0, 0, 0.10)) !important;
    box-shadow: none !important;
    border: none !important;
    background: transparent !important;
  }

  /* ── Physical Octagon Shape ── */
  .m-product-option--oct-gap {
    background: #FFFFFF !important;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    clip-path: polygon(15.79% 0%, 84.21% 0%, 100% 15.79%, 100% 84.21%, 84.21% 100%, 15.79% 100%, 0% 84.21%, 0% 15.79%) !important;
    overflow: hidden;
    box-sizing: border-box;
  }

  /* Gemstone Specific (66x38) Octagon Clip Path */
  .m-product-option--node[data-option-type="gemstone"] .m-product-option--oct-gap {
    clip-path: polygon(9.09% 0%, 90.91% 0%, 100% 15.79%, 100% 84.21%, 90.91% 100%, 9.09% 100%, 0% 84.21%, 0% 15.79%) !important;
  }

  /* ── SVG Border properties ── */
  .m-product-option--oct-svg-border {
    opacity: 0 !important;
    transition: opacity 0.2s ease !important;
  }
  
  .m-product-option--oct-svg-border polygon {
    stroke: #E8E2DC !important;
    stroke-width: 1.25px !important;
  }

  .m-product-option--node:hover .m-product-option--oct-svg-border,
  .m-product-option--node.is-selected .m-product-option--oct-svg-border {
    opacity: 1 !important;
  }

  .m-product-option--node:hover .m-product-option--oct-gap,
  .m-product-option--node.is-selected .m-product-option--oct-gap {
    background: transparent !important;
  }

  /* ── Size Button Layout ── */
  .m-product-option--node[data-option-type="button"] label.m-product-option--node__label {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Inter', sans-serif !important;
    font-size: 16px !important;
    font-weight: 700 !important;
    color: #2C2C2C !important;
    cursor: pointer;
    margin: 0;
    text-align: center;
    line-height: 1;
  }

  .m-product-option--node[data-option-type="button"] .m-product-option--oct-gap,
  .m-product-option--node[data-option-type="button"]:hover .m-product-option--oct-gap,
  .m-product-option--node[data-option-type="button"].is-selected .m-product-option--oct-gap {
    background: #FFFFFF !important;
  }

  .m-product-option--node[data-option-type="button"],
  .m-product-option--node[data-option-type="button"].is-selected,
  .m-product-option--node[data-option-type="button"]:hover,
  .m-product-option--node[data-option-type="button"] label,
  .m-product-option--node[data-option-type="button"].is-selected label,
  .m-product-option--node[data-option-type="button"]::before,
  .m-product-option--node[data-option-type="button"]::after,
  .m-product-option--node[data-option-type="button"].is-selected::before,
  .m-product-option--node[data-option-type="button"].is-selected::after {
    border: none !important;
    box-shadow: none !important;
    outline: none !important;
  }

  /* ── 5. Stop zoom effect on Gemstones ── */
  .gemstone-picker-wrapper,
  .gemstone-picker-wrapper:hover,
  .gemstone-picker-wrapper .m-product-option--content,
  .gemstone-picker-wrapper .m-product-option--content:hover,
  .m-product-option--node[data-option-type="gemstone"],
  .m-product-option--node[data-option-type="gemstone"]:hover,
  .m-product-option--node[data-option-type="gemstone"] label,
  .m-product-option--node[data-option-type="gemstone"] label:hover,
  .m-product-option--node[data-option-type="gemstone"] img {
    transform: none !important;
    scale: 1 !important;
    transition: transform 0s, scale 0s !important;
  }
</style>

<variant-picker
  id="variant-picker-{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-section-id="{{ section.id }}"
  data-update-url="{{ update_browser_history }}"
  data-product-url="{{ product.url }}"
  data-has-only-default-variant="{{ product.has_only_default_variant }}"
>
  {%- unless product.has_only_default_variant -%}
    
    {%- comment -%} 1. MATERIAL OPTION {%- endcomment -%}
    {%- for option in product.options_with_values -%}
      {%- liquid
        assign picker_type = picker_types[forloop.index0]
        assign option_label = option_labels[forloop.index0]
        assign option_name_clean = option.name | downcase | strip
        assign swatch_count = option.values | map: 'swatch' | compact | size
        if swatch_count > 0
          if picker_type == 'dropdown'
            assign picker_type = 'swatch_dropdown'
          elsif picker_type == 'color'
            assign picker_type = 'swatch_color'
          endif
        endif
      -%}
      {%- if option_name_clean == 'material' -%}
        <div class="m-product-option m-product-option--{{ picker_type }}">
          <div data-picker-field="radio" data-option-name="{{ option.name }}" data-selected-value="{{ option.selected_value }}" class="m-product-option__inner">
            <div class="m-product-option--label">
              <label class="option-label">
                <span class="option-label--title">{{ option_label }}:</span>
                <span class="option-label--selected" data-option-display-target="{{ option.name | handle }}">{{ option.selected_value }}</span>
              </label>
            </div>
            <div class="m-product-option--content m:inline-flex m:flex-wrap" data-option-container="{{ option.name | handle }}">
              {%- render 'product-variant-options', product: product, option: option, picker_type: picker_type -%}
            </div>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}

    {%- comment -%} 2. GEMSTONE OPTION (Native rendering inside custom layout wrapper) {%- endcomment -%}
    {%- for option in product.options_with_values -%}
      {%- liquid
        assign option_label = option.name
        assign option_name_clean = option.name | downcase | strip
      -%}
      {%- if option_name_clean == 'gemstone' -%}
        <div class="m-product-option m-product-option--swatch gemstone-picker-wrapper">
          <div data-picker-field="radio" data-option-name="{{ option.name }}" data-selected-value="{{ option.selected_value }}" class="m-product-option__inner">
            <div class="m-product-option--label">
              <label class="option-label">
                <span class="option-label--title">Gemstone:</span>
                <span class="option-label--selected" data-option-display-target="{{ option.name | handle }}">{{ option.selected_value }}</span>
              </label>
            </div>
            <div class="m-product-option--content m:inline-flex m:flex-wrap" data-option-container="{{ option.name | handle }}">
              {%- render 'product-variant-options', product: product, option: option, picker_type: 'swatch_color' -%}
            </div>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}

    {%- comment -%} 3. SIZE OPTION {%- endcomment -%}
    {%- for option in product.options_with_values -%}
      {%- liquid
        assign picker_type = picker_types[forloop.index0]
        assign option_label = option_labels[forloop.index0]
        assign option_name_clean = option.name | downcase | strip
        assign swatch_count = option.values | map: 'swatch' | compact | size
        if swatch_count > 0
          if picker_type == 'dropdown'
            assign picker_type = 'swatch_dropdown'
          elsif picker_type == 'color'
            assign picker_type = 'swatch_color'
          endif
        endif
      -%}
      {%- if option_name_clean contains size_title_downcase or option_name_clean == 'size' -%}
        <div class="m-product-option m-product-option--{{ picker_type }}">
          <div data-picker-field="radio" data-option-name="{{ option.name }}" data-selected-value="{{ option.selected_value }}" class="m-product-option__inner">
            <div class="m-product-option--label">
              <label class="option-label">
                <span class="option-label--title">{{ option_label }}:</span>
                <span class="option-label--selected" data-option-display-target="{{ option.name | handle }}">{{ option.selected_value }}</span>
              </label>
              <button type="button" id="size-guide-btn" style="background:none;border:none;padding:0;cursor:pointer;font-size:16px;text-decoration:underline;color:inherit;margin-left:12px;font-family:'Inter',sans-serif;font-weight:500;">
                Size Guide
              </button>
            </div>
            <div class="m-product-option--content m:inline-flex m:flex-wrap" data-option-container="{{ option.name | handle }}">
              {%- render 'product-variant-options', product: product, option: option, picker_type: picker_type -%}
            </div>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}

    {%- comment -%} 4. OTHERS {%- endcomment -%}
    {%- for option in product.options_with_values -%}
      {%- liquid
        assign picker_type = picker_types[forloop.index0]
        assign option_label = option_labels[forloop.index0]
        assign option_name_clean = option.name | downcase | strip
      -%}
      {%- unless option_name_clean == 'material' or option_name_clean == 'gemstone' or option_name_clean contains size_title_downcase or option_name_clean == 'size' -%}
        <div class="m-product-option m-product-option--{{ picker_type }}">
          <div data-picker-field="radio" data-option-name="{{ option.name }}" data-selected-value="{{ option.selected_value }}" class="m-product-option__inner">
            <div class="m-product-option--label">
              <label class="option-label">
                <span class="option-label--title">{{ option_label }}:</span>
                <span class="option-label--selected" data-option-display-target="{{ option.name | handle }}">{{ option.selected_value }}</span>
              </label>
            </div>
            <div class="m-product-option--content m:inline-flex m:flex-wrap" data-option-container="{{ option.name | handle }}">
              {%- render 'product-variant-options', product: product, option: option, picker_type: picker_type -%}
            </div>
          </div>
        </div>
      {%- endunless -%}
    {%- endfor -%}

  {%- endunless -%}
  <script type="application/json" data-selected-variant>
    {{ product.selected_or_first_available_variant | json }}
  </script>
</variant-picker>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Libre+Caslon+Text:wght@400&display=swap');

  .sg-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 9999;
    background: rgba(245, 240, 235, 0.6);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 15px;
  }

  .sg-modal-box {
    background: #ffffff;
    max-width: 850px;
    width: 100%;
    max-height: 95vh;
    overflow-y: auto;
    padding: 30px 40px;
    position: relative;
    box-sizing: border-box;
    box-shadow: 0 10px 40px rgba(0,0,0,0.08);
  }

  .sg-modal-close {
    position: absolute;
    top: 15px;
    right: 15px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 5px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
  }

  .sg-modal-close:hover { transform: scale(1.1); }

  .sg-modal-title {
    font-family: 'Libre Caslon Text', serif;
    font-size: 30px;
    font-weight: 400;
