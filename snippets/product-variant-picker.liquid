        assign option_name_clean = option.name | downcase | strip
      -%}
      {%- unless option_name_clean == 'material' or option_name_clean == 'gemstone' or option_name_clean contains size_title_downcase or option_name_clean == 'size' -%}
        <div class="m-product-option m-product-option--{{ picker_type }}">
          <div data-picker-field="radio" data-option-name="{{ option.name }}" data-selected-value="{{ option.selected_value }}" class="m-product-option__inner">
            <div class="m-product-option--label">
              <label class="option-label">
                <span class="option-label--title">{{ option_label }}:</span>
                <span class="option-label--selected" data-option-display-target="{{ option.name | handle }}">{{ option.selected_value }}</span>
              </label>
            </div>
            <div class="m-product-option--content m:inline-flex m:flex-wrap" data-option-container="{{ option.name | handle }}">
              {%- render 'product-variant-options', product: product, option: option, picker_type: picker_type -%}
            </div>
          </div>
        </div>
      {%- endunless -%}
    {%- endfor -%}

  {%- endunless -%}
  <script type="application/json" data-selected-variant>
    {{ product.selected_or_first_available_variant | json }}
  </script>
</variant-picker>

