<script>
(function () {
  'use strict';

  // Function to map input changes to text displays seamlessly
  function bindDynamicDisplays() {
    document.querySelectorAll('.m-product-option--content').forEach(function(container) {
      var targetHandle = container.getAttribute('data-option-container');
      if (!targetHandle) return;

      var displayTarget = document.querySelector('[data-option-display-target="' + CSS.escape(targetHandle) + '"]');
      if (!displayTarget) return;

      var inputs = container.querySelectorAll('input[type="radio"]');
      inputs.forEach(function(input) {
        // Ensure the initial label matches the natively selected input
        if (input.checked) {
          displayTarget.textContent = input.getAttribute('data-label') || input.value;
        }

        // Update target text instantly when user makes a choice
        input.addEventListener('change', function() {
          displayTarget.textContent = this.getAttribute('data-label') || this.value;
        });
      });
    });
  }

  // Init Modal logic handling duplication & Safari append DOM lifecycle
  function initModal() {
    var modal = document.getElementById('size-guide-modal');
    if (!modal) return;
    
    // Move modal to body if it isn't already there to avoid z-index/parent transform issues in Safari
    if (modal.parentNode !== document.body) {
      document.body.appendChild(modal);
    }

    // Cleanup any duplicate modals generated by Shopify section AJAX re-renders
    var allModals = document.querySelectorAll('#size-guide-modal');
    if (allModals.length > 1) {
      allModals.forEach(function(m, index) {
        if (index > 0) m.remove();
      });
    }
  }

  function init() {
    bindDynamicDisplays();
    initModal();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  // Re-sync if the theme's core JS manipulates the DOM
  ['variant:changed', 'theme:variant:changed', 'section:load', 'shopify:section:load'].forEach(function (evt) {
    document.addEventListener(evt, function () { 
      bindDynamicDisplays(); 
      initModal();
    });
  });

  // Use Event Delegation to guarantee Safari compatibility on dynamic UI swaps
  document.addEventListener('click', function(e) {
    // Open Modal logic
    var btn = e.target.closest('#size-guide-btn');
    if (btn) {
      e.preventDefault();
      var modal = document.getElementById('size-guide-modal');
      if (modal) {
        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
      }
    }
    
    // Close Modal logic via button
    var closeBtn = e.target.closest('#size-guide-close');
    if (closeBtn) {
      e.preventDefault();
      var modal = document.getElementById('size-guide-modal');
      if (modal) {
        modal.style.display = 'none';
        document.body.style.overflow = '';
      }
    }
    
    // Close Modal logic via background click
    var modalElem = document.getElementById('size-guide-modal');
    if (modalElem && e.target === modalElem) {
      modalElem.style.display = 'none';
      document.body.style.overflow = '';
    }
  });

  // Close Modal logic via Escape key
  document.addEventListener('keydown', function (e) {
    var modal = document.getElementById('size-guide-modal');
    if (e.key === 'Escape' && modal && modal.style.display === 'flex') {
      modal.style.display = 'none';
      document.body.style.overflow = '';
    }
  });

})();
</script>