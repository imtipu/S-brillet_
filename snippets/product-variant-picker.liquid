    border-bottom: 1px solid #E5E7EB;
  }

  .sg-steps-banner {
    background-color: #F8F8F8;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: #2C2C2C;
    text-align: center;
    padding: 10px;
    margin-bottom: 20px;
  }

  .sg-bottom-section {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }

  .sg-instructions {
    flex: 1;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: #2C2C2C;
    line-height: 1.4;
  }

  .sg-instructions p { margin: 0 0 12px 0; }

  .sg-learn-more-btn {
    display: inline-block;
    background-color: #2C2C2C;
    color: #FFFFFF;
    text-decoration: none;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    padding: 10px 24px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
  }

  .sg-learn-more-btn:hover {
    background: linear-gradient(135deg, #947863, #E9DDD4, #947863) !important;
    color: #FFFFFF;
  }

  .sg-image-wrapper {
    flex: 1;
    text-align: right;
    overflow: hidden !important;
  }

  .sg-image-wrapper img {
    max-width: 100%;
    max-height: 140px;
    object-fit: contain;
    display: block !important; 
    margin-left: auto;
    transform: translateY(30px) !important;
  }

  @media screen and (max-width: 768px) {
    .sg-modal-box { padding: 30px 20px 20px; }
    .sg-modal-title { font-size: 24px; }
    .sg-modal-subtitle { font-size: 13px; margin-bottom: 15px; }
    .sg-bottom-section { flex-direction: column; text-align: center; }
    .sg-image-wrapper { text-align: center; }
    .sg-image-wrapper img { margin: 0 auto; max-height: 120px; }
  }
</style>

<div id="size-guide-modal" class="sg-modal-overlay" style="display:none;">
  <div class="sg-modal-box">
