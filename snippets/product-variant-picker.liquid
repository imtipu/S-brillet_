<script>
(function () {
  'use strict';

  // Function to map input changes to text displays seamlessly
  function bindDynamicDisplays() {
    document.querySelectorAll('.m-product-option--content').forEach(function(container) {
      var targetHandle = container.getAttribute('data-option-container');
      if (!targetHandle) return;

      var displayTarget = document.querySelector('[data-option-display-target="' + CSS.escape(targetHandle) + '"]');
      if (!displayTarget) return;

      var inputs = container.querySelectorAll('input[type="radio"]');
      inputs.forEach(function(input) {
        // Ensure the initial label matches the natively selected input
        if (input.checked) {
          displayTarget.textContent = input.getAttribute('data-label') || input.value;
        }

        // Update target text instantly when user makes a choice
        input.addEventListener('change', function() {
          displayTarget.textContent = this.getAttribute('data-label') || this.value;
        });
      });
    });
  }

  // Init Modal logic handling duplication & Safari append DOM lifecycle
  function initModal() {
    var modal = document.getElementById('size-guide-modal');
    if (!modal) return;
    
    // Move modal to body if it isn't already there to avoid z-index/parent transform issues in Safari
    if (modal.parentNode !== document.body) {
      document.body.appendChild(modal);
    }

    // Cleanup any duplicate modals generated by Shopify section AJAX re-renders
    var allModals = document.querySelectorAll('#size-guide-modal');
    if (allModals.length > 1) {
      allModals.forEach(function(m, index) {
        if (index > 0) m.remove();
      });
    }
  }

  function init() {
    bindDynamicDisplays();
    initModal();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  // Re-sync if the theme's core JS manipulates the DOM
  ['variant:changed', 'theme:variant:changed', 'section:load', 'shopify:section:load'].forEach(function (evt) {
    document.addEventListener(evt, function () { 
      bindDynamicDisplays(); 
      initModal();
    });
  });

  // Use Event Delegation to guarantee Safari compatibility on dynamic UI swaps
  document.addEventListener('click', function(e) {
    // Open Modal logic
    var btn = e.target.closest('#size-guide-btn');
    if (btn) {
      e.preventDefault();
      var modal = document.getElementById('size-guide-modal');
      if (modal) {
        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
      }
    }
    
    // Close Modal logic via button
    var closeBtn = e.target.closest('#size-guide-close');
    if (closeBtn) {
      e.preventDefault();
      var modal = document.getElementById('size-guide-modal');
      if (modal) {
        modal.style.display = 'none';
        document.body.style.overflow = '';
      }
    }
    
    // Close Modal logic via background click
    var modalElem = document.getElementById('size-guide-modal');
    if (modalElem && e.target === modalElem) {
      modalElem.style.display = 'none';
      document.body.style.overflow = '';
    }
  });

  // Close Modal logic via Escape key
  document.addEventListener('keydown', function (e) {
    var modal = document.getElementById('size-guide-modal');
    if (e.key === 'Escape' && modal && modal.style.display === 'flex') {
      modal.style.display = 'none';
      document.body.style.overflow = '';
    }
  });

})();
</script> {% endcomment %}


















{% liquid
  assign is_size = false
  assign size_title_downcase = size_title | downcase
  assign picker_types = ''
  assign option_labels = ''

  for option in product.options_with_values
    assign found_option = false
    assign option_design = ''
    assign option_label = option.name

    for i in (1..5)
      unless found_option == true
        assign option_name_key = 'variant_option_title' | append: i
        assign option_design_key = 'variant_option_design' | append: i
        assign option_label_key = 'variant_option_display_name' | append: i

        assign option_name = settings[option_name_key]
        if option_name == option.name
          assign found_option = true
          assign option_design = settings[option_design_key]
          assign option_label = settings[option_label_key] | default: option.name
        endif
      endunless
    endfor

    assign design = option_design | prepend: ','
    assign option_label = option_label | prepend: ','
    if found_option == false or option_design == ''
      assign design = settings.variant_option_design_default | prepend: ','
    endif

    assign picker_types = picker_types | append: design
    assign option_labels = option_labels | append: option_label
  endfor

  assign picker_types = picker_types | remove_first: ',' | split: ','
  assign option_labels = option_labels | remove_first: ',' | split: ','

  assign product_grouping_block = blank
  assign product_grouping_blocks = section.blocks | where: 'type', 'product_grouping_picker'
  assign product_grouping_block = product_grouping_blocks | first

  assign has_shape = false
  assign has_material = false
  for option in product.options_with_values
    assign opt_down = option.name | downcase
    if opt_down == 'shape'
      assign has_shape = true
    endif
    if opt_down == 'material'
      assign has_material = true
    endif
  endfor
%}

