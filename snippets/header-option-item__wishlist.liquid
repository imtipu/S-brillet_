{% liquid
  if settings.wishlist_page != blank
    assign url = pages[settings.wishlist_page].url
  else
    assign url = '/pages/wishlist'
  endif

  assign wishlist_app = settings.wishlist_app
%}

<style>
  .m-header__wishlist .wishlist-icon-path,
  .ssw-link-fave-menu .wishlist-icon-path {
    fill: url(#wishlistIconGradient);
  }

  /* Growave fallback — its SVG uses fill="currentColor" */
  .ssw-link-fave-menu svg {
    color: transparent;
  }
</style>

<script>
(function() {
  /* Inject gradient <defs> directly into <body> so it is never
     trapped inside a display:none mobile header container.
     Guard against duplicate injection on re-render. */
  if (!document.getElementById('wishlist-gradient-defs')) {
    var ns  = 'http://www.w3.org/2000/svg';
    var svg = document.createElementNS(ns, 'svg');
    svg.setAttribute('id', 'wishlist-gradient-defs');
    svg.setAttribute('style', 'position:absolute;width:0;height:0;overflow:hidden;');
    svg.setAttribute('aria-hidden', 'true');
    svg.innerHTML = '<defs>'
      + '<linearGradient id="wishlistIconGradient" x1="0%" y1="0%" x2="0%" y2="100%">'
      +   '<stop id="wishlist-stop1" offset="0%"   stop-color="#2C2C2C"/>'
      +   '<stop id="wishlist-stop2" offset="50%"  stop-color="#2C2C2C"/>'
      +   '<stop id="wishlist-stop3" offset="100%" stop-color="#2C2C2C"/>'
      + '</linearGradient>'
      + '</defs>';
    document.body.appendChild(svg);
  }

  var COLORS = {
    default: ['#2C2C2C', '#2C2C2C', '#2C2C2C'],
    hover:   ['#947863', '#E9DDD4', '#947863']
  };

  function hexToRgb(hex) {
    return [
      parseInt(hex.slice(1,3), 16),
      parseInt(hex.slice(3,5), 16),
      parseInt(hex.slice(5,7), 16)
    ];
  }

  function rgbToHex(r, g, b) {
    return '#' + [r, g, b].map(function(v) {
      return Math.round(v).toString(16).padStart(2, '0');
    }).join('');
  }

  function lerp(a, b, t) { return a + (b - a) * t; }

  var frame = null;
  var current = [
    hexToRgb(COLORS.default[0]),
    hexToRgb(COLORS.default[1]),
    hexToRgb(COLORS.default[2])
  ];

  function animateTo(targets, duration) {
    if (frame) cancelAnimationFrame(frame);
    var starts  = current.map(function(c) { return c.slice(); });
    var tgts    = targets.map(hexToRgb);
    var startTime = null;

    function step(ts) {
      if (!startTime) startTime = ts;
      var t = Math.min((ts - startTime) / duration, 1);
      var e = t < 0.5 ? 2*t*t : -1 + (4 - 2*t)*t;

      current = starts.map(function(s, i) {
        return [
          lerp(s[0], tgts[i][0], e),
          lerp(s[1], tgts[i][1], e),
          lerp(s[2], tgts[i][2], e)
        ];
      });

      var stop1 = document.getElementById('wishlist-stop1');
      var stop2 = document.getElementById('wishlist-stop2');
      var stop3 = document.getElementById('wishlist-stop3');
      if (stop1) stop1.setAttribute('stop-color', rgbToHex.apply(null, current[0]));
      if (stop2) stop2.setAttribute('stop-color', rgbToHex.apply(null, current[1]));
      if (stop3) stop3.setAttribute('stop-color', rgbToHex.apply(null, current[2]));

      if (t < 1) frame = requestAnimationFrame(step);
    }
    frame = requestAnimationFrame(step);
  }

  function bindHover(selector) {
    document.querySelectorAll(selector).forEach(function(el) {
      el.addEventListener('mouseenter', function() { animateTo(COLORS.hover, 400); });
      el.addEventListener('mouseleave', function() { animateTo(COLORS.default, 400); });
    });
  }

  function init() {
    bindHover('.m-header__wishlist');
    bindHover('.ssw-link-fave-menu');
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

{% if wishlist_app == 'growave' %}
  {% if shop.customer_accounts_enabled %}
    {% liquid
      assign ssw_fave_enabled = 1
      if shop.metafields.ssw.fave_enabled
        assign ssw_fave_enabled = shop.metafields.ssw.fave_enabled | plus: 0
      endif
    %}
    {% if ssw_fave_enabled == 1 %}
      
      <a  class="ssw-link-fave-menu ssw-link-fave-menu-hide-count"
        href="{{ url }}"
        aria-label="{{ shop.metafields.ssw.lang.my_faves }}"
      >
        <span class="m-tooltip m:block m-tooltip--bottom m-tooltip--style-2">
          <svg class="m-svg-icon--medium" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512">
            <path class="wishlist-icon-path" d="M528.1 171.5L382 150.2 316.7 17.8c-11.7-23.6-45.6-23.9-57.4 0L194 150.2 47.9 171.5c-26.2 3.8-36.7 36.1-17.7 54.6l105.7 103-25 145.5c-4.5 26.3 23.2 46 46.4 33.7L288 439.6l130.7 68.7c23.2 12.2 50.9-7.4 46.4-33.7l-25-145.5 105.7-103c19-18.5 8.5-50.8-17.7-54.6zM388.6 312.3l23.7 138.4L288 385.4l-124.3 65.3 23.7-138.4-100.6-98 139-20.2 62.2-126 62.2 126 139 20.2-100.6 98z"/>
          </svg>
          <span class="m-tooltip__content">{{ 'layout.wishlist.title' | t }}</span>
        </span>
        <span class="ssw-counter-fave-menu m-wishlist-count" style="display:none">0</span>
      </a>
      <script defer>
        var sswFaveCounterMenuLoaded = true;
      </script>
    {% endif %}
  {% endif %}
