  font-family: 'Inter', sans-serif;
  font-size: 13px;
  font-weight: 400;
  color: #2c2c2c;
  line-height: 1.45;
  word-break: break-word;
  white-space: pre-wrap;
}
</style>

{%- liquid
  assign _gem_handles_seen = ''
  assign _gem_handle_list = ''
-%}

{%- for item in cart.items -%}
  {%- for opt in item.product.options_with_values -%}
    {%- assign _opt_name_lc = opt.name | downcase | strip -%}
    {%- if _opt_name_lc == 'gemstone' -%}
      {%- for val in opt.values -%}
        {%- assign _val_handle = val | handle -%}
        {%- unless _gem_handles_seen contains _val_handle -%}
          {%- assign _gem_handles_seen = _gem_handles_seen | append: _val_handle | append: ',' -%}
          {%- assign _gem_handle_list = _gem_handle_list | append: _val_handle | append: ',' -%}
        {%- endunless -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endfor -%}
{%- endfor -%}

<script>
  window.__gemFileUrls = window.__gemFileUrls || {};
  {%- assign _gem_parts = _gem_handle_list | split: ',' -%}
  {%- for _gh in _gem_parts -%}
    {%- if _gh != '' -%}
      {%- assign _gem_file_name = _gh | append: '.png' -%}
      window.__gemFileUrls[{{ _gh | json }}] = {{ _gem_file_name | file_url | json }};
    {%- endif -%}
  {%- endfor -%}
</script>

