    /* ─────────────────────────────────────────────────────────────
       SVG BORDERS FOR EDIT PANEL VNODES
    ───────────────────────────────────────────────────────────── */
    var octSvgNormal = '<svg class="m-edit-vsvg" viewBox="0 0 38 38" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><polygon points="6,1 32,1 37,6 37,32 32,37 6,37 1,32 1,6" fill="none" stroke-linejoin="miter"/></svg>';
    var octSvgGemstone = '<svg class="m-edit-vsvg" viewBox="0 0 66 38" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><polygon points="6,1 60,1 65,6 65,32 60,37 6,37 1,32 1,6" fill="none" stroke-linejoin="miter"/></svg>';

    /* ─────────────────────────────────────────────────────────────
       EDIT PANEL STATE
    ───────────────────────────────────────────────────────────── */
    var currentEditKey = '';
    var currentEditQty = 1;
    var fetchedProduct = null;
    var activeVariantId = null;
    var activeVariantAvailable = true;

    /* ─────────────────────────────────────────────────────────────
       HELPERS
    ───────────────────────────────────────────────────────────── */
    function formatPrice(cents) {
      var n = parseInt(cents, 10);
      if (isNaN(n)) return String(cents);
      return '$' + (n / 100).toFixed(2);
    }

    function getImg(imgObj) {
      if (!imgObj) return '';
      if (typeof imgObj === 'string') return imgObj;
      return imgObj.src || imgObj.url || '';
    }

    function nameToHex(name) {
      var n = String(name).toLowerCase();
      if (n.indexOf('citrine') !== -1) return '#e49b0f';
      if (n.indexOf('moissanite') !== -1 || n.indexOf('diamond') !== -1) return '#e8f4fc';
      if (n.indexOf('ruby') !== -1) return '#c0392b';
      if (n.indexOf('emerald') !== -1) return '#1e8449';
      if (n.indexOf('sapphire') !== -1) return '#1a5276';
      if (n.indexOf('rose gold') !== -1 || n.indexOf('rose') !== -1) return '#E6A389';
      if (n.indexOf('yellow gold') !== -1 || n.indexOf('gold') !== -1) return '#D4A843';
      if (n.indexOf('silver') !== -1 || n.indexOf('rhodium') !== -1 || n.indexOf('platinum') !== -1) return '#E2E2E2';
      var map = { black:'#1a1a1a', white:'#f0f0f0', red:'#cc2200', blue:'#3355bb', green:'#336633', pink:'#f4b8c8', purple:'#7733aa', yellow:'#f5c800', amethyst:'#9b59b6', opal:'#f0e6d3' };
      return map[n.trim()] || '#e0e0e0';
    }

    function shopifyHandleize(str) {
      return String(str).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
    }

    function getGemFileUrl(val) {
      var handle = shopifyHandleize(val);
      var gemMap = window.__gemFileUrls || {};
      if (gemMap[handle]) return gemMap[handle];
      return '/files/' + handle + '.png';
    }

    function normaliseOptions(product) {
      var opts = product.options_with_values || product.options || [];
      return opts.map(function(o, idx) {
        if (typeof o === 'string') {
          var vals = [];
          (product.variants || []).forEach(function(v) { var ov = v['option' + (idx + 1)]; if (ov != null && vals.indexOf(ov) === -1) vals.push(ov); });
          return { name: o, position: idx + 1, values: vals };
        }
        return { name: o.name, position: o.position || idx + 1, values: o.values || [] };
      });
    }

    function getVariantOption(variant, pos) {
      if (variant['option' + pos] != null) return variant['option' + pos];
      if (variant.options && variant.options[pos - 1] != null) return variant.options[pos - 1];
      return '';
    }

    function findBestVariant(variants, options, targetPos, targetVal, refV) {
      var exact = variants.find(function(v) {
        return options.every(function(o) {
          if (o.position === targetPos) return getVariantOption(v, o.position) === targetVal;
          return getVariantOption(v, o.position) === getVariantOption(refV, o.position);
        });
      });
      if (exact) return exact;
      return variants.find(function(v) { return getVariantOption(v, targetPos) === targetVal; }) || null;
    }

    /* ─────────────────────────────────────────────────────────────
       REMOVE BUTTON — intercept in capture phase
    ───────────────────────────────────────────────────────────── */
    document.addEventListener('click', function(e) {
      var removeBtn = e.target.closest('.m-cart-item__remove');
      if (!removeBtn) return;
      e.preventDefault();
      e.stopPropagation();
      var lineItem = removeBtn.closest('.m-cart-item');
      if (!lineItem) return;
      document.querySelectorAll('.cs-remove-inline-overlay').forEach(function(el) { el.remove(); });
      var itemKey = lineItem.getAttribute('data-id') || removeBtn.getAttribute('data-id') || (removeBtn.closest('[data-id]') && removeBtn.closest('[data-id]').getAttribute('data-id')) || '';
      var itemLink = lineItem.querySelector('a[href*="/products/"]');
      var productHandle = '';
      if (itemLink) { var parts = itemLink.getAttribute('href').split('?')[0].split('/'); productHandle = parts[parts.length - 1]; }
      var productId = lineItem.getAttribute('data-product-id') || lineItem.getAttribute('data-id') || '';
      var productImgEl = lineItem.querySelector('.m-cart-item__image img') || lineItem.querySelector('img');
      var productImgSrc = productImgEl ? productImgEl.src : '';
      var alreadyWishlisted = isProductWishlisted(productId, productHandle);
      var wishlistBtnLabel = alreadyWishlisted ? 'ALREADY IN WISHLIST' : 'ADD TO WISHLIST';
      var wishlistBtnDisabled = alreadyWishlisted ? ' data-wishlisted="true"' : '';
      var overlay = document.createElement('div');
      overlay.className = 'cs-remove-inline-overlay';
      overlay.innerHTML =
        '<button class="cs-rm-close" aria-label="Close"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 6L6 18M6 6l12 12"/></svg></button>' +
        '<div class="cs-rm-content">' +
          '<div class="cs-rm-img-wrap"><img src="' + productImgSrc + '" alt="Product">' +
            '<svg class="cs-rm-oct-border" viewBox="0 0 68 68" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><polygon points="12.24,0 55.76,0 68,12.24 68,55.76 55.76,68 12.24,68 0,55.76 0,12.24" fill="none" stroke="#E8E2DC" stroke-width="1.5" stroke-linejoin="miter"/></svg>' +
          '</div>' +
          '<div class="cs-rm-text"><h3>Remove Item From Bag?</h3><p>Would you like to save this<br>item for later?</p></div>' +
        '</div>' +
        '<div class="cs-rm-actions">' +
          '<button type="button" class="cs-rm-btn cs-rm-btn-primary cs-rm-wishlist-btn"' + wishlistBtnDisabled + ' data-key="' + itemKey + '" data-handle="' + productHandle + '" data-product-id="' + productId + '">' + wishlistBtnLabel + '</button>' +
          '<button type="button" class="cs-rm-btn cs-rm-btn-secondary cs-rm-nothanks-btn" data-key="' + itemKey + '">NO THANKS</button>' +
        '</div>';
      lineItem.appendChild(overlay);
      requestAnimationFrame(function() { requestAnimationFrame(function() { overlay.classList.add('is-visible'); }); });
    }, true);

    /* ─────────────────────────────────────────────────────────────
       REMOVE OVERLAY ACTIONS
    ───────────────────────────────────────────────────────────── */
    document.addEventListener('click', function(e) {
      if (e.target.closest('.cs-remove-inline-overlay')) { e.preventDefault(); e.stopPropagation(); e.stopImmediatePropagation(); }

      if (e.target.closest('.cs-rm-close')) {
        var overlay = e.target.closest('.cs-remove-inline-overlay');
        if (overlay) { overlay.classList.remove('is-visible'); setTimeout(function() { overlay.remove(); }, 300); }
        return;
      }

      var noThanksBtn = e.target.closest('.cs-rm-nothanks-btn');
      if (noThanksBtn) {
        var key = noThanksBtn.getAttribute('data-key');
        if (!key) return;
        noThanksBtn.textContent = 'REMOVING…';
        noThanksBtn.style.opacity = '0.5';
        noThanksBtn.style.pointerEvents = 'none';
        fetch('/cart/change.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: key, quantity: 0 }) }).then(function() {
          document.documentElement.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true }));
          document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
        });
        return;
      }

      var wishlistBtn = e.target.closest('.cs-rm-wishlist-btn');
      if (wishlistBtn) {
        if (wishlistBtn.getAttribute('data-wishlisted') === 'true') return;
        var key = wishlistBtn.getAttribute('data-key');
        var handle = wishlistBtn.getAttribute('data-handle');
        var productId = wishlistBtn.getAttribute('data-product-id');
        if (!key) return;
        if (isProductWishlisted(productId, handle)) { wishlistBtn.textContent = 'ALREADY IN WISHLIST'; wishlistBtn.setAttribute('data-wishlisted', 'true'); return; }
        wishlistBtn.textContent = 'SAVING…';
        wishlistBtn.style.opacity = '0.5';
        wishlistBtn.style.pointerEvents = 'none';
        addToWishlistNative(handle, productId);
        fetch('/cart/change.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: key, quantity: 0 }) })
          .then(function(res) { return res.json(); })
          .then(function() {
            showWishlistToast('Saved to wishlist ♥');
            document.documentElement.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true }));
            document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
            var drawerElement = document.getElementById('MinimogCartDrawer');
            if (drawerElement) fetchAndRenderWishlist(drawerElement);
          })
          .catch(function() {
            showWishlistToast('Saved to wishlist ♥');
            document.documentElement.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true }));
            document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
          });
        return;
      }
    });

    /* ─────────────────────────────────────────────────────────────
       OPEN INLINE EDIT PANEL
    ───────────────────────────────────────────────────────────── */
    window.openEditModal = function(productHandle, lineItemKey, variantId, qty) {
      var panel = document.getElementById('CsInlineEditPanel');
      if (!panel) return;
      currentEditKey = lineItemKey;
      currentEditQty = qty;
      document.getElementById('cs-iep-inner').innerHTML = brandSpinnerHTML('normal');
      document.getElementById('cs-iep-inner').style.cssText = 'display:flex;flex:1;flex-direction:column;justify-content:center;align-items:center;';
      panel.classList.add('is-open');
      fetch('/products/' + productHandle + '.js')
        .then(function(r) { return r.json(); })
        .then(function(json) {
          fetchedProduct = json.product || json;
          var variants = fetchedProduct.variants || [];
          var currentV = variants.find(function(v) { return v.id === variantId; }) || variants[0];
          activeVariantId = currentV.id;
          activeVariantAvailable = !!currentV.available;
          renderPanelUI(currentV);
        })
        .catch(function() {
          document.getElementById('cs-iep-inner').innerHTML = '<p style="color:red;text-align:center;padding:20px;">Failed to load product.</p>';
        });
    };

    function renderPanelUI(selectedVariant) {
      var product = fetchedProduct;
      var variants = product.variants || [];
      var options = normaliseOptions(product);
      var firstV = selectedVariant || variants[0];
      var imgUrl = getImg(firstV.featured_image) || (product.media && product.media[0] && getImg(product.media[0].preview_image)) || (product.images && product.images[0]) || '';
      var priceStr = formatPrice(firstV.price);
      var onSale = firstV.compare_at_price && parseInt(firstV.compare_at_price, 10) > parseInt(firstV.price, 10);
      var compareStr = onSale ? '<span class="cs-iep-compare">$' + (parseInt(firstV.compare_at_price, 10) / 100).toFixed(2) + '</span>' : '';
      var selectedOptions = options.map(function(o) { return getVariantOption(firstV, o.position); });
      var materialImgMap = {};
      var materialOptPos = -1;
      options.forEach(function(o) { if (/material|metal|finish|plat/i.test(o.name)) materialOptPos = o.position; });
      if (materialOptPos > 0) {
        variants.forEach(function(v) {
          var matVal = getVariantOption(v, materialOptPos);
          var vImg = getImg(v.featured_image);
          if (matVal && !materialImgMap[matVal] && vImg) materialImgMap[matVal] = vImg;
        });
      }
      var hasMaterial = options.some(function(o) { return /material|metal|finish|plat/i.test(o.name); });
      var hasShape = options.some(function(o) { return /shape/i.test(o.name); });
      var orderedOptions = options.slice().sort(function(a, b) {
        function getRank(name) {
          var n = name.toLowerCase();
          if (hasMaterial) {
            if (/material|metal|finish|plat/i.test(n)) return 1;
            if (/gem|stone/i.test(n)) return 2;
            if (/size/i.test(n)) return 3;
            return 4;
          } else if (hasShape) {
            if (/gem|stone/i.test(n)) return 1;
            if (/shape/i.test(n)) return 2;
            if (/quantity/i.test(n)) return 3;
            return 4;
          }
          return 5;
        }
        return getRank(a.name) - getRank(b.name) || a.position - b.position;
      });
      var h = '';
      h += '<div class="cs-iep-header">';
      if (imgUrl) h += '<img class="cs-iep-header-img" id="cs-iep-img" src="' + imgUrl + '" alt="' + escHtml(product.title) + '">';
      h += '<div class="cs-iep-header-info">';
      h += '<h4 class="cs-iep-title">' + product.title + '</h4>';
      h += '<div class="cs-iep-price-row"><span class="cs-iep-price" id="cs-iep-price">' + priceStr + '</span>' + compareStr + '</div>';
      h += '<a href="' + (product.url || '/products/' + product.handle) + '" class="cs-iep-link" target="_blank">View Details</a>';
      h += '</div></div>';
      h += '<div class="cs-iep-body">';
      orderedOptions.forEach(function(opt) {
        var currentVal = selectedOptions[opt.position - 1];
        var isMaterial = /material|metal|finish|plat/i.test(opt.name);
        var isGemOpt = /gem|stone/i.test(opt.name);
        var isShape = /shape/i.test(opt.name);
        var renderAsSwatches = isMaterial || isGemOpt || (isShape && opt.values.some(function(val) { var mV = findBestVariant(variants, options, opt.position, val, firstV); return mV && getImg(mV.featured_image); }));
        h += '<div class="cs-iep-option-group" data-opt-pos="' + opt.position + '">';
        h += '<div class="cs-iep-option-label">' + opt.name + ': <strong id="cs-iep-ol-' + opt.position + '">' + currentVal + '</strong></div>';
        if (renderAsSwatches) {
          h += '<div class="m-edit-swatch-list">';
          opt.values.forEach(function(val) {
            var matchV = findBestVariant(variants, options, opt.position, val, firstV);
            var avail = matchV ? !!matchV.available : true;
            var active = val === currentVal ? ' is-selected' : '';
            var unavCls = !avail ? ' unavailable' : '';
            var optType = isGemOpt ? 'gemstone' : 'image';
            var imgSrc = '';
            if (isMaterial) imgSrc = materialImgMap[val] || (matchV ? getImg(matchV.featured_image) : '');
            else if (isGemOpt) imgSrc = getGemFileUrl(val);
            else if (isShape) imgSrc = matchV ? getImg(matchV.featured_image) : '';
            var bgStyle = imgSrc ? 'background-image: url(' + imgSrc + ');' : 'background-color: ' + nameToHex(val) + ';';
            h += '<div class="m-edit-vnode' + active + unavCls + '" data-option-type="' + optType + '" data-opt="' + opt.position + '" data-val="' + escHtml(val) + '" title="' + escHtml(val) + '">';
            h += '<div class="m-edit-vgap"><label class="m-edit-vlabel"';
            if (!isGemOpt) h += ' style="' + bgStyle + '"';
            h += '>';
            if (isGemOpt && imgSrc) h += '<img src="' + imgSrc + '" alt="' + escHtml(val) + '" onerror="this.style.display=\'none\'">';
            if (isGemOpt && !imgSrc) h += '<span style="display:block;width:100%;height:100%;background-color:' + nameToHex(val) + ';"></span>';
            h += '</label></div>';
            h += isGemOpt ? octSvgGemstone : octSvgNormal;
            h += '</div>';
          });
          h += '</div>';
        } else {
          h += '<div class="m-edit-size-list">';
          opt.values.forEach(function(val) {
            var matchV = findBestVariant(variants, options, opt.position, val, firstV);
            var avail = matchV ? !!matchV.available : true;
            var active = val === currentVal ? ' is-selected' : '';
            var unavCls = !avail ? ' unavailable' : '';
            h += '<div class="m-edit-vnode' + active + unavCls + '" data-option-type="button" data-opt="' + opt.position + '" data-val="' + escHtml(val) + '" title="' + escHtml(val) + (avail ? '' : ' (Sold Out)') + '">';
            h += '<div class="m-edit-vgap"><label class="m-edit-vlabel">' + val + '</label></div>';
            h += octSvgNormal;
            h += '</div>';
          });
          h += '</div>';
        }
        h += '</div>';
      });
      h += '</div>';
      h += '<div class="cs-iep-footer">';
      h += '<div class="cs-iep-delivery"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 18H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h3.19M15 6h2a2 2 0 0 1 2 2l4 4v6h-4M18 18h-4M5 18a2 2 0 1 0 4 0 2 2 0 0 0-4 0zm9 0a2 2 0 1 0 4 0 2 2 0 0 0-4 0z"/></svg>READY-TO-SHIP: DELIVERY WITHIN 7–14 WORKING DAYS</div>';
      h += '<button type="button" id="CsIepSaveBtn" class="cs-checkout-button" style="width:100%;" onclick="saveVariantUpdate()">UPDATE CART</button>';
      h += '</div>';
      var inner = document.getElementById('cs-iep-inner');
      inner.style.cssText = 'display:contents;';
      inner.innerHTML = h;
      bindPanelInteractions(variants, options, selectedOptions);
    }

    function bindPanelInteractions(variants, options, selectedOptions) {
      var panel = document.getElementById('CsInlineEditPanel');
      panel.querySelectorAll('[data-opt]').forEach(function(node) {
        node.addEventListener('click', function() {
          if (node.classList.contains('unavailable')) return;
          var pos = parseInt(node.getAttribute('data-opt'), 10);
          var val = node.getAttribute('data-val');
          panel.querySelectorAll('[data-opt="' + pos + '"]').forEach(function(b) { b.classList.remove('is-selected'); });
          node.classList.add('is-selected');
          var lbl = document.getElementById('cs-iep-ol-' + pos);
          if (lbl) lbl.textContent = val;
          selectedOptions[pos - 1] = val;
          var match = (fetchedProduct.variants || []).find(function(v) {
            return options.every(function(o, i) { return getVariantOption(v, o.position) === selectedOptions[i]; });
          });
          if (match) {
            activeVariantId = match.id;
            activeVariantAvailable = !!match.available;
            var priceEl = document.getElementById('cs-iep-price');
            if (priceEl) priceEl.textContent = formatPrice(match.price);
            var imgEl = document.getElementById('cs-iep-img');
            if (imgEl) { var matchImg = getImg(match.featured_image) || (fetchedProduct.media && fetchedProduct.media[0] && getImg(fetchedProduct.media[0].preview_image)) || ''; if (matchImg) imgEl.src = matchImg; }
          }
          updateUnavailableStates(panel, variants, options, selectedOptions);
        });
      });
    }

    function updateUnavailableStates(panel, variants, options, selected) {
      options.forEach(function(opt, idx) {
        panel.querySelectorAll('[data-opt="' + opt.position + '"]').forEach(function(node) {
          var val = node.getAttribute('data-val');
          var hypo = selected.slice();
          hypo[idx] = val;
          var matchV = variants.find(function(v) { return options.every(function(o, i) { return getVariantOption(v, o.position) === hypo[i]; }); });
          if (!matchV || !matchV.available) node.classList.add('unavailable');
          else node.classList.remove('unavailable');
        });
      });
    }

    /* ─────────────────────────────────────────────────────────────
       SAVE VARIANT UPDATE
    ───────────────────────────────────────────────────────────── */
    window.saveVariantUpdate = function() {
      var btn = document.getElementById('CsIepSaveBtn');
      if (!btn) return;
      if (!activeVariantId || !activeVariantAvailable) { alert('This combination is currently unavailable.'); return; }
      btn.textContent = 'UPDATING…';
      btn.style.opacity = '0.7';
      btn.style.pointerEvents = 'none';
      fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: activeVariantId, quantity: currentEditQty }) })
        .then(function() {
          return fetch('/cart/change.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: currentEditKey, quantity: 0 }) });
        })
        .then(function() { return fetch(window.location.pathname + '?section_id=cart-drawer'); })
        .then(function(res) { return res.text(); })
        .then(function(text) {
          var tmp = document.createElement('div');
          tmp.innerHTML = text;
          var newInner = tmp.querySelector('.m-cart-drawer__inner');
          if (newInner) document.querySelector('.m-cart-drawer__inner').innerHTML = newInner.innerHTML;
          closeEditPanel();
          document.documentElement.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true }));
          document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
        })
        .catch(function() {
          alert('Something went wrong. Please try again.');
          if (btn) { btn.textContent = 'UPDATE CART'; btn.style.opacity = '1'; btn.style.pointerEvents = 'auto'; }
        });
    };

    /* ─────────────────────────────────────────────────────────────
       CLOSE EDIT PANEL
    ───────────────────────────────────────────────────────────── */
    window.closeEditPanel = window.closeEditModal = function() {
      var panel = document.getElementById('CsInlineEditPanel');
      if (panel) panel.classList.remove('is-open');
    };

    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') window.closeEditPanel(); });

    /* ─────────────────────────────────────────────────────────────
       LEFT SIDEBAR ADD TO CART LOADING
    ───────────────────────────────────────────────────────────── */
    function setLeftSidebarLoading(btn) {
      if (!btn || btn.getAttribute('data-loading') === 'true') return;
      btn.setAttribute('data-loading', 'true');
      var originalHtml = btn.innerHTML;
      btn.setAttribute('data-original-html', originalHtml);
      var textSpan = btn.querySelector('span:not(.m-spinner-icon)') || btn;
      textSpan.textContent = 'ADDING...';
      btn.style.opacity = '0.6';
      btn.style.pointerEvents = 'none';
      showRightSideLoading();
      var resetBtn = function() {
        if (btn) { btn.innerHTML = btn.getAttribute('data-original-html'); btn.style.opacity = ''; btn.style.pointerEvents = ''; btn.removeAttribute('data-loading'); }
        hideRightSideLoading();
        document.documentElement.removeEventListener('cart:updated', resetBtn);
        document.documentElement.removeEventListener('cart:refresh', resetBtn);
      };
      document.documentElement.addEventListener('cart:updated', resetBtn);
      document.documentElement.addEventListener('cart:refresh', resetBtn);
      setTimeout(resetBtn, 3000);
    }

    document.addEventListener('click', function(e) {
      var btn = e.target.closest('.custom-cart-left .m-add-to-cart, .custom-cart-left .m-product-card__add-to-cart, .custom-cart-left button[name="add"]');
      if (btn) setLeftSidebarLoading(btn);
    }, true);

    document.addEventListener('submit', function(e) {
      var form = e.target;
      if (form.closest('.custom-cart-left') && form.action && form.action.indexOf('/cart/add') !== -1) {
        var btn = form.querySelector('button[type="submit"], button[name="add"]');
        if (btn) setLeftSidebarLoading(btn);
      }
    }, true);

  })();
</script>