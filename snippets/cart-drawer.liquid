              "
            >
              {{- cart.item_count -}}
              <span
                style="
                  position: absolute;
                  top: -2px;
                  right: -2px;
                  width: 7px;
                  height: 7px;
                  background-color: #111111;
                  border-radius: 50%;
                  border: 1.5px solid white;
                "
              ></span>
            </span>

            <div class="cart-info-wrapper">
              <div class="cart-info-icon">i</div>

              <div class="cart-info-popup">
                <div class="popup-section">
                  <div class="popup-section-title">
                    <span class="popup-section-num">1</span>
                    Bundle Types
                  </div>
                  <p><strong>Non-VIP Set Deal</strong></p>
                  <p>Save instantly on any 2 or 3-piece set.</p>
                  <p><em>Cannot be combined with Welcome Gift or other offers.</em></p>
                  <br>
                  <p><strong>VIP Bundle Benefits (Starlight &amp; Galaxy Tier)</strong></p>
                  <p>Get tier-based discounts when buying 3+ items.</p>
                  <p>Enjoy free gifts with qualifying bundle orders.</p>
                </div>

                <hr class="popup-divider">

                <div class="popup-section">
                  <div class="popup-section-title">
                    <span class="popup-section-num">2</span>
                    Limitations
                  </div>
                  <ul>
                    <li>Not valid on Final Sale, Limited-Time Offers, or if Welcome Gift is applied</li>
                    <li>Cannot combine with other discounts or bundles</li>
                    <li>Welcome Gift only applies to full-priced items</li>
                  </ul>
                </div>

                <hr class="popup-divider">

                <div class="popup-section">
                  <div class="popup-section-title">
                    <span class="popup-section-num">3</span>
                    Automatic Application
                  </div>
                  <ul>
                    <li>No codes needed. Discounts and gifts apply automatically based on your tier and items in cart.</li>
                    <li>Some Rewards like (Welcome Gift, Birthday Gift, or Galaxy cash credits) must be selected manually before checkout.</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>

          <p class="m-cart-drawer__text">
            <span class="m-cart-drawer__text-content">Enjoy FREE Shipping to
              {% if localization.country.name != blank %}
                {{ localization.country.name }}
              {% else %}
                your location
              {% endif -%}
              !
            </span>
            Discounts Applied. Enjoy a free 1 + 1 Any jewellery, plus Crystal on next order!
          </p>

          {% if template.name != 'cart' %}
            <foxkit-cart-countdown></foxkit-cart-countdown>
          {% endif %}

          <foxkit-cart-goal></foxkit-cart-goal>
        </div>

        <m-cart-items
          class="m-cart-drawer__body m-scrollbar--vertical m:flex m:flex-col m:flex-1"
          id="MinimogCartDrawerBody"
          data-section-name="cart-drawer"
        >
          <form
            is="m-cart-form"
            action="{{ routes.cart_url }}"
            method="post"
            id="cart-drawer-form"
            class="m:w-full"
            novalidate
          >
            {%- if cart.items.size > 0 -%}
              <div class="m-cart-drawer__items">
                {% for item in cart.items %}
                  {% render 'cart-drawer-item',
                    item: item,
                    gift_wrap_id: gift_wrap_id,
                    gift_wraps_in_cart: gift_wraps_in_cart,
                    items_in_cart: items_in_cart
                  %}
                {% endfor %}
              </div>

            {%- else -%}
              <div class="empty-cart">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" width="120" height="100">
                    <path d="M 46 45 V 30 C 46 16, 74 16, 74 30 V 45" fill="none" stroke="#2A2A2A" stroke-width="3" stroke-linecap="round" />
                  <path d="M 36 42
                             L 28 92
                             C 27.5 96.5, 30 99, 34 99
                             L 86 99
                             C 90 99, 92.5 96.5, 92 92
                             L 84 42
                             Z"
                          fill="none" stroke="#2A2A2A" stroke-width="3" stroke-linejoin="round" />
                    <circle cx="46" cy="46" r="4.5" fill="#2A2A2A" />
                    <circle cx="74" cy="46" r="4.5" fill="#2A2A2A" />
                    <text x="60" y="83" font-family="'Georgia', serif" font-size="36" font-weight="normal" text-anchor="middle" fill="#2A2A2A">S</text>
                </svg>
                <p>{{ 'cart.general.empty' | t }}</p>
              </div>
            {%- endif -%}
          </form>
        </m-cart-items>

        <div class="m-cart-drawer__footer" id="MinimogCartDrawerFooter">
          <div class="m-cart-drawer__footer--wrapper{% if cart == empty %} m:hidden{% else %} m:block{% endif %}">
            {% render 'cart-addons', form_id: 'cart-drawer-form' %}

            <div class="m-cart-drawer__gift-wrapping">
              <div class="m:hidden">{{ gift_wrapping.object.variants.first | json }}</div>

              {%- if gift_wrapping != null -%}
                <m-gift-wrapping-component
                  class="m-gift-wrapping"
                  data-gift-wrap-id="{{ gift_wrap_id }}"
                  data-gift-wrapping="{{ cart.attributes.gift-wrapping | escape }}"
                  cart-items-size="{{ cart.items.size }}"
                  gift-wraps-in-cart="{{ gift_wraps_in_cart }}"
                  items-in-cart="{{ items_in_cart }}"
                >
                  <input
                    id="m-gift-wrapping"
                    type="checkbox"
                    name="attributes[gift-wrapping]"
                    value="yes"
                    {% if gift_wraps_in_cart > 0 %}
                      checked="checked"
                    {% endif %}
                    class="m:visually-hidden"
                  >

                  <label for="m-gift-wrapping" class="m-gift-wrapping--label">
                    {%- capture gift_price -%}<strong class="m-gift-wrapping--price">{{ gift_wrapping.object.price | money }}</strong>{%- endcapture -%}
                    <span class="m-gift-wrapping--text">
                      {{- 'cart.general.gift_wrapping_html' | t: price: gift_price -}}
                    </span>

                    <div class="m-gift-wrapping--loading">
                      <div class="cs-brand-spinner cs-brand-spinner--sm">
                        <div class="cs-brand-spinner__ring">
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 160 167" fill="none">
                            <g clip-path="url(#gw_clip)">
                              <g transform="matrix(-0.08 -3.97575e-05 -3.97575e-05 0.08 80 80)">
                                <foreignObject x="-1013" y="-1013" width="2026.01" height="2026.01">
                                  <div xmlns="http://www.w3.org/1999/xhtml" style="background:conic-gradient(from 90deg,rgba(249,246,243,1) 0deg,rgba(44,44,44,1) 91.7308deg,rgba(44,44,44,1) 180deg,rgba(249,246,243,1) 360deg);height:100%;width:100%;opacity:1"></div>
                                </foreignObject>
                              </g>
                            </g>
                            <path d="M1 80C0.447708 80 -0.000656128 79.552 0.0062561 78.9998C0.199646 63.5264 4.87724 48.433 13.4824 35.5544C22.2729 22.3984 34.7672 12.1446 49.3853 6.08964C64.0034 0.0346267 80.0887 -1.54964 95.6072 1.53718C111.126 4.624 125.38 12.2433 136.569 23.4315C147.757 34.6197 155.376 48.8743 158.463 64.3928C161.55 79.9113 159.965 95.9966 153.91 110.615C147.855 125.233 137.602 137.727 124.446 146.518C111.567 155.123 96.4736 159.8 81.0002 159.994C80.448 160.001 80 159.552 80 159C80 158.448 80.448 158.001 81.0002 157.994C96.078 157.8 110.785 153.24 123.334 144.855C136.162 136.284 146.159 124.102 152.063 109.849C157.966 95.5967 159.511 79.9135 156.501 64.783C153.492 49.6524 146.063 35.7542 135.154 24.8457C124.246 13.9372 110.348 6.5084 95.217 3.49875C80.0865 0.489101 64.4033 2.03376 50.1507 7.9374C35.8981 13.841 23.7161 23.8385 15.1454 36.6655C6.75993 49.2152 2.19969 63.922 2.00641 78.9998C1.99933 79.552 1.55229 80 1 80Z" fill="#2C2C2C"/>
                            <defs><clipPath id="gw_clip"><path d="M1 80C0.447708 80 -0.000656128 79.552 0.0062561 78.9998C0.199646 63.5264 4.87724 48.433 13.4824 35.5544C22.2729 22.3984 34.7672 12.1446 49.3853 6.08964C64.0034 0.0346267 80.0887 -1.54964 95.6072 1.53718C111.126 4.624 125.38 12.2433 136.569 23.4315C147.757 34.6197 155.376 48.8743 158.463 64.3928C161.55 79.9113 159.965 95.9966 153.91 110.615C147.855 125.233 137.602 137.727 124.446 146.518C111.567 155.123 96.4736 159.8 81.0002 159.994C80.448 160.001 80 159.552 80 159C80 158.448 80.448 158.001 81.0002 157.994C96.078 157.8 110.785 153.24 123.334 144.855C136.162 136.284 146.159 124.102 152.063 109.849C157.966 95.5967 159.511 79.9135 156.501 64.783C153.492 49.6524 146.063 35.7542 135.154 24.8457C124.246 13.9372 110.348 6.5084 95.217 3.49875C80.0865 0.489101 64.4033 2.03376 50.1507 7.9374C35.8981 13.841 23.7161 23.8385 15.1454 36.6655C6.75993 49.2152 2.19969 63.922 2.00641 78.9998C1.99933 79.552 1.55229 80 1 80Z"/></clipPath></defs>
                          </svg>
                        </div>
                      </div>
                    </div>

                    <svg
                      class="m-gift-wrapping--icon"
                      viewBox="0 0 14 14"
                      with="16"
                      height="16"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <rect x="0.5" y="0.5" width="13" height="13" stroke="currentColor"/>
                      <path d="M3.5625 7.625L5.75 9.8125L10.75 4.8125" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </label>

                  {%- if gift_wraps_in_cart > 0 -%}
                    <m-gift-note-component class="m-gift-wrapping--note">
                      <textarea
                        class="form-field"
                        name="attributes[gift-note]"
                        placeholder="{{ 'cart.general.gift_note_placeholder' | t }}"
                      >{{ cart.attributes.gift-note }}</textarea>
                    </m-gift-note-component>
                  {%- endif -%}
                </m-gift-wrapping-component>
              {%- endif -%}
            </div>

            <div class="m-cart__summary m-cart-drawer__summary">
              <div data-foxkit-cart-summary></div>

              <div data-minimog-cart-discounts>
                {%- liquid
                  assign discount_codes = cart.cart_level_discount_applications | where: 'type', 'discount_code' | map: 'title'
                  assign cart_items_has_discount = false
                  for item in cart.items
                    for allocation in item.line_level_discount_allocations
                      if allocation.discount_application.type == 'discount_code'
                        assign cart_items_has_discount = true
                      endif
                    endfor
                  endfor
                -%}

                {%- if cart.cart_level_discount_applications.size > 0 or cart_items_has_discount -%}
                  <ul class="m-cart__discount m:flex m:flex-wrap m:justify-end m:items-center" role="list">
                    {%- for discount in cart.cart_level_discount_applications -%}
                      {% render 'cart-discount-item', discount: discount %}
                    {%- endfor -%}

                    {%- if cart_items_has_discount -%}
                      {%- for item in cart.items -%}
                        {%- for allocation in item.line_level_discount_allocations -%}
                          {%- liquid
                            unless allocation.discount_application.type == 'discount_code'
                              continue
                            endunless
                            assign discount = allocation.discount_application
                            assign is_displayed = discount_codes | has: discount.title
                            if is_displayed
                              continue
                            endif
                            assign discount_codes = item.line_level_discount_allocations | slice: forloop.index0 | map: 'discount_application' | map: 'title' | concat: discount_codes
                          -%}
                          {% render 'cart-discount-item', discount: discount %}
                        {%- endfor -%}
                      {%- endfor -%}
                    {%- endif -%}
                  </ul>
                {%- endif -%}
              </div>

              <div class="m-cart__subtotal m:flex m:justify-between" data-cart-subtotal>
                <span class="m-cart__subtotal--label m:font-medium">{{ 'cart.general.subtotal' | t }}</span>
                <span class="m-cart__subtotal--price m:font-medium" data-cart-subtotal-price>
                  {% if settings.currency_code_enabled %}
                    {{ cart.total_price | money_with_currency }}
                  {% else %}
                    {{ cart.total_price | money }}
                  {% endif %}
                </span>
              </div>
            </div>

            <div class="m:flex m:flex-col m:items-center">
              {% assign show_terms = false %}

              {% if settings.agree_text != blank and settings.show_agree_on_cart %}
                <div class="m-terms-conditons">
                  <label class="form-field--checkbox">
                    <input type="checkbox" name="agree_terms" value="yes" required>
                    <span class="form-field--checkbox__label">{{ settings.agree_text }}</span>
                    <span class="form-field--checkbox__icon">
                      <svg class="m-svg-icon--medium" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" fill="none" viewBox="0 0 20 20">
                        <path d="M18.5 1.5H1.5L1.5 18.5H18.5V1.5ZM1.5 0.5C0.947715 0.5 0.5 0.947715 0.5 1.5V18.5C0.5 19.0523 0.947715 19.5 1.5 19.5H18.5C19.0523 19.5 19.5 19.0523 19.5 18.5V1.5C19.5 0.947715 19.0523 0.5 18.5 0.5H1.5Z" fill-rule="evenodd" fill="currentColor"/>
                        <path d="M14.9975 6.09084C15.201 6.27746 15.2147 6.59375 15.0281 6.79728L8.91631 13.4627C8.82231 13.5652 8.68987 13.6239 8.55079 13.6247C8.41172 13.6256 8.27857 13.5684 8.18335 13.4671L4.99513 10.0731C4.80606 9.87179 4.81596 9.55536 5.01723 9.3663C5.21849 9.17723 5.53492 9.18713 5.72399 9.3884L8.54335 12.3897L14.291 6.12145C14.4776 5.91791 14.7939 5.90421 14.9975 6.09084Z" fill="currentColor"/>
                      </svg>
                    </span>
                  </label>
                </div>
                {% assign show_terms = true %}
              {% endif %}

              <button
                type="submit"
                form="cart-drawer-form"
                class="cs-checkout-button m:w-full"
                name="checkout"
                {% if show_terms %}
                  data-terms-action disabled
                {% endif %}
              >
                <span>{{ 'cart.general.checkout' | t }}</span>
              </button>

              {%- if settings.cart_drawer_show_accelerated_button and additional_checkout_buttons -%}
                <div class="additional-checkout-buttons m:w-full">
                  {{ content_for_additional_checkout_buttons }}
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</m-cart-drawer>

<div class="cs-wishlist-toast" id="CsWishlistToast">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
  </svg>
  <span id="CsWishlistToastMsg">Saved to wishlist</span>
</div>

<script>
  (function () {
    'use strict';

    /* ─────────────────────────────────────────────────────────────
       MESSAGE SUMMARY INJECTION
    ───────────────────────────────────────────────────────────── */
    function escHtml(str) {
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/"/g, '&quot;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');
    }

function injectMessageSummaries() {
  fetch('/cart.js')
    .then(function(r) { return r.json(); })
    .then(function(cart) {
      cart.items.forEach(function(item) {
        var props = item.properties || {};
        var msg  = (props['Message'] || '').trim();
        var from = (props['From']    || '').trim();

        if (!msg && !from) return;

        var lineEl =
          document.querySelector('[data-id="' + item.key + '"]') ||
          document.querySelector('[data-line-item-key="' + item.key + '"]') ||
          document.querySelector('.m-cart-item[data-variant-id="' + item.variant_id + '"]');

        if (!lineEl) return;
        if (lineEl.querySelector('.cs-msg-summary')) return;

        var isMessageCard = item.product_title &&
          item.product_title.toLowerCase().indexOf('message card') !== -1;

        if (isMessageCard) {

          /* ── HIDE variant lines ── */
          [
            '.m-cart-item__variant',
            '.m-cart-item__option',
            '.m-cart-item__options',
            '.m-cart-item__properties',
            '.m-cart-item__property',
            '[class*="variant"]',
            '[class*="option"]',
            '[class*="property"]'
          ].forEach(function(sel) {
            lineEl.querySelectorAll(sel).forEach(function(el) {
              el.style.display = 'none';
            });
          });

          /* ── HIDE edit button ── */
          [
            '.m-cart-item__edit',
            '.m-cart-item__edit-btn',
            '.m-cart-item__action--edit',
            '.cs-edit-btn',
            'button[onclick*="openEditModal"]',
            'button[onclick*="openEdit"]',
            'a[onclick*="openEditModal"]',
            'a[onclick*="openEdit"]'
          ].forEach(function(sel) {
            lineEl.querySelectorAll(sel).forEach(function(el) {
              el.style.display = 'none';
            });
          });

          /* ── Hide edit icon by checking for openEdit in onclick ── */
          lineEl.querySelectorAll('[class*="edit"]').forEach(function(el) {
            if (el.tagName === 'BUTTON' || el.tagName === 'A' ||
                el.querySelector('svg') ||
                (el.getAttribute('onclick') || '').indexOf('openEdit') !== -1) {
              el.style.display = 'none';
            }
          });
        }

        /* ── Build Message/From HTML ── */
        var html = '<div class="cs-msg-summary">';
        if (msg) {
          html += '<div class="cs-msg-row">'
            + '<span class="cs-msg-label">MESSAGE</span>'
            + '<span class="cs-msg-value">' + escHtml(msg) + '</span>'
            + '</div>';
        }
        if (from) {
          html += '<div class="cs-msg-row">'
            + '<span class="cs-msg-label">FROM</span>'
            + '<span class="cs-msg-value">' + escHtml(from) + '</span>'
            + '</div>';
        }
        html += '</div>';

        /* ── Inject after product title inside info column ── */
        var infoCol =
          lineEl.querySelector('.m-cart-item__info') ||
          lineEl.querySelector('.m-cart-item__details') ||
          lineEl.querySelector('.m-cart-item__content') ||
          lineEl.querySelector('[class*="cart-item__info"]') ||
          lineEl.querySelector('[class*="cart-item__detail"]');

        var titleEl = infoCol
          ? (
              infoCol.querySelector('.m-cart-item__title') ||
              infoCol.querySelector('.m-cart-item__name') ||
              infoCol.querySelector('a[href*="/products/"]') ||
              infoCol.querySelector('p, h4, h3, h2')
            )
          : (
              lineEl.querySelector('.m-cart-item__title') ||
              lineEl.querySelector('.m-cart-item__name') ||
              lineEl.querySelector('a[href*="/products/"]')
            );

        if (titleEl) {
          titleEl.insertAdjacentHTML('afterend', html);
        } else if (infoCol) {
          infoCol.insertAdjacentHTML('afterbegin', html);
        } else {
          lineEl.insertAdjacentHTML('beforeend', html);
        }
      });
    })
    .catch(function() {});
}

    /* Run on load */
    document.addEventListener('DOMContentLoaded', injectMessageSummaries);

    /* Re-run after every cart update/re-render */
    ['cart:updated', 'cart:refresh', 'cart:rendered'].forEach(function(ev) {
      document.documentElement.addEventListener(ev, function() {
        setTimeout(injectMessageSummaries, 400);
      });
    });

    /* Watch for DOM mutations inside the drawer body */
    var _msgObserver = new MutationObserver(function(mutations) {
      var relevant = mutations.some(function(m) {
        return m.target && m.target.closest && (
          m.target.closest('#MinimogCartDrawerBody') ||
          m.target.closest('.m-cart-drawer__items')
        );
      });
      if (relevant) setTimeout(injectMessageSummaries, 300);
    });

    function initMsgObserver() {
      var body = document.getElementById('MinimogCartDrawerBody');
      if (body) _msgObserver.observe(body, { childList: true, subtree: true });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMsgObserver);
    } else {
      initMsgObserver();
    }

    /* ─────────────────────────────────────────────────────────────
       BRAND SPINNER HTML HELPER
    ───────────────────────────────────────────────────────────── */
    var _spinnerCounter = 0;

    function brandSpinnerHTML(size) {
      var id = 'cs_spin_clip_' + (++_spinnerCounter);
      var wrapSize = size === 'sm' ? 'width:32px;height:32px;' : 'width:56px;height:56px;';
      return (
        '<div class="cs-brand-spinner" style="' + wrapSize + 'position:relative;display:flex;align-items:center;justify-content:center;flex-shrink:0;">' +
          '<div class="cs-brand-spinner__ring" style="position:absolute;top:0;left:0;width:100%;height:100%;animation:pageTransitionSpinner 1.5s linear infinite;transform-origin:center center;">' +
            '<svg xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%;" viewBox="0 0 160 167" fill="none">' +
              '<g clip-path="url(#' + id + ')" data-figma-skip-parse="true">' +
                '<g transform="matrix(-0.08 -3.97575e-05 -3.97575e-05 0.08 80 80)">' +
                  '<foreignObject x="-1013" y="-1013" width="2026.01" height="2026.01">' +
                    '<div xmlns="http://www.w3.org/1999/xhtml" style="background:conic-gradient(from 90deg,rgba(249, 246, 243, 1) 0deg,rgba(44, 44, 44, 1) 91.7308deg,rgba(44, 44, 44, 1) 180deg,rgba(249, 246, 243, 1) 360deg);height:100%;width:100%;opacity:1"></div>' +
                  '</foreignObject>' +
                '</g>' +
              '</g>' +
              '<path d="M1 80C0.447708 80 -0.000656128 79.552 0.0062561 78.9998C0.199646 63.5264 4.87724 48.433 13.4824 35.5544C22.2729 22.3984 34.7672 12.1446 49.3853 6.08964C64.0034 0.0346267 80.0887 -1.54964 95.6072 1.53718C111.126 4.624 125.38 12.2433 136.569 23.4315C147.757 34.6197 155.376 48.8743 158.463 64.3928C161.55 79.9113 159.965 95.9966 153.91 110.615C147.855 125.233 137.602 137.727 124.446 146.518C111.567 155.123 96.4736 159.8 81.0002 159.994C80.448 160.001 80 159.552 80 159C80 158.448 80.448 158.001 81.0002 157.994C96.078 157.8 110.785 153.24 123.334 144.855C136.162 136.284 146.159 124.102 152.063 109.849C157.966 95.5967 159.511 79.9135 156.501 64.783C153.492 49.6524 146.063 35.7542 135.154 24.8457C124.246 13.9372 110.348 6.5084 95.217 3.49875C80.0865 0.489101 64.4033 2.03376 50.1507 7.9374C35.8981 13.841 23.7161 23.8385 15.1454 36.6655C6.75993 49.2152 2.19969 63.922 2.00641 78.9998C1.99933 79.552 1.55229 80 1 80Z" fill="#2C2C2C"/>' +
