<m-cart-drawer id="MinimogCartDrawer" class="m-cart-drawer">
  <div class="m-cart__overlay"></div>

  <div class="custom-split-cart-layout m-cart-drawer__inner">
    <div class="custom-cart-left m-scrollbar--vertical">
      <div class="custom-cart-left-header">
        <h2 class="custom-cart-left-title">
          Add More<br>
          Glow with
        </h2>

        <div class="custom-cart-left-subtitle">
          <svg
            class="custom-hamburger-icon"
            width="14"
            height="10"
            viewBox="0 0 14 10"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path class="line-top"    d="M1 1H13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <path class="line-middle" d="M1 5H13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <path class="line-bottom" d="M1 9H13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>

          <span class="custom-subtitle-text">
            {% if settings.cart_recommendation_collection != blank %}
              {{ collections[settings.cart_recommendation_collection].title | default: 'RECENT VIEW' | upcase }}
            {% else %}
              RECENT VIEW
            {% endif %}
          </span>

          <div class="custom-collection-dropdown m-scrollbar--vertical">
            <ul class="custom-collection-list">
              <div class="custom-menu-category">For You</div>
              <li data-handle="default-recs">
                {% if settings.cart_recommendation_collection != blank %}
                  {{ collections[settings.cart_recommendation_collection].title | default: 'RECENT VIEW' | upcase }}
                {% else %}
                  RECENT VIEW
                {% endif %}
              </li>
              <li data-handle="wishlist-recs">WISHLIST</li>
              {%- assign drawer_menu = linklists['cart'] | default: linklists['cart-drawer-menu'] -%}
              {%- if drawer_menu != blank -%}
                {%- for link in drawer_menu.links -%}
                  <div class="custom-menu-category">{{ link.title }}</div>
                  {%- if link.links != blank -%}
                    {%- for childlink in link.links -%}
                      {%- assign c_handle = childlink.url | split: '/' | last | split: '?' | first -%}
                      <li data-handle="{{ c_handle }}">{{ childlink.title | upcase }}</li>
                    {%- endfor -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </ul>
          </div>
        </div>
      </div>

      <div class="custom-cart-recs">
        <div
          class="custom-cart-recs-tab"
          data-handle="default-recs"
          style="display: flex; flex-direction: column; gap: 24px;"
        >
          {%- liquid
            assign rec_count = 0
            if settings.cart_recommendation_collection != blank
              assign related_collection = collections[settings.cart_recommendation_collection]
            else
              assign related_collection = collections['all']
              if cart.items.size > 0
                for collection in cart.items.first.product.collections
                  if collection.handle != 'all' and collection.handle != 'frontpage'
                    assign related_collection = collection
                    break
                  endif
                endfor
              endif
            endif
          -%}

          {%- for product in related_collection.products -%}
            {%- assign in_cart = false -%}
            {%- for item in cart.items -%}
              {%- if item.product.id == product.id -%}
                {%- assign in_cart = true -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}

            {%- if in_cart == false and product.available -%}
              {% render 'product-card-3', product: product %}
              {%- assign rec_count = rec_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if rec_count < 2 and settings.cart_recommendation_collection == blank -%}
            {%- for product in collections['all'].products -%}
              {%- assign in_cart = false -%}
              {%- for item in cart.items -%}
                {%- if item.product.id == product.id -%}
                  {%- assign in_cart = true -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}

              {%- if in_cart == false and product.available -%}
                {% render 'product-card-3', product: product %}
                {%- assign rec_count = rec_count | plus: 1 -%}
              {%- endif -%}

              {%- if rec_count == 2 -%}{%- break -%}{%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </div>

        <div
          class="custom-cart-recs-tab"
          data-handle="wishlist-recs"
          style="display: none; flex-direction: column; gap: 24px;"
        ></div>

        {%- if drawer_menu != blank -%}
          {%- for link in drawer_menu.links -%}
            {%- if link.links != blank -%}
              {%- for childlink in link.links -%}
                {%- assign c_handle = childlink.url | split: '/' | last | split: '?' | first -%}
                {%- assign c = collections[c_handle] -%}
                {%- if c != blank and c.products.size > 0 -%}
                  <div
                    class="custom-cart-recs-tab"
                    data-handle="{{ c.handle }}"
                    style="display: none; flex-direction: column; gap: 24px;"
                  >
                    {%- for product in c.products limit: 12 -%}
                      {%- assign in_cart = false -%}
                      {%- for item in cart.items -%}
                        {%- if item.product.id == product.id -%}
                          {%- assign in_cart = true -%}
                          {%- break -%}
                        {%- endif -%}
                      {%- endfor -%}

                      {%- if in_cart == false and product.available -%}
                        {% render 'product-card-3', product: product %}
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    <div class="custom-cart-right m:h-full m-gradient m-color-{{ settings.drawer_popup_color_scheme }}">
      <div class="cs-inline-edit-panel" id="CsInlineEditPanel">
        <div class="cs-iep-topbar">
