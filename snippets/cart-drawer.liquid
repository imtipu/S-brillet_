    /* ─────────────────────────────────────────────────────────────
       SHARED WISHLIST STORAGE
    ───────────────────────────────────────────────────────────── */
    function getWishlistStorageKey() {
      return localStorage.getItem('minimog-wishlist') ? 'minimog-wishlist' : 'm-wishlist';
    }

    function getWishlistProductHandles() {
      try {
        var raw = localStorage.getItem('m-wishlist-products');
        var list = JSON.parse(raw);
        if (Array.isArray(list)) return list.filter(Boolean);
      } catch(_) {}
      return [];
    }

    function isProductWishlisted(productId, productHandle) {
      try {
        var idKey = getWishlistStorageKey();
        var idList = JSON.parse(localStorage.getItem(idKey) || '[]');
        var pid = String(productId || '');
        if (pid) {
          var byId = idList.some(function(item) {
            return String(item) === pid || String(item.id) === pid || String(item.product_id) === pid;
          });
          if (byId) return true;
        }
        if (productHandle) {
          var handleList = getWishlistProductHandles();
          return handleList.indexOf(productHandle) !== -1;
        }
      } catch(_) {}
      return false;
    }

    function triggerMinimogWishlistLiveRender(handle, action) {
      try {
        var wl = window.MinimogTheme && window.MinimogTheme.Wishlist;
        if (wl) {
          if (action === 'add') {
            if (wl.products instanceof Set) wl.products.add(handle);
            else if (Array.isArray(wl.products)) { if (wl.products.indexOf(handle) === -1) wl.products.push(handle); }
            if (typeof wl.saveToStorage === 'function') wl.saveToStorage(handle);
          } else {
            if (wl.products instanceof Set) wl.products.delete(handle);
            else if (Array.isArray(wl.products)) wl.products = wl.products.filter(function(h) { return h !== handle; });
          }
          if (typeof wl.render === 'function') wl.render();
          if (typeof wl.loadProducts === 'function') wl.loadProducts();
          if (typeof wl.renderProducts === 'function') wl.renderProducts();
          if (typeof wl.updateWishlistCount === 'function') wl.updateWishlistCount();
          if (typeof wl.setWishlistButtonsState === 'function') wl.setWishlistButtonsState();
          if (typeof wl.addEventToWishlistButtons === 'function') wl.addEventToWishlistButtons();
          if (typeof wl.init === 'function') wl.init();
        }
      } catch(_) {}
      try {
        var wishlistPageEl = document.querySelector('m-wishlist-page, [data-section-type="wishlist"], .m-wishlist-page');
        if (wishlistPageEl) {
          if (typeof wishlistPageEl.render === 'function') wishlistPageEl.render();
          if (typeof wishlistPageEl.loadProducts === 'function') wishlistPageEl.loadProducts();
          if (typeof wishlistPageEl.renderProducts === 'function') wishlistPageEl.renderProducts();
          if (typeof wishlistPageEl.init === 'function') wishlistPageEl.init();
        }
      } catch(_) {}
      try {
        var foxkitEl = document.querySelector('foxkit-wishlist, foxkit-wishlist-page');
        if (foxkitEl) {
          ['render','loadProducts','renderProducts','init','refresh'].forEach(function(m) {
            if (typeof foxkitEl[m] === 'function') try { foxkitEl[m](); } catch(_) {}
          });
        }
      } catch(_) {}
      try {
        var allHeartBtns = document.querySelectorAll('.m-wishlist-button[data-product-handle="' + handle + '"]');
        allHeartBtns.forEach(function(btn) {
          var isActive = btn.classList.contains('is-active') || btn.classList.contains('active') || btn.classList.contains('m-wishlist--active') || btn.classList.contains('added-to-wishlist');
          if (action === 'add' && !isActive) btn.click();
          if (action === 'remove' && isActive) btn.click();
        });
      } catch(_) {}
      try {
        var storageKey = getWishlistStorageKey();
        var storageVal = localStorage.getItem(storageKey);
        try {
          window.dispatchEvent(new StorageEvent('storage', { key: storageKey, newValue: storageVal, oldValue: storageVal, storageArea: localStorage, url: window.location.href }));
        } catch(_) { window.dispatchEvent(new Event('storage')); }
        try {
          var handleVal = localStorage.getItem('m-wishlist-products');
          window.dispatchEvent(new StorageEvent('storage', { key: 'm-wishlist-products', newValue: handleVal, oldValue: handleVal, storageArea: localStorage, url: window.location.href }));
        } catch(_) {}
      } catch(_) {}
      var eventsToFire = [
        ['wishlist:updated',             { bubbles: true, detail: { handle: handle, action: action } }],
        ['wishlist:changed',             { bubbles: true, detail: { handle: handle, action: action } }],
        ['wishlist:reinit',              { bubbles: true }],
        ['minimog:wishlist:init',        { bubbles: true }],
        ['minimog:wishlist:updated',     { bubbles: true, detail: { handle: handle } }],
        ['foxkit:wishlist:updated',      { bubbles: true, detail: { handle: handle } }],
        ['ajaxProduct:addedToWishlist',  { bubbles: true, detail: { handle: handle } }],
        ['theme:wishlist:updated',       { bubbles: true }],
      ];
      eventsToFire.forEach(function(pair) {
        try { document.dispatchEvent(new CustomEvent(pair[0], pair[1])); } catch(_) {}
        try { window.dispatchEvent(new CustomEvent(pair[0], pair[1])); } catch(_) {}
        try { document.documentElement.dispatchEvent(new CustomEvent(pair[0], pair[1])); } catch(_) {}
      });
      try {
        var wishlistSection = document.querySelector('[id^="shopify-section-"][id*="wishlist"]');
        if (wishlistSection) {
          var sectionId = wishlistSection.id.replace('shopify-section-', '');
          fetch(window.location.pathname + '?section_id=' + sectionId)
            .then(function(r) { return r.text(); })
            .then(function(html) {
              var tmp = document.createElement('div');
              tmp.innerHTML = html;
              var newGrid = tmp.querySelector('.m-wishlist__products, .m-wishlist-page__products, [data-wishlist-grid], .m-product-list');
              var curGrid = wishlistSection.querySelector('.m-wishlist__products, .m-wishlist-page__products, [data-wishlist-grid], .m-product-list');
              if (newGrid && curGrid) {
                curGrid.innerHTML = newGrid.innerHTML;
                try {
                  var wl2 = window.MinimogTheme && window.MinimogTheme.Wishlist;
                  if (wl2 && typeof wl2.updateWishlistCount === 'function') wl2.updateWishlistCount();
                  if (wl2 && typeof wl2.setWishlistButtonsState === 'function') wl2.setWishlistButtonsState();
                } catch(_) {}
              }
            }).catch(function() {});
        }
      } catch(_) {}
    }

    function addToWishlistNative(handle, productId) {
      if (!handle) return false;
      if (isProductWishlisted(productId, handle)) return false;
      try {
        var HANDLE_KEY = 'm-wishlist-products';
        var raw = localStorage.getItem(HANDLE_KEY);
        var list = [];
        try { list = JSON.parse(raw); } catch(_) {}
        if (!Array.isArray(list)) list = [];
        if (list.indexOf(handle) === -1) { list.push(handle); localStorage.setItem(HANDLE_KEY, JSON.stringify(list)); }
      } catch(_) {}
      if (productId) {
        try {
          var idKey = getWishlistStorageKey();
          var idRaw = localStorage.getItem(idKey);
          var idList = [];
          try { idList = JSON.parse(idRaw); } catch(_) {}
          if (!Array.isArray(idList)) idList = [];
          var pid = String(productId);
          var exists = idList.some(function(item) { return String(item) === pid || String(item.id) === pid || String(item.product_id) === pid; });
          if (!exists) { idList.push(pid); localStorage.setItem(idKey, JSON.stringify(idList)); }
        } catch(_) {}
      }
      triggerMinimogWishlistLiveRender(handle, 'add');
      return true;
    }

    function removeFromWishlistNative(handle, productId) {
      if (!handle) return;
      try {
        var HANDLE_KEY = 'm-wishlist-products';
        var list = JSON.parse(localStorage.getItem(HANDLE_KEY) || '[]');
        list = list.filter(function(h) { return h !== handle; });
        localStorage.setItem(HANDLE_KEY, JSON.stringify(list));
      } catch(_) {}
      if (productId) {
        try {
          var idKey = getWishlistStorageKey();
          var pid = String(productId);
          var idList = JSON.parse(localStorage.getItem(idKey) || '[]');
          idList = idList.filter(function(item) { return String(item) !== pid && String(item.id) !== pid && String(item.product_id) !== pid; });
          localStorage.setItem(idKey, JSON.stringify(idList));
        } catch(_) {}
      }
      triggerMinimogWishlistLiveRender(handle, 'remove');
      var drawerEl = document.getElementById('MinimogCartDrawer');
      if (drawerEl) fetchAndRenderWishlist(drawerEl);
    }

    /* ─────────────────────────────────────────────────────────────
       LIVE DYNAMIC WISHLIST TAB RENDER
    ───────────────────────────────────────────────────────────── */
    function fetchAndRenderWishlist(drawer) {
      var wishlistTab = drawer.querySelector('.custom-cart-recs-tab[data-handle="wishlist-recs"]');
      if (!wishlistTab) return;
      var list = getWishlistProductHandles();
      if (list.length === 0) {
        wishlistTab.innerHTML = '<div style="text-align:center; padding:32px 10px; color:#888; font-family:Inter,sans-serif; font-size:13px; line-height:1.4;">Your wishlist is empty.</div>';
        return;
      }
      wishlistTab.innerHTML = '<div style="display:flex; justify-content:center; padding:30px;">' + brandSpinnerHTML('sm') + '</div>';
      var promises = list.map(function(handle) {
        return fetch('/products/' + handle + '.js').then(function(res) { if (res.ok) return res.json(); return null; }).catch(function() { return null; });
      });
      Promise.all(promises).then(function(products) {
        var html = '';
        products.forEach(function(p) {
          if (!p) return;
          var featuredImg = p.featured_image || (p.images && p.images[0]) || '';
          var price = formatPrice(p.price);
          var _addVariant = null;
          if (p.variants && p.options) {
            _addVariant = p.variants.find(function(v) {
              if (!v.available) return false;
              return p.options.every(function(opt, i) { var val = v['option' + (i + 1)]; return val && String(val).trim() !== ''; });
            });
          }
          if (!_addVariant && p.variants) _addVariant = p.variants.find(function(v) { return v.available; });
          if (!_addVariant && p.variants && p.variants.length > 0) _addVariant = p.variants[0];
          html += '<div class="cs-wishlist-item-row">';
          if (featuredImg) html += '<img src="' + featuredImg + '" style="width:68px; height:68px; object-fit:contain; background:#fcfcfc; border:1px solid #f0f0f0; padding:4px; border-radius:4px;" alt="' + escHtml(p.title) + '">';
          html += '<div style="flex:1; display:flex; flex-direction:column; gap:2px; min-width:0;">';
          html += '<h4 style="margin:0; font-family:Inter,sans-serif; font-size:13px; font-weight:500; color:#2c2c2c; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">' + p.title + '</h4>';
          html += '<span style="font-family:Inter,sans-serif; font-size:13px; font-weight:600; color:#2c2c2c;">' + price + '</span>';
          html += '</div>';
          if (p.available && _addVariant) {
            html += '<button type="button" class="cs-rm-btn cs-rm-btn-primary" style="padding:7px 10px; font-size:10px; flex-shrink:0; max-width:fit-content; height:auto; min-height:0;" onclick="window.addWishlistItemToCart(' + _addVariant.id + ', this)">ADD TO BAG</button>';
          } else {
            html += '<span style="font-size:10px; color:#999; text-transform:uppercase; font-weight:500; padding-right:4px;">SOLD OUT</span>';
          }
          html += '</div>';
        });
        wishlistTab.innerHTML = html || '<div style="text-align:center; padding:32px 10px; color:#888; font-family:Inter,sans-serif; font-size:13px;">Your wishlist items are currently unavailable.</div>';
      });
    }

    window.addWishlistItemToCart = function(variantId, button) {
      if (!variantId) return;
      var originalText = button.textContent;
      button.textContent = 'ADDING…';
      button.style.pointerEvents = 'none';
      button.style.opacity = '0.6';
      showRightSideLoading();
      fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: variantId, quantity: 1 }) })
        .then(function() {
          button.textContent = 'ADDED';
          document.documentElement.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true }));
          document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
          return fetch(window.location.pathname + '?section_id=cart-drawer');
        })
        .then(function(res) { return res.text(); })
        .then(function(text) {
          var tmp = document.createElement('div');
          tmp.innerHTML = text;
          var currentRight = document.querySelector('.custom-cart-right');
          var newRight = tmp.querySelector('.custom-cart-right');
          if (currentRight && newRight) currentRight.innerHTML = newRight.innerHTML;
          button.textContent = originalText;
          button.style.pointerEvents = 'auto';
          button.style.opacity = '1';
          hideRightSideLoading();
        })
        .catch(function() {
          button.textContent = originalText;
          button.style.pointerEvents = 'auto';
          button.style.opacity = '1';
          hideRightSideLoading();
        });
    };

    /* ─────────────────────────────────────────────────────────────
       RECOMMENDATION TAB SWITCHING
    ───────────────────────────────────────────────────────────── */
    document.addEventListener('click', function(e) {
      var listItem = e.target.closest('.custom-collection-list li');
      if (!listItem) return;
      var drawer = listItem.closest('#MinimogCartDrawer');
      if (!drawer) return;
      var handle = listItem.getAttribute('data-handle');
      var title = listItem.innerText;
      var dropdown = drawer.querySelector('.custom-collection-dropdown');
      if (dropdown) { dropdown.style.display = 'none'; setTimeout(function() { dropdown.style.display = ''; }, 300); }
      var subtitleText = drawer.querySelector('.custom-subtitle-text');
      if (subtitleText) subtitleText.innerText = title;
      drawer.querySelectorAll('.custom-cart-recs-tab').forEach(function(tab) {
        tab.style.display = tab.getAttribute('data-handle') === handle ? 'flex' : 'none';
