{%- comment -%}
  Snippet: cs-preorder.liquid
  ---------------------------------------------------------------
  Renders a "Ready to ship" banner when the current/selected variant
  has stock (qty >= 1), or a "Preorder" banner with a configurable
  ship-window when it does not (qty <= 0 and inventory is tracked).

  Icons: uses the merchant-uploaded image if set in block settings,
  otherwise falls back to a built-in default SVG for each state.

  Expected params when rendering:
    {% render 'cs-preorder', block: block, product: product, section: section %}

  Requires this block type in main-product.liquid's schema:
    "type": "delivery_preorder"
  and this case in main-product-blocks.liquid:
    {% when 'delivery_preorder' %}
      {% render 'cs-preorder', block: block, product: product, section: section %}
{%- endcomment -%}

{%- liquid
  assign rk_variant = product.selected_or_first_available_variant

  assign rk_from_raw = block.settings.preorder_date_from
  assign rk_to_raw = block.settings.preorder_date_to
  assign rk_date_format = block.settings.preorder_date_format
  if rk_date_format == blank
    assign rk_date_format = '%b %d'
  endif

  assign rk_from_display = ''
  assign rk_to_display = ''
  if rk_from_raw != blank
    assign rk_from_display = rk_from_raw | date: rk_date_format
  endif
  if rk_to_raw != blank
    assign rk_to_display = rk_to_raw | date: rk_date_format
  endif

  assign rk_preorder_text = block.settings.preorder_text
  if rk_preorder_text == blank
    assign rk_preorder_text = 'PREORDER NOW — SHIPS BETWEEN [from] AND [to]'
  endif
  assign rk_preorder_text = rk_preorder_text | replace: '[from]', rk_from_display | replace: '[to]', rk_to_display

  assign rk_ready_text = block.settings.ready_text
  if rk_ready_text == blank
    assign rk_ready_text = 'READY-TO-SHIP: DELIVERY WITHIN 5–10 WORKING DAYS'
  endif
-%}

<style>
  .rk-delivery-banner-{{ block.id }} {
    background: {{ block.settings.background_color | default: '#F4F3F1' }};
    padding: 12px 20px;
    text-align: center;
    width: 100%;
    position: relative;
    z-index: 1;
  }
  .rk-delivery-banner-{{ block.id }} .rk-delivery-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    color: #2c2c2c;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    max-width: 100%;
    margin: 0 auto;
    flex-wrap: wrap;
  }
  .rk-delivery-banner-{{ block.id }} .rk-delivery-icon,
  .rk-delivery-banner-{{ block.id }} .rk-delivery-icon-svg {
    width: 23px;
    height: 20px;
    object-fit: contain;
    flex-shrink: 0;
    display: block;
  }
  .rk-delivery-banner-{{ block.id }} .rk-delivery-text {
    line-height: 1.4;
  }
  .rk-delivery-banner-{{ block.id }} [data-rk-state] {
    display: none;
  }
  .rk-delivery-banner-{{ block.id }} [data-rk-state].is-active {
    display: flex;
  }
  @media (max-width: 1470px) {
    .rk-delivery-banner-{{ block.id }} .rk-delivery-inner {
      font-size: 12px;
      gap: 8px;
    }
  }
  @media (max-width: 1280px) {
    .rk-delivery-banner-{{ block.id }} .rk-delivery-icon,
    .rk-delivery-banner-{{ block.id }} .rk-delivery-icon-svg {
      width: 16px;
      height: 16px;
    }
  }
  @media (max-width: 768px) {
    .rk-delivery-banner-{{ block.id }} {
      padding: 10px 12px;
    }
    .rk-delivery-banner-{{ block.id }} .rk-delivery-inner {
      font-size: 12px;
      gap: 6px;
    }
    .rk-delivery-banner-{{ block.id }} .rk-delivery-icon,
    .rk-delivery-banner-{{ block.id }} .rk-delivery-icon-svg {
      width: 20px;
      height: 18px;
    }
  }
</style>

<div
  class="rk-delivery-banner rk-delivery-banner-{{ block.id }}"
  data-rk-delivery-banner
  data-block-id="{{ block.id }}"
  data-section-id="{{ section.id }}"
  {{ block.shopify_attributes }}
>
  <div class="rk-delivery-inner" data-rk-state="ready">
    {%- if block.settings.ready_icon != blank -%}
      <img
        src="{{ block.settings.ready_icon | image_url: width: 46 }}"
        alt=""
        class="rk-delivery-icon"
        width="23"
        height="20"
        loading="lazy"
      >
    {%- else -%}
     
      <svg class="rk-delivery-icon-svg" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="23" height="20" viewBox="0 0 23 20" fill="none">
<rect width="23" height="20" fill="url(#pattern0_9945_7557)"/>
<defs>
<pattern id="pattern0_9945_7557" patternContentUnits="objectBoundingBox" width="1" height="1">
<use xlink:href="#image0_9945_7557" transform="matrix(0.0028169 0 0 0.00323944 0 0.00274648)"/>
</pattern>
<image id="image0_9945_7557" width="355" height="307" preserveAspectRatio="none" xlink:href="data:image/png;base64,"/>
</defs>
</svg>
    {%- endif -%}
    <span class="rk-delivery-text">{{ rk_ready_text }}</span>
  </div>

  <div class="rk-delivery-inner" data-rk-state="preorder">
    {%- if block.settings.preorder_icon != blank -%}
      <img
        src="{{ block.settings.preorder_icon | image_url: width: 46 }}"
        alt=""
        class="rk-delivery-icon"
        width="23"
        height="20"
        loading="lazy"
      >
    {%- else -%}
      
      <svg class="rk-delivery-icon-svg" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="23" height="20" viewBox="0 0 23 20" fill="none">
<rect width="23" height="20" fill="url(#pattern0_9945_7557)"/>
<defs>
<pattern id="pattern0_9945_7557" patternContentUnits="objectBoundingBox" width="1" height="1">
<use xlink:href="#image0_9945_7557" transform="matrix(0.0028169 0 0 0.00323944 0 0.00274648)"/>
</pattern>
<image id="image0_9945_7557" width="355" height="307" preserveAspectRatio="none" xlink:href="data:image/png;base64,"/>
</defs>
</svg>
    {%- endif -%}
    <span class="rk-delivery-text" data-rk-preorder-text>{{ rk_preorder_text }}</span>
  </div>
</div>

<script>
  (function () {
    var SECTION_ID = {{ section.id | json }};
    var BLOCK_ID = {{ block.id | json }};
    var PREORDER_TEMPLATE = {{ rk_preorder_text | json }};

    // Per-variant inventory map, built server-side so JS never has to
    // guess tracked-vs-untracked. Untracked variants (inventory_management
    // blank) are always treated as in stock.
    var RK_INVENTORY = {
      {%- for variant in product.variants -%}
        "{{ variant.id }}": {
          tracked: {{ variant.inventory_management | default: '' | size | plus: 0 | json }} > 0,
          qty: {{ variant.inventory_quantity | default: 0 | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    };

    function isInStock(variantId) {
      var entry = RK_INVENTORY[variantId];
      if (!entry) return true; // fallback: don't block rendering if unknown
      if (!entry.tracked) return true;
      return entry.qty >= 1;
    }

    function setState(wrapper, inStock) {
      var readyEl = wrapper.querySelector('[data-rk-state="ready"]');
      var preorderEl = wrapper.querySelector('[data-rk-state="preorder"]');
      if (!readyEl || !preorderEl) return;
      readyEl.classList.toggle('is-active', inStock);
      preorderEl.classList.toggle('is-active', !inStock);
    }

    function init() {
      var wrapper = document.querySelector(
        '.rk-delivery-banner-' + BLOCK_ID + '[data-section-id="' + SECTION_ID + '"]'
      );
      if (!wrapper) return;

      var productInfo = document.querySelector('product-info#MainProduct-' + SECTION_ID);

      function currentVariantId() {
        if (productInfo && productInfo.currentVariant && productInfo.currentVariant.id) {
          return String(productInfo.currentVariant.id);
        }
        var urlParams = new URLSearchParams(window.location.search);
        var vid = urlParams.get('variant');
        if (vid) return vid;
        // Fallback: first key in the map (server-selected default variant)
        var keys = Object.keys(RK_INVENTORY);
        return keys.length ? keys[0] : null;
      }

      function refresh() {
        var vid = currentVariantId();
        if (!vid) return;
        setState(wrapper, isInStock(vid));
      }

      refresh();

      if (productInfo) {
        productInfo.addEventListener('change', function () {
          setTimeout(refresh, 50);
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>