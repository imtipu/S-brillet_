{% comment %} {% comment %}
  Accepts:
  - product: {Object} Product (required)
  - show_variant_options: {Boolean} Show variant swatches at the bottom (optional)
  - hide_title: {String} Hide product title (optional)
  - image_ratio: {String} Product media ratio (optional)
  - pcard_alignment: {String} Product alignment (optional)
  - show_vendor: {Boolean} Show product vendor (optional)
  - show_cart_button: {Boolean} Show Add to cart button (optional)
  - show_quickview_button: {Boolean} Show Quickview button (optional)
  - show_wishlist_button: {Boolean} Show Wishlist button (optional)
  - show_compare_button: {Boolean} Show Compare button (optional)
  - column_wrapper: {Boolean} Wrap product card (optional)
  - remove_params: {Boolean} Remove url params (optional)

  Usage:
  {% render 'product-card-custom', product: product %}
{% endcomment %}

{% liquid
  if show_variant_options == null
    assign show_variant_options = settings.show_swatch_option
  endif
  if show_inventory == null
    assign show_inventory = settings.pcard_show_inventory
  endif

  assign show_title = true
  if hide_title == true
    assign show_title = false
  endif

  if image_ratio == null or image_ratio == blank
    assign image_ratio = settings.pcard_image_ratio | default: '1/1'
  endif

  if image_ratio == 'original'
    assign image_ratio = product.featured_image.aspect_ratio | default: '1/1'
  endif

  if show_vendor == null
    assign show_vendor = settings.show_vendor
  endif

  if show_desc == null
    assign show_desc = false
  endif

  assign sold_out = false
  if product.available == false
    assign sold_out = true
  endif

  assign discount = ''
  assign compare_at_price = product.compare_at_price
  assign price = product.price
  assign on_sale = false
  if compare_at_price > price
    assign on_sale = true
    assign discount = compare_at_price | minus: price | times: 100 | divided_by: compare_at_price
  endif

  assign show_on_sale_badge = false
  if settings.on_sale_badge != 'hide' and on_sale
    assign show_on_sale_badge = true
  endif

  assign quick_add_text = 'products.product.quick_add' | t
  unless product.has_only_default_variant
    capture quick_add_text
      render 'new-locale', key: 'products.product.select_options'
    endcapture
  endunless

  assign sold_number = product.metafields.foxkit.sold_number
  assign selected_variant = product.selected_or_first_available_variant

  if product.available
    assign variant_id = product.first_available_variant.id
  else
    assign variant_id = product.selected_or_first_available_variant.id
  endif
  assign selected_variant_id = ''
  if section.settings.change_product_variant_on_fitlering
    assign variant_id = product.selected_or_first_available_variant.id
    assign selected_variant_id = product.selected_variant.id
  endif

  if pcard_alignment == null
    assign pcard_alignment = settings.pcard_alignment
  endif

  assign pcard_default_image = settings.pcard_default_image
  if image_ratio == null or image_ratio == blank
    assign image_ratio = settings.pcard_image_ratio | default: '1/1'
  endif

  if show_cart_button == null
    assign show_cart_button = settings.show_cart_button
  endif

  if show_quickview_button == null
    assign show_quickview_button = settings.show_quickview_button
  endif

  if show_wishlist_button == null
    assign show_wishlist_button = settings.show_wishlist_button
  endif

  if show_compare_button == null
    assign show_compare_button = settings.show_compare_button
  endif

  assign preview_image = product.media[0].preview_image
  if section.settings.change_product_variant_on_fitlering == true and product.selected_variant.image != null
    assign preview_image = product.selected_variant.image
  endif

  if image_ratio == 'original'
    assign image_ratio = product.media[0].aspect_ratio | default: '1/1'
  endif

  assign second_image = ''
  if product.images.size > 1 and product.images[1] != blank
    assign second_image = product.images[1]
  endif

  assign product_card_classes = 'm-product-card m-product-card--style-custom'
  if sold_out
    assign product_card_classes = product_card_classes | append: ' m-product-card--soldout'
  endif
  if on_sale
    assign product_card_classes = product_card_classes | append: ' m-product-card--onsale'
  endif

  if second_image != blank
    assign product_card_classes = product_card_classes | append: ' m-product-card--has-second-img'
  endif

  assign product_url = product.url
  if remove_params
    assign product_url = product.url | split: '?' | first
  endif

  assign first_media_type = product.media.first.media_type

  assign show_video = false
  if settings.pcard_show_video and first_media_type == 'video'
    assign show_video = true
  endif

  assign loading = 'lazy'
  assign fetchpriority = 'low'
  if index == 1 and section_index <= 2
    assign loading = 'eager'
    assign fetchpriority = 'high'
  endif

  assign gemstone_metafield = product.metafields.custom.gemstone
  assign material_title = product.metafields.custom.meterial_title

  assign variant_img_1 = product.metafields.custom.variant_1
  assign variant_img_2 = product.metafields.custom.variant_2
  assign variant_img_3 = product.metafields.custom.variant_3
%}

{% unless pcard_custom_styles_rendered %}
{% assign pcard_custom_styles_rendered = true %}
<style>
  /* ==============================================
     PRODUCT CARD - Style Custom (Isolated Design)
  ============================================== */

  :root {
    --pcard-polygon: polygon(
      18% 0%, 82% 0%,
      100% 18%, 100% 82%,
      82% 100%, 18% 100%,
      0% 82%, 0% 18%
    );
    --phcard-polygon: polygon(
      18% 0%,
      82% 0%,
      100% 18%,
      100% 82%,
      82% 100%,
      18% 100%,
      0% 82%,
      0% 18%
    );
    --vcard-polygon: polygon(96.04% 69.5%,68.77% 96.34%,30.5% 96.04%,3.66% 68.77%,3.96% 30.5%,31.23% 3.66%,69.5% 3.96%,96.34% 31.23%,96.04% 69.5%);
  }

  /* ── Card shell ─────────────────────────────────────────────────────────── */
  .m-product-card--style-custom {
    position: relative;
    background: #fff;
    padding-bottom: 0 !important;
  }

  /* ── Media wrapper ──────────────────────────────────────────────────────── */
  .m-product-card--style-custom .m-product-card__media {
    position: relative;
    overflow: visible;
  }

  /* ── Image clip container ───────────────────────────────────────────────── */
  .m-product-card--style-custom .m-pcard-img-clip {
    position: relative;
    overflow: visible;
  }

  .m-product-card--style-custom .m-pcard-img-clip .m-product-card__link {
    display: block;
    overflow: hidden;
    position: relative;
    clip-path: polygon(1% 0%, 99% 0%, 100% 1%, 100% 99%, 99% 100%, 1% 100%, 0% 99%, 0% 1%);
    transition: clip-path 0.15s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Card hover OR direct image-area hover → apply polygon clip */
  .m-product-card--style-custom:hover .m-pcard-img-clip .m-product-card__link,
  .m-product-card--style-custom .m-pcard-img-clip:hover .m-product-card__link {
    clip-path: var(--pcard-polygon);
  }

  /* ── Image layers ───────────────────────────────────────────────────────── */
  .m-product-card--style-custom .m-product-card__main-image {
    position: relative;
    z-index: 1;
    width: 100%;
    transition: opacity 0.4s ease-in-out;
  }
  .m-product-card--style-custom .m-product-card__hover-image,
  .m-product-card--style-custom .m-product-card__second-image {
    position: absolute;
    inset: 0;
    width: 100%;
    opacity: 0;
    z-index: 2;
    transition: opacity 0.4s ease-in-out;
  }

  /* All img tags fill container with cover */
  .m-product-card--style-custom .m-product-card__main-image .m-image img,
  .m-product-card--style-custom .m-product-card__main-image responsive-image img,
  .m-product-card--style-custom .m-product-card__hover-image .m-image img,
  .m-product-card--style-custom .m-product-card__hover-image responsive-image img,
  .m-product-card--style-custom .m-product-card__second-image .m-image img,
  .m-product-card--style-custom .m-product-card__second-image responsive-image img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center !important;
    display: block;
  }

  /* CARD hover → show variant hover image */
  .m-product-card--style-custom:hover .m-product-card__main-image { opacity: 0; }
  .m-product-card--style-custom:hover .m-product-card__hover-image { opacity: 1; }

  /* IMAGE AREA hover → show 2nd product image (overrides card hover) */
  .m-product-card--style-custom.m-product-card--has-second-img .m-pcard-img-clip:hover .m-product-card__main-image  { opacity: 0 !important; }
  .m-product-card--style-custom.m-product-card--has-second-img .m-pcard-img-clip:hover .m-product-card__hover-image { opacity: 0 !important; }
  .m-product-card--style-custom.m-product-card--has-second-img .m-pcard-img-clip:hover .m-product-card__second-image { opacity: 1 !important; }

  /* ── SVG polygon border ───────────────────────────────────────────────── */
  .m-product-card--style-custom .m-pcard-polygon-border {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 5;
    overflow: visible;
    display: block;
    opacity: 0;
    transition: opacity 0.15s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .m-product-card--style-custom:hover .m-pcard-polygon-border,
  .m-product-card--style-custom .m-pcard-img-clip:hover .m-pcard-polygon-border {
    opacity: 1;
  }

  /* ── Wishlist ───────────────────────────────────────────────────────────── */
  .m-product-card--style-custom .m-pcard-wishlist-wrap {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 3;
  }
  .m-product-card--style-custom .m-pcard-wish-wrapper {
    position: relative;
    width: 16px;
    height: 16px;
    display: block;
    top: -10px;
    left: 9px;
  }
  .m-product-card--style-custom .m-pcard-wish-wrapper .m-tooltip,
  .m-product-card--style-custom .m-pcard-wish-wrapper > button {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
    margin: 0 !important;
    cursor: pointer !important;
    z-index: 2;
  }
  .m-product-card--style-custom .m-pcard-wish-wrapper .m-tooltip-icon,
  .m-product-card--style-custom .m-pcard-wish-wrapper .m-tooltip-icon--active,
  .m-product-card--style-custom .m-pcard-wish-wrapper .m-tooltip__content {
    display: none !important;
  }
  .m-product-card--style-custom .m-pcard-wish-wrapper .pcard-wish-icon-default,
  .m-product-card--style-custom .m-pcard-wish-wrapper .pcard-wish-icon-filled {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 1;
    transition: opacity 0.2s ease-in-out;
  }
  .m-product-card--style-custom .m-pcard-wish-wrapper .pcard-wish-icon-default svg,
  .m-product-card--style-custom .m-pcard-wish-wrapper .pcard-wish-icon-filled svg {
    width: 20px;
    height: 20px;
    display: block;
  }
  .m-product-card--style-custom .m-pcard-wish-wrapper .pcard-wish-icon-default { opacity: 1; }
  .m-product-card--style-custom .m-pcard-wish-wrapper .pcard-wish-icon-filled  { opacity: 0; }
  .m-product-card--style-custom .m-pcard-wish-wrapper:hover .pcard-wish-icon-default { opacity: 0; }
  .m-product-card--style-custom .m-pcard-wish-wrapper:hover .pcard-wish-icon-filled  { opacity: 1; }

  /* ── Badges ─────────────────────────────────────────────────────────────── */
  .m-product-card--style-custom .m-product-card__tags {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .m-product-card--style-custom .m-product-tag {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 2px;
  }
  .m-product-card--style-custom .m-product-tag--soldout {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 3;
  }

  /* ── Card info ──────────────────────────────────────────────────────────── */
  .m-product-card__info {
    padding: 0;
    text-align: left !important;
  }
  .m-product-card--style-custom .m-product-card__content {
    padding: 16px 0px !important;
    position: relative;
    text-align: left !important;
  }

  /* ── Gemstone ───────────────────────────────────────────────────────────── */
  .m-pcard-gemstone-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 4px;
  }
  .m-pcard-gemstone-item {
    width: 20px !important;
    height: 20px !important;
    overflow: hidden;
    cursor: default;
    pointer-events: none;
    flex-shrink: 0;
    clip-path: var(--pcard-polygon);
  }
  .m-pcard-gemstone-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Material title ─────────────────────────────────────────────────────── */
  .m-product-card--style-custom .m-pcard-material-title {
    font-size: 13px;
    font-weight: 400;
    color: #888;
    margin: 0 0 2px;
    line-height: 1.2;
    font-family: 'Inter', sans-serif !important;
  }

  /* ── Add to Bag ─────────────────────────────────────────────────────────── */
  .m-pcard-direct-add {
    height: 40px;
    background: #2C2C2C;
    color: #FFFFFF;
    font-size: 16px;
    font-weight: 300;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: background 0.3s;
    border-radius: 0px !important;
    border: none !important;
    box-shadow: none !important;
  }
  .m-pcard-direct-add:hover {
    background: linear-gradient(135deg, #947863, #E9DDD4, #947863) !important;
    color: #FFFF;
  }

  @media (max-width: 768px) {
    .m-product-card--style-custom .m-pcard-material-title {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .m-product-card--style-custom .m-pcard-wish-wrapper {
      position: relative;
      width: 16px;
      height: 16px;
      display: block;
      top: -10px !important;
      left: 10px !important;
    }
  }

  /* ── Vendor ─────────────────────────────────────────────────────────────── */
  .m-product-card--style-custom .m-product-card__vendor {
    display: block;
    font-size: 11px;
    color: #999;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 4px;
  }

  /* ── Title ──────────────────────────────────────────────────────────────── */
  .m-product-card--style-custom .m-product-card__title {
    margin: 0 0 8px;
    font-size: 17px;
    font-weight: 400;
    line-height: 1.3;
    font-family: 'Inter', sans-serif !important;
  }
  .m-product-card--style-custom .m-product-card__name {
    color: #222;
    text-decoration: none;
  }
  .m-product-card--style-custom .m-product-card__name:hover {
    text-decoration: underline;
  }

  /* ── Swatches ───────────────────────────────────────────────────────────── */
  .m-product-card--style-custom .m-product-card__option-wrapper {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 5px !important;
    align-items: center;
  }
  .m-product-card--style-custom .m-pcard-swatch-wrap {
    position: relative;
    width: 34px !important;
    height: 34px !important;
    flex-shrink: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    clip-path: var(--vcard-polygon);
    transition: background 0.4s ease-in-out;
  }
  .m-product-card--style-custom .m-pcard-swatch-wrap.is-selected {
    background: #222222;
  }
  .m-product-card--style-custom .m-pcard-swatch-wrap:not(.is-selected):hover {
    background: #aaa;
  }
  .m-product-card--style-custom .m-pcard-swatch-gap {
    position: absolute;
    inset: 1px;
    background: #fff;
    clip-path: var(--vcard-polygon);
    z-index: 1;
  }
  .m-product-card--style-custom .m-pcard-swatch-img-wrap {
    position: absolute;
    inset: 3px;
    z-index: 2;
    clip-path: var(--vcard-polygon);
    overflow: hidden;
    background: #eee;
  }
  .m-product-card--style-custom .m-pcard-swatch-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Price ──────────────────────────────────────────────────────────────── */
  .m-product-card--style-custom .m-product-card__price {
    margin-bottom: 0;
    font-size: 18px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding-bottom: 10px;
  }
  .m-product-card--style-custom .m-product-card__price .m-price,
  .m-product-card--style-custom .m-product-card__price .m-price-item--sale,
  .m-product-card--style-custom .m-product-card__price .m-price-item--regular:not(s) {
    font-weight: 400 !important;
    font-size: 18px !important;
    color: #222 !important;
  }
  .m-product-card--style-custom .m-product-card__price s.m-price-item--regular,
  .m-product-card--style-custom .m-product-card__price .m-price-item--regular s {
    font-size: 14px !important;
    color: #999 !important;
    text-decoration: line-through;
    font-weight: 400 !important;
  }
</style>
{% endunless %}

{%- if column_wrapper -%}<div class="m:column">{%- endif -%}
<div
  class="{{ product_card_classes }}{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}"
  data-view="card"
  {% if sold_number != blank %}data-sold-number="{{ sold_number }}"{% endif %}
  data-product-id="{{ product.id }}"
  {% if animated %}
    data-cascade
    style="--animation-order: {{ index }};"
  {% endif %}
>

  {%- comment -%}============ IMAGE BLOCK ============{%- endcomment -%}
  <div class="m-product-card__media">

    <div class="m-pcard-img-clip">

      <a class="m-product-card__link m:block m:w-full"
        href="{{ product_url }}"
        aria-label="{{ product.title | default: 'product title' }}"
      >
        {% if preview_image != blank or first_media_type == 'video' %}
          {% unless show_video %}

            {%- comment -%} IMG 1 - main image {%- endcomment -%}
            <div class="m-product-card__main-image" data-pcard-main-img>
              {%- liquid
                assign asp_rat = image_ratio | default: preview_image.aspect_ratio
                if asp_rat == 'original'
                  assign asp_rat = preview_image.aspect_ratio
                endif
                assign alt = alt | default: preview_image.alt | escape
              -%}
              {%- capture sizes -%}(min-width: {{ settings.container_width }}px) {{ settings.container_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2){%- endcapture -%}
              <responsive-image class="m-image" style="--aspect-ratio: {{ asp_rat }}">
                {{
                  preview_image
                  | image_url: width: 1100
                  | image_tag:
                    loading: loading,
                    fetchpriority: fetchpriority,
                    class: 'm:w-full m:h-full',
                    alt: alt,
                    sizes: sizes,
                    widths: '165, 360, 535, 750, 940, 1100'
                }}
              </responsive-image>
            </div>

            {%- comment -%} CARD HOVER layer {%- endcomment -%}
            <div class="m-product-card__hover-image" data-pcard-variant-hover-img aria-hidden="true">
              {%- liquid
                assign asp_rat_h = image_ratio | default: preview_image.aspect_ratio
                if asp_rat_h == 'original'
                  assign asp_rat_h = preview_image.aspect_ratio
                endif
              -%}
              <responsive-image class="m-image" style="--aspect-ratio: {{ asp_rat_h }}">
                <img
                  src="{{ preview_image | image_url: width: 1100 }}"
                  alt="{{ alt }}"
                  width="1100"
                  height="auto"
                  loading="lazy"
                  class="m:w-full m:h-full"
                  data-pcard-hover-img-el
                >
              </responsive-image>
            </div>

            {%- comment -%} IMAGE AREA HOVER layer {%- endcomment -%}
            {%- if second_image != blank -%}
              <div class="m-product-card__second-image">
                {%- liquid
                  assign asp_rat2 = image_ratio | default: second_image.aspect_ratio
                  if asp_rat2 == 'original'
                    assign asp_rat2 = second_image.aspect_ratio
                  endif
                  assign alt2 = second_image.alt | escape
                -%}
                {%- capture sizes -%}(min-width: {{ settings.container_width }}px) {{ settings.container_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2){%- endcapture -%}
                <responsive-image class="m-image" style="--aspect-ratio: {{ asp_rat2 }}">
                  {{
                    second_image
                    | image_url: width: 1100
                    | image_tag:
                      loading: 'lazy',
                      fetchpriority: 'low',
                      class: 'm:w-full m:h-full',
                      alt: alt2,
                      sizes: sizes,
                      widths: '165, 360, 535, 750, 940, 1100'
                  }}
                </responsive-image>
              </div>
            {%- endif -%}

          {% else %}
            <m-video-component
              class="m:block m-product-card__video"
              data-type="mp4"
              style="--aspect-ratio: {{ image_ratio }}"
            >
              {{
                product.media.first
                | media_tag:
                  image_size: '1500px',
                  autoplay: true,
                  loop: true,
                  controls: false,
                  muted: true,
                  playsinline: true
              }}
            </m-video-component>
          {% endunless %}

        {% else %}
          {% if pcard_default_image != blank %}
            {%- liquid
              assign asp_rat = image_ratio | default: pcard_default_image.aspect_ratio
              if asp_rat == 'original'
                assign asp_rat = pcard_default_image.aspect_ratio
              endif
              assign alt = pcard_default_image.alt | escape
            -%}
            {%- capture sizes -%}(min-width: {{ settings.container_width }}px) {{ settings.container_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2){%- endcapture -%}
            <responsive-image class="m-image" style="--aspect-ratio: {{ asp_rat }}">
              {{
                pcard_default_image
                | image_url: width: 1100
                | image_tag:
                  loading: loading,
                  fetchpriority: fetchpriority,
                  class: 'm:w-full m:h-full',
                  alt: alt,
                  sizes: sizes,
                  widths: '165, 360, 535, 750, 940, 1100'
              }}
            </responsive-image>
          {% else %}
            <div style="--aspect-ratio: {{ image_ratio }}">
              {{ 'product-1' | placeholder_svg_tag: 'm-placeholder-svg' }}
            </div>
          {% endif %}
        {% endif %}
      </a>

      <svg
        class="m-pcard-polygon-border"
        viewBox="0 0 100 100"
        preserveAspectRatio="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <defs>
          <linearGradient id="pcard-border-grad" x1="0%" y1="50%" x2="100%" y2="50%">
            <stop offset="0%"   stop-color="#E6D7CB"/>
            <stop offset="50%"  stop-color="#FFFFFF"/>
            <stop offset="100%" stop-color="#E6D7CB"/>
          </linearGradient>
        </defs>
        <polygon
          points="18,0 82,0 100,18 100,82 82,100 18,100 0,82 0,18"
          fill="none"
          stroke="url(#pcard-border-grad)"
          stroke-width="1.5"
          vector-effect="non-scaling-stroke"
          stroke-linejoin="miter"
          stroke-alignment="outer"
        />
      </svg>

    </div>
    {%- comment -%} end .m-pcard-img-clip {%- endcomment -%}

    {%- comment -%} Badges (top-left) {%- endcomment -%}
    <div class="m-product-card__tags">
      {% if settings.show_badge_sale %}
        {% for tag in product.tags %}
          {% if tag contains 'tag__' %}
            {%- liquid
              assign tag_content = tag | split: '__' | last
              assign type = tag_content | split: '_' | first
              assign tag_name = tag_content | split: '_' | last
              assign color_scheme_class = 'm-gradient m-color-'
              case type
                when 'sale':
                  assign color_scheme_class = color_scheme_class | append: settings.sale_badge_color_scheme
                when 'new':
                  assign color_scheme_class = color_scheme_class | append: settings.new_badge_color_scheme
                when 'hot':
                  assign color_scheme_class = color_scheme_class | append: settings.hot_badge_color_scheme
              endcase
            -%}
            <span class="m-product-card__tag-name m-product-tag m-product-tag--{{ type }} {{ color_scheme_class }}">
              {{- tag_name -}}
            </span>
          {% endif %}
        {% endfor %}
      {% endif %}

      {% assign custom_badge_class = 'm-product-card__tag-name m-product-tag m-product-tag--preorder m-gradient m-color-' | append: settings.preorder_badge_color_scheme %}
      {% capture foxkit_preorder_badge %}{% render 'foxkit-preorder-badge', product: product, static: true, custom_class: custom_badge_class %}{% endcapture %}
      {% unless foxkit_preorder_badge contains 'Liquid error' %}
        {{ foxkit_preorder_badge }}
      {% endunless %}

      {% if show_on_sale_badge %}
        <span class="m-product-card__tag-name m-product-tag m-product-tag--sale m-gradient m-color-{{ settings.sale_badge_color_scheme }}">
          {%- if settings.on_sale_badge == 'show_text' -%}
            {{ 'products.product.on_sale' | t }}
          {%- elsif settings.on_sale_badge == 'show_percentage' -%}
            {{ discount | append: '%' | prepend: '-' }}
          {%- endif -%}
        </span>
      {% endif %}
    </div>

    {%- comment -%} Sold-out badge {%- endcomment -%}
    {%- if settings.show_badge_soldout -%}
      <span
        class="m-product-tag m-product-tag--soldout m-gradient m-color-{{ settings.soldout_badge_color_scheme }}"
        {% unless sold_out %}style="display: none;"{% endunless %}
      >
        {{- 'products.product.sold_out' | t -}}
      </span>
    {%- endif -%}

    {%- comment -%} Wishlist heart (top-right) {%- endcomment -%}
    <div class="m-pcard-wishlist-wrap">
      {%- if show_wishlist_button -%}
        {% assign wishlist_app = settings.wishlist_app %}
        {% if wishlist_app == 'growave' %}
          <div class="m-tooltip m-wishlist-button m-button--icon m-tooltip--style-1">
            <span class="m-tooltip-icon m:block">
              {% comment %} theme-check-disable {% endcomment %}
              {% capture the_snippet_fave_icon %}{% render 'ssw-widget-faveicon' with product.id %}{% endcapture %}
              {% unless the_snippet_fave_icon contains 'Liquid error' %}
                {{ the_snippet_fave_icon }}
              {% else %}
                {% render 'mm-ssw-widget-faveicon' with product.id %}
              {% endunless %}
              {% comment %} theme-check-enable {% endcomment %}
            </span>
          </div>
        {% else %}
          <div class="m-pcard-wish-wrapper">
            {% render 'tooltip', type: 'wishlist', product: product, class_name: 'm-tooltip--left', style: 2 %}
            <span class="pcard-wish-icon-default" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#FFFF" stroke="#222222" stroke-width="0.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
              </svg>
            </span>
            <span class="pcard-wish-icon-filled" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#222222" stroke="#222222" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
              </svg>
            </span>
          </div>
        {% endif %}
      {%- else -%}
        <button type="button" aria-label="{{ 'products.product.add_to_wishlist' | t }}" class="m-pcard-wish-wrapper">
          <span class="pcard-wish-icon-default" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#222222" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </span>
          <span class="pcard-wish-icon-filled" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#222222" stroke="#222222" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </span>
        </button>
      {%- endif -%}
    </div>

    {%- comment -%} Countdown timer {%- endcomment -%}
    {% liquid
      assign metafields_time = product.metafields.global.minimog_countdown
      if settings.show_countdown and metafields_time != blank
        render 'countdown-timer', time: metafields_time, separator: false, short_label: true, extra_classes: 'm-product-card__countdown m:hidden'
      endif
    %}

  </div>
  {%- comment -%} end .m-product-card__media {%- endcomment -%}

  {%- comment -%}============ CONTENT BLOCK ============{%- endcomment -%}
  <div class="m-product-card__content m:text-{{ pcard_alignment }}">
    <div class="m-product-card__info">

      {%- comment -%} Gemstone picker {%- endcomment -%}
      {%- if gemstone_metafield != blank -%}
        <div class="m-pcard-gemstone-row">
          {%- for gemstone in gemstone_metafield.value -%}
            {%- liquid
              assign g_src = ''
              assign g_alt = ''
              if gemstone.preview_image != blank
                assign g_src = gemstone.preview_image | image_url: width: 60
                assign g_alt = gemstone.alt | escape
              elsif gemstone.image != blank
                assign g_src = gemstone.image | image_url: width: 60
                assign g_alt = gemstone.image.alt | escape
              elsif gemstone.src != blank
                assign g_src = gemstone | image_url: width: 60
                assign g_alt = gemstone.alt | escape
              endif
            -%}
            {%- if g_src != blank -%}
              <div class="m-pcard-gemstone-item" title="{{ g_alt }}">
                <img src="{{ g_src }}" alt="{{ g_alt }}" width="28" height="28" loading="lazy">
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%} Material title {%- endcomment -%}
      {%- if material_title != blank -%}
        <p class="m-pcard-material-title">{{ material_title.value }}</p>
      {%- endif -%}

      {%- comment -%} Vendor {%- endcomment -%}
      {%- if show_vendor -%}
        <span class="m-product-card__vendor">{{ product.vendor }}</span>
      {%- endif -%}

      {%- comment -%} Product title {%- endcomment -%}
      {% if show_title == true %}
        <h3 class="m-product-card__title">
          <a href="{{ product_url }}"
            class="m-product-card__name{% if settings.uppercase_prd_name %} m:uppercase{% endif %}"
          >
            {{ product.title }}
          </a>
        </h3>
      {% endif %}

      {%- comment -%} Reviews {%- endcomment -%}
      {% if settings.show_review_badge %}
        <div class="m-product-card__reviews m:text-color-body">
          {% render 'product-reviews-app__badge', product: product %}
        </div>
      {% endif %}

      {%- comment -%} Variant swatches {%- endcomment -%}
      {%- liquid
        assign v1_url = ''
        assign v2_url = ''
        assign v3_url = ''

        if variant_img_1 != blank
          if variant_img_1.value != blank
            assign v1_url = variant_img_1.value | image_url: width: 1100
          else
            assign v1_url = variant_img_1 | image_url: width: 1100
          endif
        endif

        if variant_img_2 != blank
          if variant_img_2.value != blank
            assign v2_url = variant_img_2.value | image_url: width: 1100
          else
            assign v2_url = variant_img_2 | image_url: width: 1100
          endif
        endif

        if variant_img_3 != blank
          if variant_img_3.value != blank
            assign v3_url = variant_img_3.value | image_url: width: 1100
          else
            assign v3_url = variant_img_3 | image_url: width: 1100
          endif
        endif
      -%}

      {%- capture swatch_meta_map -%}["{{ v1_url }}","{{ v2_url }}","{{ v3_url }}"]{% endcapture %}

      {% if product.has_only_default_variant == false and show_variant_options %}
        <div
          class="m-product-card__option-wrapper"
          data-pcard-swatches
          data-meta-imgs='{{ swatch_meta_map }}'
        >
          {%- liquid
            assign seen_options = ''
            assign swatch_index = 0
          -%}
          {%- for variant in product.variants -%}
            {%- liquid
              assign opt1 = variant.option1
              assign already_seen = false
              if seen_options contains opt1
                assign already_seen = true
              endif
            -%}
            {%- unless already_seen -%}
              {%- liquid
                assign seen_options = seen_options | append: opt1 | append: '|||'
                assign sv_src = ''
                if variant.featured_image != blank
                  assign sv_src = variant.featured_image | image_url: width: 120
                elsif variant.image != blank
                  assign sv_src = variant.image | image_url: width: 120
                endif
              -%}
              {%- if sv_src != blank -%}
                {%- comment -%} data-price, data-compare-price, data-currency added for JS price sync {%- endcomment -%}
                <div
                  class="m-pcard-swatch-wrap{% if swatch_index == 0 %} is-selected{% endif %}"
                  data-swatch-index="{{ swatch_index }}"
                  data-price="{{ variant.price }}"
                  data-compare-price="{{ variant.compare_at_price }}"
                  data-currency="{{ cart.currency.iso_code }}"
                  title="{{ opt1 | escape }}"
                  role="button"
                  tabindex="0"
                  aria-label="{{ opt1 | escape }}"
                >
                  <div class="m-pcard-swatch-gap"></div>
                  <div class="m-pcard-swatch-img-wrap">
                    <img
                      src="{{ sv_src }}"
                      alt="{{ opt1 | escape }}"
                      width="32"
                      height="32"
                      loading="lazy"
                      class="m-pcard-swatch-img"
                    >
                  </div>
                </div>
                {%- assign swatch_index = swatch_index | plus: 1 -%}
              {%- endif -%}
            {%- endunless -%}
            {%- if swatch_index >= 3 -%}{%- break -%}{%- endif -%}
          {%- endfor -%}
        </div>
      {%- elsif product.has_only_default_variant == false and show_variant_options -%}
        {% render 'product-card-option',
          product: product,
          show_variant_options: show_variant_options,
          pcard_alignment: pcard_alignment,
          context: context
        %}
      {% endif %}

      {%- comment -%} Price — data-pcard-price lets JS update it on swatch click {%- endcomment -%}
      <div class="m-product-card__price" data-pcard-price>
        {% render 'product-prices', product: product, is_product_card: true %}
      </div>

      {%- comment -%} Inventory {%- endcomment -%}
      {%- if show_inventory and selected_variant.inventory_management != blank -%}
        {%- liquid
          assign inventory_threshold = settings.low_inventory_threshold
          assign show_inventory_count = settings.show_inventory_count
          assign inventory_visibility = settings.inventory_visibility
          assign inventory_hide_backordered = settings.inventory_hide_backordered

          assign total = 0
          assign inventory_policy = ''
          for variant in product.variants
            if variant.inventory_quantity > 0
              assign total = total | plus: variant.inventory_quantity
            endif
            if variant.inventory_policy == 'continue'
              assign inventory_policy = 'continue'
            endif
          endfor

          if total <= 0
            if inventory_policy == 'continue'
              assign status = 'backordered'
            elsif product.available
              assign status = 'instock'
            else
              assign status = 'outofstock'
            endif
          elsif total <= inventory_threshold
            assign status = 'low'
          else
            assign status = 'normal'
          endif

          assign show = false
          if inventory_visibility == 'always'
            assign show = true
            if status == 'backordered' and inventory_hide_backordered
              assign show = false
            endif
          else
            if status == 'low'
              assign show = true
            endif
          endif

          if status == 'outofstock'
            assign show = false
          endif

          assign show_inventory_number = true
          if show_inventory_count == 'never' or total <= 0 or show_inventory_count == 'low_inventory' and status != 'low'
            assign show_inventory_number = false
          endif
        -%}
        {%- if show == true -%}
          <div class="m-product-inventory m-product-card__inventory m:text-sm" data-status="{{ status }}">
            <div class="m-product-inventory__inner">
              <span class="m-product-inventory__text">
                <span class="m-product-inventory__pin"></span>
                <span class="m-product-inventory__status">
                  {% liquid
                    case status
                      when 'backordered'
                        render 'new-locale', key: 'products.product.backordered'
                      when 'low'
                        if show_inventory_number
                          render 'new-locale', key: 'products.product.inventory_low_quantity_html', param: '{{ quantity }}', value: total
                        else
                          render 'new-locale', key: 'products.product.low_stock'
                        endif
                      else
                        if show_inventory_number
                          render 'new-locale', key: 'products.product.inventory_quantity_html', param: '{{ quantity }}', value: total
                        else
                          echo 'products.product.in_stock' | t
                        endif
                    endcase
                  %}
                </span>
              </span>
            </div>
          </div>
        {%- endif -%}
      {%- endif -%}

    </div>
    {%- comment -%} end .m-product-card__info {%- endcomment -%}

    {%- comment -%} Direct Add To Bag Button {%- endcomment -%}
    <div class="m-pcard-direct-add">
      <product-form>
        {%- assign product_form_id = 'product-form-' | append: product.id | append: '-' | append: section.id -%}
        {%- form 'product', product, id: product_form_id, class: 'm:w-full', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
          <input type="hidden" name="id" value="{{ variant_id }}">
          <button
            type="submit"
            name="add"
            class=" a m:w-full m:flex m:items-center m:justify-center"
          >
            <span class="m-product-btn-text">
              {%- if product.available -%}
                ADD TO BAG
              {%- else -%}
                {{ 'products.product.sold_out' | t }}
              {%- endif -%}
            </span>
          </button>
        {%- endform -%}
      </product-form>
    </div>

  </div>
  {%- comment -%} end .m-product-card__content {%- endcomment -%}

  <script>
  (function () {
    var card = document.currentScript.closest('[data-product-id]');
    if (!card) return;

    var swatchWrap  = card.querySelector('[data-pcard-swatches]');
    var hoverImgEl  = card.querySelector('[data-pcard-hover-img-el]');
    var mainImgWrap = card.querySelector('[data-pcard-main-img]');
    if (!mainImgWrap || !hoverImgEl) return;

    var mainImg = mainImgWrap.querySelector('img');
    if (!mainImg) return;

    var originalMainSrc    = mainImg.src;
    var originalMainSrcset = mainImg.srcset || '';

    var metaUrls = [];
    if (swatchWrap) {
      try {
        metaUrls = JSON.parse(swatchWrap.getAttribute('data-meta-imgs') || '[]');
      } catch (e) {}
    }

    /* ── Price sync ─────────────────────────────────────────────────────── */
    var priceEl = card.querySelector('[data-pcard-price]');

    function formatMoney(cents, currency) {
      if (!cents && cents !== 0) return '';
      if (window.Shopify && window.Shopify.formatMoney) {
        return window.Shopify.formatMoney(
          cents,
          window.theme && window.theme.moneyFormat ? window.theme.moneyFormat : '{{amount}}'
        );
      }
      var symbols = { USD: '$', EUR: '€', GBP: '£', CAD: 'CA$', AUD: 'A$' };
      var sym = symbols[currency] || (currency + ' ');
      return sym + (parseInt(cents, 10) / 100).toFixed(2);
    }

    function updatePrice(sw) {
      if (!priceEl) return;
      var price        = sw.getAttribute('data-price');
      var comparePrice = sw.getAttribute('data-compare-price');
      var currency     = sw.getAttribute('data-currency') || '';
      if (!price) return;

      var priceFmt   = formatMoney(price, currency);
      var compareFmt = comparePrice && parseInt(comparePrice, 10) > parseInt(price, 10)
                       ? formatMoney(comparePrice, currency)
                       : '';

      priceEl.innerHTML = compareFmt
        ? '<span class="m-price" style="font-weight:400;font-size:18px;color:#222;">' + priceFmt + '</span>'
          + '<span class="m-price m-price-item--regular" style="font-size:14px;color:#999;text-decoration:line-through;font-weight:400;">' + compareFmt + '</span>'
        : '<span class="m-price" style="font-weight:400;font-size:18px;color:#222;">' + priceFmt + '</span>';
    }
    /* ── end price sync ─────────────────────────────────────────────────── */

    if (swatchWrap) {
      var swatches = swatchWrap.querySelectorAll('.m-pcard-swatch-wrap');

      function activate(sw) {
        /* 1. Update active ring */
        swatches.forEach(function (s) { s.classList.remove('is-selected'); });
        sw.classList.add('is-selected');

        /* 2. Update hover image */
        var idx     = parseInt(sw.getAttribute('data-swatch-index'), 10);
        var metaUrl = (metaUrls && metaUrls[idx]) ? metaUrls[idx] : '';

        var swatchImg        = sw.querySelector('.m-pcard-swatch-img');
        var activeVariantSrc = metaUrl || (swatchImg ? swatchImg.src : '');
        if (activeVariantSrc) {
          hoverImgEl.src    = activeVariantSrc;
          hoverImgEl.srcset = '';
        }

        /* 3. Update price */
        updatePrice(sw);
      }

      swatches.forEach(function (sw) {
        sw.addEventListener('click', function (e) {
          e.preventDefault();
          activate(sw);
        });
        sw.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            activate(sw);
          }
        });
      });

      /* On load: sync hover image + price to first swatch */
      var firstSwatch = swatches[0];
      if (firstSwatch) {
        var firstMeta      = (metaUrls && metaUrls[0]) ? metaUrls[0] : '';
        var firstSwatchImg = firstSwatch.querySelector('.m-pcard-swatch-img');
        var firstSrc       = firstMeta || (firstSwatchImg ? firstSwatchImg.src : '');
        if (firstSrc) {
          hoverImgEl.src    = firstSrc;
          hoverImgEl.srcset = '';
        }
        updatePrice(firstSwatch);
      }
    } else {
      hoverImgEl.src    = originalMainSrc;
      hoverImgEl.srcset = originalMainSrcset;
    }
  })();
  </script>

</div>
{%- if column_wrapper -%}</div>{%- endif -%} {% endcomment %}


















{% comment %} 
{% comment %}
  Accepts:
  - product: {Object} Product (required)
  - show_variant_options: {Boolean} Show variant swatches at the bottom (optional)
  - hide_title: {String} Hide product title (optional)
  - image_ratio: {String} Product media ratio (optional)
  - pcard_alignment: {String} Product alignment (optional)
  - show_vendor: {Boolean} Show product vendor (optional)
  - show_cart_button: {Boolean} Show Add to cart button (optional)
  - show_quickview_button: {Boolean} Show Quickview button (optional)
  - show_wishlist_button: {Boolean} Show Wishlist button (optional)
  - show_compare_button: {Boolean} Show Compare button (optional)
  - column_wrapper: {Boolean} Wrap product card (optional)
  - remove_params: {Boolean} Remove url params (optional)

  Usage:
  {% render 'product-card-custom', product: product %}
{% endcomment %}

{% liquid
  if show_variant_options == null
    assign show_variant_options = settings.show_swatch_option
  endif
  if show_inventory == null
    assign show_inventory = settings.pcard_show_inventory
  endif

  assign show_title = true
  if hide_title == true
    assign show_title = false
  endif

  assign has_group_tag = false
  if product.tags contains 'group'
    assign has_group_tag = true
  endif

  if image_ratio == null or image_ratio == blank
    assign image_ratio = settings.pcard_image_ratio | default: '1/1'
  endif

  if image_ratio == 'original'
    if has_group_tag and product.images.size > 1 and product.images[1] != blank
      assign image_ratio = product.images[1].aspect_ratio | default: '1/1'
    else
      assign image_ratio = product.featured_image.aspect_ratio | default: '1/1'
    endif
  endif

  if show_vendor == null
    assign show_vendor = settings.show_vendor
  endif

  if show_desc == null
    assign show_desc = false
  endif

  assign sold_out = false
  if product.available == false
    assign sold_out = true
  endif

  assign discount = ''
  assign compare_at_price = product.compare_at_price
  assign price = product.price
  assign on_sale = false
  if compare_at_price > price
    assign on_sale = true
    assign discount = compare_at_price | minus: price | times: 100 | divided_by: compare_at_price
  endif

  assign show_on_sale_badge = false
  if settings.on_sale_badge != 'hide' and on_sale
    assign show_on_sale_badge = true
  endif

  assign quick_add_text = 'products.product.quick_add' | t
  unless product.has_only_default_variant
    capture quick_add_text
      render 'new-locale', key: 'products.product.select_options'
    endcapture
  endunless

  assign sold_number = product.metafields.foxkit.sold_number
  assign selected_variant = product.selected_or_first_available_variant

  if product.available
    assign variant_id = product.first_available_variant.id
  else
    assign variant_id = product.selected_or_first_available_variant.id
  endif
  assign selected_variant_id = ''
  if section.settings.change_product_variant_on_fitlering
    assign variant_id = product.selected_or_first_available_variant.id
    assign selected_variant_id = product.selected_variant.id
  endif

  if pcard_alignment == null
    assign pcard_alignment = settings.pcard_alignment
  endif

  assign pcard_default_image = settings.pcard_default_image
  if image_ratio == null or image_ratio == blank
    assign image_ratio = settings.pcard_image_ratio | default: '1/1'
  endif

  if show_cart_button == null
    assign show_cart_button = settings.show_cart_button
  endif

  if show_quickview_button == null
    assign show_quickview_button = settings.show_quickview_button
  endif

  if show_wishlist_button == null
    assign show_wishlist_button = settings.show_wishlist_button
  endif

  if show_compare_button == null
    assign show_compare_button = settings.show_compare_button
  endif

  assign preview_image = product.media[0].preview_image

  if has_group_tag and product.images.size > 1 and product.images[1] != blank
    assign preview_image = product.images[1]
  endif

  if section.settings.change_product_variant_on_fitlering == true and product.selected_variant.image != null
    assign preview_image = product.selected_variant.image
  endif

  if image_ratio == 'original'
    assign image_ratio = product.media[0].aspect_ratio | default: '1/1'
  endif

  assign second_image = ''
  if product.images.size > 1 and product.images[1] != blank
    assign second_image = product.images[1]
  endif

  assign product_card_classes = 'm-product-card m-product-card--style-custom'
  if sold_out
    assign product_card_classes = product_card_classes | append: ' m-product-card--soldout'
  endif
  if on_sale
    assign product_card_classes = product_card_classes | append: ' m-product-card--onsale'
  endif

  if second_image != blank
    assign product_card_classes = product_card_classes | append: ' m-product-card--has-second-img'
  endif

  assign product_url = product.url
  if remove_params
    assign product_url = product.url | split: '?' | first
  endif

  assign first_media_type = product.media.first.media_type

  assign show_video = false
  if settings.pcard_show_video and first_media_type == 'video'
    assign show_video = true
  endif

  assign loading = 'lazy'
  assign fetchpriority = 'low'
  if index == 1 and section_index <= 2
    assign loading = 'eager'
    assign fetchpriority = 'high'
  endif

  assign gemstone_metafield = product.metafields.custom.gemstone
  assign material_title = product.metafields.custom.meterial_title

  assign variant_img_1 = product.metafields.custom.variant_1
  assign variant_img_2 = product.metafields.custom.variant_2
  assign variant_img_3 = product.metafields.custom.variant_3
%}

{% unless pcard_custom_styles_rendered %}
{% assign pcard_custom_styles_rendered = true %}
<style>
  /* ==============================================
     PRODUCT CARD - Style Custom (Isolated Design)
  ============================================== */

  :root {
    --pcard-polygon: polygon(
      18% 0%, 82% 0%,
      100% 18%, 100% 82%,
      82% 100%, 18% 100%,
      0% 82%, 0% 18%
    );
    --phcard-polygon: polygon(
      18% 0%,
      82% 0%,
      100% 18%,
      100% 82%,
      82% 100%,
      18% 100%,
      0% 82%,
      0% 18%
    );
    --vcard-polygon: polygon(96.04% 69.5%,68.77% 96.34%,30.5% 96.04%,3.66% 68.77%,3.96% 30.5%,31.23% 3.66%,69.5% 3.96%,96.34% 31.23%,96.04% 69.5%);
  }

  /* ── Card shell ─────────────────────────────────────────────────────────── */
  .m-product-card--style-custom {
    position: relative;
    background: #fff;
    padding-bottom: 0 !important;
  }

  /* ── Media wrapper ──────────────────────────────────────────────────────── */
  .m-product-card--style-custom .m-product-card__media {
    position: relative;
    overflow: visible;
  }

  /* ── Image clip container ───────────────────────────────────────────────── */
  .m-product-card--style-custom .m-pcard-img-clip {
    position: relative;
    overflow: visible;
  }

  .m-product-card--style-custom .m-pcard-img-clip .m-product-card__link {
    display: block;
    overflow: hidden;
    position: relative;
    clip-path: polygon(1% 0%, 99% 0%, 100% 1%, 100% 99%, 99% 100%, 1% 100%, 0% 99%, 0% 1%);
    transition: clip-path 0.15s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Card hover OR direct image-area hover → apply polygon clip */
  .m-product-card--style-custom:hover .m-pcard-img-clip .m-product-card__link,
  .m-product-card--style-custom .m-pcard-img-clip:hover .m-product-card__link {
    clip-path: var(--pcard-polygon);
  }

  /* ── Image layers ───────────────────────────────────────────────────────── */
  .m-product-card--style-custom .m-product-card__main-image {
    position: relative;
    z-index: 1;
    width: 100%;
    transition: opacity 0.4s ease-in-out;
  }
  .m-product-card--style-custom .m-product-card__hover-image,
  .m-product-card--style-custom .m-product-card__second-image {
    position: absolute;
    inset: 0;
    width: 100%;
    opacity: 0;
    z-index: 2;
    transition: opacity 0.4s ease-in-out;
  }

  /* All img tags fill container with cover */
  .m-product-card--style-custom .m-product-card__main-image .m-image img,
  .m-product-card--style-custom .m-product-card__main-image responsive-image img,
  .m-product-card--style-custom .m-product-card__hover-image .m-image img,
  .m-product-card--style-custom .m-product-card__hover-image responsive-image img,
  .m-product-card--style-custom .m-product-card__second-image .m-image img,
  .m-product-card--style-custom .m-product-card__second-image responsive-image img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center !important;
    display: block;
  }

  /* CARD hover → show variant hover image */
  .m-product-card--style-custom:hover .m-product-card__main-image { opacity: 0; }
  .m-product-card--style-custom:hover .m-product-card__hover-image { opacity: 1; }

  /* IMAGE AREA hover → show 2nd product image (overrides card hover) */
  .m-product-card--style-custom.m-product-card--has-second-img .m-pcard-img-clip:hover .m-product-card__main-image  { opacity: 0 !important; }
  .m-product-card--style-custom.m-product-card--has-second-img .m-pcard-img-clip:hover .m-product-card__hover-image { opacity: 0 !important; }
  .m-product-card--style-custom.m-product-card--has-second-img .m-pcard-img-clip:hover .m-product-card__second-image { opacity: 1 !important; }

  /* ── SVG polygon border ───────────────────────────────────────────────── */
  .m-product-card--style-custom .m-pcard-polygon-border {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 5;
    overflow: visible;
    display: block;
    opacity: 0;
    transition: opacity 0.15s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .m-product-card--style-custom:hover .m-pcard-polygon-border,
  .m-product-card--style-custom .m-pcard-img-clip:hover .m-pcard-polygon-border {
    opacity: 1;
  }

  /* ── Wishlist ───────────────────────────────────────────────────────────── */
  .m-product-card--style-custom .m-pcard-wishlist-wrap {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 3;
  }
  .m-product-card--style-custom .m-pcard-wish-wrapper {
    position: relative;
    width: 16px;
    height: 16px;
    display: block;
    top: -10px;
    left: 9px;
  }
  .m-product-card--style-custom .m-pcard-wish-wrapper .m-tooltip,
  .m-product-card--style-custom .m-pcard-wish-wrapper > button {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
    margin: 0 !important;
    cursor: pointer !important;
    z-index: 2;
  }
  .m-product-card--style-custom .m-pcard-wish-wrapper .m-tooltip-icon,
  .m-product-card--style-custom .m-pcard-wish-wrapper .m-tooltip-icon--active,
  .m-product-card--style-custom .m-pcard-wish-wrapper .m-tooltip__content {
    display: none !important;
  }
  .m-product-card--style-custom .m-pcard-wish-wrapper .pcard-wish-icon-default,
  .m-product-card--style-custom .m-pcard-wish-wrapper .pcard-wish-icon-filled {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 1;
    transition: opacity 0.2s ease-in-out;
  }
  .m-product-card--style-custom .m-pcard-wish-wrapper .pcard-wish-icon-default svg,
  .m-product-card--style-custom .m-pcard-wish-wrapper .pcard-wish-icon-filled svg {
    width: 20px;
    height: 20px;
    display: block;
  }
  .m-product-card--style-custom .m-pcard-wish-wrapper .pcard-wish-icon-default { opacity: 1; }
  .m-product-card--style-custom .m-pcard-wish-wrapper .pcard-wish-icon-filled  { opacity: 0; }
  .m-product-card--style-custom .m-pcard-wish-wrapper:hover .pcard-wish-icon-default { opacity: 0; }
  .m-product-card--style-custom .m-pcard-wish-wrapper:hover .pcard-wish-icon-filled  { opacity: 1; }

  /* ── Badges ─────────────────────────────────────────────────────────────── */
  .m-product-card--style-custom .m-product-card__tags {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .m-product-card--style-custom .m-product-tag {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 2px;
  }
  .m-product-card--style-custom .m-product-tag--soldout {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 3;
  }

  /* ── Card info ──────────────────────────────────────────────────────────── */
  .m-product-card__info {
    padding: 0;
    text-align: left !important;
  }
  .m-product-card--style-custom .m-product-card__content {
    padding: 16px 0px !important;
    position: relative;
    text-align: left !important;
  }

  /* ── Gemstone ───────────────────────────────────────────────────────────── */
  .m-pcard-gemstone-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 4px;
  }
  .m-pcard-gemstone-item {
    width: 20px !important;
    height: 20px !important;
    overflow: hidden;
    cursor: default;
    pointer-events: none;
    flex-shrink: 0;
    clip-path: var(--pcard-polygon);
  }
  .m-pcard-gemstone-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Material title ─────────────────────────────────────────────────────── */
  .m-product-card--style-custom .m-pcard-material-title {
    font-size: 13px;
    font-weight: 400;
    color: #888;
    margin: 0 0 2px;
    line-height: 1.2;
    font-family: 'Inter', sans-serif !important;
  }

  /* ── Add to Bag ─────────────────────────────────────────────────────────── */
  .m-pcard-direct-add {
    height: 40px;
    background: #2C2C2C;
    color: #FFFFFF;
    font-size: 16px;
    font-weight: 300;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: background 0.3s;
    border-radius: 0px !important;
    border: none !important;
    box-shadow: none !important;
  }
  .m-pcard-direct-add:hover {
    background: linear-gradient(135deg, #947863, #E9DDD4, #947863) !important;
    color: #FFFF;
  }

  @media (max-width: 768px) {
    .m-product-card--style-custom .m-pcard-material-title {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .m-product-card--style-custom .m-pcard-wish-wrapper {
      position: relative;
      width: 16px;
      height: 16px;
      display: block;
      top: -10px !important;
      left: 10px !important;
    }
  }

  /* ── Vendor ─────────────────────────────────────────────────────────────── */
  .m-product-card--style-custom .m-product-card__vendor {
    display: block;
    font-size: 11px;
    color: #999;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 4px;
  }

  /* ── Title ──────────────────────────────────────────────────────────────── */
  .m-product-card--style-custom .m-product-card__title {
    margin: 0 0 8px;
    font-size: 17px;
    font-weight: 400;
    line-height: 1.3;
    font-family: 'Inter', sans-serif !important;
  }
  .m-product-card--style-custom .m-product-card__name {
    color: #222;
    text-decoration: none;
  }
  .m-product-card--style-custom .m-product-card__name:hover {
    text-decoration: underline;
  }

  /* ── Swatches ───────────────────────────────────────────────────────────── */
  .m-product-card--style-custom .m-product-card__option-wrapper {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 5px !important;
    align-items: center;
  }
  .m-product-card--style-custom .m-pcard-swatch-wrap {
    position: relative;
    width: 34px !important;
    height: 34px !important;
    flex-shrink: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    clip-path: var(--vcard-polygon);
    transition: background 0.4s ease-in-out;
  }
  .m-product-card--style-custom .m-pcard-swatch-wrap.is-selected {
    background: #222222;
  }
  .m-product-card--style-custom .m-pcard-swatch-wrap:not(.is-selected):hover {
    background: #aaa;
  }
  .m-product-card--style-custom .m-pcard-swatch-gap {
    position: absolute;
    inset: 1px;
    background: #fff;
    clip-path: var(--vcard-polygon);
    z-index: 1;
  }
  .m-product-card--style-custom .m-pcard-swatch-img-wrap {
    position: absolute;
    inset: 3px;
    z-index: 2;
    clip-path: var(--vcard-polygon);
    overflow: hidden;
    background: #eee;
  }
  .m-product-card--style-custom .m-pcard-swatch-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Price ──────────────────────────────────────────────────────────────── */
  .m-product-card--style-custom .m-product-card__price {
    margin-bottom: 0;
    font-size: 18px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding-bottom: 10px;
  }
  .m-product-card--style-custom .m-product-card__price .m-price,
  .m-product-card--style-custom .m-product-card__price .m-price-item--sale,
  .m-product-card--style-custom .m-product-card__price .m-price-item--regular:not(s) {
    font-weight: 400 !important;
    font-size: 18px !important;
    color: #222 !important;
  }
  .m-product-card--style-custom .m-product-card__price s.m-price-item--regular,
  .m-product-card--style-custom .m-product-card__price .m-price-item--regular s {
    font-size: 14px !important;
    color: #999 !important;
    text-decoration: line-through;
    font-weight: 400 !important;
  }
</style>
{% endunless %}

{%- if column_wrapper -%}<div class="m:column">{%- endif -%}
<div
  class="{{ product_card_classes }}{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}"
  data-view="card"
  {% if sold_number != blank %}data-sold-number="{{ sold_number }}"{% endif %}
  data-product-id="{{ product.id }}"
  {% if animated %}
    data-cascade
    style="--animation-order: {{ index }};"
  {% endif %}
>

  {%- comment -%}============ IMAGE BLOCK ============{%- endcomment -%}
  <div class="m-product-card__media">

    <div class="m-pcard-img-clip">

      <a class="m-product-card__link m:block m:w-full"
        href="{{ product_url }}"
        aria-label="{{ product.title | default: 'product title' }}"
      >
        {% if preview_image != blank or first_media_type == 'video' %}
          {% unless show_video %}

            {%- comment -%} IMG 1 - main image {%- endcomment -%}
            <div class="m-product-card__main-image" data-pcard-main-img>
              {%- liquid
                assign asp_rat = image_ratio | default: preview_image.aspect_ratio
                if asp_rat == 'original'
                  assign asp_rat = preview_image.aspect_ratio
                endif
                assign alt = alt | default: preview_image.alt | escape
              -%}
              {%- capture sizes -%}(min-width: {{ settings.container_width }}px) {{ settings.container_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2){%- endcapture -%}
              <responsive-image class="m-image" style="--aspect-ratio: {{ asp_rat }}">
                {{
                  preview_image
                  | image_url: width: 1100
                  | image_tag:
                    loading: loading,
                    fetchpriority: fetchpriority,
                    class: 'm:w-full m:h-full',
                    alt: alt,
                    sizes: sizes,
                    widths: '165, 360, 535, 750, 940, 1100'
                }}
              </responsive-image>
            </div>

            {%- comment -%} CARD HOVER layer {%- endcomment -%}
            <div class="m-product-card__hover-image" data-pcard-variant-hover-img aria-hidden="true">
              {%- liquid
                assign asp_rat_h = image_ratio | default: preview_image.aspect_ratio
                if asp_rat_h == 'original'
                  assign asp_rat_h = preview_image.aspect_ratio
                endif
              -%}
              <responsive-image class="m-image" style="--aspect-ratio: {{ asp_rat_h }}">
                <img
                  src="{{ preview_image | image_url: width: 1100 }}"
                  alt="{{ alt }}"
                  width="1100"
                  height="auto"
                  loading="lazy"
                  class="m:w-full m:h-full"
                  data-pcard-hover-img-el
                >
              </responsive-image>
            </div>

            {%- comment -%} IMAGE AREA HOVER layer {%- endcomment -%}
            {%- if second_image != blank -%}
              <div class="m-product-card__second-image">
                {%- liquid
                  assign asp_rat2 = image_ratio | default: second_image.aspect_ratio
                  if asp_rat2 == 'original'
                    assign asp_rat2 = second_image.aspect_ratio
                  endif
                  assign alt2 = second_image.alt | escape
                -%}
                {%- capture sizes -%}(min-width: {{ settings.container_width }}px) {{ settings.container_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2){%- endcapture -%}
                <responsive-image class="m-image" style="--aspect-ratio: {{ asp_rat2 }}">
                  {{
                    second_image
                    | image_url: width: 1100
                    | image_tag:
                      loading: 'lazy',
                      fetchpriority: 'low',
                      class: 'm:w-full m:h-full',
                      alt: alt2,
                      sizes: sizes,
                      widths: '165, 360, 535, 750, 940, 1100'
                  }}
                </responsive-image>
              </div>
            {%- endif -%}

          {% else %}
            <m-video-component
              class="m:block m-product-card__video"
              data-type="mp4"
              style="--aspect-ratio: {{ image_ratio }}"
            >
              {{
                product.media.first
                | media_tag:
                  image_size: '1500px',
                  autoplay: true,
                  loop: true,
                  controls: false,
                  muted: true,
                  playsinline: true
              }}
            </m-video-component>
          {% endunless %}

        {% else %}
          {% if pcard_default_image != blank %}
            {%- liquid
              assign asp_rat = image_ratio | default: pcard_default_image.aspect_ratio
              if asp_rat == 'original'
                assign asp_rat = pcard_default_image.aspect_ratio
              endif
              assign alt = pcard_default_image.alt | escape
            -%}
            {%- capture sizes -%}(min-width: {{ settings.container_width }}px) {{ settings.container_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2){%- endcapture -%}
            <responsive-image class="m-image" style="--aspect-ratio: {{ asp_rat }}">
              {{
                pcard_default_image
                | image_url: width: 1100
                | image_tag:
                  loading: loading,
                  fetchpriority: fetchpriority,
                  class: 'm:w-full m:h-full',
                  alt: alt,
                  sizes: sizes,
                  widths: '165, 360, 535, 750, 940, 1100'
              }}
            </responsive-image>
          {% else %}
            <div style="--aspect-ratio: {{ image_ratio }}">
              {{ 'product-1' | placeholder_svg_tag: 'm-placeholder-svg' }}
            </div>
          {% endif %}
        {% endif %}
      </a>

      <svg
        class="m-pcard-polygon-border"
        viewBox="0 0 100 100"
        preserveAspectRatio="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <defs>
          <linearGradient id="pcard-border-grad" x1="0%" y1="50%" x2="100%" y2="50%">
            <stop offset="0%"   stop-color="#E6D7CB"/>
            <stop offset="50%"  stop-color="#FFFFFF"/>
            <stop offset="100%" stop-color="#E6D7CB"/>
          </linearGradient>
        </defs>
        <polygon
          points="18,0 82,0 100,18 100,82 82,100 18,100 0,82 0,18"
          fill="none"
          stroke="url(#pcard-border-grad)"
          stroke-width="1.5"
          vector-effect="non-scaling-stroke"
          stroke-linejoin="miter"
          stroke-alignment="outer"
        />
      </svg>

    </div>
    {%- comment -%} end .m-pcard-img-clip {%- endcomment -%}

    {%- comment -%} Badges (top-left) {%- endcomment -%}
    <div class="m-product-card__tags">
      {% if settings.show_badge_sale %}
        {% for tag in product.tags %}
          {% if tag contains 'tag__' %}
            {%- liquid
              assign tag_content = tag | split: '__' | last
              assign type = tag_content | split: '_' | first
              assign tag_name = tag_content | split: '_' | last
              assign color_scheme_class = 'm-gradient m-color-'
              case type
                when 'sale':
                  assign color_scheme_class = color_scheme_class | append: settings.sale_badge_color_scheme
                when 'new':
                  assign color_scheme_class = color_scheme_class | append: settings.new_badge_color_scheme
                when 'hot':
                  assign color_scheme_class = color_scheme_class | append: settings.hot_badge_color_scheme
              endcase
            -%}
            <span class="m-product-card__tag-name m-product-tag m-product-tag--{{ type }} {{ color_scheme_class }}">
              {{- tag_name -}}
            </span>
          {% endif %}
        {% endfor %}
      {% endif %}

      {% assign custom_badge_class = 'm-product-card__tag-name m-product-tag m-product-tag--preorder m-gradient m-color-' | append: settings.preorder_badge_color_scheme %}
      {% capture foxkit_preorder_badge %}{% render 'foxkit-preorder-badge', product: product, static: true, custom_class: custom_badge_class %}{% endcapture %}
      {% unless foxkit_preorder_badge contains 'Liquid error' %}
        {{ foxkit_preorder_badge }}
      {% endunless %}

      {% if show_on_sale_badge %}
        <span class="m-product-card__tag-name m-product-tag m-product-tag--sale m-gradient m-color-{{ settings.sale_badge_color_scheme }}">
          {%- if settings.on_sale_badge == 'show_text' -%}
            {{ 'products.product.on_sale' | t }}
          {%- elsif settings.on_sale_badge == 'show_percentage' -%}
            {{ discount | append: '%' | prepend: '-' }}
          {%- endif -%}
        </span>
      {% endif %}
    </div>

    {%- comment -%} Sold-out badge {%- endcomment -%}
    {%- if settings.show_badge_soldout -%}
      <span
        class="m-product-tag m-product-tag--soldout m-gradient m-color-{{ settings.soldout_badge_color_scheme }}"
        {% unless sold_out %}style="display: none;"{% endunless %}
      >
        {{- 'products.product.sold_out' | t -}}
      </span>
    {%- endif -%}

    {%- comment -%} Wishlist heart (top-right) {%- endcomment -%}
    <div class="m-pcard-wishlist-wrap">
      {%- if show_wishlist_button -%}
        {% assign wishlist_app = settings.wishlist_app %}
        {% if wishlist_app == 'growave' %}
          <div class="m-tooltip m-wishlist-button m-button--icon m-tooltip--style-1">
            <span class="m-tooltip-icon m:block">
              {% comment %} theme-check-disable {% endcomment %}
              {% capture the_snippet_fave_icon %}{% render 'ssw-widget-faveicon' with product.id %}{% endcapture %}
              {% unless the_snippet_fave_icon contains 'Liquid error' %}
                {{ the_snippet_fave_icon }}
              {% else %}
                {% render 'mm-ssw-widget-faveicon' with product.id %}
              {% endunless %}
              {% comment %} theme-check-enable {% endcomment %}
            </span>
          </div>
        {% else %}
          <div class="m-pcard-wish-wrapper">
            {% render 'tooltip', type: 'wishlist', product: product, class_name: 'm-tooltip--left', style: 2 %}
            <span class="pcard-wish-icon-default" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#FFFF" stroke="#222222" stroke-width="0.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
              </svg>
            </span>
            <span class="pcard-wish-icon-filled" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#222222" stroke="#222222" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
              </svg>
            </span>
          </div>
        {% endif %}
      {%- else -%}
        <button type="button" aria-label="{{ 'products.product.add_to_wishlist' | t }}" class="m-pcard-wish-wrapper">
          <span class="pcard-wish-icon-default" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#222222" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </span>
          <span class="pcard-wish-icon-filled" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#222222" stroke="#222222" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </span>
        </button>
      {%- endif -%}
    </div>

    {%- comment -%} Countdown timer {%- endcomment -%}
    {% liquid
      assign metafields_time = product.metafields.global.minimog_countdown
      if settings.show_countdown and metafields_time != blank
        render 'countdown-timer', time: metafields_time, separator: false, short_label: true, extra_classes: 'm-product-card__countdown m:hidden'
      endif
    %}

  </div>
  {%- comment -%} end .m-product-card__media {%- endcomment -%}

  {%- comment -%}============ CONTENT BLOCK ============{%- endcomment -%}
  <div class="m-product-card__content m:text-{{ pcard_alignment }}">
    <div class="m-product-card__info">

      {%- comment -%} Gemstone picker {%- endcomment -%}
      {%- if gemstone_metafield != blank -%}
        <div class="m-pcard-gemstone-row">
          {%- for gemstone in gemstone_metafield.value -%}
            {%- liquid
              assign g_src = ''
              assign g_alt = ''
              if gemstone.preview_image != blank
                assign g_src = gemstone.preview_image | image_url: width: 60
                assign g_alt = gemstone.alt | escape
              elsif gemstone.image != blank
                assign g_src = gemstone.image | image_url: width: 60
                assign g_alt = gemstone.image.alt | escape
              elsif gemstone.src != blank
                assign g_src = gemstone | image_url: width: 60
                assign g_alt = gemstone.alt | escape
              endif
            -%}
            {%- if g_src != blank -%}
              <div class="m-pcard-gemstone-item" title="{{ g_alt }}">
                <img src="{{ g_src }}" alt="{{ g_alt }}" width="28" height="28" loading="lazy">
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%} Material title {%- endcomment -%}
      {%- if material_title != blank -%}
        <p class="m-pcard-material-title">{{ material_title.value }}</p>
      {%- endif -%}

      {%- comment -%} Vendor {%- endcomment -%}
      {%- if show_vendor -%}
        <span class="m-product-card__vendor">{{ product.vendor }}</span>
      {%- endif -%}

      {%- comment -%} Product title {%- endcomment -%}
      {% if show_title == true %}
        <h3 class="m-product-card__title">
          <a href="{{ product_url }}"
            class="m-product-card__name{% if settings.uppercase_prd_name %} m:uppercase{% endif %}"
          >
            {{ product.title }}
          </a>
        </h3>
      {% endif %}

      {%- comment -%} Reviews {%- endcomment -%}
      {% if settings.show_review_badge %}
        <div class="m-product-card__reviews m:text-color-body">
          {% render 'product-reviews-app__badge', product: product %}
        </div>
      {% endif %}

      {%- comment -%} Variant swatches {%- endcomment -%}
      {%- liquid
        assign v1_url = ''
        assign v2_url = ''
        assign v3_url = ''

        if variant_img_1 != blank
          if variant_img_1.value != blank
            assign v1_url = variant_img_1.value | image_url: width: 1100
          else
            assign v1_url = variant_img_1 | image_url: width: 1100
          endif
        endif

        if variant_img_2 != blank
          if variant_img_2.value != blank
            assign v2_url = variant_img_2.value | image_url: width: 1100
          else
            assign v2_url = variant_img_2 | image_url: width: 1100
          endif
        endif

        if variant_img_3 != blank
          if variant_img_3.value != blank
            assign v3_url = variant_img_3.value | image_url: width: 1100
          else
            assign v3_url = variant_img_3 | image_url: width: 1100
          endif
        endif
      -%}

      {%- capture swatch_meta_map -%}["{{ v1_url }}","{{ v2_url }}","{{ v3_url }}"]{% endcapture %}

      {% if product.has_only_default_variant == false and show_variant_options %}
        <div
          class="m-product-card__option-wrapper"
          data-pcard-swatches
          data-meta-imgs='{{ swatch_meta_map }}'
        >
          {%- liquid
            assign seen_options = ''
            assign swatch_index = 0
          -%}
          {%- for variant in product.variants -%}
            {%- liquid
              assign opt1 = variant.option1
              assign already_seen = false
              if seen_options contains opt1
                assign already_seen = true
              endif
            -%}
            {%- unless already_seen -%}
              {%- liquid
                assign seen_options = seen_options | append: opt1 | append: '|||'
                assign sv_src = ''
                if variant.featured_image != blank
                  assign sv_src = variant.featured_image | image_url: width: 120
                elsif variant.image != blank
                  assign sv_src = variant.image | image_url: width: 120
                endif
              -%}
              {%- if sv_src != blank -%}
                {%- comment -%} data-price, data-compare-price, data-currency added for JS price sync {%- endcomment -%}
                <div
                  class="m-pcard-swatch-wrap{% if swatch_index == 0 %} is-selected{% endif %}"
                  data-swatch-index="{{ swatch_index }}"
                  data-price="{{ variant.price }}"
                  data-compare-price="{{ variant.compare_at_price }}"
                  data-currency="{{ cart.currency.iso_code }}"
                  title="{{ opt1 | escape }}"
                  role="button"
                  tabindex="0"
                  aria-label="{{ opt1 | escape }}"
                >
                  <div class="m-pcard-swatch-gap"></div>
                  <div class="m-pcard-swatch-img-wrap">
                    <img
                      src="{{ sv_src }}"
                      alt="{{ opt1 | escape }}"
                      width="32"
                      height="32"
                      loading="lazy"
                      class="m-pcard-swatch-img"
                    >
                  </div>
                </div>
                {%- assign swatch_index = swatch_index | plus: 1 -%}
              {%- endif -%}
            {%- endunless -%}
            {%- if swatch_index >= 3 -%}{%- break -%}{%- endif -%}
          {%- endfor -%}
        </div>
      {%- elsif product.has_only_default_variant == false and show_variant_options -%}
        {% render 'product-card-option',
          product: product,
          show_variant_options: show_variant_options,
          pcard_alignment: pcard_alignment,
          context: context
        %}
      {% endif %}

      {%- comment -%} Price — data-pcard-price lets JS update it on swatch click {%- endcomment -%}
      <div class="m-product-card__price" data-pcard-price>
        {% render 'product-prices', product: product, is_product_card: true %}
      </div>

      {%- comment -%} Inventory {%- endcomment -%}
      {%- if show_inventory and selected_variant.inventory_management != blank -%}
        {%- liquid
          assign inventory_threshold = settings.low_inventory_threshold
          assign show_inventory_count = settings.show_inventory_count
          assign inventory_visibility = settings.inventory_visibility
          assign inventory_hide_backordered = settings.inventory_hide_backordered

          assign total = 0
          assign inventory_policy = ''
          for variant in product.variants
            if variant.inventory_quantity > 0
              assign total = total | plus: variant.inventory_quantity
            endif
            if variant.inventory_policy == 'continue'
              assign inventory_policy = 'continue'
            endif
          endfor

          if total <= 0
            if inventory_policy == 'continue'
              assign status = 'backordered'
            elsif product.available
              assign status = 'instock'
            else
              assign status = 'outofstock'
            endif
          elsif total <= inventory_threshold
            assign status = 'low'
          else
            assign status = 'normal'
          endif

          assign show = false
          if inventory_visibility == 'always'
            assign show = true
            if status == 'backordered' and inventory_hide_backordered
              assign show = false
            endif
          else
            if status == 'low'
              assign show = true
            endif
          endif

          if status == 'outofstock'
            assign show = false
          endif

          assign show_inventory_number = true
          if show_inventory_count == 'never' or total <= 0 or show_inventory_count == 'low_inventory' and status != 'low'
            assign show_inventory_number = false
          endif
        -%}
        {%- if show == true -%}
          <div class="m-product-inventory m-product-card__inventory m:text-sm" data-status="{{ status }}">
            <div class="m-product-inventory__inner">
              <span class="m-product-inventory__text">
                <span class="m-product-inventory__pin"></span>
                <span class="m-product-inventory__status">
                  {% liquid
                    case status
                      when 'backordered'
                        render 'new-locale', key: 'products.product.backordered'
                      when 'low'
                        if show_inventory_number
                          render 'new-locale', key: 'products.product.inventory_low_quantity_html', param: '{{ quantity }}', value: total
                        else
                          render 'new-locale', key: 'products.product.low_stock'
                        endif
                      else
                        if show_inventory_number
                          render 'new-locale', key: 'products.product.inventory_quantity_html', param: '{{ quantity }}', value: total
                        else
                          echo 'products.product.in_stock' | t
                        endif
                    endcase
                  %}
                </span>
              </span>
            </div>
          </div>
        {%- endif -%}
      {%- endif -%}

    </div>
    {%- comment -%} end .m-product-card__info {%- endcomment -%}

    {%- comment -%} Direct Add To Bag Button {%- endcomment -%}
    <div class="m-pcard-direct-add">
      <product-form>
        {%- assign product_form_id = 'product-form-' | append: product.id | append: '-' | append: section.id -%}
        {%- form 'product', product, id: product_form_id, class: 'm:w-full', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
          <input type="hidden" name="id" value="{{ variant_id }}">
          <button
            type="submit"
            name="add"
            class=" a m:w-full m:flex m:items-center m:justify-center"
          >
            <span class="m-product-btn-text">
              {%- if product.available -%}
                ADD TO BAG
              {%- else -%}
                {{ 'products.product.sold_out' | t }}
              {%- endif -%}
            </span>
          </button>
        {%- endform -%}
      </product-form>
    </div>

  </div>
  {%- comment -%} end .m-product-card__content {%- endcomment -%}

  <script>
  (function () {
    var card = document.currentScript.closest('[data-product-id]');
    if (!card) return;

    var swatchWrap  = card.querySelector('[data-pcard-swatches]');
    var hoverImgEl  = card.querySelector('[data-pcard-hover-img-el]');
    var mainImgWrap = card.querySelector('[data-pcard-main-img]');
    if (!mainImgWrap || !hoverImgEl) return;

    var mainImg = mainImgWrap.querySelector('img');
    if (!mainImg) return;

    var originalMainSrc    = mainImg.src;
    var originalMainSrcset = mainImg.srcset || '';

    var metaUrls = [];
    if (swatchWrap) {
      try {
        metaUrls = JSON.parse(swatchWrap.getAttribute('data-meta-imgs') || '[]');
      } catch (e) {}
    }

    /* ── Price sync ─────────────────────────────────────────────────────── */
    var priceEl = card.querySelector('[data-pcard-price]');

    function formatMoney(cents, currency) {
      if (!cents && cents !== 0) return '';
      if (window.Shopify && window.Shopify.formatMoney) {
        return window.Shopify.formatMoney(
          cents,
          window.theme && window.theme.moneyFormat ? window.theme.moneyFormat : '{{amount}}'
        );
      }
      var symbols = { USD: '$', EUR: '€', GBP: '£', CAD: 'CA$', AUD: 'A$' };
      var sym = symbols[currency] || (currency + ' ');
      return sym + (parseInt(cents, 10) / 100).toFixed(2);
    }

    function updatePrice(sw) {
      if (!priceEl) return;
      var price        = sw.getAttribute('data-price');
      var comparePrice = sw.getAttribute('data-compare-price');
      var currency     = sw.getAttribute('data-currency') || '';
      if (!price) return;

      var priceFmt   = formatMoney(price, currency);
      var compareFmt = comparePrice && parseInt(comparePrice, 10) > parseInt(price, 10)
                       ? formatMoney(comparePrice, currency)
                       : '';

      priceEl.innerHTML = compareFmt
        ? '<span class="m-price" style="font-weight:400;font-size:18px;color:#222;">' + priceFmt + '</span>'
          + '<span class="m-price m-price-item--regular" style="font-size:14px;color:#999;text-decoration:line-through;font-weight:400;">' + compareFmt + '</span>'
        : '<span class="m-price" style="font-weight:400;font-size:18px;color:#222;">' + priceFmt + '</span>';
    }
    /* ── end price sync ─────────────────────────────────────────────────── */

    if (swatchWrap) {
      var swatches = swatchWrap.querySelectorAll('.m-pcard-swatch-wrap');

      function activate(sw) {
        /* 1. Update active ring */
        swatches.forEach(function (s) { s.classList.remove('is-selected'); });
        sw.classList.add('is-selected');

        /* 2. Update hover image */
        var idx     = parseInt(sw.getAttribute('data-swatch-index'), 10);
        var metaUrl = (metaUrls && metaUrls[idx]) ? metaUrls[idx] : '';

        var swatchImg        = sw.querySelector('.m-pcard-swatch-img');
        var activeVariantSrc = metaUrl || (swatchImg ? swatchImg.src : '');
        if (activeVariantSrc) {
          hoverImgEl.src    = activeVariantSrc;
          hoverImgEl.srcset = '';
        }

        /* 3. Update price */
        updatePrice(sw);
      }

      swatches.forEach(function (sw) {
        sw.addEventListener('click', function (e) {
          e.preventDefault();
          activate(sw);
        });
        sw.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            activate(sw);
          }
        });
      });

      /* On load: sync hover image + price to first swatch */
      var firstSwatch = swatches[0];
      if (firstSwatch) {
        var firstMeta      = (metaUrls && metaUrls[0]) ? metaUrls[0] : '';
        var firstSwatchImg = firstSwatch.querySelector('.m-pcard-swatch-img');
        var firstSrc       = firstMeta || (firstSwatchImg ? firstSwatchImg.src : '');
        if (firstSrc) {
          hoverImgEl.src    = firstSrc;
          hoverImgEl.srcset = '';
        }
        updatePrice(firstSwatch);
      }
    } else {
      hoverImgEl.src    = originalMainSrc;
      hoverImgEl.srcset = originalMainSrcset;
    }
  })();
  </script>

</div>
{%- if column_wrapper -%}</div>{%- endif -%} {% endcomment %}


















{% comment %}
  Accepts:
  - product: {Object} Product (required)
  - show_variant_options: {Boolean} Show variant swatches at the bottom (optional)
  - hide_title: {String} Hide product title (optional)
  - image_ratio: {String} Product media ratio (optional)
  - pcard_alignment: {String} Product alignment (optional)
  - show_vendor: {Boolean} Show product vendor (optional)
  - show_cart_button: {Boolean} Show Add to cart button (optional)
  - show_quickview_button: {Boolean} Show Quickview button (optional)
  - show_wishlist_button: {Boolean} Show Wishlist button (optional)
  - show_compare_button: {Boolean} Show Compare button (optional)
  - column_wrapper: {Boolean} Wrap product card (optional)
  - remove_params: {Boolean} Remove url params (optional)

  Usage:
  {% render 'product-card-custom', product: product %}
{% endcomment %}

{% liquid
  if show_variant_options == null
    assign show_variant_options = settings.show_swatch_option
  endif
  if show_inventory == null
    assign show_inventory = settings.pcard_show_inventory
  endif

  assign show_title = true
  if hide_title == true
    assign show_title = false
  endif

  assign has_group_tag = false
  if product.tags contains 'group'
    assign has_group_tag = true
  endif

  if image_ratio == null or image_ratio == blank
    assign image_ratio = settings.pcard_image_ratio | default: '1/1'
  endif

  if image_ratio == 'original'
    if has_group_tag and product.images.size > 1 and product.images[1] != blank
      assign image_ratio = product.images[1].aspect_ratio | default: '1/1'
    else
      assign image_ratio = product.featured_image.aspect_ratio | default: '1/1'
    endif
  endif

  if show_vendor == null
    assign show_vendor = settings.show_vendor
  endif

  if show_desc == null
    assign show_desc = false
  endif

  assign sold_out = false
  if product.available == false
    assign sold_out = true
  endif

  assign discount = ''
  assign compare_at_price = product.compare_at_price
  assign price = product.price
  assign on_sale = false
  if compare_at_price > price
    assign on_sale = true
    assign discount = compare_at_price | minus: price | times: 100 | divided_by: compare_at_price
  endif

  assign show_on_sale_badge = false
  if settings.on_sale_badge != 'hide' and on_sale
    assign show_on_sale_badge = true
  endif

  assign quick_add_text = 'products.product.quick_add' | t
  unless product.has_only_default_variant
    capture quick_add_text
      render 'new-locale', key: 'products.product.select_options'
    endcapture
  endunless

  assign sold_number = product.metafields.foxkit.sold_number
  assign selected_variant = product.selected_or_first_available_variant

  if product.available
    assign variant_id = product.first_available_variant.id
  else
    assign variant_id = product.selected_or_first_available_variant.id
  endif
  assign selected_variant_id = ''
  if section.settings.change_product_variant_on_fitlering
    assign variant_id = product.selected_or_first_available_variant.id
    assign selected_variant_id = product.selected_variant.id
  endif

  if pcard_alignment == null
    assign pcard_alignment = settings.pcard_alignment
  endif

  assign pcard_default_image = settings.pcard_default_image
  if image_ratio == null or image_ratio == blank
    assign image_ratio = settings.pcard_image_ratio | default: '1/1'
  endif

  if show_cart_button == null
    assign show_cart_button = settings.show_cart_button
  endif

  if show_quickview_button == null
    assign show_quickview_button = settings.show_quickview_button
  endif

  if show_wishlist_button == null
    assign show_wishlist_button = settings.show_wishlist_button
  endif

  if show_compare_button == null
    assign show_compare_button = settings.show_compare_button
  endif

  assign preview_image = product.media[0].preview_image

  if has_group_tag and product.images.size > 1 and product.images[1] != blank
    assign preview_image = product.images[1]
  endif

  if section.settings.change_product_variant_on_fitlering == true and product.selected_variant.image != null
    assign preview_image = product.selected_variant.image
  endif

  if image_ratio == 'original'
    assign image_ratio = product.media[0].aspect_ratio | default: '1/1'
  endif

  assign second_image = ''
  if product.images.size > 1 and product.images[1] != blank
    assign second_image = product.images[1]
  endif

  assign product_card_classes = 'm-product-card m-product-card--style-custom'
  if sold_out
    assign product_card_classes = product_card_classes | append: ' m-product-card--soldout'
  endif
  if on_sale
    assign product_card_classes = product_card_classes | append: ' m-product-card--onsale'
  endif

  if second_image != blank
    assign product_card_classes = product_card_classes | append: ' m-product-card--has-second-img'
  endif

  assign product_url = product.url
  if remove_params
    assign product_url = product.url | split: '?' | first
  endif

  assign first_media_type = product.media.first.media_type

  assign show_video = false
  if settings.pcard_show_video and first_media_type == 'video'
    assign show_video = true
  endif

  assign loading = 'lazy'
  assign fetchpriority = 'low'
  if index == 1 and section_index <= 2
    assign loading = 'eager'
    assign fetchpriority = 'high'
  endif

  assign gemstone_metafield = product.metafields.custom.gemstone
  assign material_title = product.metafields.custom.meterial_title

  assign variant_img_1 = product.metafields.custom.variant_1
  assign variant_img_2 = product.metafields.custom.variant_2
  assign variant_img_3 = product.metafields.custom.variant_3
%}

{% unless pcard_custom_styles_rendered %}
{% assign pcard_custom_styles_rendered = true %}
<style>
  /* ==============================================
     PRODUCT CARD - Style Custom (Isolated Design)
  ============================================== */

  :root {
    --pcard-polygon: polygon(
      18% 0%, 82% 0%,
      100% 18%, 100% 82%,
      82% 100%, 18% 100%,
      0% 82%, 0% 18%
    );
    --phcard-polygon: polygon(
      18% 0%,
      82% 0%,
      100% 18%,
      100% 82%,
      82% 100%,
      18% 100%,
      0% 82%,
      0% 18%
    );
    --vcard-polygon: polygon(96.04% 69.5%,68.77% 96.34%,30.5% 96.04%,3.66% 68.77%,3.96% 30.5%,31.23% 3.66%,69.5% 3.96%,96.34% 31.23%,96.04% 69.5%);
  }

  /* ── Card shell ─────────────────────────────────────────────────────────── */
  .m-product-card--style-custom {
    position: relative;
    background: #fff;
    padding-bottom: 0 !important;
  }

  /* ── Media wrapper ──────────────────────────────────────────────────────── */
  .m-product-card--style-custom .m-product-card__media {
    position: relative;
    overflow: visible;
  }

  /* ── Image clip container ───────────────────────────────────────────────── */
  .m-product-card--style-custom .m-pcard-img-clip {
    position: relative;
    overflow: visible;
  }

  .m-product-card--style-custom .m-pcard-img-clip .m-product-card__link {
    display: block;
    overflow: hidden;
    position: relative;
    clip-path: polygon(1% 0%, 99% 0%, 100% 1%, 100% 99%, 99% 100%, 1% 100%, 0% 99%, 0% 1%);
    transition: clip-path 0.15s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Card hover OR direct image-area hover → apply polygon clip */
  .m-product-card--style-custom:hover .m-pcard-img-clip .m-product-card__link,
  .m-product-card--style-custom .m-pcard-img-clip:hover .m-product-card__link {
    clip-path: var(--pcard-polygon);
  }

  /* ── Image layers ───────────────────────────────────────────────────────── */
  .m-product-card--style-custom .m-product-card__main-image {
    position: relative;
    z-index: 1;
    width: 100%;
    transition: opacity 0.4s ease-in-out;
  }
  .m-product-card--style-custom .m-product-card__hover-image,
  .m-product-card--style-custom .m-product-card__second-image {
    position: absolute;
    inset: 0;
    width: 100%;
    opacity: 0;
    z-index: 2;
    transition: opacity 0.4s ease-in-out;
  }

  /* All img tags fill container with cover */
  .m-product-card--style-custom .m-product-card__main-image .m-image img,
  .m-product-card--style-custom .m-product-card__main-image responsive-image img,
  .m-product-card--style-custom .m-product-card__hover-image .m-image img,
  .m-product-card--style-custom .m-product-card__hover-image responsive-image img,
  .m-product-card--style-custom .m-product-card__second-image .m-image img,
  .m-product-card--style-custom .m-product-card__second-image responsive-image img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center !important;
    display: block;
  }

  /* CARD hover → show variant hover image */
  .m-product-card--style-custom:hover .m-product-card__main-image { opacity: 0; }
  .m-product-card--style-custom:hover .m-product-card__hover-image { opacity: 1; }

  /* IMAGE AREA hover → show 2nd product image (overrides card hover) */
  .m-product-card--style-custom.m-product-card--has-second-img .m-pcard-img-clip:hover .m-product-card__main-image  { opacity: 0 !important; }
  .m-product-card--style-custom.m-product-card--has-second-img .m-pcard-img-clip:hover .m-product-card__hover-image { opacity: 0 !important; }
  .m-product-card--style-custom.m-product-card--has-second-img .m-pcard-img-clip:hover .m-product-card__second-image { opacity: 1 !important; }

  /* ── SVG polygon border ───────────────────────────────────────────────── */
  .m-product-card--style-custom .m-pcard-polygon-border {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 5;
    overflow: visible;
    display: block;
    opacity: 0;
    transition: opacity 0.15s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .m-product-card--style-custom:hover .m-pcard-polygon-border,
  .m-product-card--style-custom .m-pcard-img-clip:hover .m-pcard-polygon-border {
    opacity: 1;
  }

  /* ── Wishlist ───────────────────────────────────────────────────────────── */
  .m-product-card--style-custom .m-pcard-wishlist-wrap {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 3;
  }
  .m-product-card--style-custom .m-pcard-wish-wrapper {
    position: relative;
    width: 16px;
    height: 16px;
    display: block;
    top: -10px;
    left: 9px;
  }
  .m-product-card--style-custom .m-pcard-wish-wrapper .m-tooltip,
  .m-product-card--style-custom .m-pcard-wish-wrapper > button {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
    margin: 0 !important;
    cursor: pointer !important;
    z-index: 2;
  }
  .m-product-card--style-custom .m-pcard-wish-wrapper .m-tooltip-icon,
  .m-product-card--style-custom .m-pcard-wish-wrapper .m-tooltip-icon--active,
  .m-product-card--style-custom .m-pcard-wish-wrapper .m-tooltip__content {
    display: none !important;
  }
  .m-product-card--style-custom .m-pcard-wish-wrapper .pcard-wish-icon-default,
  .m-product-card--style-custom .m-pcard-wish-wrapper .pcard-wish-icon-filled {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 1;
    transition: opacity 0.2s ease-in-out;
  }
  .m-product-card--style-custom .m-pcard-wish-wrapper .pcard-wish-icon-default svg,
  .m-product-card--style-custom .m-pcard-wish-wrapper .pcard-wish-icon-filled svg {
    width: 20px;
    height: 20px;
    display: block;
  }
  .m-product-card--style-custom .m-pcard-wish-wrapper .pcard-wish-icon-default { opacity: 1; }
  .m-product-card--style-custom .m-pcard-wish-wrapper .pcard-wish-icon-filled  { opacity: 0; }
  .m-product-card--style-custom .m-pcard-wish-wrapper:hover .pcard-wish-icon-default { opacity: 0; }
  .m-product-card--style-custom .m-pcard-wish-wrapper:hover .pcard-wish-icon-filled  { opacity: 1; }

  /* ── Badges ─────────────────────────────────────────────────────────────── */
  .m-product-card--style-custom .m-product-card__tags {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .m-product-card--style-custom .m-product-tag {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 2px;
  }
  .m-product-card--style-custom .m-product-tag--soldout {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 3;
  }

  /* ── Card info ──────────────────────────────────────────────────────────── */
  .m-product-card__info {
    padding: 0;
    text-align: left !important;
  }
  .m-product-card--style-custom .m-product-card__content {
    padding: 16px 0px !important;
    position: relative;
    text-align: left !important;
  }

  /* ── Gemstone ───────────────────────────────────────────────────────────── */
  .m-pcard-gemstone-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 4px;
  }
  .m-pcard-gemstone-item {
    width: 20px !important;
    height: 20px !important;
    overflow: hidden;
    cursor: default;
    pointer-events: none;
    flex-shrink: 0;
    clip-path: var(--pcard-polygon);
  }
  .m-pcard-gemstone-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Material title ─────────────────────────────────────────────────────── */
  .m-product-card--style-custom .m-pcard-material-title {
    font-size: 13px;
    font-weight: 400;
    color: #888;
    margin: 0 0 2px;
    line-height: 1.2;
    font-family: 'Inter', sans-serif !important;
  }

  /* ── Add to Bag ─────────────────────────────────────────────────────────── */
  .m-pcard-direct-add {
    height: 40px;
    background: #2C2C2C;
    color: #FFFFFF;
    font-size: 16px;
    font-weight: 300;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: background 0.3s;
    border-radius: 0px !important;
    border: none !important;
    box-shadow: none !important;
  }
  .m-pcard-direct-add:hover {
    background: linear-gradient(135deg, #947863, #E9DDD4, #947863) !important;
    color: #FFFF;
  }

  @media (max-width: 768px) {
    .m-product-card--style-custom .m-pcard-material-title {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .m-product-card--style-custom .m-pcard-wish-wrapper {
      position: relative;
      width: 16px;
      height: 16px;
      display: block;
      top: -10px !important;
      left: 10px !important;
    }
  }

  /* ── Vendor ─────────────────────────────────────────────────────────────── */
  .m-product-card--style-custom .m-product-card__vendor {
    display: block;
    font-size: 11px;
    color: #999;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 4px;
  }

  /* ── Title ──────────────────────────────────────────────────────────────── */
  .m-product-card--style-custom .m-product-card__title {
    margin: 0 0 8px;
    font-size: 17px;
    font-weight: 400;
    line-height: 1.3;
    font-family: 'Inter', sans-serif !important;
  }
  .m-product-card--style-custom .m-product-card__name {
    color: #222;
    text-decoration: none;
  }
  .m-product-card--style-custom .m-product-card__name:hover {
    text-decoration: underline;
  }

  /* ── Swatches ───────────────────────────────────────────────────────────── */
  .m-product-card--style-custom .m-product-card__option-wrapper {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 5px !important;
    align-items: center;
  }
  .m-product-card--style-custom .m-pcard-swatch-wrap {
    position: relative;
    width: 34px !important;
    height: 34px !important;
    flex-shrink: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    clip-path: var(--vcard-polygon);
    transition: background 0.4s ease-in-out;
  }
  .m-product-card--style-custom .m-pcard-swatch-wrap.is-selected {
    background: #222222;
  }
  .m-product-card--style-custom .m-pcard-swatch-wrap:not(.is-selected):hover {
    background: #aaa;
  }
  .m-product-card--style-custom .m-pcard-swatch-gap {
    position: absolute;
    inset: 1px;
    background: #fff;
    clip-path: var(--vcard-polygon);
    z-index: 1;
  }
  .m-product-card--style-custom .m-pcard-swatch-img-wrap {
    position: absolute;
    inset: 3px;
    z-index: 2;
    clip-path: var(--vcard-polygon);
    overflow: hidden;
    background: #eee;
  }
  .m-product-card--style-custom .m-pcard-swatch-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Price ──────────────────────────────────────────────────────────────── */
  .m-product-card--style-custom .m-product-card__price {
    margin-bottom: 0;
    font-size: 18px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding-bottom: 10px;
  }
  .m-product-card--style-custom .m-product-card__price .m-price,
  .m-product-card--style-custom .m-product-card__price .m-price-item--sale,
  .m-product-card--style-custom .m-product-card__price .m-price-item--regular:not(s) {
    font-weight: 400 !important;
    font-size: 18px !important;
    color: #222 !important;
  }
  .m-product-card--style-custom .m-product-card__price s.m-price-item--regular,
  .m-product-card--style-custom .m-product-card__price .m-price-item--regular s {
    font-size: 14px !important;
    color: #999 !important;
    text-decoration: line-through;
    font-weight: 400 !important;
  }
</style>
{% endunless %}

{%- if column_wrapper -%}<div class="m:column">{%- endif -%}
<div
  class="{{ product_card_classes }}{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}"
  data-view="card"
  {% if sold_number != blank %}data-sold-number="{{ sold_number }}"{% endif %}
  data-product-id="{{ product.id }}"
  {% if animated %}
    data-cascade
    style="--animation-order: {{ index }};"
  {% endif %}
>

  {%- comment -%}============ IMAGE BLOCK ============{%- endcomment -%}
  <div class="m-product-card__media">

    <div class="m-pcard-img-clip">

      <a class="m-product-card__link m:block m:w-full"
        href="{{ product_url }}"
        aria-label="{{ product.title | default: 'product title' }}"
      >
        {% if preview_image != blank or first_media_type == 'video' %}
          {% unless show_video %}

            {%- comment -%} IMG 1 - main image {%- endcomment -%}
            <div class="m-product-card__main-image" data-pcard-main-img>
              {%- liquid
                assign asp_rat = image_ratio | default: preview_image.aspect_ratio
                if asp_rat == 'original'
                  assign asp_rat = preview_image.aspect_ratio
                endif
                assign alt = alt | default: preview_image.alt | escape
              -%}
              {%- capture sizes -%}(min-width: {{ settings.container_width }}px) {{ settings.container_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2){%- endcapture -%}
              <responsive-image class="m-image" style="--aspect-ratio: {{ asp_rat }}">
                {{
                  preview_image
                  | image_url: width: 1100
                  | image_tag:
                    loading: loading,
                    fetchpriority: fetchpriority,
                    class: 'm:w-full m:h-full',
                    alt: alt,
                    sizes: sizes,
                    widths: '165, 360, 535, 750, 940, 1100'
                }}
              </responsive-image>
            </div>

            {%- comment -%} CARD HOVER layer {%- endcomment -%}
            <div class="m-product-card__hover-image" data-pcard-variant-hover-img aria-hidden="true">
              {%- liquid
                assign asp_rat_h = image_ratio | default: preview_image.aspect_ratio
                if asp_rat_h == 'original'
                  assign asp_rat_h = preview_image.aspect_ratio
                endif
              -%}
              <responsive-image class="m-image" style="--aspect-ratio: {{ asp_rat_h }}">
                <img
                  src="{{ preview_image | image_url: width: 1100 }}"
                  alt="{{ alt }}"
                  width="1100"
                  height="auto"
                  loading="lazy"
                  class="m:w-full m:h-full"
                  data-pcard-hover-img-el
                >
              </responsive-image>
            </div>

            {%- comment -%} IMAGE AREA HOVER layer {%- endcomment -%}
            {%- if second_image != blank -%}
              <div class="m-product-card__second-image">
                {%- liquid
                  assign asp_rat2 = image_ratio | default: second_image.aspect_ratio
                  if asp_rat2 == 'original'
                    assign asp_rat2 = second_image.aspect_ratio
                  endif
                  assign alt2 = second_image.alt | escape
                -%}
                {%- capture sizes -%}(min-width: {{ settings.container_width }}px) {{ settings.container_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2){%- endcapture -%}
                <responsive-image class="m-image" style="--aspect-ratio: {{ asp_rat2 }}">
                  {{
                    second_image
                    | image_url: width: 1100
                    | image_tag:
                      loading: 'lazy',
                      fetchpriority: 'low',
                      class: 'm:w-full m:h-full',
                      alt: alt2,
                      sizes: sizes,
                      widths: '165, 360, 535, 750, 940, 1100'
                  }}
                </responsive-image>
              </div>
            {%- endif -%}

          {% else %}
            <m-video-component
              class="m:block m-product-card__video"
              data-type="mp4"
              style="--aspect-ratio: {{ image_ratio }}"
            >
              {{
                product.media.first
                | media_tag:
                  image_size: '1500px',
                  autoplay: true,
                  loop: true,
                  controls: false,
                  muted: true,
                  playsinline: true
              }}
            </m-video-component>
          {% endunless %}

        {% else %}
          {% if pcard_default_image != blank %}
            {%- liquid
              assign asp_rat = image_ratio | default: pcard_default_image.aspect_ratio
              if asp_rat == 'original'
                assign asp_rat = pcard_default_image.aspect_ratio
              endif
              assign alt = pcard_default_image.alt | escape
            -%}
            {%- capture sizes -%}(min-width: {{ settings.container_width }}px) {{ settings.container_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2){%- endcapture -%}
            <responsive-image class="m-image" style="--aspect-ratio: {{ asp_rat }}">
              {{
                pcard_default_image
                | image_url: width: 1100
                | image_tag:
                  loading: loading,
                  fetchpriority: fetchpriority,
                  class: 'm:w-full m:h-full',
                  alt: alt,
                  sizes: sizes,
                  widths: '165, 360, 535, 750, 940, 1100'
              }}
            </responsive-image>
          {% else %}
            <div style="--aspect-ratio: {{ image_ratio }}">
              {{ 'product-1' | placeholder_svg_tag: 'm-placeholder-svg' }}
            </div>
          {% endif %}
        {% endif %}
      </a>

      <svg
        class="m-pcard-polygon-border"
        viewBox="0 0 100 100"
        preserveAspectRatio="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <defs>
          <linearGradient id="pcard-border-grad" x1="0%" y1="50%" x2="100%" y2="50%">
            <stop offset="0%"   stop-color="#E6D7CB"/>
            <stop offset="50%"  stop-color="#FFFFFF"/>
            <stop offset="100%" stop-color="#E6D7CB"/>
          </linearGradient>
        </defs>
        <polygon
          points="18,0 82,0 100,18 100,82 82,100 18,100 0,82 0,18"
          fill="none"
          stroke="url(#pcard-border-grad)"
          stroke-width="1.5"
          vector-effect="non-scaling-stroke"
          stroke-linejoin="miter"
          stroke-alignment="outer"
        />
      </svg>

    </div>
    {%- comment -%} end .m-pcard-img-clip {%- endcomment -%}

    {%- comment -%} Badges (top-left) {%- endcomment -%}
    <div class="m-product-card__tags">
      {% if settings.show_badge_sale %}
        {% for tag in product.tags %}
          {% if tag contains 'tag__' %}
            {%- liquid
              assign tag_content = tag | split: '__' | last
              assign type = tag_content | split: '_' | first
              assign tag_name = tag_content | split: '_' | last
              assign color_scheme_class = 'm-gradient m-color-'
              case type
                when 'sale':
                  assign color_scheme_class = color_scheme_class | append: settings.sale_badge_color_scheme
                when 'new':
                  assign color_scheme_class = color_scheme_class | append: settings.new_badge_color_scheme
                when 'hot':
                  assign color_scheme_class = color_scheme_class | append: settings.hot_badge_color_scheme
              endcase
            -%}
            <span class="m-product-card__tag-name m-product-tag m-product-tag--{{ type }} {{ color_scheme_class }}">
              {{- tag_name -}}
            </span>
          {% endif %}
        {% endfor %}
      {% endif %}

      {% assign custom_badge_class = 'm-product-card__tag-name m-product-tag m-product-tag--preorder m-gradient m-color-' | append: settings.preorder_badge_color_scheme %}
      {% capture foxkit_preorder_badge %}{% render 'foxkit-preorder-badge', product: product, static: true, custom_class: custom_badge_class %}{% endcapture %}
      {% unless foxkit_preorder_badge contains 'Liquid error' %}
        {{ foxkit_preorder_badge }}
      {% endunless %}

      {% if show_on_sale_badge %}
        <span class="m-product-card__tag-name m-product-tag m-product-tag--sale m-gradient m-color-{{ settings.sale_badge_color_scheme }}">
          {%- if settings.on_sale_badge == 'show_text' -%}
            {{ 'products.product.on_sale' | t }}
          {%- elsif settings.on_sale_badge == 'show_percentage' -%}
            {{ discount | append: '%' | prepend: '-' }}
          {%- endif -%}
        </span>
      {% endif %}
    </div>

    {%- comment -%} Sold-out badge {%- endcomment -%}
    {%- if settings.show_badge_soldout -%}
      <span
        class="m-product-tag m-product-tag--soldout m-gradient m-color-{{ settings.soldout_badge_color_scheme }}"
        {% unless sold_out %}style="display: none;"{% endunless %}
      >
        {{- 'products.product.sold_out' | t -}}
      </span>
    {%- endif -%}

    {%- comment -%} Wishlist heart (top-right) {%- endcomment -%}
    <div class="m-pcard-wishlist-wrap">
      {%- if show_wishlist_button -%}
        {% assign wishlist_app = settings.wishlist_app %}
        {% if wishlist_app == 'growave' %}
          <div class="m-tooltip m-wishlist-button m-button--icon m-tooltip--style-1">
            <span class="m-tooltip-icon m:block">
              {% comment %} theme-check-disable {% endcomment %}
              {% capture the_snippet_fave_icon %}{% render 'ssw-widget-faveicon' with product.id %}{% endcapture %}
              {% unless the_snippet_fave_icon contains 'Liquid error' %}
                {{ the_snippet_fave_icon }}
              {% else %}
                {% render 'mm-ssw-widget-faveicon' with product.id %}
              {% endunless %}
              {% comment %} theme-check-enable {% endcomment %}
            </span>
          </div>
        {% else %}
          <div class="m-pcard-wish-wrapper">
            {% render 'tooltip', type: 'wishlist', product: product, class_name: 'm-tooltip--left', style: 2 %}
            <span class="pcard-wish-icon-default" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#FFFF" stroke="#222222" stroke-width="0.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
              </svg>
            </span>
            <span class="pcard-wish-icon-filled" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#222222" stroke="#222222" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
              </svg>
            </span>
          </div>
        {% endif %}
      {%- else -%}
        <button type="button" aria-label="{{ 'products.product.add_to_wishlist' | t }}" class="m-pcard-wish-wrapper">
          <span class="pcard-wish-icon-default" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#222222" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </span>
          <span class="pcard-wish-icon-filled" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#222222" stroke="#222222" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </span>
        </button>
      {%- endif -%}
    </div>

    {%- comment -%} Countdown timer {%- endcomment -%}
    {% liquid
      assign metafields_time = product.metafields.global.minimog_countdown
      if settings.show_countdown and metafields_time != blank
        render 'countdown-timer', time: metafields_time, separator: false, short_label: true, extra_classes: 'm-product-card__countdown m:hidden'
      endif
    %}

  </div>
  {%- comment -%} end .m-product-card__media {%- endcomment -%}

  {%- comment -%}============ CONTENT BLOCK ============{%- endcomment -%}
  <div class="m-product-card__content m:text-{{ pcard_alignment }}">
    <div class="m-product-card__info">

      {%- comment -%} Gemstone picker {%- endcomment -%}
      {%- if gemstone_metafield != blank -%}
        <div class="m-pcard-gemstone-row">
          {%- for gemstone in gemstone_metafield.value -%}
            {%- liquid
              assign g_src = ''
              assign g_alt = ''
              if gemstone.preview_image != blank
                assign g_src = gemstone.preview_image | image_url: width: 60
                assign g_alt = gemstone.alt | escape
              elsif gemstone.image != blank
                assign g_src = gemstone.image | image_url: width: 60
                assign g_alt = gemstone.image.alt | escape
              elsif gemstone.src != blank
                assign g_src = gemstone | image_url: width: 60
                assign g_alt = gemstone.alt | escape
              endif
            -%}
            {%- if g_src != blank -%}
              <div class="m-pcard-gemstone-item" title="{{ g_alt }}">
                <img src="{{ g_src }}" alt="{{ g_alt }}" width="28" height="28" loading="lazy">
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%} Material title {%- endcomment -%}
      {%- if material_title != blank -%}
        <p class="m-pcard-material-title">{{ material_title.value }}</p>
      {%- endif -%}

      {%- comment -%} Vendor {%- endcomment -%}
      {%- if show_vendor -%}
        <span class="m-product-card__vendor">{{ product.vendor }}</span>
      {%- endif -%}

      {%- comment -%} Product title {%- endcomment -%}
      {% if show_title == true %}
        <h3 class="m-product-card__title">
          <a href="{{ product_url }}"
            class="m-product-card__name{% if settings.uppercase_prd_name %} m:uppercase{% endif %}"
          >
            {{ product.title }}
          </a>
        </h3>
      {% endif %}

      {%- comment -%} Reviews {%- endcomment -%}
      {% if settings.show_review_badge %}
        <div class="m-product-card__reviews m:text-color-body">
          {% render 'product-reviews-app__badge', product: product %}
        </div>
      {% endif %}

      {%- comment -%} Variant swatches {%- endcomment -%}
      {%- liquid
        assign v1_url = ''
        assign v2_url = ''
        assign v3_url = ''

        if variant_img_1 != blank
          if variant_img_1.value != blank
            assign v1_url = variant_img_1.value | image_url: width: 1100
          else
            assign v1_url = variant_img_1 | image_url: width: 1100
          endif
        endif

        if variant_img_2 != blank
          if variant_img_2.value != blank
            assign v2_url = variant_img_2.value | image_url: width: 1100
          else
            assign v2_url = variant_img_2 | image_url: width: 1100
          endif
        endif

        if variant_img_3 != blank
          if variant_img_3.value != blank
            assign v3_url = variant_img_3.value | image_url: width: 1100
          else
            assign v3_url = variant_img_3 | image_url: width: 1100
          endif
        endif
      -%}

      {%- capture swatch_meta_map -%}["{{ v1_url }}","{{ v2_url }}","{{ v3_url }}"]{% endcapture %}

      {% if product.has_only_default_variant == false and show_variant_options %}
        <div
          class="m-product-card__option-wrapper"
          data-pcard-swatches
          data-meta-imgs='{{ swatch_meta_map }}'
        >
          {%- liquid
            assign seen_options = ''
            assign swatch_index = 0
          -%}
          {%- for variant in product.variants -%}
            {%- liquid
              assign opt1 = variant.option1
              assign already_seen = false
              if seen_options contains opt1
                assign already_seen = true
              endif
            -%}
            {%- unless already_seen -%}
              {%- liquid
                assign seen_options = seen_options | append: opt1 | append: '|||'

                comment
                  Small material swatch icon comes from the variant metafield.
                  The real Shopify variant image remains separate for product
                  image/hover/checkout use.
                endcomment

                assign sv_src = ''
                assign material_swatch = variant.metafields.custom.material_swatch.value

                if material_swatch != blank
                  assign sv_src = material_swatch | image_url: width: 120
                elsif variant.featured_image != blank
                  assign sv_src = variant.featured_image | image_url: width: 120
                elsif variant.image != blank
                  assign sv_src = variant.image | image_url: width: 120
                endif

                assign sv_product_src = ''
                if variant.featured_image != blank
                  assign sv_product_src = variant.featured_image | image_url: width: 1100
                elsif variant.image != blank
                  assign sv_product_src = variant.image | image_url: width: 1100
                endif
              -%}
              {%- if sv_src != blank -%}
                {%- comment -%} data-price, data-compare-price, data-currency added for JS price sync {%- endcomment -%}
                <div
                  class="m-pcard-swatch-wrap{% if swatch_index == 0 %} is-selected{% endif %}"
                  data-swatch-index="{{ swatch_index }}"
                  data-variant-image="{{ sv_product_src }}"
                  data-price="{{ variant.price }}"
                  data-compare-price="{{ variant.compare_at_price }}"
                  data-currency="{{ cart.currency.iso_code }}"
                  title="{{ opt1 | escape }}"
                  role="button"
                  tabindex="0"
                  aria-label="{{ opt1 | escape }}"
                >
                  <div class="m-pcard-swatch-gap"></div>
                  <div class="m-pcard-swatch-img-wrap">
                    <img
                      src="{{ sv_src }}"
                      alt="{{ opt1 | escape }}"
                      width="32"
                      height="32"
                      loading="lazy"
                      class="m-pcard-swatch-img"
                    >
                  </div>
                </div>
                {%- assign swatch_index = swatch_index | plus: 1 -%}
              {%- endif -%}
            {%- endunless -%}
            {%- if swatch_index >= 3 -%}{%- break -%}{%- endif -%}
          {%- endfor -%}
        </div>
      {%- elsif product.has_only_default_variant == false and show_variant_options -%}
        {% render 'product-card-option',
          product: product,
          show_variant_options: show_variant_options,
          pcard_alignment: pcard_alignment,
          context: context
        %}
      {% endif %}

      {%- comment -%} Price — data-pcard-price lets JS update it on swatch click {%- endcomment -%}
      <div class="m-product-card__price" data-pcard-price>
        {% render 'product-prices', product: product, is_product_card: true %}
      </div>

      {%- comment -%} Inventory {%- endcomment -%}
      {%- if show_inventory and selected_variant.inventory_management != blank -%}
        {%- liquid
          assign inventory_threshold = settings.low_inventory_threshold
          assign show_inventory_count = settings.show_inventory_count
          assign inventory_visibility = settings.inventory_visibility
          assign inventory_hide_backordered = settings.inventory_hide_backordered

          assign total = 0
          assign inventory_policy = ''
          for variant in product.variants
            if variant.inventory_quantity > 0
              assign total = total | plus: variant.inventory_quantity
            endif
            if variant.inventory_policy == 'continue'
              assign inventory_policy = 'continue'
            endif
          endfor

          if total <= 0
            if inventory_policy == 'continue'
              assign status = 'backordered'
            elsif product.available
              assign status = 'instock'
            else
              assign status = 'outofstock'
            endif
          elsif total <= inventory_threshold
            assign status = 'low'
          else
            assign status = 'normal'
          endif

          assign show = false
          if inventory_visibility == 'always'
            assign show = true
            if status == 'backordered' and inventory_hide_backordered
              assign show = false
            endif
          else
            if status == 'low'
              assign show = true
            endif
          endif

          if status == 'outofstock'
            assign show = false
          endif

          assign show_inventory_number = true
          if show_inventory_count == 'never' or total <= 0 or show_inventory_count == 'low_inventory' and status != 'low'
            assign show_inventory_number = false
          endif
        -%}
        {%- if show == true -%}
          <div class="m-product-inventory m-product-card__inventory m:text-sm" data-status="{{ status }}">
            <div class="m-product-inventory__inner">
              <span class="m-product-inventory__text">
                <span class="m-product-inventory__pin"></span>
                <span class="m-product-inventory__status">
                  {% liquid
                    case status
                      when 'backordered'
                        render 'new-locale', key: 'products.product.backordered'
                      when 'low'
                        if show_inventory_number
                          render 'new-locale', key: 'products.product.inventory_low_quantity_html', param: '{{ quantity }}', value: total
                        else
                          render 'new-locale', key: 'products.product.low_stock'
                        endif
                      else
                        if show_inventory_number
                          render 'new-locale', key: 'products.product.inventory_quantity_html', param: '{{ quantity }}', value: total
                        else
                          echo 'products.product.in_stock' | t
                        endif
                    endcase
                  %}
                </span>
              </span>
            </div>
          </div>
        {%- endif -%}
      {%- endif -%}

    </div>
    {%- comment -%} end .m-product-card__info {%- endcomment -%}

    {%- comment -%} Direct Add To Bag Button {%- endcomment -%}
    <div class="m-pcard-direct-add">
      <product-form>
        {%- assign product_form_id = 'product-form-' | append: product.id | append: '-' | append: section.id -%}
        {%- form 'product', product, id: product_form_id, class: 'm:w-full', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
          <input type="hidden" name="id" value="{{ variant_id }}">
          <button
            type="submit"
            name="add"
            class=" a m:w-full m:flex m:items-center m:justify-center"
          >
            <span class="m-product-btn-text">
              {%- if product.available -%}
                ADD TO BAG
              {%- else -%}
                {{ 'products.product.sold_out' | t }}
              {%- endif -%}
            </span>
          </button>
        {%- endform -%}
      </product-form>
    </div>

  </div>
  {%- comment -%} end .m-product-card__content {%- endcomment -%}

  <script>
  (function () {
    var card = document.currentScript.closest('[data-product-id]');
    if (!card) return;

    var swatchWrap  = card.querySelector('[data-pcard-swatches]');
    var hoverImgEl  = card.querySelector('[data-pcard-hover-img-el]');
    var mainImgWrap = card.querySelector('[data-pcard-main-img]');
    if (!mainImgWrap || !hoverImgEl) return;

    var mainImg = mainImgWrap.querySelector('img');
    if (!mainImg) return;

    var originalMainSrc    = mainImg.src;
    var originalMainSrcset = mainImg.srcset || '';

    var metaUrls = [];
    if (swatchWrap) {
      try {
        metaUrls = JSON.parse(swatchWrap.getAttribute('data-meta-imgs') || '[]');
      } catch (e) {}
    }

    /* ── Price sync ─────────────────────────────────────────────────────── */
    var priceEl = card.querySelector('[data-pcard-price]');

    function formatMoney(cents, currency) {
      if (!cents && cents !== 0) return '';
      if (window.Shopify && window.Shopify.formatMoney) {
        return window.Shopify.formatMoney(
          cents,
          window.theme && window.theme.moneyFormat ? window.theme.moneyFormat : '{{amount}}'
        );
      }
      var symbols = { USD: '$', EUR: '€', GBP: '£', CAD: 'CA$', AUD: 'A$' };
      var sym = symbols[currency] || (currency + ' ');
      return sym + (parseInt(cents, 10) / 100).toFixed(2);
    }

    function updatePrice(sw) {
      if (!priceEl) return;
      var price        = sw.getAttribute('data-price');
      var comparePrice = sw.getAttribute('data-compare-price');
      var currency     = sw.getAttribute('data-currency') || '';
      if (!price) return;

      var priceFmt   = formatMoney(price, currency);
      var compareFmt = comparePrice && parseInt(comparePrice, 10) > parseInt(price, 10)
                       ? formatMoney(comparePrice, currency)
                       : '';

      priceEl.innerHTML = compareFmt
        ? '<span class="m-price" style="font-weight:400;font-size:18px;color:#222;">' + priceFmt + '</span>'
          + '<span class="m-price m-price-item--regular" style="font-size:14px;color:#999;text-decoration:line-through;font-weight:400;">' + compareFmt + '</span>'
        : '<span class="m-price" style="font-weight:400;font-size:18px;color:#222;">' + priceFmt + '</span>';
    }
    /* ── end price sync ─────────────────────────────────────────────────── */

    if (swatchWrap) {
      var swatches = swatchWrap.querySelectorAll('.m-pcard-swatch-wrap');

      function activate(sw) {
        /* 1. Update active ring */
        swatches.forEach(function (s) { s.classList.remove('is-selected'); });
        sw.classList.add('is-selected');

        /* 2. Update hover image */
        var idx     = parseInt(sw.getAttribute('data-swatch-index'), 10);
        var metaUrl = (metaUrls && metaUrls[idx]) ? metaUrls[idx] : '';

        var variantImage     = sw.getAttribute('data-variant-image') || '';
        var activeVariantSrc = metaUrl || variantImage || originalMainSrc;
        if (activeVariantSrc) {
          hoverImgEl.src    = activeVariantSrc;
          hoverImgEl.srcset = '';
        }

        /* 3. Update price */
        updatePrice(sw);
      }

      swatches.forEach(function (sw) {
        sw.addEventListener('click', function (e) {
          e.preventDefault();
          activate(sw);
        });
        sw.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            activate(sw);
          }
        });
      });

      /* On load: sync hover image + price to first swatch */
      var firstSwatch = swatches[0];
      if (firstSwatch) {
        var firstMeta         = (metaUrls && metaUrls[0]) ? metaUrls[0] : '';
        var firstVariantImage = firstSwatch.getAttribute('data-variant-image') || '';
        var firstSrc          = firstMeta || firstVariantImage || originalMainSrc;
        if (firstSrc) {
          hoverImgEl.src    = firstSrc;
          hoverImgEl.srcset = '';
        }
        updatePrice(firstSwatch);
      }
    } else {
      hoverImgEl.src    = originalMainSrc;
      hoverImgEl.srcset = originalMainSrcset;
    }
  })();
  </script>

</div>
{%- if column_wrapper -%}</div>{%- endif -%}
