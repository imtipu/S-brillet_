        {%- endif -%}

        <div class="mpg-product-grouping__select-wrap select">
          <select
            id="ProductGroupingSelect-{{ section.id }}-{{ block.id }}"
            class="mpg-product-grouping__select select__select"
            aria-label="{{ picker_label | default: 'Product option' | escape }}"
            onchange="if (this.value) window.location.assign(this.value);"
          >
            {%- for related_product in related_products -%}
              {%- liquid
                assign option_value_metafield = related_product.metafields[option_value_namespace][option_value_key]
                assign option_text = option_value_metafield.value | default: related_product.title
                assign is_current_product = false
                if related_product.id == product.id
                  assign is_current_product = true
                endif
              -%}
              <option
                value="{{ related_product.url }}"
                {% if is_current_product %}selected{% endif %}
              >
                {{ option_text | escape }}
                {%- if block.settings.show_sold_out_text and related_product.available == false -%}
                  — Sold out
                {%- endif -%}
              </option>
            {%- endfor -%}
          </select>

          {%- render 'icon-caret' -%}
        </div>
      </div>

    {%- elsif block.settings.picker_type == 'text_pills' -%}
      <fieldset class="mpg-product-grouping__fieldset">
        {%- if picker_label != blank -%}
          <legend class="mpg-product-grouping__label form__label">
            {{ picker_label | escape }}
          </legend>
        {%- endif -%}

        <div class="mpg-product-grouping__pill-options" role="list">
          {%- for related_product in related_products -%}
            {%- liquid
              assign option_value_metafield = related_product.metafields[option_value_namespace][option_value_key]
              assign option_text = option_value_metafield.value | default: related_product.title
              assign is_current_product = false
              if related_product.id == product.id
                assign is_current_product = true
              endif
            -%}

            <a
              class="mpg-product-grouping__pill{% if is_current_product %} is-active{% endif %}{% unless related_product.available %} is-sold-out{% endunless %}"
              href="{{ related_product.url }}"
              role="listitem"
              {% if is_current_product %}aria-current="page"{% endif %}
            >
              <span>{{ option_text | escape }}</span>
              {%- if block.settings.show_sold_out_text and related_product.available == false -%}
                <small>Sold out</small>
              {%- endif -%}
            </a>
          {%- endfor -%}
        </div>
      </fieldset>

    {%- else -%}
      <div class="m-product-option m-product-option--swatch mpg-product-grouping__variant-layout">
        <div class="m-product-option__inner">
          {%- if picker_label != blank -%}
            <div class="m-product-option--label mpg-product-grouping__variant-label">
              <label class="option-label">
                <span class="option-label--title">{{ picker_label | escape }}:</span>
                {%- if block.settings.show_selected_value -%}
                  <span class="option-label--selected">{{ current_option_text | escape }}</span>
                {%- endif -%}
              </label>
            </div>
          {%- endif -%}

          <div
            class="m-product-option--content m:inline-flex m:flex-wrap mpg-product-grouping__swatch-options"
            role="list"
          >
            {%- for related_product in related_products -%}
              {%- liquid
                assign option_value_metafield = related_product.metafields[option_value_namespace][option_value_key]
                assign option_text = option_value_metafield.value | default: related_product.title

                assign is_current_product = false
                if related_product.id == product.id
                  assign is_current_product = true
                endif

                assign swatch_image = blank
                if swatch_image_namespace != blank and swatch_image_key != blank
                  assign swatch_image_metafield = related_product.metafields[swatch_image_namespace][swatch_image_key]
                  assign swatch_image = swatch_image_metafield.value
                endif

                if swatch_image == blank
                  assign swatch_image = related_product.featured_image
                endif

                assign swatch_render_image = swatch_image.preview_image | default: swatch_image
              -%}

              <a
                href="{{ related_product.url }}"
                class="mpg-product-grouping__swatch-node m-product-option--node m-tooltip m-tooltip--top{% if is_current_product %} is-selected{% endif %}{% unless related_product.available %} m-product-option--node__unavailable{% endunless %}"
                data-option-type="product-grouping"
                data-product-grouping-value="{{ option_text | escape }}"
                role="listitem"
                {% if is_current_product %}aria-current="page"{% endif %}
                aria-label="{{ option_text | escape }}{% unless related_product.available %}, sold out{% endunless %}"
              >
                <span class="m-product-option--oct-gap mpg-product-grouping__oct-gap">
                  <span class="m-product-option--oct-inner mpg-product-grouping__oct-inner">
                    <span class="m-product-option--node__label mpg-product-grouping__swatch-label">
                      {%- if swatch_render_image != blank -%}
                        <img
                          src="{{ swatch_render_image | image_url: height: 160 }}"
                          alt="{{ option_text | escape }}"
                          loading="lazy"
                          width="auto"
                          height="{{ block.settings.swatch_height | default: 38 }}"
                        >
                      {%- else -%}
                        <span class="mpg-product-grouping__fallback-text">{{ option_text | escape }}</span>
                      {%- endif -%}
                    </span>
                  </span>
                </span>

                <span class="m-tooltip__content">{{ option_text | escape }}</span>
              </a>
            {%- endfor -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>

{%- elsif request.design_mode -%}
  <div class="mpg-product-grouping mpg-product-grouping--debug">
    <strong>Product Grouping Picker is connected, but no products were returned.</strong>
    <p>Check the current product metafield, metaobject status, and Product Grouping list.</p>
  </div>
